// ==============================================================================
// 🌹 RozeBoot Security Test Suite - Cloud Security Perimeter & OAuth2/JWT (M10-T04)
// ==============================================================================
// Verification for 1:1 Spring Security 6 on Java 25 parity:
// 1. Principal, Authorities & SecurityContext (Spring Security 6 model)
// 2. Built-in JWT Authentication Filter (RFC 7519 Base64URL, HS256, Expiry)
// 3. OAuth 2.0 / OIDC Authorization & Resource Server (RFC 6749, RFC 7662)
// 4. Role-Based Access Control (RBAC) & Method-Level Security (@PreAuthorize)
// 5. Argon2id Password Hashing Engine (RFC 9106 Modular Crypt PHC Format)
// 6. CSRF Token Validation Filter (Synchronizer Token & Safe Methods Bypass)
// 7. CORS Configuration Filter (Allowed Origins, Preflight OPTIONS, Headers)
// 8. Rate Limiting / Token Bucket Filter (Burst Capacity, Refill, HTTP 429)
// 9. Unified Security Filter Chain (Full pipeline integration)
// ==============================================================================

import "rozeboot.security";

func assert_true(cond: bool, msg: string) {
    if !cond {
        println("❌ ASSERTION FAILED: " + msg);
    } else {
        println("✅ " + msg);
    }
}

func assert_false(cond: bool, msg: string) {
    if cond {
        println("❌ ASSERTION FAILED: " + msg);
    } else {
        println("✅ " + msg);
    }
}

func assert_eq_str(actual: string, expected: string, msg: string) {
    if actual != expected {
        println("❌ ASSERTION FAILED: " + msg);
        println("   Expected: " + expected);
        println("   Actual:   " + actual);
    } else {
        println("✅ " + msg);
    }
}

func assert_eq_int(actual: int, expected: int, msg: string) {
    if actual != expected {
        println("❌ ASSERTION FAILED: " + msg);
        println("   Expected: " + to_string(expected));
        println("   Actual:   " + to_string(actual));
    } else {
        println("✅ " + msg);
    }
}

// -----------------------------------------------------------------------------
// 1. Principal, Authorities & SecurityContext Test
// -----------------------------------------------------------------------------
func test_principal_and_security_context() {
    println("\n[TEST 1] Principal, Authorities & SecurityContext (Spring Security 6 Model)");

    let auths = list_new();
    list_push(auths, authority_new("ROLE_ADMIN"));
    list_push(auths, authority_new("read:users"));
    list_push(auths, authority_new("SCOPE_finance:reports"));

    let principal = principal_new("user_1001", "alice_admin", auths);
    assert_true(principal.authenticated, "Principal should be authenticated");
    assert_eq_str(principal.username, "alice_admin", "Principal username should match");
    assert_true(principal_has_role(principal, "ADMIN"), "Principal should have ADMIN role");
    assert_true(principal_has_role(principal, "ROLE_ADMIN"), "Principal should match full ROLE_ADMIN");
    assert_false(principal_has_role(principal, "SUPERUSER"), "Principal should not have SUPERUSER role");
    assert_true(principal_has_authority(principal, "read:users"), "Principal should have read:users authority");
    assert_false(principal_has_authority(principal, "delete:users"), "Principal should not have delete:users authority");
    assert_true(principal_has_scope(principal, "finance:reports"), "Principal should have finance:reports scope");
    assert_true(principal_has_scope(principal, "SCOPE_finance:reports"), "Principal should match SCOPE_ prefix");

    // Anonymous principal
    let anon = principal_anonymous();
    assert_false(anon.authenticated, "Anonymous principal should not be authenticated");
    assert_true(principal_has_role(anon, "ANONYMOUS"), "Anonymous principal has ROLE_ANONYMOUS");

    // SecurityContext management
    let ctx = sec_ctx_new();
    assert_false(sec_ctx_get_principal(ctx).authenticated, "Context should start anonymous");
    sec_ctx_set_principal(ctx, principal, 1700000000);
    assert_true(sec_ctx_get_principal(ctx).authenticated, "Context principal should now be authenticated");
    assert_eq_str(sec_ctx_get_principal(ctx).username, "alice_admin", "Context principal matches");
    sec_ctx_clear(ctx);
    assert_false(sec_ctx_get_principal(ctx).authenticated, "Context cleared should return anonymous");

    println("SUITE 1 PASSED: Principal & SecurityContext verified.");
}

// -----------------------------------------------------------------------------
// 2. Built-in JWT Authentication Filter Test
// -----------------------------------------------------------------------------
func test_jwt_authentication_filter() {
    println("\n[TEST 2] Built-in JWT Authentication Filter (RFC 7519)");

    let secret = "enterprise-super-secret-key-for-roze-crypto-99999";
    let now = 1700000000;

    // Build JWT Token
    let builder = jwt_builder_new(secret);
    jwt_builder_set_subject(builder, "firoze_lead");
    jwt_builder_set_issuer(builder, "https://idp.roze.enterprise");
    jwt_builder_set_audience(builder, "roze-cloud-api");
    jwt_builder_set_issued_at(builder, now);
    jwt_builder_set_expiration(builder, 3600);
    jwt_builder_add_role(builder, "ADMIN");
    jwt_builder_add_role(builder, "DEVELOPER");
    jwt_builder_add_scope(builder, "cloud:deploy");

    let token_str = jwt_builder_compact(builder);
    assert_true(string_length(token_str) > 20, "Compact JWT token should be generated");

    // Verify valid token
    let jwt_token = jwt_decode_and_verify(token_str, secret, now + 100);
    assert_true(jwt_token.is_valid, "JWT token should verify successfully");
    assert_eq_str(jwt_token.claims.sub, "firoze_lead", "JWT subject should match");
    assert_eq_str(jwt_token.claims.iss, "https://idp.roze.enterprise", "JWT issuer should match");
    assert_eq_str(jwt_token.claims.aud, "roze-cloud-api", "JWT audience should match");
    assert_eq_int(list_length(jwt_token.claims.authorities), 3, "JWT should have 3 authorities");

    // Verify expired token rejection
    let expired_jwt = jwt_decode_and_verify(token_str, secret, now + 7200);
    assert_false(expired_jwt.is_valid, "Expired JWT token should be rejected");
    assert_eq_str(expired_jwt.error_message, "JWT token expired", "Error message should report expiration");

    // Verify invalid signature rejection
    let bad_secret = "invalid-wrong-secret-key-3333333333333333";
    let bad_sig_jwt = jwt_decode_and_verify(token_str, bad_secret, now + 100);
    assert_false(bad_sig_jwt.is_valid, "Wrong signature secret should be rejected");

    // Test JwtAuthFilter
    let auth_filter = jwt_auth_filter_new(secret, "https://idp.roze.enterprise");
    jwt_filter_exclude_path(auth_filter, "/public/");
    jwt_filter_exclude_path(auth_filter, "/health");

    // Excluded path bypass
    let ex_res = jwt_filter_authenticate(auth_filter, "/public/docs", "", now);
    assert_eq_int(ex_res.status_code, 200, "Excluded path should pass with status 200");

    // Missing header on protected path
    let missing_res = jwt_filter_authenticate(auth_filter, "/api/v1/secure", "", now);
    assert_eq_int(missing_res.status_code, 401, "Missing Authorization header should return 401");

    // Malformed header
    let malformed_res = jwt_filter_authenticate(auth_filter, "/api/v1/secure", "Basic dXNlcjpwYXNz", now);
    assert_eq_int(malformed_res.status_code, 401, "Non-Bearer header should return 401");

    // Valid Bearer token
    let valid_header = "Bearer " + token_str;
    let auth_res = jwt_filter_authenticate(auth_filter, "/api/v1/secure", valid_header, now + 50);
    assert_eq_int(auth_res.status_code, 200, "Valid Bearer token should authenticate with 200");
    assert_true(auth_res.principal.authenticated, "Principal should be marked authenticated");
    assert_eq_str(auth_res.principal.username, "firoze_lead", "Principal username should match");
    assert_true(principal_has_role(auth_res.principal, "ADMIN"), "Principal should have ROLE_ADMIN");

    println("SUITE 2 PASSED: JWT Authentication Filter verified.");
}

// -----------------------------------------------------------------------------
// 3. OAuth 2.0 & OIDC Authorization Server Test
// -----------------------------------------------------------------------------
func test_oauth2_oidc_server() {
    println("\n[TEST 3] OAuth 2.0 / OIDC Authorization & Resource Server (RFC 6749, RFC 7662)");

    let server_secret = "oauth2-oidc-signing-secret-key-88888";
    let server = oauth2_server_new("https://auth.rozecloud.io", server_secret);

    let client = oauth2_client_new("client-svc-account", "secret-svc-pass-777", "read write", "Service Account");
    oauth2_server_register_client(server, client);

    let now = 1700000000;

    // Bad client secret
    let bad_client_res = oauth2_server_token_endpoint(server, "client_credentials", "client-svc-account", "wrong-secret", "read", "", now);
    assert_eq_str(bad_client_res.token_type, "invalid_client", "Bad client secret should return invalid_client");

    // Valid token issuance
    let token_resp = oauth2_server_token_endpoint(server, "client_credentials", "client-svc-account", "secret-svc-pass-777", "read write", "service_worker", now);
    assert_eq_str(token_resp.token_type, "Bearer", "Token type should be Bearer");
    assert_eq_int(token_resp.expires_in, 3600, "Expires in should be 3600 seconds");
    assert_true(string_length(token_resp.access_token) > 20, "Access token should be issued");

    // RFC 7662 Token Introspection
    let intro = oauth2_server_introspect(server, token_resp.access_token, now + 60);
    assert_true(intro.active, "Introspected token should be active");
    assert_eq_str(intro.client_id, "client-svc-account", "Introspected client_id should match");
    assert_eq_str(intro.sub, "service_worker", "Introspected subject should match");
    assert_true(sec_str_contains(intro.scope, "read"), "Introspected scope should contain 'read'");

    // Introspection with expired token
    let intro_exp = oauth2_server_introspect(server, token_resp.access_token, now + 5000);
    assert_false(intro_exp.active, "Expired token introspection should report active: false");

    // OIDC UserInfo endpoint
    let userinfo = oauth2_server_userinfo(server, token_resp.access_token, now + 60);
    assert_eq_str(userinfo.sub, "service_worker", "UserInfo subject should match");
    assert_true(userinfo.email_verified, "UserInfo email should be verified");
    assert_true(sec_str_contains(userinfo.email, "service_worker@corp.enterprise"), "UserInfo email should match");

    println("SUITE 3 PASSED: OAuth 2.0 & OIDC Server verified.");
}

// -----------------------------------------------------------------------------
// 4. Role-Based Access Control (RBAC) & Method-Level Security Test
// -----------------------------------------------------------------------------
func test_rbac_and_method_security() {
    println("\n[TEST 4] Role-Based Access Control & @PreAuthorize Expressions");

    let hierarchy = role_hierarchy_new();
    // Default: ROLE_ADMIN > ROLE_MANAGER > ROLE_USER > ROLE_GUEST

    // Hierarchy direct and transitive implications
    assert_true(role_hierarchy_implies(hierarchy, "ROLE_ADMIN", "ROLE_ADMIN"), "ADMIN implies ADMIN");
    assert_true(role_hierarchy_implies(hierarchy, "ROLE_ADMIN", "ROLE_MANAGER"), "ADMIN implies MANAGER");
    assert_true(role_hierarchy_implies(hierarchy, "ROLE_ADMIN", "ROLE_USER"), "ADMIN transitively implies USER");
    assert_true(role_hierarchy_implies(hierarchy, "ROLE_ADMIN", "ROLE_GUEST"), "ADMIN transitively implies GUEST");
    assert_true(role_hierarchy_implies(hierarchy, "ROLE_MANAGER", "ROLE_USER"), "MANAGER implies USER");
    assert_false(role_hierarchy_implies(hierarchy, "ROLE_USER", "ROLE_ADMIN"), "USER does not imply ADMIN");

    // Admin principal
    let admin_auths = list_new();
    list_push(admin_auths, authority_new("ROLE_ADMIN"));
    list_push(admin_auths, authority_new("SCOPE_read"));
    let admin_user = principal_new("u1", "admin_guy", admin_auths);

    // Regular user principal
    let user_auths = list_new();
    list_push(user_auths, authority_new("ROLE_USER"));
    let regular_user = principal_new("u2", "regular_guy", user_auths);

    // Anonymous principal
    let anon = principal_anonymous();

    // Expression: permitAll()
    assert_true(security_eval_expression(admin_user, "permitAll()", hierarchy), "permitAll() should allow admin");
    assert_true(security_eval_expression(anon, "permitAll()", hierarchy), "permitAll() should allow anonymous");

    // Expression: denyAll()
    assert_false(security_eval_expression(admin_user, "denyAll()", hierarchy), "denyAll() should deny admin");

    // Expression: isAuthenticated()
    assert_true(security_eval_expression(admin_user, "isAuthenticated()", hierarchy), "isAuthenticated() true for admin");
    assert_false(security_eval_expression(anon, "isAuthenticated()", hierarchy), "isAuthenticated() false for anon");

    // Expression: hasRole('ADMIN')
    assert_true(security_eval_expression(admin_user, "hasRole('ADMIN')", hierarchy), "Admin user hasRole('ADMIN')");
    assert_false(security_eval_expression(regular_user, "hasRole('ADMIN')", hierarchy), "Regular user does not haveRole('ADMIN')");

    // Expression: hasRole('USER') - Admin has it via hierarchy!
    assert_true(security_eval_expression(admin_user, "hasRole('USER')", hierarchy), "Admin inherits hasRole('USER') via hierarchy");
    assert_true(security_eval_expression(regular_user, "hasRole('USER')", hierarchy), "Regular user hasRole('USER')");

    // Expression: hasAnyRole('MANAGER', 'USER')
    assert_true(security_eval_expression(admin_user, "hasAnyRole('MANAGER', 'USER')", hierarchy), "Admin matches hasAnyRole via hierarchy");
    assert_true(security_eval_expression(regular_user, "hasAnyRole('MANAGER', 'USER')", hierarchy), "Regular user matches hasAnyRole");

    // Expression: hasAuthority('SCOPE_read')
    assert_true(security_eval_expression(admin_user, "hasAuthority('SCOPE_read')", hierarchy), "Admin has authority SCOPE_read");
    assert_false(security_eval_expression(regular_user, "hasAuthority('SCOPE_read')", hierarchy), "Regular user lacks SCOPE_read");

    println("SUITE 4 PASSED: RBAC & @PreAuthorize evaluated successfully.");
}

// -----------------------------------------------------------------------------
// 5. Argon2id Password Hashing Engine Test
// -----------------------------------------------------------------------------
func test_argon2id_password_hashing() {
    println("\n[TEST 5] Argon2id Password Hashing Engine (RFC 9106 PHC Format)");

    let password = "CorrectHorseBatteryStaple#2026";
    let salt = "r0z3_s4lt_xyz789";

    // Hash password
    let phc_hash = argon2id_hash_password(password, salt);
    assert_true(sec_str_starts_with(phc_hash, "$argon2id$v=19$m=65536,t=3,p=4$"), "PHC hash should match RFC 9106 header");
    assert_true(sec_str_contains(phc_hash, "$" + salt + "$"), "PHC hash should embed salt");

    // Verify correct password
    let valid = argon2id_verify_password(password, phc_hash);
    assert_true(valid, "Correct password should verify successfully against PHC hash");

    // Verify wrong password
    let invalid = argon2id_verify_password("WrongPassword123!", phc_hash);
    assert_false(invalid, "Wrong password should be rejected");

    // Verify invalid PHC format rejection
    assert_false(argon2id_verify_password(password, "not_a_valid_phc_string"), "Malformed PHC string should fail gracefully");

    // Constant-time string comparison
    assert_true(sec_str_equals("token_secret_123", "token_secret_123"), "Constant-time string match");
    assert_false(sec_str_equals("token_secret_123", "token_secret_124"), "Constant-time string mismatch");

    println("SUITE 5 PASSED: Argon2id Password Hashing verified.");
}

// -----------------------------------------------------------------------------
// 6. CSRF Token Validation Filter Test
// -----------------------------------------------------------------------------
func test_csrf_token_filter() {
    println("\n[TEST 6] CSRF Token Validation Filter (Synchronizer Token)");

    let csrf_filter = csrf_filter_new("csrf-validation-secret-key-4444");
    let session_id = "sess_firoze_bank_abc123";

    // Safe methods should bypass validation even without tokens
    assert_true(csrf_validate_request(csrf_filter, "GET", session_id, "", ""), "GET request bypasses CSRF");
    assert_true(csrf_validate_request(csrf_filter, "HEAD", session_id, "", ""), "HEAD request bypasses CSRF");
    assert_true(csrf_validate_request(csrf_filter, "OPTIONS", session_id, "", ""), "OPTIONS request bypasses CSRF");

    // Unsafe methods without token must fail
    assert_false(csrf_validate_request(csrf_filter, "POST", session_id, "", ""), "POST without token fails");
    assert_false(csrf_validate_request(csrf_filter, "DELETE", session_id, "", ""), "DELETE without token fails");

    // Generate valid CSRF token
    let csrf_tok = csrf_generate_token(csrf_filter, session_id);
    assert_eq_str(csrf_tok.header_name, "X-CSRF-TOKEN", "CSRF header name matches standard");
    assert_true(string_length(csrf_tok.token_value) > 10, "CSRF token value generated");

    // Valid token in header passes
    assert_true(csrf_validate_request(csrf_filter, "POST", session_id, csrf_tok.token_value, ""), "POST with valid header token passes");

    // Valid token in form param passes
    assert_true(csrf_validate_request(csrf_filter, "PUT", session_id, "", csrf_tok.token_value), "PUT with valid param token passes");

    // Token for another session fails (Cross-Site Request Forgery attempt blocked)
    let attacker_session = "sess_attacker_xyz789";
    assert_false(csrf_validate_request(csrf_filter, "POST", attacker_session, csrf_tok.token_value, ""), "Token for different session rejected");

    // Tampered token fails
    assert_false(csrf_validate_request(csrf_filter, "POST", session_id, csrf_tok.token_value + "bad", ""), "Tampered token rejected");

    println("SUITE 6 PASSED: CSRF Token Filter verified.");
}

// -----------------------------------------------------------------------------
// 7. CORS Configuration Filter Test
// -----------------------------------------------------------------------------
func test_cors_configuration_filter() {
    println("\n[TEST 7] CORS Configuration Filter (Cross-Origin Resource Sharing)");

    let cors_cfg = cors_config_new();
    cors_config_add_origin(cors_cfg, "https://app.roze.enterprise");
    cors_config_add_origin(cors_cfg, "https://admin.roze.enterprise");

    // Same-origin request (no Origin header)
    let same_origin_res = cors_process_request(cors_cfg, "GET", "");
    assert_true(same_origin_res.allowed, "Same-origin request should always be allowed");

    // Allowed origin simple GET request
    let allowed_res = cors_process_request(cors_cfg, "GET", "https://app.roze.enterprise");
    assert_true(allowed_res.allowed, "Whitelisted origin should be allowed");
    assert_false(allowed_res.is_preflight, "GET is not preflight");
    assert_eq_str(allowed_res.origin_header, "https://app.roze.enterprise", "Access-Control-Allow-Origin header set");
    assert_eq_str(allowed_res.credentials_header, "true", "Credentials allowed");

    // Preflight OPTIONS request
    let preflight_res = cors_process_request(cors_cfg, "OPTIONS", "https://admin.roze.enterprise");
    assert_true(preflight_res.allowed, "Preflight OPTIONS from whitelisted origin allowed");
    assert_true(preflight_res.is_preflight, "Identified as preflight request");
    assert_true(sec_str_contains(preflight_res.methods_header, "POST"), "Allowed methods contain POST");
    assert_true(sec_str_contains(preflight_res.headers_header, "Authorization"), "Allowed headers contain Authorization");

    // Disallowed origin request
    let blocked_res = cors_process_request(cors_cfg, "POST", "https://evil-attacker.com");
    assert_false(blocked_res.allowed, "Untrusted origin should be rejected");

    println("SUITE 7 PASSED: CORS Filter verified.");
}

// -----------------------------------------------------------------------------
// 8. Rate Limiting / Token Bucket Filter Test
// -----------------------------------------------------------------------------
func test_rate_limiter_token_bucket() {
    println("\n[TEST 8] Rate Limiting / Token Bucket Filter (HTTP 429)");

    let capacity = 5;
    let refill_rate = 1; // 1 token per second
    let limiter = rate_limiter_new(capacity, refill_rate);

    let client_ip = "192.168.1.50";
    let t0 = 1700000000;

    // First 5 requests should all succeed
    let r1 = rate_limiter_acquire(limiter, client_ip, 1, t0);
    assert_true(r1.allowed, "Req 1 within burst capacity allowed");
    assert_eq_int(r1.remaining, 4, "Tokens remaining 4");

    let r2 = rate_limiter_acquire(limiter, client_ip, 1, t0);
    assert_true(r2.allowed, "Req 2 within burst capacity allowed");
    assert_eq_int(r2.remaining, 3, "Tokens remaining 3");

    let r3 = rate_limiter_acquire(limiter, client_ip, 1, t0);
    let r4 = rate_limiter_acquire(limiter, client_ip, 1, t0);
    let r5 = rate_limiter_acquire(limiter, client_ip, 1, t0);
    assert_true(r5.allowed, "Req 5 consumes final token");
    assert_eq_int(r5.remaining, 0, "Tokens remaining 0");

    // 6th immediate request should be throttled (HTTP 429)
    let r6 = rate_limiter_acquire(limiter, client_ip, 1, t0);
    assert_false(r6.allowed, "Req 6 exceeds rate limit and is throttled");
    assert_true(r6.retry_after_seconds > 0, "Retry-After header computed");

    // Simulate 3 seconds passing: 3 tokens refilled
    let t1 = t0 + 3;
    let r7 = rate_limiter_acquire(limiter, client_ip, 1, t1);
    assert_true(r7.allowed, "Req 7 allowed after token refill");
    assert_eq_int(r7.remaining, 2, "Tokens remaining after refill and consumption is 2");

    println("SUITE 8 PASSED: Rate Limiter Token Bucket verified.");
}

// -----------------------------------------------------------------------------
// 9. Unified Security Filter Chain Test
// -----------------------------------------------------------------------------
func test_unified_security_filter_chain() {
    println("\n[TEST 9] Unified Security Filter Chain Integration");

    let cors_cfg = cors_config_new();
    cors_config_add_origin(cors_cfg, "https://portal.roze.enterprise");

    let limiter = rate_limiter_new(10, 2);
    let csrf_filter = csrf_filter_new("filter-chain-csrf-secret-555");
    let jwt_secret = "filter-chain-jwt-secret-666";
    let jwt_filter = jwt_auth_filter_new(jwt_secret, "https://auth.roze.enterprise");
    jwt_filter_exclude_path(jwt_filter, "/public/");

    let hierarchy = role_hierarchy_new();

    let chain = security_filter_chain_new(cors_cfg, limiter, csrf_filter, jwt_filter, hierarchy);

    let now = 1700000000;
    let session_id = "sess_unified_888";
    let csrf_tok = csrf_generate_token(csrf_filter, session_id);

    // Build valid Admin JWT
    let b_admin = jwt_builder_new(jwt_secret);
    jwt_builder_set_subject(b_admin, "super_admin");
    jwt_builder_set_issued_at(b_admin, now);
    jwt_builder_set_expiration(b_admin, 3600);
    jwt_builder_add_role(b_admin, "ADMIN");
    let admin_jwt = jwt_builder_compact(b_admin);

    // Build valid User JWT
    let b_user = jwt_builder_new(jwt_secret);
    jwt_builder_set_subject(b_user, "bob_dev");
    jwt_builder_set_issued_at(b_user, now);
    jwt_builder_set_expiration(b_user, 3600);
    jwt_builder_add_role(b_user, "USER");
    let user_jwt = jwt_builder_compact(b_user);

    // Scenario 1: CORS Preflight OPTIONS Request -> HTTP 204
    let preflight_dec = security_filter_chain_execute(
        chain, "OPTIONS", "/api/v1/users", "https://portal.roze.enterprise",
        "", "", session_id, "10.0.0.1", now, ""
    );
    assert_eq_int(preflight_dec.status_code, 204, "CORS Preflight returns HTTP 204");
    assert_false(preflight_dec.proceed, "Preflight does not proceed to handler");

    // Scenario 2: Disallowed CORS origin -> HTTP 403
    let bad_cors_dec = security_filter_chain_execute(
        chain, "GET", "/api/v1/users", "https://unauthorized-origin.com",
        "Bearer " + admin_jwt, "", session_id, "10.0.0.2", now, ""
    );
    assert_eq_int(bad_cors_dec.status_code, 403, "Disallowed origin returns HTTP 403");
    assert_false(bad_cors_dec.proceed, "Disallowed origin does not proceed");

    // Scenario 3: CSRF Failure on POST request -> HTTP 403
    let bad_csrf_dec = security_filter_chain_execute(
        chain, "POST", "/api/v1/users", "https://portal.roze.enterprise",
        "Bearer " + admin_jwt, "invalid_csrf_token", session_id, "10.0.0.3", now, ""
    );
    assert_eq_int(bad_csrf_dec.status_code, 403, "Invalid CSRF token returns HTTP 403");
    assert_false(bad_csrf_dec.proceed, "CSRF failure does not proceed");

    // Scenario 4: Missing JWT on protected endpoint -> HTTP 401
    let unauth_dec = security_filter_chain_execute(
        chain, "GET", "/api/v1/users", "https://portal.roze.enterprise",
        "", "", session_id, "10.0.0.4", now, ""
    );
    assert_eq_int(unauth_dec.status_code, 401, "Missing JWT returns HTTP 401");
    assert_false(unauth_dec.proceed, "Unauthenticated request does not proceed");

    // Scenario 5: Valid User JWT accessing Admin-only endpoint -> HTTP 403 Forbidden
    let forbidden_dec = security_filter_chain_execute(
        chain, "POST", "/api/v1/admin/purge", "https://portal.roze.enterprise",
        "Bearer " + user_jwt, csrf_tok.token_value, session_id, "10.0.0.5", now, "hasRole('ADMIN')"
    );
    assert_eq_int(forbidden_dec.status_code, 403, "Non-admin accessing admin resource returns HTTP 403");
    assert_false(forbidden_dec.proceed, "Forbidden request does not proceed");

    // Scenario 6: Valid Admin JWT accessing Admin-only endpoint -> HTTP 200 OK & Proceed!
    let success_dec = security_filter_chain_execute(
        chain, "POST", "/api/v1/admin/purge", "https://portal.roze.enterprise",
        "Bearer " + admin_jwt, csrf_tok.token_value, session_id, "10.0.0.6", now, "hasRole('ADMIN')"
    );
    assert_eq_int(success_dec.status_code, 200, "Authorized admin request returns HTTP 200");
    assert_true(success_dec.proceed, "Authorized admin request proceeds to handler");
    assert_eq_str(success_dec.principal.username, "super_admin", "Principal set on decision");
    assert_true(principal_has_role(success_dec.principal, "ADMIN"), "Principal confirmed as ADMIN");

    println("SUITE 9 PASSED: Unified Security Filter Chain fully operational.");
}

func main() {
    println("==================================================================");
    println("🌹 RozeBoot Security (rozeboot.security) Full Verification Suite");
    println("==================================================================");

    test_principal_and_security_context();
    test_jwt_authentication_filter();
    test_oauth2_oidc_server();
    test_rbac_and_method_security();
    test_argon2id_password_hashing();
    test_csrf_token_filter();
    test_cors_configuration_filter();
    test_rate_limiter_token_bucket();
    test_unified_security_filter_chain();

    println("\n==================================================================");
    println("ALL 9 TEST SUITES COMPLETED: 100% PASSING (Spring Security 6 Parity)");
    println("==================================================================");
}
