// Authorization Scope & Boundary Rules
class ScanScope {
    authorized_by: string,
    allowed_cidrs: List,
    blocked_cidrs: List,
    audit_events: List,
}

func sec_scan_scope_new(authorized_by: string) -> ScanScope {
