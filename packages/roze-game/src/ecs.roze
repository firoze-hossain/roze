// Global World Resources (Singletons)
func world_insert_resource(w: World, key: string, res: Unknown) {
    let i = 0;
    while i < list_length(w.resources) {
        let entry: ResourceEntry = list_get(w.resources, i);
        if entry.name == key {
            entry.value = res;
            return;
        }
        i = i + 1;
    }
    list_push(w.resources, new ResourceEntry(key, res));
}

func world_get_resource(w: World, key: string) -> Unknown {
    let i = 0;
    while i < list_length(w.resources) {
        let entry: ResourceEntry = list_get(w.resources, i);
        if entry.name == key {
            return entry.value;
        }
        i = i + 1;
    }
    return "";
}

func world_has_resource(w: World, key: string) -> bool {
    let i = 0;
    while i < list_length(w.resources) {
        let entry: ResourceEntry = list_get(w.resources, i);
        if entry.name == key {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ==============================================================================
// SECTION 5: Bevy-Style Query Filter System
// ==============================================================================

class Query {
    all_mask: int,
    none_mask: int
}

func query_new(all_mask: int, none_mask: int) -> Query {
    return new Query(all_mask, none_mask);
}

class QueryResult {
    matched_archetypes: list,
    total_entities: int
}

func world_query(w: World, all_mask: int, none_mask: int) -> QueryResult {
    let matched = list_new();
    let total = 0;
    let count = list_length(w.archetypes);
    let i = 0;
    while i < count {
        let arch: Archetype = list_get(w.archetypes, i);
        let n_entities = list_length(arch.entity_ids);
        if n_entities > 0 {
            if bit_and(arch.mask, all_mask) == all_mask {
                if none_mask == 0 || bit_and(arch.mask, none_mask) == 0 {
                    list_push(matched, arch);
                    total = total + n_entities;
                }
            }
        }
        i = i + 1;
    }
    return new QueryResult(matched, total);
}

// ==============================================================================
// SECTION 6: Scene Graph Hierarchy & Matrix Propagation
// ==============================================================================

func world_attach_child(w: World, parent: Entity, child: Entity) {
    if !world_is_alive(w, parent) || !world_is_alive(w, child) {
        return;
    }
    if !world_has_component(w, parent, comp_hierarchy()) {
        world_add_hierarchy(w, parent, hierarchy_new());
    }
    if !world_has_component(w, child, comp_hierarchy()) {
        world_add_hierarchy(w, child, hierarchy_new());
    }

    let p_node = world_get_hierarchy(w, parent);
    let c_node = world_get_hierarchy(w, child);

    c_node.parent_id = parent.id;
    c_node.parent_gen = parent.generation;
    c_node.depth = p_node.depth + 1;
    list_push(p_node.children_ids, child.id);

    if world_has_component(w, child, comp_transform()) {
        let ct = world_get_transform(w, child);
        ct.is_dirty = true;
    }
}

func world_detach_child(w: World, child: Entity) {
    if !world_is_alive(w, child) || !world_has_component(w, child, comp_hierarchy()) {
        return;
    }
    let c_node = world_get_hierarchy(w, child);
    if c_node.parent_id >= 0 {
        let parent_e = new Entity(c_node.parent_id, c_node.parent_gen);
        if world_is_alive(w, parent_e) && world_has_component(w, parent_e, comp_hierarchy()) {
            let p_node = world_get_hierarchy(w, parent_e);
            let idx = 0;
            while idx < list_length(p_node.children_ids) {
                let cid: int = list_get(p_node.children_ids, idx);
                if cid == child.id {
                    list_remove(p_node.children_ids, idx);
                } else {
                    idx = idx + 1;
                }
            }
        }
        c_node.parent_id = -1;
        c_node.depth = 0;
    }
}

func world_propagate_hierarchy_recursive(w: World, parent_entity: Entity, parent_world_matrix: Mat4) {
    let p_node = world_get_hierarchy(w, parent_entity);
    let c_idx = 0;
    let num_children = list_length(p_node.children_ids);
    while c_idx < num_children {
        let child_id: int = list_get(p_node.children_ids, c_idx);
        let child_gen: int = list_get(w.entity_gens, child_id);
        let child_e = new Entity(child_id, child_gen);
        if world_is_alive(w, child_e) && world_has_component(w, child_e, comp_transform()) {
            let ct = world_get_transform(w, child_e);
            transform_update_local(ct);
            ct.world_matrix = mat4_mul(parent_world_matrix, ct.local_matrix);
            ct.is_dirty = false;

            if world_has_component(w, child_e, comp_hierarchy()) {
                world_propagate_hierarchy_recursive(w, child_e, ct.world_matrix);
            }
        }
        c_idx = c_idx + 1;
    }
}

func world_update_scene_graph(w: World) {
    let q = world_query(w, comp_transform(), 0);
    let a_idx = 0;
    let n_archs = list_length(q.matched_archetypes);
    while a_idx < n_archs {
        let arch: Archetype = list_get(q.matched_archetypes, a_idx);
        let r_idx = 0;
        let n_rows = list_length(arch.entity_ids);
        while r_idx < n_rows {
            let eid: int = list_get(arch.entity_ids, r_idx);
            let egen: int = list_get(arch.entity_gens, r_idx);
            let e = new Entity(eid, egen);
            let is_root = true;
            if world_has_component(w, e, comp_hierarchy()) {
                let h = world_get_hierarchy(w, e);
                if h.parent_id >= 0 {
                    is_root = false;
                }
            }
            if is_root {
                let t = world_get_transform(w, e);
                if t.is_dirty {
                    transform_update_local(t);
                    t.world_matrix = t.local_matrix;
                    t.is_dirty = false;
                }
                if world_has_component(w, e, comp_hierarchy()) {
                    world_propagate_hierarchy_recursive(w, e, t.world_matrix);
                }
            }
            r_idx = r_idx + 1;
        }
        a_idx = a_idx + 1;
    }
}

// ==============================================================================
// SECTION 7: Built-in Systems & Scheduling Engine
// ==============================================================================

func system_movement(w: World, dt: float) -> int {
    let q = world_query(w, bit_or(comp_transform(), comp_velocity()), 0);
    let updated = 0;
    let a_idx = 0;
    let n_archs = list_length(q.matched_archetypes);
    while a_idx < n_archs {
        let arch: Archetype = list_get(q.matched_archetypes, a_idx);
        let r = 0;
        let n_rows = list_length(arch.entity_ids);
        while r < n_rows {
            let t: Transform = list_get(arch.col_transforms, r);
            let v: Velocity = list_get(arch.col_velocities, r);

            // Record previous position for interpolation
            t.prev_position.x = t.position.x;
            t.prev_position.y = t.position.y;
            t.prev_position.z = t.position.z;

            // Integrate linear velocity
            t.position.x = t.position.x + (v.linear.x * dt);
            t.position.y = t.position.y + (v.linear.y * dt);
            t.position.z = t.position.z + (v.linear.z * dt);

            // Integrate angular velocity
            t.rotation.x = t.rotation.x + (v.angular.x * dt);
            t.rotation.y = t.rotation.y + (v.angular.y * dt);
            t.rotation.z = t.rotation.z + (v.angular.z * dt);

            t.is_dirty = true;
            updated = updated + 1;
            r = r + 1;
        }
        a_idx = a_idx + 1;
    }
    return updated;
}

func system_physics_fixed(w: World, fixed_dt: float) -> int {
    let q = world_query(w, bit_or(bit_or(comp_transform(), comp_velocity()), comp_rigidbody()), 0);
    let updated = 0;
    let gravity_y = -9.81;
    let a_idx = 0;
    let n_archs = list_length(q.matched_archetypes);
    while a_idx < n_archs {
        let arch: Archetype = list_get(q.matched_archetypes, a_idx);
        let r = 0;
        let n_rows = list_length(arch.entity_ids);
        while r < n_rows {
            let rb: RigidBody = list_get(arch.col_rigidbodies, r);
            if !rb.is_static {
                let t: Transform = list_get(arch.col_transforms, r);
                let v: Velocity = list_get(arch.col_velocities, r);

                // Apply gravity
                v.linear.y = v.linear.y + (gravity_y * fixed_dt);

                // Apply linear damping
                let damp = 1.0 - (rb.linear_damping * fixed_dt);
                if damp < 0.0 { damp = 0.0; }
                v.linear.x = v.linear.x * damp;
                v.linear.z = v.linear.z * damp;

                // Ground plane collision resolution (y = 0.0)
                if t.position.y <= 0.0 && v.linear.y < 0.0 {
                    t.position.y = 0.0;
                    v.linear.y = (0.0 - v.linear.y) * rb.restitution;
                    if v.linear.y < 0.05 {
                        v.linear.y = 0.0;
                    }
                }
                updated = updated + 1;
            }
            r = r + 1;
        }
        a_idx = a_idx + 1;
    }
    return updated;
}

func system_camera_sync(w: World) {
    let q = world_query(w, bit_or(comp_transform(), comp_camera()), 0);
    let a_idx = 0;
    while a_idx < list_length(q.matched_archetypes) {
        let arch: Archetype = list_get(q.matched_archetypes, a_idx);
        let r = 0;
        while r < list_length(arch.entity_ids) {
            let cam: Camera = list_get(arch.col_cameras, r);
            if cam.is_active {
                let t: Transform = list_get(arch.col_transforms, r);
                let forward = mat4_transform_vector(t.world_matrix, new Vector3(0.0, 0.0, -1.0));
                let target = vec3_add(t.position, forward);
                let up = new Vector3(0.0, 1.0, 0.0);
                cam.view_matrix = mat4_look_at(t.position, target, up);
            }
            r = r + 1;
        }
        a_idx = a_idx + 1;
    }
}

func system_lifetime(w: World, dt: float) -> int {
    let q = world_query(w, comp_lifetime(), 0);
    let despawned = 0;
    let dead_entities = list_new();
    let a_idx = 0;
    while a_idx < list_length(q.matched_archetypes) {
        let arch: Archetype = list_get(q.matched_archetypes, a_idx);
        let r = 0;
        while r < list_length(arch.entity_ids) {
            let lt: Lifetime = list_get(arch.col_lifetimes, r);
            lt.remaining_sec = lt.remaining_sec - dt;
            if lt.remaining_sec <= 0.0 {
                let eid: int = list_get(arch.entity_ids, r);
                let egen: int = list_get(arch.entity_gens, r);
                list_push(dead_entities, new Entity(eid, egen));
            }
            r = r + 1;
        }
        a_idx = a_idx + 1;
    }

    let d_idx = 0;
    while d_idx < list_length(dead_entities) {
        let dead_e: Entity = list_get(dead_entities, d_idx);
        if world_despawn(w, dead_e) {
            despawned = despawned + 1;
        }
        d_idx = d_idx + 1;
    }
    return despawned;
}

// ==============================================================================
// SECTION 8: 60+ FPS Real-Time Game Loop & Fixed-Timestep Engine
// ==============================================================================

class EngineTime {
    elapsed_seconds: float,
    delta_seconds: float,
    fixed_timestep: float,
    accumulator: float,
    alpha: float,
    frame_count: int,
    fixed_ticks: int
}

func engine_time_new(fixed_dt: float) -> EngineTime {
    return new EngineTime(0.0, 0.0, fixed_dt, 0.0, 0.0, 0, 0);
}

class Engine {
    world: World,
    time: EngineTime,
    target_fps: int,
    max_accumulator: float,
    is_running: bool,
    total_entities_processed: int,
    last_fps: float
}

func engine_new(target_fps: int) -> Engine {
    let w = world_new();
    let fps_f = 60.0;
    if target_fps > 0 {
        fps_f = target_fps * 1.0;
    }
    let fixed_dt = 1.0 / fps_f;
    let time = engine_time_new(fixed_dt);

    return new Engine(
        w,
        time,
        target_fps,
        0.25, // Clamp accumulator to 250ms to prevent spiral of death
        true,
        0,
        fps_f
    );
}

func engine_step(eng: Engine, frame_dt: float) {
    if !eng.is_running {
        return;
    }
    let dt = frame_dt;
    if dt > eng.max_accumulator {
        dt = eng.max_accumulator;
    }

    eng.time.delta_seconds = dt;
    eng.time.elapsed_seconds = eng.time.elapsed_seconds + dt;
    eng.time.accumulator = eng.time.accumulator + dt;

    // 1. Fixed-Timestep Physics Loop
    while eng.time.accumulator >= eng.time.fixed_timestep {
        system_physics_fixed(eng.world, eng.time.fixed_timestep);
        eng.time.accumulator = eng.time.accumulator - eng.time.fixed_timestep;
        eng.time.fixed_ticks = eng.time.fixed_ticks + 1;
    }

    // 2. Alpha interpolation factor for smooth rendering
    eng.time.alpha = eng.time.accumulator / eng.time.fixed_timestep;

    // 3. Update Systems (Gameplay & Kinematics)
    let moved = system_movement(eng.world, dt);
    eng.total_entities_processed = eng.total_entities_processed + moved;

    // 4. Lifetimes & Despawn System
    system_lifetime(eng.world, dt);

    // 5. PostUpdate: Scene Graph Matrix Propagation
    world_update_scene_graph(eng.world);

    // 6. Camera Synchronization
    system_camera_sync(eng.world);

    eng.time.frame_count = eng.time.frame_count + 1;
    if dt > 0.0 {
        eng.last_fps = 1.0 / dt;
    }
}

// Compute Interpolated Rendering Position
func engine_get_render_position(w: World, e: Entity, alpha: float) -> Vector3 {
    let t = world_get_transform(w, e);
    return vec3_lerp(t.prev_position, t.position, alpha);
}

// ==============================================================================
// SECTION 9: Fluent Entity Builder API
// ==============================================================================

class EntityBuilder {
    world: World,
    entity: Entity
}

func entity_builder(w: World) -> EntityBuilder {
    let e = world_spawn(w);
    return new EntityBuilder(w, e);
}

func eb_with_position(eb: EntityBuilder, x: float, y: float, z: float) -> EntityBuilder {
    world_add_transform(eb.world, eb.entity, transform_new(x, y, z));
    return eb;
}

func eb_with_velocity(eb: EntityBuilder, vx: float, vy: float, vz: float) -> EntityBuilder {
    world_add_velocity(eb.world, eb.entity, velocity_new(vx, vy, vz));
    return eb;
}

func eb_with_rigidbody(eb: EntityBuilder, mass: float, restitution: float) -> EntityBuilder {
    world_add_rigidbody(eb.world, eb.entity, rigidbody_new(mass, restitution));
    return eb;
}

func eb_with_collider_sphere(eb: EntityBuilder, radius: float) -> EntityBuilder {
    world_add_collider(eb.world, eb.entity, collider_sphere(radius));
    return eb;
}

func eb_with_collider_box(eb: EntityBuilder, sx: float, sy: float, sz: float) -> EntityBuilder {
    world_add_collider(eb.world, eb.entity, collider_box(sx, sy, sz));
    return eb;
}

func eb_with_mesh(eb: EntityBuilder, name: string, col: Color) -> EntityBuilder {
    world_add_mesh(eb.world, eb.entity, mesh_renderer_new(name, col));
    return eb;
}

func eb_with_camera(eb: EntityBuilder, fov: float, aspect: float) -> EntityBuilder {
    world_add_camera(eb.world, eb.entity, camera_new(fov, aspect));
    return eb;
}

func eb_with_tag(eb: EntityBuilder, name: string) -> EntityBuilder {
    world_add_tag(eb.world, eb.entity, tag_new(name));
    return eb;
}

func eb_with_lifetime(eb: EntityBuilder, sec: float) -> EntityBuilder {
    world_add_lifetime(eb.world, eb.entity, lifetime_new(sec));
    return eb;
}

func eb_build(eb: EntityBuilder) -> Entity {
    return eb.entity;
}
