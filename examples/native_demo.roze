// examples/native_demo.roze
// Demonstrates the native (Cranelift) backend -- compiles to a real,
// standalone executable, no JVM/JDK involved at all.
// Try it: roze run examples/native_demo.roze --target native
//
// Uses what the native backend supports today: int/bool/string/list/
// map/class functions, arithmetic, string concatenation and equality,
// list push/get/set/remove, map put/get/has/remove, class construction
// and field read/write (all under ARC -- see
// docs/MEMORY_MODEL_DECISION.md), if/while/for, and calling other
// functions. Not supported yet: string/list/map elements or keys/
// values inside a list/map specifically, a weak reference (so two
// classes referencing each other will leak), and every Core/
// Collections/IO/Web/Database intrinsic (JVM-specific today).

func fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func sign(x: int) -> int {
    if x > 0 {
        return 1;
    } else if x < 0 {
        return -1;
    } else {
        return 0;
    }
}

func sum_to(n: int) -> int {
    let total = 0;
    for let i = 1; i <= n; i = i + 1 {
        total = total + i;
    }
    return total;
}

func greet(name: string) -> string {
    return "Hello, " + name + "!";
}

func make_range(n: int) -> list {
    let l = list_new();
    for let i = 0; i < n; i = i + 1 {
        list_push(l, i);
    }
    return l;
}

func sum_list(l: list) -> int {
    let total = 0;
    for let i = 0; i < list_length(l); i = i + 1 {
        total = total + list_get(l, i);
    }
    return total;
}

class Person {
    name: string,
    age: int
}

func greet_person(p: Person) -> string {
    return "Hi, " + p.name + "!";
}

func main() {
    println("Hello from the native backend!");

    println(fib(10));
    println(sign(-5));
    println(sum_to(100));

    let x = 5;
    let y = 10;
    println(x < y && y > 0);
    println(x > y || y > 0);

    let i = 0;
    while i < 3 {
        println(i);
        i = i + 1;
    }

    let greeting = greet("Roze");
    println(greeting);
    println(greeting == "Hello, Roze!");

    let numbers = make_range(10);
    println(list_length(numbers));
    println(sum_list(numbers));
    list_push(numbers, 100);
    println(list_get(numbers, 10));

    let ages = map_new();
    map_put(ages, 1, 30);
    map_put(ages, 2, 25);
    println(map_size(ages));
    println(map_get(ages, 1));
    println(map_has(ages, 3));
    map_remove(ages, 1);
    println(map_has(ages, 1));
    println(map_size(ages));

    let alice = new Person("Alice", 30);
    println(alice.name);
    println(greet_person(alice));
    alice.age = 31;
    println(alice.age);
}
