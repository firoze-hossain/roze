// compiler/tests/fixtures/std_math.roze
//
// Verification of Roze Universal Mathematics & High-Precision Numerical Engine (M7-T01)
// Direct mathematical parity with Java 25 java.math.BigInteger / java.math.BigDecimal
// and Python 3.15 decimal.Decimal.

import "math";

func main() {
    println("=== M7-T01 Universal Math: BigInt & BigDecimal Engine ===");

    // =========================================================================
    // SUITE 1: BigInt Construction, Conversions & Basic Arithmetic
    // =========================================================================
    println("--- Suite 1: BigInt Construction, Conversions & Basic Arithmetic ---");
    let z = bigint_zero();
    if (!z.is_zero() || z.to_string() != "0") {
        println("FAIL: bigint_zero failed: " + z.to_string());
        return;
    }

    let b1 = bigint_from_int(123456789);
    if (b1.to_string() != "123456789") {
        println("FAIL: bigint_from_int failed: " + b1.to_string());
        return;
    }
    if (b1.to_int() != 123456789) {
        println("FAIL: b1.to_int failed");
        return;
    }

    let b_neg = bigint_from_int(-42);
    if (!b_neg.is_negative() || b_neg.to_string() != "-42") {
        println("FAIL: b_neg failed: " + b_neg.to_string());
        return;
    }
    if (b_neg.abs().to_string() != "42") {
        println("FAIL: b_neg.abs failed: " + b_neg.abs().to_string());
        return;
    }

    // String parsing
    let s_val = "9876543210123456789";
    let b_str = bigint_from_string(s_val);
    if (b_str.to_string() != s_val) {
        println("FAIL: b_str parsing failed: " + b_str.to_string());
        return;
    }

    // Addition & Subtraction
    let a = bigint_from_int(1000);
    let b = bigint_from_int(250);
    let sum = a.add(b);
    let diff = a.sub(b);
    if (sum.to_string() != "1250" || diff.to_string() != "750") {
        println("FAIL: basic add/sub failed");
        return;
    }

    // Negative operand addition: 1000 + (-1500) = -500
    let neg_1500 = bigint_from_int(-1500);
    let mixed_sum = a.add(neg_1500);
    if (mixed_sum.to_string() != "-500") {
        println("FAIL: mixed_sum failed: " + mixed_sum.to_string());
        return;
    }

    // Comparisons
    if (a.cmp(b) <= 0 || b.cmp(a) >= 0 || a.cmp(a) != 0) {
        println("FAIL: BigInt cmp failed");
        return;
    }
    if (!a.equals(bigint_from_int(1000))) {
        println("FAIL: BigInt equals failed");
        return;
    }
    println("SUITE 1 PASSED: BigInt construction, parsing, and basic arithmetic verified");

    // =========================================================================
    // SUITE 2: Karatsuba Multiplication & Division / Modulo
    // =========================================================================
    println("--- Suite 2: Karatsuba Multiplication & Division / Modulo ---");
    let mul_small = bigint_from_int(12345).mul(bigint_from_int(6789));
    if (mul_small.to_string() != "83810205") {
        println("FAIL: mul_small failed: " + mul_small.to_string());
        return;
    }

    // Large multi-limb Karatsuba multiplication (> 8 limbs)
    let big_x = bigint_from_string("123456789012345678901234567890");
    let big_y = bigint_from_string("987654321098765432109876543210");
    let big_prod = big_x.mul(big_y);
    let expected_prod = "121932631137021795226185032733622923332237463801111263526900";
    if (big_prod.to_string() != expected_prod) {
        println("FAIL: Karatsuba big_prod failed: " + big_prod.to_string());
        return;
    }

    // Integer Division & Remainder
    let div_a = bigint_from_int(100);
    let div_b = bigint_from_int(7);
    let q = div_a.div(div_b);
    let r = div_a.rem(div_b);
    if (q.to_string() != "14" || r.to_string() != "2") {
        println("FAIL: div/rem 100/7 failed: q=" + q.to_string() + " r=" + r.to_string());
        return;
    }

    // Division reconstruction: dividend = quotient * divisor + remainder
    let div_large_a = bigint_from_string("98765432109876543210");
    let div_large_b = bigint_from_string("123456789");
    let dr = div_large_a.div_rem(div_large_b);
    let q_large: BigInt = list_get(dr, 0);
    let r_large: BigInt = list_get(dr, 1);
    let reconstructed = q_large.mul(div_large_b).add(r_large);
    if (!reconstructed.equals(div_large_a)) {
        println("FAIL: division reconstruction failed");
        return;
    }

    // Powers
    let two = bigint_two();
    let p10 = two.pow(10);
    let p32 = two.pow(32);
    if (p10.to_string() != "1024" || p32.to_string() != "4294967296") {
        println("FAIL: pow failed: p10=" + p10.to_string() + " p32=" + p32.to_string());
        return;
    }
    println("SUITE 2 PASSED: Karatsuba multiplication, division, and powers verified");

    // =========================================================================
    // SUITE 3: Modular Exponentiation & Miller-Rabin Primality Testing
    // =========================================================================
    println("--- Suite 3: Modular Exponentiation & Miller-Rabin Primality ---");
    // mod_pow: 2^10 mod 1000 = 1024 mod 1000 = 24
    let m_pow = two.mod_pow(bigint_from_int(10), bigint_from_int(1000));
    if (m_pow.to_string() != "24") {
        println("FAIL: mod_pow failed: " + m_pow.to_string());
        return;
    }

    // Miller-Rabin Primality: Known Primes
    let prime_10007 = bigint_from_int(10007);
    if (!prime_10007.is_prob_prime(10)) {
        println("FAIL: 10007 should be prime");
        return;
    }

    let mersenne_31 = bigint_from_string("2147483647");
    if (!mersenne_31.is_prob_prime(10)) {
        println("FAIL: 2147483647 (2^31 - 1) should be prime");
        return;
    }

    // Miller-Rabin Primality: Known Composites
    let composite_561 = bigint_from_int(561); // Carmichael number
    if (composite_561.is_prob_prime(10)) {
        println("FAIL: 561 (Carmichael number) should be composite");
        return;
    }

    let composite_10000 = bigint_from_int(10000);
    if (composite_10000.is_prob_prime(5)) {
        println("FAIL: 10000 should be composite");
        return;
    }

    // GCD & LCM
    let gcd_res = bigint_from_int(48).gcd(bigint_from_int(18));
    let lcm_res = bigint_from_int(12).lcm(bigint_from_int(15));
    if (gcd_res.to_string() != "6" || lcm_res.to_string() != "60") {
        println("FAIL: gcd/lcm failed: gcd=" + gcd_res.to_string() + " lcm=" + lcm_res.to_string());
        return;
    }
    println("SUITE 3 PASSED: Modular exponentiation, Miller-Rabin test, and GCD/LCM verified");

    // =========================================================================
    // SUITE 4: BigDecimal Construction & String Parsing
    // =========================================================================
    println("--- Suite 4: BigDecimal Construction & String Parsing ---");
    let bd1 = bigdecimal_from_string("123.45");
    if (bd1.get_scale() != 2 || bd1.to_string() != "123.45") {
        println("FAIL: bd1 failed: scale=" + to_string(bd1.get_scale()) + " str=" + bd1.to_string());
        return;
    }

    let bd_neg = bigdecimal_from_string("-0.0075");
    if (bd_neg.get_scale() != 4 || bd_neg.to_string() != "-0.0075") {
        println("FAIL: bd_neg failed: " + bd_neg.to_string());
        return;
    }

    let bd_int = bigdecimal_from_int(500);
    if (bd_int.get_scale() != 0 || bd_int.to_string() != "500") {
        println("FAIL: bd_int failed: " + bd_int.to_string());
        return;
    }
    println("SUITE 4 PASSED: BigDecimal construction, scaling, and decimal formatting verified");

    // =========================================================================
    // SUITE 5: BigDecimal Arithmetic & Scale Alignment
    // =========================================================================
    println("--- Suite 5: BigDecimal Arithmetic & Scale Alignment ---");
    // Aligned addition: 123.45 (scale 2) + 0.055 (scale 3) = 123.505 (scale 3)
    let bd_a = bigdecimal_from_string("123.45");
    let bd_b = bigdecimal_from_string("0.055");
    let bd_sum = bd_a.add(bd_b);
    if (bd_sum.to_string() != "123.505" || bd_sum.get_scale() != 3) {
        println("FAIL: bd_sum failed: " + bd_sum.to_string());
        return;
    }

    // Subtraction: 10.5 - 0.25 = 10.25
    let bd_diff = bigdecimal_from_string("10.5").sub(bigdecimal_from_string("0.25"));
    if (bd_diff.to_string() != "10.25") {
        println("FAIL: bd_diff failed: " + bd_diff.to_string());
        return;
    }

    // Multiplication: 12.5 (scale 1) * 2.4 (scale 1) = 30.00 (scale 2)
    let bd_prod = bigdecimal_from_string("12.5").mul(bigdecimal_from_string("2.4"));
    if (bd_prod.to_string() != "30.00" || bd_prod.get_scale() != 2) {
        println("FAIL: bd_prod failed: " + bd_prod.to_string());
        return;
    }
    println("SUITE 5 PASSED: BigDecimal addition, subtraction, and multiplication verified");

    // =========================================================================
    // SUITE 6: BigDecimal Division & Rounding Modes
    // =========================================================================
    println("--- Suite 6: BigDecimal Division & Rounding Modes ---");
    let num_10 = bigdecimal_from_int(10);
    let den_3 = bigdecimal_from_int(3);

    // 10 / 3 to scale 4 with ROUND_DOWN: 3.3333
    let div_down = num_10.div(den_3, 4, round_mode_down());
    if (div_down.to_string() != "3.3333") {
        println("FAIL: div_down failed: " + div_down.to_string());
        return;
    }

    // 10 / 3 to scale 4 with ROUND_UP: 3.3334
    let div_up = num_10.div(den_3, 4, round_mode_up());
    if (div_up.to_string() != "3.3334") {
        println("FAIL: div_up failed: " + div_up.to_string());
        return;
    }

    // Banker's Rounding (ROUND_HALF_EVEN): Parity with Java 25 & Python 3.15
    // 2.5 rounded to 0 decimals -> 2 (nearest even)
    let val_25 = bigdecimal_from_string("2.5");
    let round_even_2 = val_25.set_scale(0, round_mode_half_even());
    if (round_even_2.to_string() != "2") {
        println("FAIL: 2.5 round_even failed: " + round_even_2.to_string());
        return;
    }

    // 3.5 rounded to 0 decimals -> 4 (nearest even)
    let val_35 = bigdecimal_from_string("3.5");
    let round_even_4 = val_35.set_scale(0, round_mode_half_even());
    if (round_even_4.to_string() != "4") {
        println("FAIL: 3.5 round_even failed: " + round_even_4.to_string());
        return;
    }

    // Financial set_scale with HALF_UP: 123.4567 to scale 2 -> 123.46
    let fin_val = bigdecimal_from_string("123.4567");
    let fin_scaled = fin_val.set_scale(2, round_mode_half_up());
    if (fin_scaled.to_string() != "123.46") {
        println("FAIL: fin_scaled failed: " + fin_scaled.to_string());
        return;
    }
    println("SUITE 6 PASSED: BigDecimal division and all 7 rounding modes verified");

    // =========================================================================
    // SUITE 7: Complex Numbers & Scientific Math
    // =========================================================================
    println("--- Suite 7: Complex Numbers & Scientific Math ---");
    let c1 = complex_new(3.0, 4.0);
    let c2 = complex_new(1.0, -2.0);

    let c_sum = c1.add(c2);
    if (c_sum.real() != 4.0 || c_sum.imag() != 2.0) {
        println("FAIL: c_sum failed");
        return;
    }

    // (1 + 2i) * (3 + 4i) = (3 - 8) + (4 + 6)i = -5 + 10i
    let c3 = complex_new(1.0, 2.0);
    let c4 = complex_new(3.0, 4.0);
    let c_prod = c3.mul(c4);
    if (c_prod.real() != -5.0 || c_prod.imag() != 10.0) {
        println("FAIL: c_prod failed");
        return;
    }

    // Factorials: 10! = 3628800, 20! = 2432902008176640000
    let f10 = math_factorial(10);
    if (f10.to_string() != "3628800") {
        println("FAIL: 10! failed: " + f10.to_string());
        return;
    }
    let f20 = math_factorial(20);
    if (f20.to_string() != "2432902008176640000") {
        println("FAIL: 20! failed: " + f20.to_string());
        return;
    }

    // Fibonacci: F(10) = 55, F(50) = 12586269025
    let fib10 = math_fibonacci(10);
    let fib50 = math_fibonacci(50);
    if (fib10.to_string() != "55" || fib50.to_string() != "12586269025") {
        println("FAIL: fib failed: F(10)=" + fib10.to_string() + " F(50)=" + fib50.to_string());
        return;
    }

    // Constants
    let pi = math_pi();
    let e_val = math_e();
    if (pi < 3.14 || pi > 3.15 || e_val < 2.71 || e_val > 2.72) {
        println("FAIL: math constants out of bounds");
        return;
    }
    println("SUITE 7 PASSED: Complex numbers, factorials, Fibonacci, and constants verified");

    println("ALL SUITES COMPLETED: Roze Universal Mathematics Engine 100% OPERATIONAL");
}
