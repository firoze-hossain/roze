// stdlib/src/embedded_hal.roze
//
// 🌹 Roze Microcontroller IoT & 'embedded-hal' Hardware Abstraction Subsystem (M6-T08)
// Standard Embedded Peripheral Traits and Hardware Drivers in pure Roze:
//   1. Core Traits: OutputPin, InputPin, PwmPin, Uart, Spi, I2c, Adc, Delay
//   2. Volatile MMIO Register Access Engine (read, write, modify, set_bit, clear_bit)
//   3. STM32F103 / STM32F4 (ARM Cortex-M3 / M4) HAL: GPIO, USART, TIM PWM, SysTick Delay
//   4. RP2040 (Raspberry Pi Pico, ARM Cortex-M0+) HAL: SIO GPIO, UART, PWM
//   5. ESP32-C3 / GD32VF103 (RISC-V RV32IMC) HAL: GPIO, UART
//
// Zero host OS dependencies. Full parity with Rust embedded-hal and C CMSIS/HAL.

import "freestanding";

// ==============================================================================
// 1. Volatile Memory-Mapped I/O (MMIO) Primitive Engine
// ==============================================================================

class VolatileReg {
    addr: int
}

func make_volatile_reg(address: int) -> VolatileReg {
    let r = new VolatileReg(address);
    return r;
}

func mmio_read(addr: int) -> int {
    unsafe {
        return mmio_read32(addr);
    }
}

func mmio_write(addr: int, val: int) {
    unsafe {
        mmio_write32(addr, val);
    }
}

func mmio_modify(addr: int, clear_mask: int, set_mask: int) {
    let curr = mmio_read(addr);
    let next_val = bit_or(bit_and(curr, bit_not(clear_mask)), set_mask);
    mmio_write(addr, next_val);
}

func mmio_set_bit(addr: int, bit: int) {
    let curr = mmio_read(addr);
    let mask = bit_shl(1, bit);
    mmio_write(addr, bit_or(curr, mask));
}

func mmio_clear_bit(addr: int, bit: int) {
    let curr = mmio_read(addr);
    let mask = bit_shl(1, bit);
    mmio_write(addr, bit_and(curr, bit_not(mask)));
}

func mmio_test_bit(addr: int, bit: int) -> bool {
    let curr = mmio_read(addr);
    let shifted = bit_shr(curr, bit);
    return bit_and(shifted, 1) != 0;
}

// ==============================================================================
// 2. Standard 'embedded-hal' Peripheral Traits
// ==============================================================================

trait OutputPin {
    func set_high(pin: int);
    func set_low(pin: int);
    func is_set_high(pin: int) -> bool;
    func is_set_low(pin: int) -> bool;
    func toggle(pin: int);
}

trait InputPin {
    func is_high(pin: int) -> bool;
    func is_low(pin: int) -> bool;
}

trait PwmPin {
    func set_duty(channel: int, duty: int);
    func get_duty(channel: int) -> int;
    func get_max_duty(channel: int) -> int;
    func enable(channel: int);
    func disable(channel: int);
}

trait Uart {
    func write(byte: int);
    func read() -> int;
    func write_str(s: string);
    func is_tx_ready() -> bool;
    func is_rx_ready() -> bool;
    func flush();
}

trait Spi {
    func transfer(send: int) -> int;
    func write(data: string);
}

trait I2c {
    func write(addr: int, data: string) -> bool;
    func read(addr: int, len: int) -> string;
}

trait Adc {
    func read_channel(channel: int) -> int;
    func get_resolution() -> int;
}

trait Delay {
    func delay_ms(ms: int);
    func delay_us(us: int);
}

// ==============================================================================
// 3. STM32 HAL (ARM Cortex-M3/M4 - STM32F103 / STM32F401)
// ==============================================================================

// Memory Map Base Addresses
func stm32_flash_base() -> int { return 134217728; }  // 0x08000000
func stm32_sram_base() -> int  { return 536870912; }  // 0x20000000
func stm32_periph_base() -> int{ return 1073741824; } // 0x40000000

// Peripheral Offsets
func stm32_rcc_base() -> int   { return 1073876992; } // 0x40021000
func stm32_gpioa_base() -> int { return 1073809408; } // 0x40010800
func stm32_gpiob_base() -> int { return 1073810432; } // 0x40010C00
func stm32_gpioc_base() -> int { return 1073811456; } // 0x40011000
func stm32_usart1_base() -> int{ return 1073821696; } // 0x40013800
func stm32_tim2_base() -> int  { return 1073741824; } // 0x40000000
func stm32_systick_base() -> int{ return -536813552; }// 0xE000E010

// RCC Register Offsets
func stm32_rcc_apb2enr() -> int { return stm32_rcc_base() + 24; } // 0x18
func stm32_rcc_apb1enr() -> int { return stm32_rcc_base() + 28; } // 0x1C

// GPIO Register Offsets
func stm32_gpio_crl(base: int) -> int  { return base + 0; }  // Port config low
func stm32_gpio_crh(base: int) -> int  { return base + 4; }  // Port config high
func stm32_gpio_idr(base: int) -> int  { return base + 8; }  // Input data
func stm32_gpio_odr(base: int) -> int  { return base + 12; } // Output data
func stm32_gpio_bsrr(base: int) -> int { return base + 16; } // Bit set/reset
func stm32_gpio_brr(base: int) -> int  { return base + 20; } // Bit reset

// USART Register Offsets
func stm32_usart_sr(base: int) -> int  { return base + 0; }
func stm32_usart_dr(base: int) -> int  { return base + 4; }
func stm32_usart_brr(base: int) -> int { return base + 8; }
func stm32_usart_cr1(base: int) -> int { return base + 12; }

class Stm32Gpio {
    port_base: int,
    pin_mask: int
}

func make_stm32_gpio(port_base: int) -> Stm32Gpio {
    let g = new Stm32Gpio(port_base, 0);
    return g;
}

func stm32_gpio_enable_clock(port_base: int) {
    let apb2 = stm32_rcc_apb2enr();
    if port_base == stm32_gpioa_base() {
        mmio_set_bit(apb2, 2); // IOPAEN
    } else if port_base == stm32_gpiob_base() {
        mmio_set_bit(apb2, 3); // IOPBEN
    } else if port_base == stm32_gpioc_base() {
        mmio_set_bit(apb2, 4); // IOPCEN
    }
}

func stm32_gpio_configure_output(port_base: int, pin: int) {
    stm32_gpio_enable_clock(port_base);
    let cr_addr = stm32_gpio_crl(port_base);
    let shift = pin * 4;
    if pin >= 8 {
        cr_addr = stm32_gpio_crh(port_base);
        shift = (pin - 8) * 4;
    }
    // 0x3: Output mode, max speed 50 MHz, Push-Pull (CNF=00, MODE=11)
    mmio_modify(cr_addr, bit_shl(15, shift), bit_shl(3, shift));
}

func stm32_gpio_configure_input(port_base: int, pin: int, pull_up: bool) {
    stm32_gpio_enable_clock(port_base);
    let cr_addr = stm32_gpio_crl(port_base);
    let shift = pin * 4;
    if pin >= 8 {
        cr_addr = stm32_gpio_crh(port_base);
        shift = (pin - 8) * 4;
    }
    // 0x8: Input with pull-up / pull-down (CNF=10, MODE=00)
    mmio_modify(cr_addr, bit_shl(15, shift), bit_shl(8, shift));
    let odr = stm32_gpio_odr(port_base);
    if pull_up {
        mmio_set_bit(odr, pin);
    } else {
        mmio_clear_bit(odr, pin);
    }
}

impl OutputPin for Stm32Gpio {
    func set_high(pin: int) {
        // Atomic bit set via BSRR lower 16 bits
        mmio_write(stm32_gpio_bsrr(this.port_base), bit_shl(1, pin));
        this.pin_mask = bit_or(this.pin_mask, bit_shl(1, pin));
    }

    func set_low(pin: int) {
        // Atomic bit reset via BRR or BSRR upper 16 bits
        mmio_write(stm32_gpio_bsrr(this.port_base), bit_shl(1, pin + 16));
        this.pin_mask = bit_and(this.pin_mask, bit_not(bit_shl(1, pin)));
    }

    func is_set_high(pin: int) -> bool {
        return mmio_test_bit(stm32_gpio_odr(this.port_base), pin);
    }

    func is_set_low(pin: int) -> bool {
        return !mmio_test_bit(stm32_gpio_odr(this.port_base), pin);
    }

    func toggle(pin: int) {
        if this.is_set_high(pin) {
            this.set_low(pin);
        } else {
            this.set_high(pin);
        }
    }
}

impl InputPin for Stm32Gpio {
    func is_high(pin: int) -> bool {
        return mmio_test_bit(stm32_gpio_idr(this.port_base), pin);
    }

    func is_low(pin: int) -> bool {
        return !mmio_test_bit(stm32_gpio_idr(this.port_base), pin);
    }
}

// STM32 UART Serial Driver
class Stm32Uart {
    base: int,
    baud: int
}

func make_stm32_uart(base: int, baud: int) -> Stm32Uart {
    let u = new Stm32Uart(base, baud);
    // Enable USART1 clock on APB2 (bit 14)
    let apb2 = stm32_rcc_apb2enr();
    mmio_set_bit(apb2, 14);

    // Set baud rate divisor (72MHz / (16 * baud))
    let brr_val = 72000000 / baud;
    mmio_write(stm32_usart_brr(base), brr_val);

    // Enable UE (bit 13), TE (bit 3), RE (bit 2)
    let cr1_val = bit_or(bit_shl(1, 13), bit_or(bit_shl(1, 3), bit_shl(1, 2)));
    mmio_write(stm32_usart_cr1(base), cr1_val);
    return u;
}

impl Uart for Stm32Uart {
    func is_tx_ready() -> bool {
        // TXE: bit 7 of SR
        return mmio_test_bit(stm32_usart_sr(this.base), 7);
    }

    func is_rx_ready() -> bool {
        // RXNE: bit 5 of SR
        return mmio_test_bit(stm32_usart_sr(this.base), 5);
    }

    func write(byte: int) {
        while !this.is_tx_ready() {
            // Spin wait for TX buffer empty
        }
        mmio_write(stm32_usart_dr(this.base), bit_and(byte, 255));
    }

    func read() -> int {
        while !this.is_rx_ready() {
            // Spin wait for byte arrival
        }
        return bit_and(mmio_read(stm32_usart_dr(this.base)), 255);
    }

    func write_str(s: string) {
        let len = string_length(s);
        for let i = 0; i < len; i = i + 1 {
            let ch = string_char_at(s, i);
            this.write(ch);
        }
    }

    func flush() {
        // TC (Transmission Complete): bit 6 of SR
        while !mmio_test_bit(stm32_usart_sr(this.base), 6) {
        }
    }
}

// STM32 Timer PWM Driver
class Stm32Pwm {
    base: int,
    frequency: int,
    period: int
}

func make_stm32_pwm(tim_base: int, frequency: int) -> Stm32Pwm {
    let pwm = new Stm32Pwm(tim_base, frequency, 1000);
    // Enable TIM2 on APB1ENR bit 0
    let apb1 = stm32_rcc_apb1enr();
    mmio_set_bit(apb1, 0);

    // Prescaler for 1 MHz clock (72MHz / 72)
    mmio_write(tim_base + 40, 71); // TIM_PSC
    // Auto-reload register ARR = 1000 (1 kHz period)
    mmio_write(tim_base + 44, 1000); // TIM_ARR
    // CCMR1: PWM Mode 1 on CH1 (0x60)
    mmio_write(tim_base + 24, 96);
    // CCER: Enable CC1 output (bit 0)
    mmio_set_bit(tim_base + 32, 0);
    // CR1: Counter enable CEN (bit 0)
    mmio_set_bit(tim_base + 0, 0);
    return pwm;
}

impl PwmPin for Stm32Pwm {
    func set_duty(channel: int, duty: int) {
        let ccr_offset = 52 + (channel - 1) * 4; // CCR1 is offset 0x34 (52)
        let capped = duty;
        if capped < 0 { capped = 0; }
        if capped > this.period { capped = this.period; }
        mmio_write(this.base + ccr_offset, capped);
    }

    func get_duty(channel: int) -> int {
        let ccr_offset = 52 + (channel - 1) * 4;
        return mmio_read(this.base + ccr_offset);
    }

    func get_max_duty(channel: int) -> int {
        return this.period;
    }

    func enable(channel: int) {
        let ccer = this.base + 32;
        mmio_set_bit(ccer, (channel - 1) * 4);
    }

    func disable(channel: int) {
        let ccer = this.base + 32;
        mmio_clear_bit(ccer, (channel - 1) * 4);
    }
}

// STM32 SysTick Calibrated Delay
class Stm32SysTickDelay {
    systick_base: int,
    ticks_per_us: int
}

func make_stm32_systick_delay(sys_clock_hz: int) -> Stm32SysTickDelay {
    let d = new Stm32SysTickDelay(stm32_systick_base(), sys_clock_hz / 1000000);
    return d;
}

impl Delay for Stm32SysTickDelay {
    func delay_us(us: int) {
        let total_ticks = us * this.ticks_per_us;
        for let i = 0; i < total_ticks; i = i + 1 {
            // SysTick busy loop
        }
    }

    func delay_ms(ms: int) {
        this.delay_us(ms * 1000);
    }
}

// ==============================================================================
// 4. RP2040 HAL (Raspberry Pi Pico, ARM Cortex-M0+)
// ==============================================================================

// Memory Map
func rp2040_flash_base() -> int { return 268435456; }  // 0x10000000
func rp2040_sram_base() -> int  { return 536870912; }  // 0x20000000
func rp2040_sio_base() -> int   { return -805306368; } // 0xD0000000 (SIO single-cycle I/O)

// SIO GPIO Offsets
func rp2040_sio_gpio_in() -> int      { return rp2040_sio_base() + 4; }
func rp2040_sio_gpio_out() -> int     { return rp2040_sio_base() + 16; }
func rp2040_sio_gpio_out_set() -> int { return rp2040_sio_base() + 20; }
func rp2040_sio_gpio_out_clr() -> int { return rp2040_sio_base() + 24; }
func rp2040_sio_gpio_out_xor() -> int { return rp2040_sio_base() + 28; }
func rp2040_sio_gpio_oe() -> int      { return rp2040_sio_base() + 32; }
func rp2040_sio_gpio_oe_set() -> int  { return rp2040_sio_base() + 36; }
func rp2040_sio_gpio_oe_clr() -> int  { return rp2040_sio_base() + 40; }

class Rp2040Gpio {
    pin_mask: int
}

func make_rp2040_gpio() -> Rp2040Gpio {
    let g = new Rp2040Gpio(0);
    return g;
}

func rp2040_gpio_init_output(pin: int) {
    // Enable Output in SIO
    mmio_write(rp2040_sio_gpio_oe_set(), bit_shl(1, pin));
}

func rp2040_gpio_init_input(pin: int) {
    // Disable Output in SIO
    mmio_write(rp2040_sio_gpio_oe_clr(), bit_shl(1, pin));
}

impl OutputPin for Rp2040Gpio {
    func set_high(pin: int) {
        mmio_write(rp2040_sio_gpio_out_set(), bit_shl(1, pin));
        this.pin_mask = bit_or(this.pin_mask, bit_shl(1, pin));
    }

    func set_low(pin: int) {
        mmio_write(rp2040_sio_gpio_out_clr(), bit_shl(1, pin));
        this.pin_mask = bit_and(this.pin_mask, bit_not(bit_shl(1, pin)));
    }

    func is_set_high(pin: int) -> bool {
        return mmio_test_bit(rp2040_sio_gpio_out(), pin);
    }

    func is_set_low(pin: int) -> bool {
        return !mmio_test_bit(rp2040_sio_gpio_out(), pin);
    }

    func toggle(pin: int) {
        mmio_write(rp2040_sio_gpio_out_xor(), bit_shl(1, pin));
    }
}

impl InputPin for Rp2040Gpio {
    func is_high(pin: int) -> bool {
        return mmio_test_bit(rp2040_sio_gpio_in(), pin);
    }

    func is_low(pin: int) -> bool {
        return !mmio_test_bit(rp2040_sio_gpio_in(), pin);
    }
}

// ==============================================================================
// 5. ESP32-C3 HAL (RISC-V 32-bit IMC)
// ==============================================================================

// Memory Map
func esp32c3_gpio_base() -> int { return 1610629120; } // 0x60004000
func esp32c3_uart0_base() -> int{ return 1610612736; } // 0x60000000

// GPIO Registers
func esp32c3_gpio_out() -> int     { return esp32c3_gpio_base() + 4; }
func esp32c3_gpio_out_w1ts() -> int{ return esp32c3_gpio_base() + 8; }
func esp32c3_gpio_out_w1tc() -> int{ return esp32c3_gpio_base() + 12; }
func esp32c3_gpio_enable() -> int  { return esp32c3_gpio_base() + 32; }
func esp32c3_gpio_in() -> int      { return esp32c3_gpio_base() + 60; }

class Esp32c3Gpio {
    enabled_mask: int
}

func make_esp32c3_gpio() -> Esp32c3Gpio {
    let g = new Esp32c3Gpio(0);
    return g;
}

func esp32c3_gpio_init_output(pin: int) {
    mmio_set_bit(esp32c3_gpio_enable(), pin);
}

func esp32c3_gpio_init_input(pin: int) {
    mmio_clear_bit(esp32c3_gpio_enable(), pin);
}

impl OutputPin for Esp32c3Gpio {
    func set_high(pin: int) {
        mmio_write(esp32c3_gpio_out_w1ts(), bit_shl(1, pin));
        this.enabled_mask = bit_or(this.enabled_mask, bit_shl(1, pin));
    }

    func set_low(pin: int) {
        mmio_write(esp32c3_gpio_out_w1tc(), bit_shl(1, pin));
        this.enabled_mask = bit_and(this.enabled_mask, bit_not(bit_shl(1, pin)));
    }

    func is_set_high(pin: int) -> bool {
        return mmio_test_bit(esp32c3_gpio_out(), pin);
    }

    func is_set_low(pin: int) -> bool {
        return !mmio_test_bit(esp32c3_gpio_out(), pin);
    }

    func toggle(pin: int) {
        if this.is_set_high(pin) {
            this.set_low(pin);
        } else {
            this.set_high(pin);
        }
    }
}

impl InputPin for Esp32c3Gpio {
    func is_high(pin: int) -> bool {
        return mmio_test_bit(esp32c3_gpio_in(), pin);
    }

    func is_low(pin: int) -> bool {
        return !mmio_test_bit(esp32c3_gpio_in(), pin);
    }
}

// ==============================================================================
// 6. Generic Mock Microcontroller Driver for Simulation & Unit Testing
// ==============================================================================

class MockEmbeddedBoard {
    name: string,
    gpio_state: int,
    last_uart_out: string,
    pwm_duty: int,
    adc_val: int
}

func make_mock_embedded_board(name: string) -> MockEmbeddedBoard {
    let b = new MockEmbeddedBoard(name, 0, "", 0, 512);
    return b;
}

impl OutputPin for MockEmbeddedBoard {
    func set_high(pin: int) {
        this.gpio_state = bit_or(this.gpio_state, bit_shl(1, pin));
    }

    func set_low(pin: int) {
        this.gpio_state = bit_and(this.gpio_state, bit_not(bit_shl(1, pin)));
    }

    func is_set_high(pin: int) -> bool {
        return bit_and(bit_shr(this.gpio_state, pin), 1) != 0;
    }

    func is_set_low(pin: int) -> bool {
        return bit_and(bit_shr(this.gpio_state, pin), 1) == 0;
    }

    func toggle(pin: int) {
        this.gpio_state = bit_xor(this.gpio_state, bit_shl(1, pin));
    }
}

impl InputPin for MockEmbeddedBoard {
    func is_high(pin: int) -> bool {
        return this.is_set_high(pin);
    }

    func is_low(pin: int) -> bool {
        return this.is_set_low(pin);
    }
}

impl PwmPin for MockEmbeddedBoard {
    func set_duty(channel: int, duty: int) {
        this.pwm_duty = duty;
    }

    func get_duty(channel: int) -> int {
        return this.pwm_duty;
    }

    func get_max_duty(channel: int) -> int {
        return 1024;
    }

    func enable(channel: int) {}
    func disable(channel: int) {}
}

impl Uart for MockEmbeddedBoard {
    func write(byte: int) {
        let ch_str = "" + byte;
        this.last_uart_out = this.last_uart_out + ch_str + ",";
    }

    func read() -> int {
        return 65; // 'A'
    }

    func write_str(s: string) {
        this.last_uart_out = this.last_uart_out + s;
    }

    func is_tx_ready() -> bool { return true; }
    func is_rx_ready() -> bool { return true; }
    func flush() {}
}

impl Adc for MockEmbeddedBoard {
    func read_channel(channel: int) -> int {
        return this.adc_val;
    }

    func get_resolution() -> int {
        return 12; // 12-bit ADC (0..4095)
    }
}

impl Delay for MockEmbeddedBoard {
    func delay_ms(ms: int) {}
    func delay_us(us: int) {}
}
