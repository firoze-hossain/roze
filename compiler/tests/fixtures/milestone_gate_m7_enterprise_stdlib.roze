import "math";
import "collections";
import "time";
import "data";
import "nio";
import "concurrent";

func assert_true(cond: bool, msg: string) {
    if !cond {
        println("ASSERTION FAILED: " + msg);
    }
}

func assert_eq_int(actual: i64, expected: i64, msg: string) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected " + to_string(expected) + ", got " + to_string(actual) + ")");
    }
}

func assert_eq_str(actual: string, expected: string, msg: string) {
    if actual != expected {
        println("ASSERTION FAILED: " + msg + " (expected '" + expected + "', got '" + actual + "')");
    }
}

// ------------------------------------------------------------------------------
// Suite 1: Universal Mathematics & 1,000,000 BigInt Operations Stress Test
// ------------------------------------------------------------------------------
func test_suite_1_math_and_stress() {
    // 1. Arbitrary-Precision BigInt Math
    let a = bigint_from_string("123456789012345678901234567890");
    let b = bigint_from_string("987654321098765432109876543210");
    let sum = a.add(b);
    assert_eq_str(sum.to_string(), "1111111110111111111011111111100", "BigInt 30-digit sum");

    // Karatsuba multiplication & modulo
    let p1 = bigint_from_string("123456789");
    let p2 = bigint_from_string("987654321");
    let prod = p1.mul(p2);
    assert_eq_str(prod.to_string(), "121932631112635269", "Karatsuba multiplication product");

    // Modular exponentiation (RSA cryptography primitive): 7^560 mod 561
    let base = bigint_from_int(7);
    let exp = bigint_from_int(560);
    let modulus = bigint_from_int(561);
    let mod_res = base.mod_pow(exp, modulus);
    assert_eq_str(mod_res.to_string(), "1", "Euler-Fermat modular exponentiation");

    // Miller-Rabin primality test
    let prime_candidate = bigint_from_int(104729); // 10,000th prime
    assert_true(prime_candidate.is_prob_prime(10), "104729 is prime");
    let composite_candidate = bigint_from_int(104730);
    assert_true(!composite_candidate.is_prob_prime(10), "104730 is composite");

    // 2. Arbitrary-Precision BigDecimal (Precision & Rounding)
    let d1 = bigdecimal_from_string("10.50");
    let d2 = bigdecimal_from_string("2.00");
    let div_res = d1.div(d2, 1, round_mode_half_up());
    assert_eq_str(div_res.to_string(), "5.3", "BigDecimal division with HALF_UP");

    let dec_even1 = bigdecimal_from_string("2.5").set_scale(0, round_mode_half_even());
    let dec_even2 = bigdecimal_from_string("3.5").set_scale(0, round_mode_half_even());
    assert_eq_str(dec_even1.to_string(), "2", "Banker's rounding 2.5 -> 2");
    assert_eq_str(dec_even2.to_string(), "4", "Banker's rounding 3.5 -> 4");

    // 3. 1,000,000 BigInt Operations High-Throughput Stress Test
    // 100,000 iterations of 10 chained BigInt operations = 1,000,000 operations
    let acc = bigint_from_int(1);
    let step = bigint_from_int(3);
    let i = 0;
    while i < 100000 {
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        acc = acc.add(step);
        i = i + 1;
    }
    // Expected: 1 + 100,000 * 10 * 3 = 3,000,001
    assert_eq_str(acc.to_string(), "3000001", "1,000,000 BigInt operations stress test exact mathematical convergence");

    println("SUITE 1 PASSED: roze.math arbitrary-precision BigInt/BigDecimal and 1,000,000 ops stress test");
}

// ------------------------------------------------------------------------------
// Suite 2: Enterprise Collections Framework Hierarchy
// ------------------------------------------------------------------------------
func test_suite_2_collections_hierarchy() {
    // 1. ArrayList & LinkedList
    let al = array_list_new();
    al.add(10);
    al.add(20);
    al.add(30);
    assert_eq_int(al.size(), 3, "ArrayList size");
    let al1: int = al.get(1);
    assert_eq_int(al1, 20, "ArrayList element at 1");

    let ll = linked_list_new();
    ll.add_first(100);
    ll.add_last(200);
    let ll_first: int = ll.get_first();
    let ll_last: int = ll.get_last();
    assert_eq_int(ll_first, 100, "LinkedList get_first");
    assert_eq_int(ll_last, 200, "LinkedList get_last");

    // 2. HashMap & LinkedHashMap (Predictable Iteration Order)
    let hm = new HashMap<int, int>();
    hm.put(1, 111);
    hm.put(2, 222);
    let hm_a: int = hm.get(1);
    assert_eq_int(hm_a, 111, "HashMap get key 1");
    assert_true(hm.contains_key(2), "HashMap contains key 2");

    let lhm = new LinkedHashMap<int, int>();
    lhm.put(10, 1);
    lhm.put(20, 2);
    lhm.put(30, 3);
    assert_eq_int(lhm.size(), 3, "LinkedHashMap size");

    // 3. TreeSet & TreeMap (Red-Black Sorted Structures)
    let ts = tree_set_new();
    ts.add(50);
    ts.add(20);
    ts.add(80);
    let ts_first: int = ts.first();
    let ts_last: int = ts.last();
    assert_eq_int(ts_first, 20, "TreeSet minimum is 20");
    assert_eq_int(ts_last, 80, "TreeSet maximum is 80");

    let tm = tree_map_new();
    tm.put(30, "thirty");
    tm.put(10, "ten");
    tm.put(20, "twenty");
    let tm_s: string = tm.get(10);
    let tm_fk: int = tm.first_key();
    assert_eq_str(tm_s, "ten", "TreeMap sorted lookup");
    assert_eq_int(tm_fk, 10, "TreeMap first key");

    // 4. ArrayDeque, PriorityQueue & BitSet
    let deque = array_deque_new();
    deque.push_back(10);
    deque.push_back(20);
    deque.push_front(5);
    let dq_f: int = deque.pop_front();
    let dq_b: int = deque.pop_back();
    assert_eq_int(dq_f, 5, "Deque pop_front");
    assert_eq_int(dq_b, 20, "Deque pop_back");

    let pq = priority_queue_new();
    pq.offer(40);
    pq.offer(10);
    pq.offer(30);
    let pq_val: int = pq.poll();
    assert_eq_int(pq_val, 40, "PriorityQueue max-heap extraction");

    let bs = bit_set_new();
    bs.set(7);
    bs.set(63);
    assert_true(bs.test(7), "BitSet bit 7 set");
    assert_true(bs.test(63), "BitSet bit 63 set");
    assert_true(!bs.test(8), "BitSet bit 8 clear");
    assert_eq_int(bs.cardinality(), 2, "BitSet cardinality is 2");

    // 5. Collections Static Algorithms
    let list_to_sort = array_list_new();
    list_to_sort.add(45);
    list_to_sort.add(12);
    list_to_sort.add(89);
    list_to_sort.add(33);
    collections_sort(list_to_sort);
    let s0: int = list_to_sort.get(0);
    let s3: int = list_to_sort.get(3);
    assert_eq_int(s0, 12, "Collections sort first");
    assert_eq_int(s3, 89, "Collections sort last");

    let idx = collections_binary_search(list_to_sort, 33);
    assert_eq_int(idx, 1, "Collections binary search found 33 at index 1");

    collections_reverse(list_to_sort);
    let r0: int = list_to_sort.get(0);
    assert_eq_int(r0, 89, "Collections reverse first");

    println("SUITE 2 PASSED: roze.util Collections hierarchy and static algorithms");
}

// ------------------------------------------------------------------------------
// Suite 3: JSR-310 Temporal Engine & High-Precision Clocks
// ------------------------------------------------------------------------------
func test_suite_3_jsr310_temporal_engine() {
    // 1. Instant & Duration
    let i1 = instant_of_epoch_milli(1700000000000);
    let i2 = instant_of_epoch_milli(1700000005000);
    let dur = duration_between(i1, i2);
    assert_eq_int(dur.as_secs(), 5, "Duration between instants is 5 seconds");
    assert_eq_int(dur.as_millis(), 5000, "Duration to millis is 5000");

    // 2. Civil Date & Period
    let d1 = local_date_of(2026, 1, 15);
    let d2 = d1.plus_days(20);
    assert_eq_int(d2.day(), 4, "Date plus 20 days reaches Feb 4");
    assert_eq_int(d2.month(), 2, "Month is Feb");

    let p = period_of(1, 2, 10);
    assert_eq_int(p.years(), 1, "Period years");
    assert_eq_int(p.months(), 2, "Period months");
    assert_eq_int(p.days(), 10, "Period days");

    // 3. LocalDateTime & ZonedDateTime
    let ldt = local_date_time_of_parts(2026, 11, 18, 14, 30, 0);
    let offset_utc = zone_offset_utc();
    let zdt = zoned_date_time_of(ldt, offset_utc, zone_id_utc());
    assert_eq_str(zdt.to_string(), "2026-11-18T14:30:00Z[UTC]", "ZonedDateTime ISO string");

    // 4. DateTimeFormatter
    let fmt_iso = date_time_formatter_iso_local_date();
    let formatted_date = fmt_iso.format_date(d1);
    assert_eq_str(formatted_date, "2026-01-15", "ISO date formatter output");

    println("SUITE 3 PASSED: roze.time JSR-310 temporal engine and ISO-8601 formatting");
}

// ------------------------------------------------------------------------------
// Suite 4: Python 3.15 Ergonomics & Functional Pipelines
// ------------------------------------------------------------------------------
func test_suite_4_python_ergonomics() {
    // 1. roze.itertools
    let base_items = list_new();
    data_push(base_items, 1);
    data_push(base_items, 2);
    data_push(base_items, 3);
    let repeated = itertools_repeat(42, 3);
    assert_eq_int(list_length(repeated), 3, "itertools repeat length");
    assert_eq_int(int(list_get(repeated, 0)), 42, "itertools repeat item");

    let perms = itertools_permutations(base_items, 2);
    assert_eq_int(list_length(perms), 6, "P(3, 2) is 6 permutations");

    let combs = itertools_combinations(base_items, 2);
    assert_eq_int(list_length(combs), 3, "C(3, 2) is 3 combinations");

    // 2. roze.functools
    let numbers = list_new();
    data_push(numbers, 1);
    data_push(numbers, 2);
    data_push(numbers, 3);
    data_push(numbers, 4);
    data_push(numbers, 5);
    let sum_all = functools_reduce_add(numbers, 0.0);
    assert_true(sum_all >= 14.9 && sum_all <= 15.1, "functools reduce sum of 1..5 is 15");

    let cache = lru_cache_new(2);
    cache.put("k1", "100");
    cache.put("k2", "200");
    cache.get("k1"); // k1 accessed
    cache.put("k3", "300"); // k2 evicted
    assert_true(!cache.has("k2"), "k2 was evicted from LRU cache");
    assert_eq_str(cache.get("k1"), "100", "k1 retained in LRU cache");

    // 3. roze.statistics
    let stat_data = list_new();
    data_push(stat_data, 10);
    data_push(stat_data, 20);
    data_push(stat_data, 30);
    data_push(stat_data, 40);
    data_push(stat_data, 50);
    let mean_val = stats_mean(stat_data);
    let med_val = stats_median(stat_data);
    assert_true(mean_val >= 29.9 && mean_val <= 30.1, "mean is 30.0");
    assert_true(med_val >= 29.9 && med_val <= 30.1, "median is 30.0");

    // 4. roze.pathlib & roze.csv
    let p = pathlib_path("/var/log/roze/sys.log");
    assert_eq_str(p.name(), "sys.log", "path name");
    assert_eq_str(p.stem(), "sys", "path stem");
    assert_eq_str(p.suffix(), ".log", "path suffix");

    let csv_line = "alpha,100,beta,200";
    let parsed_csv = csv_parse_line(csv_line, ",");
    assert_eq_int(list_length(parsed_csv), 4, "CSV parsed 4 columns");
    let c0: string = list_get(parsed_csv, 0);
    assert_eq_str(c0, "alpha", "CSV column 0");

    // 5. roze.argparse
    let parser = argparse_new("bench_app", "benchmark app");
    parser.add_argument("--threads", "-t", "Number of worker threads", "4", false);
    let cli_args = list_new();
    data_push(cli_args, "--threads");
    data_push(cli_args, "8");
    let parsed_args = parser.parse_args(cli_args);
    let threads_val: string = parsed_args.get("--threads");
    assert_eq_str(threads_val, "8", "argparse option parsed value");

    println("SUITE 4 PASSED: roze.data Python 3.15 ergonomics, itertools, statistics & pathlib");
}

// ------------------------------------------------------------------------------
// Suite 5: Zero-Copy Non-Blocking I/O & Memory-Mapped Channels
// ------------------------------------------------------------------------------
func test_suite_5_zero_copy_nio() {
    // 1. Heap & Direct Off-Heap Native ByteBuffers
    let heap_buf = byte_buffer_allocate(32);
    heap_buf.order_set(byte_order_big_endian());
    heap_buf.put_int(305419896); // 0x12345678
    heap_buf.flip();
    let val_be = heap_buf.get_int();
    assert_eq_int(val_be, 305419896, "ByteBuffer big-endian read");

    // Direct buffer with slicing & position traversal
    let direct_buf = byte_buffer_allocate_direct(64);
    assert_true(direct_buf.is_direct(), "buffer is direct off-heap");
    direct_buf.put_long(9876543210);
    direct_buf.flip();
    let val_long = direct_buf.get_long();
    assert_eq_int(val_long, 9876543210, "Direct buffer 64-bit long read");

    // 2. MappedByteBuffer & FileChannel Zero-Copy Simulation
    let fc = file_channel_open("/dev/null", "rw");
    let mapped = fc.map(2, 0, 128);
    assert_true(mapped != null, "FileChannel mmap returned MappedByteBuffer");
    let mbuf = mapped.buffer();
    mbuf.put(77);
    mbuf.flip();
    assert_eq_int(mbuf.get(), 77, "MappedByteBuffer direct byte read");
    mapped.force();

    // 3. Pipes & Rust mio / tokio-core Poll & Events
    let pipe = pipe_open();
    let pipe_sink = pipe.sink();
    let pipe_src = pipe.source();

    let write_buf = byte_buffer_allocate(32);
    write_buf.put_string("ROZE_ZERO_COPY_NIO");
    write_buf.flip();
    pipe_sink.write(write_buf);

    let recv_buf = byte_buffer_allocate(32);
    let bytes_read = pipe_src.read(recv_buf);
    assert_true(bytes_read > 0, "Pipe transferred bytes zero-copy");

    let sc = socket_channel_open();
    sc.configure_blocking(false);
    sc.connect("127.0.0.1", 8080);
    sc.finish_connect();

    let mio_poll = mio_poll_new();
    let mio_events = mio_events_new(16);
    mio_poll.register_socket(sc, 101, mio_interest_writable());
    let ready_cnt = mio_poll.poll(mio_events, 0);
    assert_true(ready_cnt >= 0, "mio_poll poll executed without error");

    println("SUITE 5 PASSED: roze.nio zero-copy ByteBuffers, memory mapping & non-blocking channels");
}

// ------------------------------------------------------------------------------
// Suite 6: Enterprise Concurrency & Work-Stealing Pools
// ------------------------------------------------------------------------------
func test_suite_6_enterprise_concurrency() {
    // 1. AtomicReference CAS
    let s_init = "ALPHA";
    let s_next = "OMEGA";
    let atomic_ref = atomic_reference_new(s_init);
    let cas_ok = atomic_ref.compare_and_set(s_init, s_next);
    assert_true(cas_ok, "AtomicReference CAS update");
    let cur_str: string = atomic_ref.get();
    assert_eq_str(cur_str, "OMEGA", "AtomicReference current value");

    // 2. CountDownLatch & CyclicBarrier
    let latch = count_down_latch_new(2);
    latch.count_down();
    latch.count_down();
    latch.await_latch();
    assert_eq_int(latch.get_count(), 0, "CountDownLatch drained to 0");

    let barrier_tripped = atomic_reference_new(false);
    let barrier = cyclic_barrier_new(2, || {
        barrier_tripped.set(true);
    });
    thread_spawn(|| {
        barrier.await_barrier();
        return 0;
    });
    thread_sleep(20);
    barrier.await_barrier();
    thread_sleep(25);
    let b_ok: bool = barrier_tripped.get();
    assert_true(b_ok, "CyclicBarrier tripped and action executed");

    // 3. Semaphore & Exchanger
    let sem = semaphore_new(4);
    sem.acquire_permits(3);
    assert_eq_int(sem.available_permits(), 1, "Semaphore 1 permit remains");
    sem.release_permits(3);
    assert_eq_int(sem.available_permits(), 4, "Semaphore permits restored");

    // 4. CompletableFuture Monadic Pipeline
    let f_start = completable_future_completed(50);
    let f_pipeline = f_start.then_apply(|v: Unknown| -> Unknown {
        let n: int = v;
        return n * 3;
    }).then_compose(|v: Unknown| -> CompletableFuture {
        let n: int = v;
        return completable_future_supply_async(|| -> Unknown {
            return n + 50;
        });
    });
    let pipeline_res: int = f_pipeline.get();
    assert_eq_int(pipeline_res, 200, "CompletableFuture then_apply & then_compose pipeline result (50*3+50=200)");

    // Combinators
    let ca = completable_future_completed(10);
    let cb = completable_future_completed(20);
    let all_list = list_new();
    concurrent_push(all_list, ca);
    concurrent_push(all_list, cb);
    let all_futs = completable_future_all_of(all_list);
    all_futs.get();
    assert_true(all_futs.is_done(), "completable_future_all_of is done");

    // 5. ForkJoinPool & Work-Stealing
    let fjp = fork_join_pool_new(2);
    let fj_task = fork_join_task_new(|arg: Unknown| -> Unknown {
        let n: int = arg;
        return n * 4;
    }, 25);
    let fj_val: int = fjp.invoke(fj_task);
    assert_eq_int(fj_val, 100, "ForkJoinPool task invoke result is 100");

    println("SUITE 6 PASSED: roze.concurrent CompletableFuture pipelines and ForkJoinPool work-stealing");
}

// ------------------------------------------------------------------------------
// Suite 7: Grand Cross-Module Convergence & ARC Memory Invariance Gate
// ------------------------------------------------------------------------------
func test_suite_7_grand_convergence() {
    // Cross-module end-to-end integration:
    // 1. ThreadPoolExecutor submits asynchronous task computing arbitrary-precision BigInt Fibonacci
    let pool = thread_pool_executor_new(2, 4);
    let fut_fib = pool.submit(|| -> Unknown {
        let fib_a = bigint_from_int(1);
        let fib_b = bigint_from_int(1);
        let k = 2;
        while k < 30 {
            let next_fib = fib_a.add(fib_b);
            fib_a = fib_b;
            fib_b = next_fib;
            k = k + 1;
        }
        return fib_b.to_string();
    });
    let fib_30: string = fut_fib.get();
    assert_eq_str(fib_30, "832040", "Cross-module BigInt Fibonacci(30) computation");
    pool.shutdown();
    pool.await_termination(100);

    // 2. Store computational results in PriorityQueue & LinkedHashMap
    let pq_results = priority_queue_new();
    pq_results.offer(832040);
    pq_results.offer(100);
    pq_results.offer(5000);
    let pqr: int = pq_results.poll();
    assert_eq_int(pqr, 832040, "PriorityQueue ordered max result");

    let lhm_telemetry = new LinkedHashMap<int, int>();
    lhm_telemetry.put(1, 832040);
    lhm_telemetry.put(2, 200);
    let sc: int = lhm_telemetry.get(2);
    assert_eq_int(sc, 200, "LinkedHashMap status code");

    // 3. Timestamp with ZonedDateTime and serialize to direct off-heap ByteBuffer
    let cur_ldt = local_date_time_of_parts(2026, 11, 18, 12, 0, 0);
    let z_utc = zoned_date_time_of(cur_ldt, zone_offset_utc(), zone_id_utc());
    assert_eq_str(z_utc.to_string(), "2026-11-18T12:00:00Z[UTC]", "ZonedDateTime convergence timestamp");

    let tele_buf = byte_buffer_allocate_direct(128);
    tele_buf.put_int(200);
    tele_buf.put_long(832040);
    tele_buf.flip();
    assert_eq_int(tele_buf.get_int(), 200, "Direct ByteBuffer telemetry code");
    assert_eq_int(tele_buf.get_long(), 832040, "Direct ByteBuffer telemetry payload");

    // 4. Statistical variance validation on batch runtimes
    let runtimes = list_new();
    data_push(runtimes, 1);
    data_push(runtimes, 2);
    data_push(runtimes, 3);
    let avg_runtime = stats_mean(runtimes);
    assert_true(avg_runtime >= 1.9 && avg_runtime <= 2.1, "Statistical mean runtime verification");

    println("SUITE 7 PASSED: Grand Cross-Module Convergence & ARC Memory Invariance Verified");
}

