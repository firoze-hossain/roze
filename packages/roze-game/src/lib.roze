// ==============================================================================
// SECTION 5: Collision Detection & Physics Engine
// ==============================================================================

func game_check_collision_recs(r1: Rectangle, r2: Rectangle) -> bool {
    let r1_right = r1.x + r1.width;
    let r1_bottom = r1.y + r1.height;
    let r2_right = r2.x + r2.width;
    let r2_bottom = r2.y + r2.height;

    if r1.x < r2_right && r1_right > r2.x && r1.y < r2_bottom && r1_bottom > r2.y {
        return true;
    }
    return false;
}

func game_check_collision_circles(c1: Vector2, r1: float, c2: Vector2, r2: float) -> bool {
    let dx = c1.x - c2.x;
    let dy = c1.y - c2.y;
    let dist_sq = (dx * dx) + (dy * dy);
    let radius_sum = r1 + r2;
    return dist_sq <= (radius_sum * radius_sum);
}

// ==============================================================================
// SECTION 6: High-Level Game Loop & Scene Management
// ==============================================================================

class GameObject {
    name: string,
    pos: Vector2,
    velocity: Vector2,
    size: Vector2,
    color: Color,
    active: bool
}

func game_object_new(name: string, x: float, y: float, w: float, h: float, col: Color) -> GameObject {
    let pos = new Vector2(x, y);
    let vel = new Vector2(0.0, 0.0);
    let sz = new Vector2(w, h);
    return new GameObject(name, pos, vel, sz, col, true);
}

func game_object_update(obj: GameObject, dt: float) {
    obj.pos.x = obj.pos.x + (obj.velocity.x * dt);
    obj.pos.y = obj.pos.y + (obj.velocity.y * dt);
}

func game_version() -> string {
    return "1.0.0";
}
