class BeanEntry {
    name: string,
    instance: Unknown
}

class LifecycleRecord {
    bean_name: string,
    action: string, // "REGISTERED", "POST_CONSTRUCT", "PRE_DESTROY", "PROTOTYPE_CREATED"
    detail: string
}

func lifecycle_record_new(name: string, action: string, detail: string) -> LifecycleRecord {
    return new LifecycleRecord(name, action, detail);
}

class StackFrame {
    bean_name: string
}

func stack_frame_new(name: string) -> StackFrame {
    return new StackFrame(name);
}

class ApplicationEvent {
    event_type: string,
    source: string,
    timestamp: int,
    payload: string
}

func application_event_new(event_type: string, source: string, payload: string) -> ApplicationEvent {
    return new ApplicationEvent(event_type, source, 0, payload);
}

class EventListenerEntry {
    listener_name: string,
    target_event_type: string,
    callback_name: string
}

func event_listener_entry_new(name: string, evt_type: string, cb: string) -> EventListenerEntry {
    return new EventListenerEntry(name, evt_type, cb);
}

class CycleDiagnostic {
    has_cycle: bool,
    cycle_path: string,
    participating_count: int
}

func cycle_diagnostic_new(has_cycle: bool, path: string, count: int) -> CycleDiagnostic {
    return new CycleDiagnostic(has_cycle, path, count);
}

// ==============================================================================
// SECTION 7: IoC Container & ApplicationContext Core Engine
// ==============================================================================

class IoCContainer {
    definitions: list, // list of BeanDefinition
    beans: list, // list of BeanEntry (singletons)
    lifecycle_log: list, // list of LifecycleRecord
    environment: Environment,
    event_listeners: list, // list of EventListenerEntry
    published_events: list, // list of ApplicationEvent
    initialization_order: list, // list of StackFrame
    active: bool,
    cycle_detected: bool,
    cycle_error: string
}

func ioc_container_new() -> IoCContainer {
    let defs = list_new();
    let bns = list_new();
    let logs = list_new();
    let env = env_new();
    let listeners = list_new();
    let events = list_new();
    let order = list_new();
    return new IoCContainer(defs, bns, logs, env, listeners, events, order, true, false, "");
}

func ioc_get_environment(ioc: IoCContainer) -> Environment {
    return ioc.environment;
}

func ioc_register_definition(ioc: IoCContainer, def: BeanDefinition) {
    list_push(ioc.definitions, def);
    list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "REGISTERED", def.type_name));
}

func ioc_register_singleton(ioc: IoCContainer, name: string, type_name: string, instance: Unknown) {
    let def = bean_definition_new(name, type_name, scope_singleton());
    def.instance = instance;
    def.is_instantiated = true;
    def.is_initialized = true;
    def.state = bean_state_initialized();
    ioc_register_definition(ioc, def);
    list_push(ioc.beans, new BeanEntry(name, instance));
}

func ioc_find_definition(ioc: IoCContainer, name: string) -> BeanDefinition {
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.name == name {
            return def;
        }
        i = i + 1;
    }
    return null;
}

func ioc_contains_definition(ioc: IoCContainer, identifier: string) -> bool {
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.name == identifier || def.type_name == identifier {
            if def.active {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

func ioc_contains_bean(ioc: IoCContainer, name: string) -> bool {
    let total = list_length(ioc.beans);
    let i = 0;
    while i < total {
        let entry: BeanEntry = list_get(ioc.beans, i);
        if entry.name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func ioc_is_singleton(ioc: IoCContainer, name: string) -> bool {
    let def = ioc_find_definition(ioc, name);
    if def != null {
        return def.scope == scope_singleton();
    }
    return false;
}

func ioc_is_prototype(ioc: IoCContainer, name: string) -> bool {
    let def = ioc_find_definition(ioc, name);
    if def != null {
        return def.scope == scope_prototype();
    }
    return false;
}

func ioc_get_definition_count(ioc: IoCContainer) -> int {
    let count = 0;
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.active {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func ioc_get_definition_names(ioc: IoCContainer) -> list {
    let names = list_new();
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.active {
            list_push(names, new StackFrame(def.name));
        }
        i = i + 1;
    }
    return names;
}

// ==============================================================================
// SECTION 8: Condition Evaluation Engine
// ==============================================================================

func ioc_evaluate_condition(ioc: IoCContainer, rule: ConditionRule) -> bool {
    if rule.condition_type == "property" {
        let key = rule.property_key;
        if env_contains_property(ioc.environment, key) {
            let actual = env_get_property(ioc.environment, key, "");
            return actual == rule.expected_value;
        } else {
            return rule.match_if_missing;
        }
    }
    if rule.condition_type == "missing_bean" {
        return !ioc_contains_definition(ioc, rule.target_identifier);
    }
    if rule.condition_type == "on_bean" {
        return ioc_contains_definition(ioc, rule.target_identifier);
    }
    if rule.condition_type == "profile" {
        return env_is_profile_active(ioc.environment, rule.target_identifier);
    }
    return true;
}

func ioc_evaluate_bean_conditions(ioc: IoCContainer, def: BeanDefinition) -> bool {
    let cond_count = list_length(def.conditions);
    let i = 0;
    while i < cond_count {
        let rule: ConditionRule = list_get(def.conditions, i);
        if !ioc_evaluate_condition(ioc, rule) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ==============================================================================
// SECTION 9: Cycle Detection & Kahn's Topological Sort Engine
// ==============================================================================

func ioc_dfs_cycle_check(ioc: IoCContainer, current_def: BeanDefinition, visiting: list, path: string) -> bool {
    let name = current_def.name;
    let v_count = list_length(visiting);
    let i = 0;
    while i < v_count {
        let frame: StackFrame = list_get(visiting, i);
        if frame.bean_name == name {
            // Circular dependency cycle detected!
            ioc.cycle_detected = true;
            ioc.cycle_error = "CircularDependencyException: Cycle detected in bean hierarchy: " + path + " -> " + name;
            return true;
        }
        i = i + 1;
    }

    list_push(visiting, new StackFrame(name));
    let next_path = path;
    if string_length(next_path) > 0 {
        next_path = next_path + " -> " + name;
    } else {
        next_path = name;
    }

    let dep_count = list_length(current_def.dependencies);
    let d = 0;
    while d < dep_count {
        let dep_ref: DependencyRef = list_get(current_def.dependencies, d);
        let dep_def = ioc_find_definition(ioc, dep_ref.target_bean_name);
        if dep_def != null && dep_def.active {
            let has_sub_cycle = ioc_dfs_cycle_check(ioc, dep_def, visiting, next_path);
            if has_sub_cycle {
                return true;
            }
        }
        d = d + 1;
    }

    let last_idx = list_length(visiting) - 1;
    if last_idx >= 0 {
        list_remove(visiting, last_idx);
    }
    return false;
}

func ioc_detect_circular_dependencies(ioc: IoCContainer) -> bool {
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.active {
            let visiting = list_new();
            let has_cycle = ioc_dfs_cycle_check(ioc, def, visiting, "");
            if has_cycle {
                list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "CYCLE_DETECTED", ioc.cycle_error));
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Kahn's Algorithm for Topological Sort of Bean Graph
func ioc_topological_sort(ioc: IoCContainer) -> bool {
    // Collect active beans
    let active_defs = list_new();
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.active {
            list_push(active_defs, def);
        }
        i = i + 1;
    }

    let active_count = list_length(active_defs);
    let in_degrees = list_new(); // list of int
    let d_idx = 0;
    while d_idx < active_count {
        let cur_def: BeanDefinition = list_get(active_defs, d_idx);
        let dep_count = list_length(cur_def.dependencies);
        // Only count dependencies that are also active beans
        let real_dep_count = 0;
        let c = 0;
        while c < dep_count {
            let d_ref: DependencyRef = list_get(cur_def.dependencies, c);
            let d_def = ioc_find_definition(ioc, d_ref.target_bean_name);
            if d_def != null && d_def.active {
                real_dep_count = real_dep_count + 1;
            }
            c = c + 1;
        }
        list_push(in_degrees, real_dep_count);
        d_idx = d_idx + 1;
    }

    // Queue nodes with in-degree 0
    let queue = list_new();
    let q_i = 0;
    while q_i < active_count {
        let deg: int = list_get(in_degrees, q_i);
        if deg == 0 {
            let z_def: BeanDefinition = list_get(active_defs, q_i);
            list_push(queue, z_def);
        }
        q_i = q_i + 1;
    }

    ioc.initialization_order = list_new();
    while list_length(queue) > 0 {
        let cur_node: BeanDefinition = list_remove(queue, 0);
        list_push(ioc.initialization_order, new StackFrame(cur_node.name));

        // For each other node that has cur_node as dependency, decrement its in-degree
        let n_idx = 0;
        while n_idx < active_count {
            let cand_def: BeanDefinition = list_get(active_defs, n_idx);
            let has_dep = false;
            let cand_deps_len = list_length(cand_def.dependencies);
            let cd = 0;
            while cd < cand_deps_len {
                let dr: DependencyRef = list_get(cand_def.dependencies, cd);
                if dr.target_bean_name == cur_node.name {
                    has_dep = true;
                }
                cd = cd + 1;
            }

            if has_dep {
                let current_deg: int = list_get(in_degrees, n_idx);
                let new_deg = current_deg - 1;
                list_set(in_degrees, n_idx, new_deg);
                if new_deg == 0 {
                    list_push(queue, cand_def);
                }
            }
            n_idx = n_idx + 1;
        }
    }

    if list_length(ioc.initialization_order) < active_count {
        ioc.cycle_detected = true;
        ioc.cycle_error = "CircularDependencyException: Cycle detected in bean hierarchy during topological resolution";
        return false;
    }
    return true;
}

func ioc_get_initialization_order(ioc: IoCContainer) -> list {
    return ioc.initialization_order;
}

func ioc_get_cycle_diagnostic(ioc: IoCContainer) -> CycleDiagnostic {
    return new CycleDiagnostic(ioc.cycle_detected, ioc.cycle_error, list_length(ioc.definitions));
}

// ==============================================================================
// SECTION 10: Event Bus & ApplicationListener Engine
// ==============================================================================

func ioc_register_listener(ioc: IoCContainer, listener_name: string, evt_type: string, callback_name: string) {
    list_push(ioc.event_listeners, new EventListenerEntry(listener_name, evt_type, callback_name));
}

func ioc_publish_event(ioc: IoCContainer, event: ApplicationEvent) {
    list_push(ioc.published_events, event);
    let total = list_length(ioc.event_listeners);
    let i = 0;
    while i < total {
        let l: EventListenerEntry = list_get(ioc.event_listeners, i);
        if l.target_event_type == "*" || l.target_event_type == event.event_type {
            list_push(ioc.lifecycle_log, new LifecycleRecord(l.listener_name, "EVENT_TRIGGERED", event.event_type));
        }
        i = i + 1;
    }
}

func ioc_get_published_events(ioc: IoCContainer) -> list {
    return ioc.published_events;
}

// ==============================================================================
// SECTION 11: Bean Creation, Resolution & Lifecycle Management
// ==============================================================================

func ioc_refresh(ioc: IoCContainer) -> bool {
    // 1. Evaluate bean conditions
    let total_defs = list_length(ioc.definitions);
    let i = 0;
    while i < total_defs {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        let matches = ioc_evaluate_bean_conditions(ioc, def);
        def.active = matches;
        if !matches {
            list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "SKIPPED_CONDITION", "Condition not met"));
        }
        i = i + 1;
    }

    // 2. Detect circular dependencies
    if ioc_detect_circular_dependencies(ioc) {
        return false;
    }

    // 3. Compute topological dependency graph order
    if !ioc_topological_sort(ioc) {
        return false;
    }

    // 4. Initialize singletons in topological order
    let order_len = list_length(ioc.initialization_order);
    let o = 0;
    while o < order_len {
        let frame: StackFrame = list_get(ioc.initialization_order, o);
        let def = ioc_find_definition(ioc, frame.bean_name);
        if def != null && def.active && def.scope == scope_singleton() {
            // Eagerly resolve and instantiate singleton
            if !def.is_instantiated {
                def.is_instantiated = true;
                def.state = bean_state_instantiated();
                def.creation_count = def.creation_count + 1;
                list_push(ioc.beans, new BeanEntry(def.name, def.instance));
            }

            // Resolve @Value placeholder bindings
            let vb_count = list_length(def.value_bindings);
            let v = 0;
            while v < vb_count {
                let vb: ValueBinding = list_get(def.value_bindings, v);
                vb.resolved_value = env_resolve_placeholders(ioc.environment, vb.expression);
                v = v + 1;
            }

            // Execute @PostConstruct hook
            if !def.is_initialized {
                if string_length(def.post_construct_hook) > 0 {
                    list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "POST_CONSTRUCT", def.post_construct_hook));
                }
                def.is_initialized = true;
                def.state = bean_state_initialized();
            }
        }
        o = o + 1;
    }

    // 5. Publish ContextRefreshedEvent
    ioc_publish_event(ioc, application_event_new("ContextRefreshedEvent", "IoCContainer", "ApplicationContext successfully refreshed"));
    return true;
}

func ioc_resolve_dependencies(ioc: IoCContainer) -> bool {
    return ioc_refresh(ioc);
}

func ioc_get_bean(ioc: IoCContainer, name: string) -> Unknown {
    let def = ioc_find_definition(ioc, name);
    if def == null || !def.active {
        return null;
    }

    // Singleton Scope: Return cached singleton instance
    if def.scope == scope_singleton() {
        let total = list_length(ioc.beans);
        let i = 0;
        while i < total {
            let entry: BeanEntry = list_get(ioc.beans, i);
            if entry.name == name {
                return entry.instance;
            }
            i = i + 1;
        }
        return def.instance;
    }

    // Prototype Scope: Create a new instance upon each getBean call
    if def.scope == scope_prototype() {
        def.creation_count = def.creation_count + 1;
        list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "PROTOTYPE_CREATED", "count=" + ioc_int_to_str(def.creation_count)));
        if string_length(def.post_construct_hook) > 0 {
            list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "POST_CONSTRUCT", def.post_construct_hook));
        }
        // Returns the prototype template or prototype instance reference
        return def.instance;
    }

    return null;
}

func ioc_get_bean_by_type(ioc: IoCContainer, type_name: string) -> Unknown {
    let candidates = list_new();
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.type_name == type_name && def.active {
            list_push(candidates, def);
        }
        i = i + 1;
    }

    let cand_count = list_length(candidates);
    if cand_count == 0 {
        return null;
    }
    if cand_count == 1 {
        let only_def: BeanDefinition = list_get(candidates, 0);
        return ioc_get_bean(ioc, only_def.name);
    }

    // Multiple candidates: check for @Primary
    let p = 0;
    while p < cand_count {
        let c_def: BeanDefinition = list_get(candidates, p);
        if c_def.is_primary {
            return ioc_get_bean(ioc, c_def.name);
        }
        p = p + 1;
    }

    // Default to first candidate
    let first_def: BeanDefinition = list_get(candidates, 0);
    return ioc_get_bean(ioc, first_def.name);
}

func ioc_get_bean_with_qualifier(ioc: IoCContainer, type_name: string, qualifier: string) -> Unknown {
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.type_name == type_name && def.active {
            if def.name == qualifier {
                return ioc_get_bean(ioc, def.name);
            }
        }
        i = i + 1;
    }
    return null;
}

func ioc_get_beans_of_type(ioc: IoCContainer, type_name: string) -> list {
    let matches = list_new();
    let total = list_length(ioc.definitions);
    let i = 0;
    while i < total {
        let def: BeanDefinition = list_get(ioc.definitions, i);
        if def.type_name == type_name && def.active {
            let instance = ioc_get_bean(ioc, def.name);
            if instance != null {
                list_push(matches, new BeanEntry(def.name, instance));
            }
        }
        i = i + 1;
    }
    return matches;
}

func ioc_close(ioc: IoCContainer) {
    if !ioc.active {
        return;
    }

    // 1. Publish ContextClosedEvent
    ioc_publish_event(ioc, application_event_new("ContextClosedEvent", "IoCContainer", "ApplicationContext shutting down"));

    // 2. Invoke @PreDestroy on Singletons in REVERSE topological order
    let order_len = list_length(ioc.initialization_order);
    let idx = order_len - 1;
    while idx >= 0 {
        let frame: StackFrame = list_get(ioc.initialization_order, idx);
        let def = ioc_find_definition(ioc, frame.bean_name);
        if def != null && def.active && def.scope == scope_singleton() {
            if string_length(def.pre_destroy_hook) > 0 {
                list_push(ioc.lifecycle_log, new LifecycleRecord(def.name, "PRE_DESTROY", def.pre_destroy_hook));
            }
            def.state = bean_state_destroyed();
        }
        idx = idx - 1;
    }

    // 3. Clear beans
    ioc.beans = list_new();
    ioc.active = false;
    list_push(ioc.lifecycle_log, new LifecycleRecord("IoCContainer", "SHUTDOWN", "IoC Container successfully shutdown"));
}

func ioc_destroy(ioc: IoCContainer) {
    ioc_close(ioc);
}

// ==============================================================================
// SECTION 12: Lifecycle Query Utilities & Diagnostics
// ==============================================================================

func ioc_get_lifecycle_logs(ioc: IoCContainer) -> list {
    return ioc.lifecycle_log;
}

func ioc_has_lifecycle_action(ioc: IoCContainer, bean_name: string, action: string) -> bool {
    let total = list_length(ioc.lifecycle_log);
    let i = 0;
    while i < total {
        let rec: LifecycleRecord = list_get(ioc.lifecycle_log, i);
        if rec.bean_name == bean_name && rec.action == action {
            return true;
        }
        i = i + 1;
    }
    return false;
}

