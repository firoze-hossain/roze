// ------------------------------------------------------------------------------
// 2. Color Palettes & Helpers
// ------------------------------------------------------------------------------

func color_rgba(r: int, g: int, b: int, a: int) -> int {
    let r_part = (r % 256) * 16777216; // << 24
    let g_part = (g % 256) * 65536;    // << 16
    let b_part = (b % 256) * 256;      // << 8
    let a_part = a % 256;
    return r_part + g_part + b_part + a_part;
}

func color_rgb(r: int, g: int, b: int) -> int {
    return color_rgba(r, g, b, 255);
}

// Built-in standard game palette
func color_black() -> int { return 255; }                     // 0x000000FF
func color_white() -> int { return -1; }                      // 0xFFFFFFFF
func color_raywhite() -> int { return -179516161; }           // 0xF5F5F5FF
func color_red() -> int { return -433502465; }                // 0xE62937FF
func color_green() -> int { return 14954751; }                // 0x00E430FF
func color_blue() -> int { return 7991807; }                  // 0x0079F1FF
func color_gold() -> int { return -3460097; }                 // 0xFFCB00FF
func color_orange() -> int { return -6225665; }               // 0xFFA100FF
func color_magenta() -> int { return -953904641; }            // 0xC724B1FF
func color_darkgray() -> int { return 1347440895; }           // 0x505050FF
func color_lightgray() -> int { return -741094913; }          // 0xD3D3D3FF
func color_skyblue() -> int { return 1723858943; }            // 0x66BFFFFF

