    return HTTP_custom("GET", path, host, "", "", 0);
}
func HTTP_Post(path: string, host: string, body: string) -> Packet {
    return HTTP_custom("POST", path, host, "", body, 0);
}
func HTTP_Response_200(body: string) -> Packet {
    return HTTP_custom("", "", "", "", body, 200);
}
