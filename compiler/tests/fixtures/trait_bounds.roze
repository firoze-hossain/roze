// compiler/tests/fixtures/trait_bounds.roze
// Tests M1-T01: Advanced Generics, Trait Bounds, where clauses & Associated Types

trait Printable {
    func print_info() -> int;
}

trait Cloneable {
    func clone_val() -> int;
}

class User {
    id: int,
}

impl Printable for User {
    func print_info() -> int {
        println("User id:");
        println(this.id);
        return this.id;
    }
}

impl Cloneable for User {
    func clone_val() -> int {
        return this.id;
    }
}

class Product {
    price: int,
}

impl Printable for Product {
    func print_info() -> int {
        println("Product price:");
        println(this.price);
        return this.price;
    }
}

// 1. Single Trait Bound
func show_item<T: Printable>(item: T) -> int {
    return item.print_info();
}

// 2. Multiple Trait Bounds with +
func show_and_clone<T: Printable + Cloneable>(item: T) -> int {
    let cloned_id = item.clone_val();
    item.print_info();
    return cloned_id;
}

// 3. Where Clause
func show_both<A, B>(a: A, b: B) -> int where A: Printable, B: Printable {
    a.print_info();
    b.print_info();
    return 1;
}

// 4. Generic Class with Trait Bound
class PrintableHolder<T: Printable> {
    data: T,
}

// 5. Trait with Associated Type
trait Producer {
    type Item;
    func produce() -> int;
}

class NumberProducer {
    val: int,
}

impl Producer for NumberProducer {
    type Item = int;
    func produce() -> int {
        return this.val;
    }
}

func main() {
    let u = new User(42);
    let p = new Product(199);

    println("=== Single Trait Bound ===");
    show_item<User>(u);
    show_item<Product>(p);

    println("=== Multiple Trait Bounds ===");
    let cloned = show_and_clone<User>(u);
    println(cloned);

    println("=== Where Clause ===");
    show_both<User, Product>(u, p);

    println("=== Generic Class with Bound ===");
    let holder = new PrintableHolder<User>(u);
    holder.data.print_info();

    println("=== Associated Types ===");
    let prod = new NumberProducer(777);
    println(prod.produce());

    println("trait bounds and associated types verified!");
}
