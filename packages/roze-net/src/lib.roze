}

func audit_log_entry_to_string(entry: AuditLogEntry) -> string {
    return "[" + int_to_str(entry.timestamp_ms) + "] [" + entry.operator + "] " +
           entry.action + " -> " + entry.target + " [" + entry.status + "]: " + entry.message;
}

