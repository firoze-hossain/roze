// packages/roze-torch/tests/test_torch.roze
// Comprehensive M8-T01 Tensor Engine & Vector Arithmetic Verification Suite
import "roze-torch";

func assert_true(cond: bool, msg: string) {
    if !cond {
        println("❌ Assertion failed: " + msg);
    }
}

func approx_eq(a: float, b: float, eps: float) -> bool {
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    return diff <= eps;
}

// -----------------------------------------------------------------------------
// Test 1: Shape & Strides for Arbitrary Ranks (0D to 6D)
// -----------------------------------------------------------------------------
func test_shapes_and_strides() {
    println("--- Test 1: Shapes & Strides (0D to 6D) ---");

    // 0D Scalar
    let s0 = shape_0d();
    assert_true(s0.rank == 0, "0D rank must be 0");
    assert_true(s0.numel() == 1, "0D numel must be 1");
    let t0 = tensor_scalar(42.0, dtype_float32());
    assert_true(t0.rank() == 0, "Scalar rank must be 0");
    assert_true(approx_eq(t0.item(), 42.0, 0.001), "Scalar item must be 42.0");

    // 1D Vector
    let t1 = tensor_zeros_1d(5);
    assert_true(t1.rank() == 1, "1D rank must be 1");
    assert_true(t1.numel() == 5, "1D numel must be 5");
    assert_true(t1.is_contiguous(), "1D zeros must be contiguous");
    t1.set_1d(2, 7.5);
    assert_true(approx_eq(t1.get_1d(2), 7.5, 0.001), "1D get/set failed");

    // 2D Matrix
    let t2 = tensor_zeros_2d(3, 4);
    assert_true(t2.rank() == 2, "2D rank must be 2");
    assert_true(t2.numel() == 12, "2D numel must be 12");
    assert_true(t2.strides.s0 == 4 && t2.strides.s1 == 1, "2D contiguous strides mismatch");
    t2.set_2d(2, 3, 9.25);
    assert_true(approx_eq(t2.get_2d(2, 3), 9.25, 0.001), "2D get/set failed");

    // 3D Volume
    let t3 = tensor_zeros_3d(2, 3, 4);
    assert_true(t3.rank() == 3, "3D rank must be 3");
    assert_true(t3.numel() == 24, "3D numel must be 24");
    assert_true(t3.strides.s0 == 12 && t3.strides.s1 == 4 && t3.strides.s2 == 1, "3D strides mismatch");
    t3.set_3d(1, 2, 3, 19.5);
    assert_true(approx_eq(t3.get_3d(1, 2, 3), 19.5, 0.001), "3D get/set failed");

    // 4D Tensor
    let t4 = tensor_zeros_4d(2, 3, 2, 2);
    assert_true(t4.rank() == 4, "4D rank must be 4");
    assert_true(t4.numel() == 24, "4D numel must be 24");
    t4.set_4d(1, 2, 1, 1, 33.0);
    assert_true(approx_eq(t4.get_4d(1, 2, 1, 1), 33.0, 0.001), "4D get/set failed");

    // 5D Tensor
    let t5 = tensor_zeros_5d(2, 2, 2, 2, 2);
    assert_true(t5.rank() == 5, "5D rank must be 5");
    assert_true(t5.numel() == 32, "5D numel must be 32");
    t5.set_5d(1, 1, 1, 1, 1, 55.0);
    assert_true(approx_eq(t5.get_5d(1, 1, 1, 1, 1), 55.0, 0.001), "5D get/set failed");

    // 6D Tensor
    let t6 = tensor_zeros_6d(2, 1, 2, 1, 2, 2);
    assert_true(t6.rank() == 6, "6D rank must be 6");
    assert_true(t6.numel() == 16, "6D numel must be 16");
    t6.set_6d(1, 0, 1, 0, 1, 1, 66.0);
    assert_true(approx_eq(t6.get_6d(1, 0, 1, 0, 1, 1), 66.0, 0.001), "6D get/set failed");

    println("✓ Shape and strides tests passed!");
}

// -----------------------------------------------------------------------------
// Test 2: All 8 Dtypes & Half / BFloat16 Precision
// -----------------------------------------------------------------------------
func test_dtypes() {
    println("--- Test 2: All 8 Dtypes & Bitwise Half/BFloat Conversions ---");

    // Float32
    let tf32 = tensor_zeros(shape_1d(2), dtype_float32());
    tf32.set_1d(0, 12.34);
    assert_true(approx_eq(tf32.get_1d(0), 12.34, 0.01), "Float32 read/write failed");

    // Float64
    let tf64 = tensor_zeros(shape_1d(2), dtype_float64());
    tf64.set_1d(0, 987654.321);
    assert_true(approx_eq(tf64.get_1d(0), 987654.321, 0.0001), "Float64 read/write failed");

    // Float16 (IEEE 754 half-precision)
    let tf16 = tensor_zeros(shape_1d(4), dtype_float16());
    tf16.set_1d(0, 1.5);
    tf16.set_1d(1, -2.5);
    tf16.set_1d(2, 100.0);
    assert_true(approx_eq(tf16.get_1d(0), 1.5, 0.01), "Float16 (1.5) mismatch");
    assert_true(approx_eq(tf16.get_1d(1), -2.5, 0.01), "Float16 (-2.5) mismatch");
    assert_true(approx_eq(tf16.get_1d(2), 100.0, 0.1), "Float16 (100.0) mismatch");

    // BFloat16
    let tbf16 = tensor_zeros(shape_1d(3), dtype_bfloat16());
    tbf16.set_1d(0, 3.14);
    tbf16.set_1d(1, -42.0);
    assert_true(approx_eq(tbf16.get_1d(0), 3.14, 0.05), "BFloat16 (3.14) mismatch");
    assert_true(approx_eq(tbf16.get_1d(1), -42.0, 0.1), "BFloat16 (-42.0) mismatch");

    // Int32
    let ti32 = tensor_zeros(shape_1d(3), dtype_int32());
    ti32.set_1d(0, 12345.0);
    ti32.set_1d(1, -6789.0);
    assert_true(ti32.get_1d(0) == 12345.0, "Int32 positive mismatch");
    assert_true(ti32.get_1d(1) == -6789.0, "Int32 negative mismatch");

    // Int64
    let ti64 = tensor_zeros(shape_1d(2), dtype_int64());
    ti64.set_1d(0, 1000000.0);
    assert_true(ti64.get_1d(0) == 1000000.0, "Int64 mismatch");

    // UInt8
    let tu8 = tensor_zeros(shape_1d(3), dtype_uint8());
    tu8.set_1d(0, 255.0);
    tu8.set_1d(1, 42.0);
    assert_true(tu8.get_1d(0) == 255.0, "UInt8 255 mismatch");
    assert_true(tu8.get_1d(1) == 42.0, "UInt8 42 mismatch");

    // Bool
    let tbool = tensor_zeros(shape_1d(2), dtype_bool());
    tbool.set_1d(0, 1.0);
    tbool.set_1d(1, 0.0);
    assert_true(tbool.get_1d(0) == 1.0, "Bool true mismatch");
    assert_true(tbool.get_1d(1) == 0.0, "Bool false mismatch");

    println("✓ Dtypes & precision tests passed!");
}

// -----------------------------------------------------------------------------
// Test 3: Strided Slicing with Negative Indices & Steps (Zero-Copy Views)
// -----------------------------------------------------------------------------
func test_slicing() {
    println("--- Test 3: Strided Slicing with Negative Indices & Steps ---");

    // 1D Slicing: [0, 10, 20, 30, 40, 50]
    let t = tensor_zeros_1d(6);
    let i = 0;
    while i < 6 {
        t.set_1d(i, i * 10.0);
        i = i + 1;
    }

    // Subslice [1:4] -> elements 10, 20, 30
    let s_sub = tensor_slice_1d(t, slice_range(1, 4));
    assert_true(s_sub.numel() == 3, "Slice [1:4] length must be 3");
    assert_true(approx_eq(s_sub.get_1d(0), 10.0, 0.001), "Slice [1:4] elem 0");
    assert_true(approx_eq(s_sub.get_1d(1), 20.0, 0.001), "Slice [1:4] elem 1");
    assert_true(approx_eq(s_sub.get_1d(2), 30.0, 0.001), "Slice [1:4] elem 2");

    // Negative indices: [-4:-1] -> elements [2:5] = 20, 30, 40
    let s_neg = tensor_slice_1d(t, slice_range(-4, -1));
    assert_true(s_neg.numel() == 3, "Slice [-4:-1] length must be 3");
    assert_true(approx_eq(s_neg.get_1d(0), 20.0, 0.001), "Slice [-4:-1] elem 0");
    assert_true(approx_eq(s_neg.get_1d(2), 40.0, 0.001), "Slice [-4:-1] elem 2");

    // Step slicing: [::2] -> elements 0, 20, 40
    let s_step = tensor_slice_1d(t, slice_new(0, 6, 2));
    assert_true(s_step.numel() == 3, "Slice [::2] length must be 3");
    assert_true(approx_eq(s_step.get_1d(0), 0.0, 0.001), "Slice [::2] elem 0");
    assert_true(approx_eq(s_step.get_1d(1), 20.0, 0.001), "Slice [::2] elem 1");
    assert_true(approx_eq(s_step.get_1d(2), 40.0, 0.001), "Slice [::2] elem 2");

    // Negative step (Reverse slice): [::-1] -> 50, 40, 30, 20, 10, 0
    let sl_rev = slice_reverse();
    let s_rev = tensor_slice_1d(t, sl_rev);
    assert_true(s_rev.numel() == 6, "Reverse slice length must be 6");
    assert_true(approx_eq(s_rev.get_1d(0), 50.0, 0.001), "Reverse elem 0 must be 50");
    assert_true(approx_eq(s_rev.get_1d(1), 40.0, 0.001), "Reverse elem 1 must be 40");
    assert_true(approx_eq(s_rev.get_1d(5), 0.0, 0.001), "Reverse elem 5 must be 0");

    // 2D Slicing: 3x3 matrix
    let m = tensor_zeros_2d(3, 3);
    m.set_2d(0, 0, 1.0); m.set_2d(0, 1, 2.0); m.set_2d(0, 2, 3.0);
    m.set_2d(1, 0, 4.0); m.set_2d(1, 1, 5.0); m.set_2d(1, 2, 6.0);
    m.set_2d(2, 0, 7.0); m.set_2d(2, 1, 8.0); m.set_2d(2, 2, 9.0);

    // Submatrix rows [1:3], cols [0:2] -> 2x2: [[4, 5], [7, 8]]
    let sm = tensor_slice_2d(m, slice_range(1, 3), slice_range(0, 2));
    assert_true(sm.shape.dim0 == 2 && sm.shape.dim1 == 2, "2D slice shape mismatch");
    assert_true(approx_eq(sm.get_2d(0, 0), 4.0, 0.001), "Submatrix (0,0) == 4");
    assert_true(approx_eq(sm.get_2d(0, 1), 5.0, 0.001), "Submatrix (0,1) == 5");
    assert_true(approx_eq(sm.get_2d(1, 0), 7.0, 0.001), "Submatrix (1,0) == 7");
    assert_true(approx_eq(sm.get_2d(1, 1), 8.0, 0.001), "Submatrix (1,1) == 8");

    // Select row 1 view -> 1D vector [4, 5, 6]
    let r1 = tensor_select(m, 0, 1);
    assert_true(r1.numel() == 3, "Select row 1 length must be 3");
    assert_true(approx_eq(r1.get_1d(0), 4.0, 0.001), "Row 1 (0) == 4");
    assert_true(approx_eq(r1.get_1d(1), 5.0, 0.001), "Row 1 (1) == 5");
    assert_true(approx_eq(r1.get_1d(2), 6.0, 0.001), "Row 1 (2) == 6");

    println("✓ Strided slicing and negative steps tests passed!");
}

// -----------------------------------------------------------------------------
// Test 4: Broadcasting Engine & Elementwise Binary Arithmetic
// -----------------------------------------------------------------------------
func test_broadcasting() {
    println("--- Test 4: Broadcasting Engine & Elementwise Ops ---");

    // (2, 3) + (1, 3) broadcasting
    let a = tensor_ones_2d(2, 3);
    let b = tensor_zeros_2d(1, 3);
    b.set_2d(0, 0, 10.0);
    b.set_2d(0, 1, 20.0);
    b.set_2d(0, 2, 30.0);

    let c = tensor_add(a, b);
    assert_true(c.shape.dim0 == 2 && c.shape.dim1 == 3, "Broadcast sum shape mismatch");
    assert_true(approx_eq(c.get_2d(0, 0), 11.0, 0.001), "c(0,0) must be 11");
    assert_true(approx_eq(c.get_2d(0, 1), 21.0, 0.001), "c(0,1) must be 21");
    assert_true(approx_eq(c.get_2d(1, 2), 31.0, 0.001), "c(1,2) must be 31");

    // Subtraction & Scaling
    let sub = tensor_sub(c, a);
    assert_true(approx_eq(sub.get_2d(0, 0), 10.0, 0.001), "Sub failed");

    let scaled = tensor_scale(sub, 2.0);
    assert_true(approx_eq(scaled.get_2d(0, 0), 20.0, 0.001), "Scale failed");

    // Multiplication & Division
    let mul = tensor_mul(a, b);
    assert_true(approx_eq(mul.get_2d(1, 1), 20.0, 0.001), "Mul failed");

    let div = tensor_div(mul, b);
    assert_true(approx_eq(div.get_2d(1, 1), 1.0, 0.001), "Div failed");

    println("✓ Broadcasting & elementwise arithmetic tests passed!");
}

// -----------------------------------------------------------------------------
// Test 5: Matrix Transposition, Permutation & Contiguous Re-allocation
// -----------------------------------------------------------------------------
func test_transpose_and_contiguous() {
    println("--- Test 5: Transposition, Permutation & Contiguous Re-allocation ---");

    // Transpose 2D matrix (2, 3) -> (3, 2)
    let a = tensor_zeros_2d(2, 3);
    a.set_2d(0, 0, 1.0); a.set_2d(0, 1, 2.0); a.set_2d(0, 2, 3.0);
    a.set_2d(1, 0, 4.0); a.set_2d(1, 1, 5.0); a.set_2d(1, 2, 6.0);

    let at = tensor_t(a);
    assert_true(at.shape.dim0 == 3 && at.shape.dim1 == 2, "Transpose shape must be (3, 2)");
    assert_true(approx_eq(at.get_2d(0, 0), 1.0, 0.001), "at(0,0) == 1");
    assert_true(approx_eq(at.get_2d(1, 0), 2.0, 0.001), "at(1,0) == 2");
    assert_true(approx_eq(at.get_2d(2, 1), 6.0, 0.001), "at(2,1) == 6");
    assert_true(!at.is_contiguous(), "Transposed view must NOT be contiguous");

    // Contiguous re-allocation
    let contig = tensor_contiguous(at);
    assert_true(contig.is_contiguous(), "Contiguous copy must be contiguous");
    assert_true(approx_eq(contig.get_2d(0, 0), 1.0, 0.001), "contig(0,0) == 1");
    assert_true(approx_eq(contig.get_2d(1, 0), 2.0, 0.001), "contig(1,0) == 2");
    assert_true(approx_eq(contig.get_2d(2, 1), 6.0, 0.001), "contig(2,1) == 6");

    // 3D Permute: (2, 3, 4) permute (2, 0, 1) -> (4, 2, 3)
    let vol = tensor_zeros_3d(2, 3, 4);
    vol.set_3d(1, 2, 3, 99.0);
    let perm = tensor_permute_3d(vol, 2, 0, 1);
    assert_true(perm.shape.dim0 == 4 && perm.shape.dim1 == 2 && perm.shape.dim2 == 3, "Permute shape mismatch");
    assert_true(approx_eq(perm.get_3d(3, 1, 2), 99.0, 0.001), "Permuted value mismatch");

    println("✓ Transposition and contiguous tests passed!");
}

// -----------------------------------------------------------------------------
// Test 6: Shape Transformations (Reshape, Flatten, Squeeze, Unsqueeze)
// -----------------------------------------------------------------------------
func test_shape_transformations() {
    println("--- Test 6: Shape Transformations ---");

    // Reshape: (2, 3) -> (6) and (3, 2)
    let a = tensor_zeros_2d(2, 3);
    a.set_2d(0, 0, 1.0); a.set_2d(0, 1, 2.0); a.set_2d(0, 2, 3.0);
    a.set_2d(1, 0, 4.0); a.set_2d(1, 1, 5.0); a.set_2d(1, 2, 6.0);

    let reshaped = tensor_reshape(a, shape_1d(6));
    assert_true(reshaped.rank() == 1 && reshaped.numel() == 6, "Reshape 1D failed");
    assert_true(approx_eq(reshaped.get_1d(3), 4.0, 0.001), "Reshape elem 3 mismatch");

    // Flatten
    let flat = tensor_flatten(a, 0, 1);
    assert_true(flat.rank() == 1 && flat.numel() == 6, "Flatten failed");
    assert_true(approx_eq(flat.get_1d(5), 6.0, 0.001), "Flatten elem 5 mismatch");

    // Unsqueeze: (2, 3) unsqueeze at 0 -> (1, 2, 3)
    let unsq = tensor_unsqueeze(a, 0);
    assert_true(unsq.rank() == 3 && unsq.shape.dim0 == 1 && unsq.shape.dim1 == 2 && unsq.shape.dim2 == 3, "Unsqueeze 0 failed");

    // Squeeze: (1, 2, 3) squeeze at 0 -> (2, 3)
    let sq = tensor_squeeze(unsq, 0);
    assert_true(sq.rank() == 2 && sq.shape.dim0 == 2 && sq.shape.dim1 == 3, "Squeeze failed");

    println("✓ Shape transformation tests passed!");
}

// -----------------------------------------------------------------------------
// Test 7: Tensor Contraction & Linear Algebra (dot, matmul GEMM, bmm, tensordot)
// -----------------------------------------------------------------------------
func test_linear_algebra() {
    println("--- Test 7: Tensor Contractions & Linear Algebra ---");

    // Vector Dot Product: [1, 2, 3] . [4, 5, 6] = 4 + 10 + 18 = 32
    let v1 = tensor_zeros_1d(3);
    v1.set_1d(0, 1.0); v1.set_1d(1, 2.0); v1.set_1d(2, 3.0);
    let v2 = tensor_zeros_1d(3);
    v2.set_1d(0, 4.0); v2.set_1d(1, 5.0); v2.set_1d(2, 6.0);
    let dot_prod = tensor_dot(v1, v2);
    assert_true(approx_eq(dot_prod, 32.0, 0.001), "Dot product must be 32");

    // Matrix Multiplication GEMM: (2, 3) x (3, 2) -> (2, 2)
    // a = [[1, 2, 3], [4, 5, 6]]
    // b = [[7, 8], [9, 1], [2, 3]]
    // c = a x b = [[1*7+2*9+3*2, 1*8+2*1+3*3], [4*7+5*9+6*2, 4*8+5*1+6*3]]
    //   = [[7+18+6, 8+2+9], [28+45+12, 32+5+18]] = [[31, 19], [85, 55]]
    let a = tensor_zeros_2d(2, 3);
    a.set_2d(0, 0, 1.0); a.set_2d(0, 1, 2.0); a.set_2d(0, 2, 3.0);
    a.set_2d(1, 0, 4.0); a.set_2d(1, 1, 5.0); a.set_2d(1, 2, 6.0);

    let b = tensor_zeros_2d(3, 2);
    b.set_2d(0, 0, 7.0); b.set_2d(0, 1, 8.0);
    b.set_2d(1, 0, 9.0); b.set_2d(1, 1, 1.0);
    b.set_2d(2, 0, 2.0); b.set_2d(2, 1, 3.0);

    let mm = tensor_matmul(a, b);
    assert_true(mm.shape.dim0 == 2 && mm.shape.dim1 == 2, "Matmul shape mismatch");
    assert_true(approx_eq(mm.get_2d(0, 0), 31.0, 0.001), "GEMM (0,0) must be 31");
    assert_true(approx_eq(mm.get_2d(0, 1), 19.0, 0.001), "GEMM (0,1) must be 19");
    assert_true(approx_eq(mm.get_2d(1, 0), 85.0, 0.001), "GEMM (1,0) must be 85");
    assert_true(approx_eq(mm.get_2d(1, 1), 55.0, 0.001), "GEMM (1,1) must be 55");

    // Batched Matrix Multiply (BMM): (2, 2, 3) x (2, 3, 2) -> (2, 2, 2)
    let b_a = tensor_zeros_3d(2, 2, 3);
    let b_b = tensor_zeros_3d(2, 3, 2);
    let b_i = 0;
    while b_i < 2 {
        let r = 0;
        while r < 2 {
            let k = 0;
            while k < 3 {
                b_a.set_3d(b_i, r, k, a.get_2d(r, k));
                k = k + 1;
            }
            r = r + 1;
        }
        let k2 = 0;
        while k2 < 3 {
            let c = 0;
            while c < 2 {
                b_b.set_3d(b_i, k2, c, b.get_2d(k2, c));
                c = c + 1;
            }
            k2 = k2 + 1;
        }
        b_i = b_i + 1;
    }
    let bmm_out = tensor_bmm(b_a, b_b);
    assert_true(bmm_out.shape.dim0 == 2 && bmm_out.shape.dim1 == 2 && bmm_out.shape.dim2 == 2, "BMM shape mismatch");
    assert_true(approx_eq(bmm_out.get_3d(0, 0, 0), 31.0, 0.001), "BMM batch 0 (0,0) must be 31");
    assert_true(approx_eq(bmm_out.get_3d(1, 1, 1), 55.0, 0.001), "BMM batch 1 (1,1) must be 55");

    // Tensordot contraction
    let td = tensor_tensordot(a, b, 1);
    assert_true(approx_eq(td.get_2d(0, 0), 31.0, 0.001), "Tensordot (0,0) must be 31");

    println("✓ Contractions and linear algebra tests passed!");
}

// -----------------------------------------------------------------------------
// Test 8: Mathematical Reductions & Norms
// -----------------------------------------------------------------------------
func test_reductions() {
    println("--- Test 8: Reductions & Norms ---");

    let t = tensor_zeros_2d(2, 2);
    t.set_2d(0, 0, 1.0);
    t.set_2d(0, 1, -2.0);
    t.set_2d(1, 0, 3.0);
    t.set_2d(1, 1, -4.0);

    // Sum & Mean
    let sum_val = tensor_sum(t);
    assert_true(approx_eq(sum_val, -2.0, 0.001), "Sum must be -2");

    let mean_val = tensor_mean(t);
    assert_true(approx_eq(mean_val, -0.5, 0.001), "Mean must be -0.5");

    // Max & Min
    let max_val = tensor_max(t);
    assert_true(approx_eq(max_val, 3.0, 0.001), "Max must be 3");

    let min_val = tensor_min(t);
    assert_true(approx_eq(min_val, -4.0, 0.001), "Min must be -4");

    // Norms
    let l1 = tensor_norm_l1(t); // |1| + |-2| + |3| + |-4| = 10
    assert_true(approx_eq(l1, 10.0, 0.001), "L1 norm must be 10");

    let l2 = tensor_norm_l2(t); // sqrt(1 + 4 + 9 + 16) = sqrt(30) ≈ 5.4772
    assert_true(approx_eq(l2, 5.4772, 0.01), "L2 norm must be ~5.477");

    // Dimensional Sum: along dim 0 -> (1, 2) sums columns -> [4.0, -6.0]
    let col_sum = tensor_sum_dim(t, 0, false);
    assert_true(col_sum.numel() == 2, "Dim 0 sum length must be 2");
    assert_true(approx_eq(col_sum.get_1d(0), 4.0, 0.001), "Col sum 0 must be 4");
    assert_true(approx_eq(col_sum.get_1d(1), -6.0, 0.001), "Col sum 1 must be -6");

    println("✓ Reductions and norms tests passed!");
}

// -----------------------------------------------------------------------------
// Test 9: Neural Activations, Layers & Optimization
// -----------------------------------------------------------------------------
func test_neural_network() {
    println("--- Test 9: Activations, Linear Layer & Optimizers ---");

    let t = tensor_zeros_1d(3);
    t.set_1d(0, -3.0);
    t.set_1d(1, 0.0);
    t.set_1d(2, 3.0);

    // ReLU: [-3, 0, 3] -> [0, 0, 3]
    let r = tensor_relu(t);
    assert_true(approx_eq(r.get_1d(0), 0.0, 0.001), "ReLU (-3) == 0");
    assert_true(approx_eq(r.get_1d(2), 3.0, 0.001), "ReLU (3) == 3");

    // Sigmoid: 0 -> 0.5
    let sig = tensor_sigmoid(t);
    assert_true(approx_eq(sig.get_1d(1), 0.5, 0.01), "Sigmoid (0) == 0.5");

    // Tanh: 0 -> 0.0
    let th = tensor_tanh(t);
    assert_true(approx_eq(th.get_1d(1), 0.0, 0.01), "Tanh (0) == 0.0");

    // GELU & SiLU
    let gelu_out = tensor_gelu(t);
    assert_true(approx_eq(gelu_out.get_1d(1), 0.0, 0.01), "GELU (0) == 0.0");
    let silu_out = tensor_silu(t);
    assert_true(approx_eq(silu_out.get_1d(1), 0.0, 0.01), "SiLU (0) == 0.0");

    // Softmax: sum over distribution equals 1.0
    let sm = tensor_softmax(t);
    let sm_sum = tensor_sum(sm);
    assert_true(approx_eq(sm_sum, 1.0, 0.01), "Softmax probabilities must sum to 1.0");

    // Linear Layer Forward Pass
    let layer = linear_new(3, 2);
    let inp = tensor_ones_2d(1, 3);
    let out = linear_forward(layer, inp);
    assert_true(out.shape.dim0 == 1 && out.shape.dim1 == 2, "Linear forward shape mismatch");

    // MSE Loss
    let target = tensor_zeros_2d(1, 2);
    let loss = mse_loss(out, target);
    assert_true(loss >= 0.0, "MSE loss must be non-negative");

    // SGD Step
    sgd_step(layer, 0.01);

    println("✓ Neural network activations and layers tests passed!");
}

// -----------------------------------------------------------------------------
// Test 10: Autograd Tape Recording & GradFn Inspection (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_tape_and_grad_fn() {
    println("--- Test 10: Autograd Tape Recording & GradFn Inspection ---");

    let a = tensor_scalar(2.0, dtype_float32());
    let b = tensor_scalar(3.0, dtype_float32());
    a.set_requires_grad(true);
    b.set_requires_grad(true);

    assert_true(a.get_is_leaf(), "a must be leaf");
    assert_true(b.get_is_leaf(), "b must be leaf");
    assert_true(a.get_grad_fn() == null, "Leaf tensor has null grad_fn");

    // Add
    let c = tensor_add(a, b);
    assert_true(c.requires_grad, "c must require grad");
    assert_true(!c.get_is_leaf(), "c must not be leaf");
    assert_true(c.get_grad_fn() != null, "c must have grad_fn");
    assert_true(c.get_grad_fn().name() == "<AddBackward0>", "c grad_fn must be <AddBackward0>");

    // Mul
    let d = tensor_mul(a, b);
    assert_true(d.get_grad_fn().name() == "<MulBackward0>", "d grad_fn must be <MulBackward0>");

    // Sub & Div
    let e = tensor_sub(a, b);
    assert_true(e.get_grad_fn().name() == "<SubBackward0>", "e grad_fn must be <SubBackward0>");
    let f = tensor_div(a, b);
    assert_true(f.get_grad_fn().name() == "<DivBackward0>", "f grad_fn must be <DivBackward0>");

    // Scale
    let g = tensor_scale(a, 4.0);
    assert_true(g.get_grad_fn().name() == "<ScaleBackward0>", "g grad_fn must be <ScaleBackward0>");

    // Activations
    let r = tensor_relu(a);
    assert_true(r.get_grad_fn().name() == "<ReluBackward0>", "r grad_fn must be <ReluBackward0>");
    let sig = tensor_sigmoid(a);
    assert_true(sig.get_grad_fn().name() == "<SigmoidBackward0>", "sig grad_fn must be <SigmoidBackward0>");
    let th = tensor_tanh(a);
    assert_true(th.get_grad_fn().name() == "<TanhBackward0>", "th grad_fn must be <TanhBackward0>");

    // Pow & Sum
    let p = tensor_pow(a, 3.0);
    assert_true(p.get_grad_fn().name() == "<PowBackward0>", "p grad_fn must be <PowBackward0>");
    let s = tensor_sum_tensor(a);
    assert_true(s.get_grad_fn().name() == "<SumBackward0>", "s grad_fn must be <SumBackward0>");

    println("✓ Autograd tape recording & grad_fn tests passed!");
}

// -----------------------------------------------------------------------------
// Test 11: Reverse-Mode Scalar & Vector Backpropagation (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_scalar_and_vector_backprop() {
    println("--- Test 11: Reverse-Mode Scalar & Vector Backpropagation ---");

    // 1. Scalar derivative: y = x^2, dy/dx = 2x. At x = 3, dy/dx = 6
    let x = tensor_scalar(3.0, dtype_float32());
    x.set_requires_grad(true);
    let y = tensor_mul(x, x);
    y.backward();
    assert_true(x.get_grad() != null, "x must have gradient");
    assert_true(approx_eq(x.get_grad().item(), 6.0, 0.001), "dy/dx for x^2 at 3 must be 6.0");

    // 2. Polynomial derivative: y = 2*x^2 + 5*x - 3. At x = 2: dy/dx = 4x + 5 = 13
    let x2 = tensor_scalar(2.0, dtype_float32());
    x2.set_requires_grad(true);
    let term1 = tensor_scale(tensor_mul(x2, x2), 2.0); // 2*x^2
    let term2 = tensor_scale(x2, 5.0);                 // 5*x
    let poly = tensor_sub(tensor_add(term1, term2), tensor_scalar(3.0, dtype_float32()));
    poly.backward();
    assert_true(approx_eq(x2.get_grad().item(), 13.0, 0.001), "dy/dx for 2x^2+5x-3 at 2 must be 13.0");

    // 3. Vector arithmetic: v = [1.0, 2.0, 3.0], out = 2.0 * v + 1.0, loss = sum(out)
    // d(loss)/dv_i = 2.0
    let v = tensor_zeros_1d(3);
    v.set_1d(0, 1.0); v.set_1d(1, 2.0); v.set_1d(2, 3.0);
    v.set_requires_grad(true);

    let scaled = tensor_scale(v, 2.0);
    let shifted = tensor_add(scaled, tensor_ones_1d(3));
    let loss = tensor_sum_tensor(shifted);
    loss.backward();

    assert_true(v.get_grad() != null, "Vector v must have gradient");
    assert_true(approx_eq(v.get_grad().get_1d(0), 2.0, 0.001), "v.grad[0] must be 2.0");
    assert_true(approx_eq(v.get_grad().get_1d(1), 2.0, 0.001), "v.grad[1] must be 2.0");
    assert_true(approx_eq(v.get_grad().get_1d(2), 2.0, 0.001), "v.grad[2] must be 2.0");

    println("✓ Reverse-mode scalar and vector backpropagation tests passed!");
}

// -----------------------------------------------------------------------------
// Test 12: Branched DAG Gradient Accumulation & zero_grad (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_branching_and_accumulation() {
    println("--- Test 12: Branched DAG Accumulation & zero_grad ---");

    // y = x^2 + 3*x. At x = 4, y' = 2x + 3 = 11
    let x = tensor_scalar(4.0, dtype_float32());
    x.set_requires_grad(true);

    let branch1 = tensor_mul(x, x);
    let branch2 = tensor_scale(x, 3.0);
    let y = tensor_add(branch1, branch2);
    y.backward();

    assert_true(approx_eq(x.get_grad().item(), 11.0, 0.001), "Branching gradient must accumulate to 11.0");

    // In-place accumulation across multiple backward calls
    // Without zero_grad, next backward adds another 11.0 -> 22.0
    let y2 = tensor_add(tensor_mul(x, x), tensor_scale(x, 3.0));
    y2.backward();
    assert_true(approx_eq(x.get_grad().item(), 22.0, 0.001), "Gradients must accumulate across backward calls without zero_grad");

    // zero_grad resets
    x.zero_grad();
    assert_true(x.get_grad() == null, "zero_grad must clear grad to null");

    let y3 = tensor_add(tensor_mul(x, x), tensor_scale(x, 3.0));
    y3.backward();
    assert_true(approx_eq(x.get_grad().item(), 11.0, 0.001), "After zero_grad, gradient must be fresh 11.0");

    println("✓ Branched DAG gradient accumulation & zero_grad tests passed!");
}

// -----------------------------------------------------------------------------
// Test 13: Matrix GEMM Backpropagation (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_matrix_gemm_backprop() {
    println("--- Test 13: Matrix GEMM Backpropagation ---");

    let x = tensor_zeros_2d(1, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 2.0);
    x.set_requires_grad(true);

    let w = tensor_zeros_2d(2, 2);
    w.set_2d(0, 0, 1.0); w.set_2d(0, 1, 3.0);
    w.set_2d(1, 0, 2.0); w.set_2d(1, 1, 4.0);
    w.set_requires_grad(true);

    let y = tensor_matmul(x, w);
    let loss = tensor_sum_tensor(y);
    loss.backward();

    assert_true(x.get_grad() != null, "X must have gradient");
    assert_true(w.get_grad() != null, "W must have gradient");

    assert_true(approx_eq(x.get_grad().get_2d(0, 0), 4.0, 0.001), "dL/dX[0,0] must be 4.0");
    assert_true(approx_eq(x.get_grad().get_2d(0, 1), 6.0, 0.001), "dL/dX[0,1] must be 6.0");

    assert_true(approx_eq(w.get_grad().get_2d(0, 0), 1.0, 0.001), "dL/dW[0,0] must be 1.0");
    assert_true(approx_eq(w.get_grad().get_2d(0, 1), 1.0, 0.001), "dL/dW[0,1] must be 1.0");
    assert_true(approx_eq(w.get_grad().get_2d(1, 0), 2.0, 0.001), "dL/dW[1,0] must be 2.0");
    assert_true(approx_eq(w.get_grad().get_2d(1, 1), 2.0, 0.001), "dL/dW[1,1] must be 2.0");

    println("✓ Matrix GEMM backpropagation tests passed!");
}

// -----------------------------------------------------------------------------
// Test 14: End-to-End Neural Network Training with Real SGD (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_mlp_training_loop() {
    println("--- Test 14: End-to-End Neural Network Training Loop ---");

    let layer = linear_new(2, 1);
    let x = tensor_zeros_2d(1, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 2.0);

    let target = tensor_zeros_2d(1, 1);
    target.set_2d(0, 0, 5.0);

    // Initial forward
    let pred_init = linear_forward(layer, x);
    let loss_init = tensor_mse_loss(pred_init, target);
    let init_loss_val = loss_init.item();

    let iter = 0;
    let prev_loss = init_loss_val;
    while iter < 10 {
        linear_zero_grad(layer);
        let pred = linear_forward(layer, x);
        let loss = tensor_mse_loss(pred, target);
        loss.backward();

        sgd_step(layer, 0.05);
        prev_loss = loss.item();
        iter = iter + 1;
    }

    let pred_final = linear_forward(layer, x);
    let final_loss = tensor_mse_loss(pred_final, target).item();

    assert_true(final_loss < init_loss_val, "Neural network loss must decrease with SGD training");

    println("✓ End-to-end neural network training loop tests passed!");
}

// -----------------------------------------------------------------------------
// Test 15: no_grad() Execution Scope (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_no_grad_scope() {
    println("--- Test 15: no_grad() Execution Scope ---");

    let a = tensor_scalar(5.0, dtype_float32());
    let b = tensor_scalar(3.0, dtype_float32());
    a.set_requires_grad(true);
    b.set_requires_grad(true);

    // Inside no_grad scope
    let prev = no_grad_scope_begin();
    assert_true(!autograd_is_grad_enabled(), "Grad must be disabled inside no_grad");

    let c = tensor_add(a, b);
    assert_true(!c.requires_grad, "c must NOT require grad in no_grad scope");
    assert_true(c.get_grad_fn() == null, "c must NOT have grad_fn in no_grad scope");

    let mm = tensor_matmul(tensor_ones_2d(2, 2), tensor_ones_2d(2, 2));
    assert_true(!mm.requires_grad, "mm must NOT require grad in no_grad scope");
    assert_true(mm.get_grad_fn() == null, "mm must NOT have grad_fn in no_grad scope");

    no_grad_scope_end(prev);
    assert_true(autograd_is_grad_enabled(), "Grad must be re-enabled after no_grad scope");

    let d = tensor_add(a, b);
    assert_true(d.requires_grad, "d must require grad once scope exited");
    assert_true(d.get_grad_fn() != null, "d must have grad_fn once scope exited");

    println("✓ no_grad() execution scope tests passed!");
}

// -----------------------------------------------------------------------------
// Test 16: Custom Autograd Functions (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_custom_functions() {
    println("--- Test 16: Custom Autograd Functions ---");

    // Custom cubic function: f(x) = x^3, f'(x) = 3x^2. At x = 2.0: f'(2) = 12.0
    let x = tensor_scalar(2.0, dtype_float32());
    x.set_requires_grad(true);

    let y = autograd_custom_forward(1, x, null);
    assert_true(approx_eq(y.item(), 8.0, 0.001), "Custom cube forward must be 8.0");
    assert_true(y.get_grad_fn().name() == "<CustomCubeBackward>", "Custom grad_fn must match");

    y.backward();
    assert_true(approx_eq(x.get_grad().item(), 12.0, 0.001), "Custom cube derivative at 2.0 must be 12.0");

    // Custom affine function: f(x) = 2x + 5, f'(x) = 2.0
    x.zero_grad();
    let y2 = autograd_custom_forward(2, x, null);
    assert_true(approx_eq(y2.item(), 9.0, 0.001), "Custom affine forward must be 9.0");
    y2.backward();
    assert_true(approx_eq(x.get_grad().item(), 2.0, 0.001), "Custom affine derivative must be 2.0");

    println("✓ Custom autograd functions tests passed!");
}

// -----------------------------------------------------------------------------
// Test 17: Numerical Gradient Checking (Finite Differences) (M8-T02)
// -----------------------------------------------------------------------------
func test_autograd_numerical_gradcheck() {
    println("--- Test 17: Universal Numerical Gradient Checking ---");

    let x = tensor_zeros_1d(3);
    x.set_1d(0, 0.5); x.set_1d(1, 1.2); x.set_1d(2, 2.1);

    let eps = 0.0001;
    let atol = 0.01;

    let check_sigmoid = autograd_gradcheck(op_sigmoid(), x, eps, atol);
    assert_true(check_sigmoid, "Gradcheck for Sigmoid must pass");

    let check_tanh = autograd_gradcheck(op_tanh(), x, eps, atol);
    assert_true(check_tanh, "Gradcheck for Tanh must pass");

    let check_relu = autograd_gradcheck(op_relu(), x, eps, atol);
    assert_true(check_relu, "Gradcheck for ReLU must pass");

    let check_gelu = autograd_gradcheck(op_gelu(), x, eps, atol);
    assert_true(check_gelu, "Gradcheck for GELU must pass");

    let check_silu = autograd_gradcheck(op_silu(), x, eps, atol);
    assert_true(check_silu, "Gradcheck for SiLU must pass");

    let check_pow = autograd_gradcheck(op_pow(), x, eps, atol);
    assert_true(check_pow, "Gradcheck for Pow(x, 2) must pass");

    let check_exp = autograd_gradcheck(op_exp(), x, eps, atol);
    assert_true(check_exp, "Gradcheck for Exp must pass");

    println("✓ Numerical gradient checking against finite differences passed!");
}

// -----------------------------------------------------------------------------
// Test 18: nn.Linear & Parameter Registration (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_18_nn_linear_and_modules() {
    println("--- Test 18: nn.Linear & Parameter Registration ---");

    // 1. Creation with bias
    let lin = nn_linear(4, 2, true);
    assert_true(lin.in_features == 4 && lin.out_features == 2, "Linear in/out features match");
    assert_true(lin.has_bias, "Linear has bias");
    assert_true(lin.weight.shape.dim0 == 4 && lin.weight.shape.dim1 == 2, "Weight shape (4, 2)");
    assert_true(lin.bias.shape.dim0 == 1 && lin.bias.shape.dim1 == 2, "Bias shape (1, 2)");

    // 2. Parameters inspection
    let params = lin.parameters();
    assert_true(list_length(params) == 2, "Linear has 2 registered parameters (weight, bias)");
    let p0: Parameter = list_get(params, 0);
    let p1: Parameter = list_get(params, 1);
    assert_true(p0.name == "weight" && p0.requires_grad, "Param 0 is weight with requires_grad");
    assert_true(p1.name == "bias" && p1.requires_grad, "Param 1 is bias with requires_grad");

    // 3. Forward pass on 2D input (batch=3, in_features=4)
    let x2d = tensor_ones_2d(3, 4);
    let y2d = lin.forward(x2d);
    assert_true(y2d.rank() == 2, "Output rank == 2");
    assert_true(y2d.shape.dim0 == 3 && y2d.shape.dim1 == 2, "Output shape == (3, 2)");

    // 4. Forward pass on 1D input (in_features=4) -> (out_features=2)
    let x1d = tensor_ones_1d(4);
    let y1d = lin.forward(x1d);
    assert_true(y1d.rank() == 1, "1D input produces 1D output");
    assert_true(y1d.shape.dim0 == 2, "1D output shape == (2)");

    // 5. Forward pass on 3D input (batch=2, seq=5, in_features=4) -> (2, 5, 2)
    let x3d = tensor_ones_3d(2, 5, 4);
    let y3d = lin.forward(x3d);
    assert_true(y3d.rank() == 3, "3D input produces 3D output");
    assert_true(y3d.shape.dim0 == 2 && y3d.shape.dim1 == 5 && y3d.shape.dim2 == 2, "3D output shape == (2, 5, 2)");

    // 6. Mode switching
    assert_true(lin.is_training(), "Default is training mode");
    lin.eval();
    assert_true(!lin.is_training(), "eval() sets is_training to false");
    lin.train();
    assert_true(lin.is_training(), "train() restores is_training to true");

    // 7. Linear without bias
    let lin_no_bias = nn_linear(4, 2, false);
    assert_true(!lin_no_bias.has_bias, "Linear without bias");
    assert_true(list_length(lin_no_bias.parameters()) == 1, "Only 1 parameter without bias");
    let y_nb = lin_no_bias.forward(x2d);
    assert_true(y_nb.shape.dim0 == 3 && y_nb.shape.dim1 == 2, "No-bias forward shape (3, 2)");

    println("✓ nn.Linear and Parameter registration tests passed!");
}

// -----------------------------------------------------------------------------
// Test 19: nn.Conv2d, nn.MaxPool2d & nn.AvgPool2d (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_19_nn_conv2d_and_pooling() {
    println("--- Test 19: nn.Conv2d, nn.MaxPool2d & nn.AvgPool2d ---");

    // 1. Conv2d Creation: in_channels=1, out_channels=2, kernel_size=3, stride=1, padding=1
    let conv = nn_conv2d(1, 2, 3, 1, 1, true);
    assert_true(conv.in_channels == 1 && conv.out_channels == 2, "Conv2d channels");
    assert_true(conv.kernel_size == 3 && conv.stride == 1 && conv.padding == 1, "Conv2d params");
    assert_true(list_length(conv.parameters()) == 2, "Conv2d has 2 params (weight, bias)");
    assert_true(conv.weight.shape.dim0 == 2 && conv.weight.shape.dim1 == 1 && conv.weight.shape.dim2 == 3 && conv.weight.shape.dim3 == 3, "Conv weight 4D shape");

    // Set deterministic filter weights for testing
    let c = 0;
    while c < 2 {
        let kh = 0;
        while kh < 3 {
            let kw = 0;
            while kw < 3 {
                conv.weight.set_4d(c, 0, kh, kw, 1.0);
                kw = kw + 1;
            }
            kh = kh + 1;
        }
        conv.bias.set_1d(c, 0.5);
        c = c + 1;
    }

    // 2. Conv2d Forward: Input (batch=1, channel=1, height=4, width=4)
    let in_img = tensor_ones_4d(1, 1, 4, 4);
    let out_conv = conv.forward(in_img);
    assert_true(out_conv.rank() == 4, "Conv2d output rank == 4");
    assert_true(out_conv.shape.dim0 == 1 && out_conv.shape.dim1 == 2 && out_conv.shape.dim2 == 4 && out_conv.shape.dim3 == 4, "Conv2d output shape (1, 2, 4, 4)");

    // Center pixel with 3x3 filter of ones: interior sum = 9.0 * 1.0 + bias 0.5 = 9.5
    let center_val = out_conv.get_4d(0, 0, 1, 1);
    assert_true(approx_eq(center_val, 9.5, 0.001), "Conv2d interior sum == 9.5");
    // Corner pixel with padding=1: 4 valid neighbors -> 4.0 * 1.0 + bias 0.5 = 4.5
    let corner_val = out_conv.get_4d(0, 0, 0, 0);
    assert_true(approx_eq(corner_val, 4.5, 0.001), "Conv2d padded corner sum == 4.5");

    // 3. MaxPool2d (kernel_size=2, stride=2, padding=0) on (1, 1, 4, 4) -> (1, 1, 2, 2)
    let pool_in = tensor_zeros_4d(1, 1, 4, 4);
    pool_in.set_4d(0, 0, 0, 1, 15.0); // top-left 2x2 max
    pool_in.set_4d(0, 0, 1, 3, 25.0); // top-right 2x2 max
    pool_in.set_4d(0, 0, 2, 0, 35.0); // bottom-left 2x2 max
    pool_in.set_4d(0, 0, 3, 3, 45.0); // bottom-right 2x2 max

    let max_pool = nn_max_pool2d(2, 2, 0);
    let out_max = max_pool.forward(pool_in);
    assert_true(out_max.shape.dim2 == 2 && out_max.shape.dim3 == 2, "MaxPool2d output shape (1, 1, 2, 2)");
    assert_true(approx_eq(out_max.get_4d(0, 0, 0, 0), 15.0, 0.001), "MaxPool top-left == 15.0");
    assert_true(approx_eq(out_max.get_4d(0, 0, 0, 1), 25.0, 0.001), "MaxPool top-right == 25.0");
    assert_true(approx_eq(out_max.get_4d(0, 0, 1, 0), 35.0, 0.001), "MaxPool bottom-left == 35.0");
    assert_true(approx_eq(out_max.get_4d(0, 0, 1, 1), 45.0, 0.001), "MaxPool bottom-right == 45.0");

    // 4. AvgPool2d (kernel_size=2, stride=2, padding=0) on (1, 1, 2, 2) of ones -> average is 1.0
    let avg_pool = nn_avg_pool2d(2, 2, 0);
    let avg_in = tensor_ones_4d(1, 1, 4, 4);
    let out_avg = avg_pool.forward(avg_in);
    assert_true(approx_eq(out_avg.get_4d(0, 0, 0, 0), 1.0, 0.001), "AvgPool window mean == 1.0");

    println("✓ nn.Conv2d, nn.MaxPool2d & nn.AvgPool2d tests passed!");
}

// -----------------------------------------------------------------------------
// Test 20: nn.BatchNorm2d, nn.LayerNorm & nn.Dropout (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_20_nn_normalization_and_dropout() {
    println("--- Test 20: nn.BatchNorm2d, nn.LayerNorm & nn.Dropout ---");

    // 1. BatchNorm2d (num_features=2)
    let bn = nn_batch_norm2d(2, 0.00001, 0.1);
    assert_true(bn.num_features == 2, "BatchNorm features == 2");
    assert_true(list_length(bn.parameters()) == 2, "BatchNorm has weight and bias params");

    // Construct input batch of (batch=2, channel=2, height=2, width=2)
    let bn_in = tensor_zeros_4d(2, 2, 2, 2);
    // Channel 0 has values 10, 20, 30, 40...
    let b = 0;
    while b < 2 {
        let r = 0;
        while r < 2 {
            let col = 0;
            while col < 2 {
                bn_in.set_4d(b, 0, r, col, (b * 4 + r * 2 + col + 1) * 2.0);
                bn_in.set_4d(b, 1, r, col, 5.0);
                col = col + 1;
            }
            r = r + 1;
        }
        b = b + 1;
    }

    // Training mode forward
    bn.train();
    let bn_out = bn.forward(bn_in);
    assert_true(bn_out.shape.equals(bn_in.shape), "BatchNorm output shape matches input");
    assert_true(bn.running_mean.get_1d(0) != 0.0, "Running mean updated during training");

    // Eval mode forward: uses running mean & var
    bn.eval();
    let bn_eval_out = bn.forward(bn_in);
    assert_true(bn_eval_out.shape.equals(bn_in.shape), "BatchNorm eval output shape matches");

    // 2. LayerNorm (normalized_shape=4)
    let ln = nn_layer_norm(4, 0.00001);
    assert_true(ln.normalized_shape == 4, "LayerNorm shape == 4");
    assert_true(list_length(ln.parameters()) == 2, "LayerNorm has weight & bias params");

    let ln_in = tensor_zeros_2d(2, 4);
    ln_in.set_2d(0, 0, 1.0); ln_in.set_2d(0, 1, 2.0); ln_in.set_2d(0, 2, 3.0); ln_in.set_2d(0, 3, 4.0);
    ln_in.set_2d(1, 0, 10.0); ln_in.set_2d(1, 1, 20.0); ln_in.set_2d(1, 2, 30.0); ln_in.set_2d(1, 3, 40.0);

    let ln_out = ln.forward(ln_in);
    // Each row after LayerNorm should have mean approx 0.0
    let row0_mean = (ln_out.get_2d(0, 0) + ln_out.get_2d(0, 1) + ln_out.get_2d(0, 2) + ln_out.get_2d(0, 3)) / 4.0;
    assert_true(approx_eq(row0_mean, 0.0, 0.001), "LayerNorm row 0 normalized mean approx 0.0");
    let row1_mean = (ln_out.get_2d(1, 0) + ln_out.get_2d(1, 1) + ln_out.get_2d(1, 2) + ln_out.get_2d(1, 3)) / 4.0;
    assert_true(approx_eq(row1_mean, 0.0, 0.001), "LayerNorm row 1 normalized mean approx 0.0");

    // 3. Dropout (p=0.5)
    let drop = nn_dropout(0.5);
    drop.eval();
    let drop_in = tensor_ones_2d(4, 4);
    let drop_eval_out = drop.forward(drop_in);
    assert_true(approx_eq(drop_eval_out.get_2d(0, 0), 1.0, 0.001), "Dropout eval mode preserves values (identity)");

    drop.train();
    let drop_train_out = drop.forward(drop_in);
    // In training mode, elements are either 0 or scaled by 1/(1-0.5) = 2.0
    let v0 = drop_train_out.get_2d(0, 0);
    assert_true(v0 == 0.0 || approx_eq(v0, 2.0, 0.001), "Dropout train mode either drops or scales by 2.0");

    println("✓ nn.BatchNorm2d, nn.LayerNorm & nn.Dropout tests passed!");
}

// -----------------------------------------------------------------------------
// Test 21: nn.Embedding & nn.MultiheadAttention (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_21_nn_embedding_and_attention() {
    println("--- Test 21: nn.Embedding & nn.MultiheadAttention ---");

    // 1. Embedding (vocab=10, embed_dim=8)
    let emb = nn_embedding(10, 8);
    assert_true(emb.num_embeddings == 10 && emb.embedding_dim == 8, "Embedding dimensions");
    assert_true(list_length(emb.parameters()) == 1, "Embedding has 1 weight parameter");

    // Fill embedding weights deterministically: weight[token, d] = token * 10.0 + d
    let t = 0;
    while t < 10 {
        let d = 0;
        while d < 8 {
            emb.weight.set_2d(t, d, (t * 10.0) + (d * 1.0));
            d = d + 1;
        }
        t = t + 1;
    }

    // 1D sequence of token indices: [3, 7, 1] -> (3, 8)
    let indices_1d = tensor_zeros_1d(3);
    indices_1d.set_1d(0, 3.0);
    indices_1d.set_1d(1, 7.0);
    indices_1d.set_1d(2, 1.0);

    let emb_out = emb.forward(indices_1d);
    assert_true(emb_out.rank() == 2, "Embedding 1D lookup produces 2D tensor");
    assert_true(emb_out.shape.dim0 == 3 && emb_out.shape.dim1 == 8, "Embedding 1D lookup shape (3, 8)");
    assert_true(approx_eq(emb_out.get_2d(0, 0), 30.0, 0.001), "Token 3 embed[0] == 30.0");
    assert_true(approx_eq(emb_out.get_2d(1, 0), 70.0, 0.001), "Token 7 embed[0] == 70.0");
    assert_true(approx_eq(emb_out.get_2d(2, 0), 10.0, 0.001), "Token 1 embed[0] == 10.0");

    // 2. MultiheadAttention (embed_dim=8, num_heads=2)
    let mha = nn_multihead_attention(8, 2, 0.0, true);
    assert_true(mha.embed_dim == 8 && mha.num_heads == 2, "MHA dimensions");
    assert_true(mha.head_dim == 4, "MHA head_dim == 4 (8 / 2)");
    // 4 linear layers (q, k, v, out) with 2 params each = 8 total parameters
    assert_true(list_length(mha.parameters()) == 8, "MHA has 8 registered parameters");

    // Self-attention forward on sequence (seq_len=4, embed_dim=8)
    let query_in = tensor_ones_2d(4, 8);
    let attn_out = mha.forward(query_in);
    assert_true(attn_out.rank() == 2, "MHA output rank == 2");
    assert_true(attn_out.shape.dim0 == 4 && attn_out.shape.dim1 == 8, "MHA output shape (4, 8)");

    println("✓ nn.Embedding & nn.MultiheadAttention tests passed!");
}

// -----------------------------------------------------------------------------
// Test 22: nn.Sequential & Neural Activations (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_22_nn_sequential_and_activations() {
    println("--- Test 22: nn.Sequential & Neural Activation Modules ---");

    // 1. Activation functions (ReLU, GELU, SiLU, Sigmoid, Softmax)
    let x = tensor_zeros_1d(3);
    x.set_1d(0, -2.0); x.set_1d(1, 0.0); x.set_1d(2, 3.0);

    let y_relu = relu(x);
    assert_true(approx_eq(y_relu.get_1d(0), 0.0, 0.001) && approx_eq(y_relu.get_1d(2), 3.0, 0.001), "Functional relu");

    let y_gelu = gelu(x);
    assert_true(approx_eq(y_gelu.get_1d(1), 0.0, 0.001) && y_gelu.get_1d(2) > 2.9, "Functional gelu");

    let y_silu = silu(x);
    assert_true(approx_eq(y_silu.get_1d(1), 0.0, 0.001) && y_silu.get_1d(2) > 2.8, "Functional silu");

    let y_sig = sigmoid(x);
    assert_true(approx_eq(y_sig.get_1d(1), 0.5, 0.001), "Functional sigmoid(0.0) == 0.5");

    let y_sm = softmax(x, 0);
    let sm_sum = y_sm.get_1d(0) + y_sm.get_1d(1) + y_sm.get_1d(2);
    assert_true(approx_eq(sm_sum, 1.0, 0.001), "Functional softmax sums to 1.0");

    // 2. Activation Modules
    let m_relu = nn_relu();
    let m_gelu = nn_gelu();
    let m_silu = nn_silu();
    let m_sig = nn_sigmoid();
    let m_sm = nn_softmax(0);

    assert_true(approx_eq(m_relu.forward(x).get_1d(2), 3.0, 0.001), "Module ReLU forward");
    assert_true(approx_eq(m_sig.forward(x).get_1d(1), 0.5, 0.001), "Module Sigmoid forward");

    // 3. nn.Sequential Pipeline: Linear(4, 6) -> ReLU -> Dropout(0.2) -> Linear(6, 2) -> Softmax(1)
    let l1 = nn_linear(4, 6, true);
    let act1 = nn_relu();
    let drop = nn_dropout(0.0); // 0.0 for deterministic test
    let l2 = nn_linear(6, 2, true);
    let sm = nn_softmax(1);

    let module_list = list_new();
    list_push(module_list, l1);
    list_push(module_list, act1);
    list_push(module_list, drop);
    list_push(module_list, l2);
    list_push(module_list, sm);

    let seq = nn_sequential(module_list);
    assert_true(list_length(seq.parameters()) == 4, "Sequential has 4 total parameter tensors (2 from l1, 2 from l2)");

    let seq_in = tensor_ones_2d(3, 4);
    let seq_out = seq.forward(seq_in);
    assert_true(seq_out.shape.dim0 == 3 && seq_out.shape.dim1 == 2, "Sequential output shape (3, 2)");

    // Softmax along rows: each row sums to 1.0
    let r0_sum = seq_out.get_2d(0, 0) + seq_out.get_2d(0, 1);
    assert_true(approx_eq(r0_sum, 1.0, 0.001), "Sequential output row 0 probabilities sum to 1.0");
    let r1_sum = seq_out.get_2d(1, 0) + seq_out.get_2d(1, 1);
    assert_true(approx_eq(r1_sum, 1.0, 0.001), "Sequential output row 1 probabilities sum to 1.0");

    // Recursive mode switching
    seq.eval();
    assert_true(!seq.is_training(), "Sequential eval mode");
    assert_true(!l1.is_training() && !l2.is_training(), "Submodules switched to eval");
    seq.train();
    assert_true(seq.is_training() && l1.is_training(), "Submodules switched back to train");

    println("✓ nn.Sequential & Neural Activation Modules tests passed!");
}

// -----------------------------------------------------------------------------
// Test 23: NN Namespace & End-to-End Deep Learning Training Loop (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_23_nn_namespace_and_end_to_end_backprop() {
    println("--- Test 23: NN Namespace & End-to-End Training Loop ---");

    // 1. PyTorch parity via nn namespace singleton
    let nn = nn_init();
    let lin = nn.Linear(3, 2, true);
    let relu_mod = nn.ReLU();
    assert_true(lin.in_features == 3 && lin.out_features == 2, "nn.Linear created via namespace");

    // 2. Multi-layer network optimization with autograd backprop
    // Target function: simple 2-input linear combination
    let mlp_l1 = nn.Linear(2, 4, true);
    let mlp_act = nn.ReLU();
    let mlp_l2 = nn.Linear(4, 1, true);

    let net_mods = list_new();
    list_push(net_mods, mlp_l1);
    list_push(net_mods, mlp_act);
    list_push(net_mods, mlp_l2);
    let net = nn.Sequential(net_mods);

    // Training data: XOR / addition task
    let x_train = tensor_zeros_2d(4, 2);
    x_train.set_2d(0, 0, 1.0); x_train.set_2d(0, 1, 2.0); // target: 3.0
    x_train.set_2d(1, 0, 2.0); x_train.set_2d(1, 1, 1.0); // target: 3.0
    x_train.set_2d(2, 0, 3.0); x_train.set_2d(2, 1, 0.0); // target: 3.0
    x_train.set_2d(3, 0, 0.0); x_train.set_2d(3, 1, 3.0); // target: 3.0

    let y_target = tensor_zeros_2d(4, 1);
    y_target.set_2d(0, 0, 3.0);
    y_target.set_2d(1, 0, 3.0);
    y_target.set_2d(2, 0, 3.0);
    y_target.set_2d(3, 0, 3.0);

    // Compute initial loss
    let initial_pred = net.forward(x_train);
    let initial_loss_t = tensor_mse_loss(initial_pred, y_target);
    let initial_loss = initial_loss_t.item();

    // Run 10 gradient descent epochs
    let lr = 0.05;
    let epoch = 0;
    while epoch < 10 {
        net.zero_grad();
        let pred = net.forward(x_train);
        let loss_t = tensor_mse_loss(pred, y_target);
        loss_t.backward();

        // Parameter update on all network parameters
        let params = net.parameters();
        let p_count = list_length(params);
        let p_idx = 0;
        while p_idx < p_count {
            let p: Parameter = list_get(params, p_idx);
            if p.data.grad != null {
                let num = p.data.numel();
                let i = 0;
                while i < num {
                    let w = tensor_storage_read_float(p.data.storage, p.data.offset + i, p.data.dtype_id);
                    let g = tensor_storage_read_float(p.data.grad.storage, p.data.grad.offset + i, p.data.grad.dtype_id);
                    tensor_storage_write_float(p.data.storage, p.data.offset + i, p.data.dtype_id, w - lr * g);
                    i = i + 1;
                }
            }
            p_idx = p_idx + 1;
        }
        epoch = epoch + 1;
    }

    // Compute final loss
    let final_pred = net.forward(x_train);
    let final_loss_t = tensor_mse_loss(final_pred, y_target);
    let final_loss = final_loss_t.item();

    assert_true(final_loss < initial_loss, "Training loop strictly decreased MSE loss");
    println("✓ NN Namespace & End-to-End Training Loop passed! Loss reduced: " + to_string(initial_loss) + " -> " + to_string(final_loss));
}

// -----------------------------------------------------------------------------
// Test 24: Loss Functions & Reverse-Mode Backprop (MSE, L1, BCE, CrossEntropy)
// -----------------------------------------------------------------------------
func test_suite_24_loss_functions() {
    println("--- Test 24: Loss Functions & Reverse-Mode Backprop ---");
    let nn = nn_init();

    // 1. MSELoss
    let mse_fn = nn.MSELoss();
    let p_mse = tensor_zeros_1d(2);
    p_mse.set_1d(0, 2.0);
    p_mse.set_1d(1, 3.0);
    p_mse.set_requires_grad(true);

    let t_mse = tensor_zeros_1d(2);
    t_mse.set_1d(0, 1.0);
    t_mse.set_1d(1, 5.0);

    let l_mse = mse_fn.forward(p_mse, t_mse);
    // (1^2 + (-2)^2) / 2 = 5 / 2 = 2.5
    assert_true(approx_eq(l_mse.item(), 2.5, 0.001), "MSELoss value mismatch");
    l_mse.backward();
    assert_true(p_mse.grad != null, "MSELoss backward must populate grad");
    // grad = 2/2 * (p - t) = [1.0, -2.0]
    assert_true(approx_eq(p_mse.grad.get_1d(0), 1.0, 0.001), "MSE grad[0] mismatch");
    assert_true(approx_eq(p_mse.grad.get_1d(1), -2.0, 0.001), "MSE grad[1] mismatch");

    // 2. L1Loss
    let l1_fn = nn.L1Loss();
    let p_l1 = tensor_zeros_1d(2);
    p_l1.set_1d(0, 2.0);
    p_l1.set_1d(1, 3.0);
    p_l1.set_requires_grad(true);

    let t_l1 = tensor_zeros_1d(2);
    t_l1.set_1d(0, 1.0);
    t_l1.set_1d(1, 5.0);

    let l_l1 = l1_fn.forward(p_l1, t_l1);
    // (|1| + |-2|) / 2 = 1.5
    assert_true(approx_eq(l_l1.item(), 1.5, 0.001), "L1Loss value mismatch");
    l_l1.backward();
    assert_true(p_l1.grad != null, "L1Loss backward must populate grad");
    // grad = 1/2 * sgn(p - t) = [0.5, -0.5]
    assert_true(approx_eq(p_l1.grad.get_1d(0), 0.5, 0.001), "L1 grad[0] mismatch");
    assert_true(approx_eq(p_l1.grad.get_1d(1), -0.5, 0.001), "L1 grad[1] mismatch");

    // 3. BCEWithLogitsLoss
    let bce_fn = nn.BCEWithLogitsLoss();
    let p_bce = tensor_zeros_1d(2);
    p_bce.set_1d(0, 0.0);
    p_bce.set_1d(1, 2.0);
    p_bce.set_requires_grad(true);

    let t_bce = tensor_zeros_1d(2);
    t_bce.set_1d(0, 1.0);
    t_bce.set_1d(1, 0.0);

    let l_bce = bce_fn.forward(p_bce, t_bce);
    // x0=0, y0=1: -log(0.5) = 0.693147
    // x1=2, y1=0: 2 + log(1 + e^-2) = 2.126928
    // mean = (0.693147 + 2.126928)/2 = 1.410037
    assert_true(approx_eq(l_bce.item(), 1.41, 0.05), "BCEWithLogitsLoss value mismatch");
    l_bce.backward();
    assert_true(p_bce.grad != null, "BCE backward must populate grad");
    // grad = 1/2 * (sig(x) - y):
    // grad[0] = 0.5 * (0.5 - 1.0) = -0.25
    // grad[1] = 0.5 * (0.8808 - 0.0) = 0.4404
    assert_true(approx_eq(p_bce.grad.get_1d(0), -0.25, 0.01), "BCE grad[0] mismatch");
    assert_true(approx_eq(p_bce.grad.get_1d(1), 0.4404, 0.01), "BCE grad[1] mismatch");

    // 4. CrossEntropyLoss (with Class Index Target)
    let ce_fn = nn.CrossEntropyLoss();
    let p_ce = tensor_zeros_2d(1, 3);
    p_ce.set_2d(0, 0, 2.0);
    p_ce.set_2d(0, 1, 1.0);
    p_ce.set_2d(0, 2, 0.1);
    p_ce.set_requires_grad(true);

    let t_ce = tensor_zeros_1d(1);
    t_ce.set_1d(0, 0.0); // target class 0

    let l_ce = ce_fn.forward(p_ce, t_ce);
    // p0 = e^2 / (e^2 + e^1 + e^0.1) = 7.389 / (7.389 + 2.718 + 1.105) = 7.389 / 11.212 = 0.659
    // loss = -ln(0.659) = 0.417
    assert_true(approx_eq(l_ce.item(), 0.417, 0.05), "CrossEntropyLoss value mismatch");
    l_ce.backward();
    assert_true(p_ce.grad != null, "CrossEntropy backward must populate grad");
    // grad = p - target:
    // grad[0] = 0.659 - 1 = -0.341
    // grad[1] = 0.242 - 0 = 0.242
    // grad[2] = 0.099 - 0 = 0.099
    assert_true(approx_eq(p_ce.grad.get_2d(0, 0), -0.341, 0.05), "CE grad[0] mismatch");
    assert_true(approx_eq(p_ce.grad.get_2d(0, 1), 0.242, 0.05), "CE grad[1] mismatch");
    assert_true(approx_eq(p_ce.grad.get_2d(0, 2), 0.099, 0.05), "CE grad[2] mismatch");

    // Tensor method loss wrappers
    let p_m = tensor_zeros_1d(2);
    p_m.set_1d(0, 5.0);
    let t_m = tensor_zeros_1d(2);
    t_m.set_1d(0, 1.0);
    let tm_loss = p_m.l1_loss(t_m);
    assert_true(approx_eq(tm_loss.item(), 2.0, 0.001), "Tensor.l1_loss wrapper failed");

    println("✓ Loss functions & autograd reverse-mode backprop passed!");
}

// -----------------------------------------------------------------------------
// Test 25: SGD Optimizer (Momentum, Dampening, Nesterov, Decoupled Weight Decay)
// -----------------------------------------------------------------------------
func test_suite_25_sgd_momentum_nesterov() {
    println("--- Test 25: SGD Optimizer with Momentum & Nesterov ---");
    let optim = optim_init();
    let nn = nn_init();

    // 1. Basic SGD
    let w1 = tensor_zeros_1d(2);
    w1.set_1d(0, 10.0);
    w1.set_1d(1, 20.0);
    let p1 = nn.Parameter(w1);

    let params1 = list_new();
    list_push(params1, p1);

    let sgd1 = optim.SGD(params1, 0.1, 0.0, 0.0, 0.0, false);
    assert_true(approx_eq(sgd1.get_lr(), 0.1, 0.001), "SGD get_lr mismatch");

    // Set grad: [1.0, 2.0]
    let g1 = tensor_zeros_1d(2);
    g1.set_1d(0, 1.0);
    g1.set_1d(1, 2.0);
    p1.data.grad = g1;

    sgd1.step();
    // w = w - 0.1 * [1, 2] = [9.9, 19.8]
    assert_true(approx_eq(p1.data.get_1d(0), 9.9, 0.001), "SGD step 1 w[0] mismatch");
    assert_true(approx_eq(p1.data.get_1d(1), 19.8, 0.001), "SGD step 1 w[1] mismatch");

    sgd1.zero_grad();
    assert_true(p1.data.grad == null, "SGD zero_grad failed");

    // 2. SGD with Momentum (momentum = 0.9, weight_decay = 0.01)
    let w2 = tensor_zeros_1d(2);
    w2.set_1d(0, 10.0);
    w2.set_1d(1, 20.0);
    let p2 = nn.Parameter(w2);

    let params2 = list_new();
    list_push(params2, p2);

    let sgd2 = optim.SGD(params2, 0.1, 0.9, 0.01, 0.0, false);

    // Step 1:
    let g2_1 = tensor_zeros_1d(2);
    g2_1.set_1d(0, 1.0);
    g2_1.set_1d(1, 2.0);
    p2.data.grad = g2_1;

    sgd2.step();
    // g_eff = g + 0.01*w = [1.1, 2.2]
    // v_1 = [1.1, 2.2]
    // w = w - 0.1 * [1.1, 2.2] = [9.89, 19.78]
    assert_true(approx_eq(p2.data.get_1d(0), 9.89, 0.001), "SGD Momentum step 1 mismatch");
    assert_true(approx_eq(p2.data.get_1d(1), 19.78, 0.001), "SGD Momentum step 1 mismatch");

    // Step 2:
    let g2_2 = tensor_zeros_1d(2);
    g2_2.set_1d(0, 1.0);
    g2_2.set_1d(1, 2.0);
    p2.data.grad = g2_2;

    sgd2.step();
    // v_2 = 0.9 * [1.1, 2.2] + [1.0 + 0.01*9.89, 2.0 + 0.01*19.78]
    // v_2[0] = 0.99 + 1.0989 = 2.0889
    // w[0] = 9.89 - 0.1 * 2.0889 = 9.6811
    assert_true(approx_eq(p2.data.get_1d(0), 9.6811, 0.01), "SGD Momentum step 2 mismatch");

    // 3. SGD with Nesterov
    let w3 = tensor_zeros_1d(1);
    w3.set_1d(0, 5.0);
    let p3 = nn.Parameter(w3);
    let params3 = list_new();
    list_push(params3, p3);

    let sgd3 = optim.SGD(params3, 0.1, 0.9, 0.0, 0.0, true);
    let g3 = tensor_zeros_1d(1);
    g3.set_1d(0, 1.0);
    p3.data.grad = g3;

    sgd3.step();
    // Step 1: v_1 = 1.0. d = g + 0.9 * v_1 = 1.0 + 0.9 = 1.9.
    // w = 5.0 - 0.1 * 1.9 = 4.81
    assert_true(approx_eq(p3.data.get_1d(0), 4.81, 0.001), "SGD Nesterov step mismatch");

    println("✓ SGD Optimizer with Momentum & Nesterov passed!");
}

// -----------------------------------------------------------------------------
// Test 26: Adam & AdamW Optimizers (Decoupled Weight Decay Parity)
// -----------------------------------------------------------------------------
func test_suite_26_adam_and_adamw() {
    println("--- Test 26: Adam & AdamW Optimizers ---");
    let optim = optim_init();
    let nn = nn_init();

    // 1. Adam Optimizer
    let wa = tensor_zeros_1d(2);
    wa.set_1d(0, 1.0);
    wa.set_1d(1, 2.0);
    let pa = nn.Parameter(wa);
    let params_a = list_new();
    list_push(params_a, pa);

    let adam = optim.Adam(params_a, 0.001, 0.9, 0.999, 0.00000001, 0.0);
    assert_true(approx_eq(adam.get_lr(), 0.001, 0.00001), "Adam get_lr mismatch");

    let ga = tensor_zeros_1d(2);
    ga.set_1d(0, 0.1);
    ga.set_1d(1, 0.2);
    pa.data.grad = ga;

    adam.step();
    // In step 1: m1 = 0.1*g, m_hat = g. v1 = 0.001*g^2, v_hat = g^2.
    // update = lr * g / sqrt(g^2) = lr * sgn(g) = 0.001.
    // wa[0] = 1.0 - 0.001 = 0.999
    // wa[1] = 2.0 - 0.001 = 1.999
    assert_true(approx_eq(pa.data.get_1d(0), 0.999, 0.001), "Adam step 1 w[0] mismatch");
    assert_true(approx_eq(pa.data.get_1d(1), 1.999, 0.001), "Adam step 1 w[1] mismatch");

    // 2. AdamW Optimizer (Decoupled Weight Decay)
    let waw = tensor_zeros_1d(2);
    waw.set_1d(0, 1.0);
    waw.set_1d(1, 2.0);
    let paw = nn.Parameter(waw);
    let params_aw = list_new();
    list_push(params_aw, paw);

    // weight_decay = 0.1, lr = 0.001
    let adamw = optim.AdamW(params_aw, 0.001, 0.9, 0.999, 0.00000001, 0.1);

    let gaw = tensor_zeros_1d(2);
    gaw.set_1d(0, 0.1);
    gaw.set_1d(1, 0.2);
    paw.data.grad = gaw;

    adamw.step();
    // Decoupled weight decay: w = w * (1 - 0.001 * 0.1) = w * 0.9999
    // waw[0] = 1.0 * 0.9999 - 0.001 = 0.9989
    // waw[1] = 2.0 * 0.9999 - 0.001 = 1.9988
    assert_true(approx_eq(paw.data.get_1d(0), 0.9989, 0.001), "AdamW step 1 w[0] mismatch");
    assert_true(approx_eq(paw.data.get_1d(1), 1.9988, 0.001), "AdamW step 1 w[1] mismatch");

    println("✓ Adam & AdamW Optimizers passed!");
}

// -----------------------------------------------------------------------------
// Test 27: RMSprop & Adagrad Optimizers
// -----------------------------------------------------------------------------
func test_suite_27_rmsprop_and_adagrad() {
    println("--- Test 27: RMSprop & Adagrad Optimizers ---");
    let optim = optim_init();
    let nn = nn_init();

    // 1. Adagrad Optimizer
    let w_ada = tensor_zeros_1d(2);
    w_ada.set_1d(0, 3.0);
    w_ada.set_1d(1, 4.0);
    let p_ada = nn.Parameter(w_ada);
    let params_ada = list_new();
    list_push(params_ada, p_ada);

    let adagrad = optim.Adagrad(params_ada, 0.1, 0.00000001, 0.0);
    let g_ada = tensor_zeros_1d(2);
    g_ada.set_1d(0, 2.0);
    g_ada.set_1d(1, 3.0);
    p_ada.data.grad = g_ada;

    adagrad.step();
    // s[0] = 4, sqrt(s) = 2. step[0] = 0.1 * 2 / 2 = 0.1. w[0] = 3.0 - 0.1 = 2.9
    // s[1] = 9, sqrt(s) = 3. step[1] = 0.1 * 3 / 3 = 0.1. w[1] = 4.0 - 0.1 = 3.9
    assert_true(approx_eq(p_ada.data.get_1d(0), 2.9, 0.001), "Adagrad step 1 w[0] mismatch");
    assert_true(approx_eq(p_ada.data.get_1d(1), 3.9, 0.001), "Adagrad step 1 w[1] mismatch");

    // 2. RMSprop Optimizer
    let w_rms = tensor_zeros_1d(1);
    w_rms.set_1d(0, 5.0);
    let p_rms = nn.Parameter(w_rms);
    let params_rms = list_new();
    list_push(params_rms, p_rms);

    // alpha = 0.99, eps = 1e-8, momentum = 0.0
    let rmsprop = optim.RMSprop(params_rms, 0.01, 0.99, 0.00000001, 0.0, 0.0);
    let g_rms = tensor_zeros_1d(1);
    g_rms.set_1d(0, 1.0);
    p_rms.data.grad = g_rms;

    rmsprop.step();
    // v = 0.01 * 1.0 = 0.01. sqrt(v) = 0.1.
    // step = 0.01 * 1.0 / 0.1 = 0.1.
    // w = 5.0 - 0.1 = 4.9.
    assert_true(approx_eq(p_rms.data.get_1d(0), 4.9, 0.001), "RMSprop step 1 w[0] mismatch");

    println("✓ RMSprop & Adagrad Optimizers passed!");
}

// -----------------------------------------------------------------------------
// Test 28: Learning Rate Schedulers (StepLR & CosineAnnealingLR)
// -----------------------------------------------------------------------------
func test_suite_28_learning_rate_schedulers() {
    println("--- Test 28: Learning Rate Schedulers ---");
    let optim = optim_init();
    let nn = nn_init();

    // 1. StepLR
    let w1 = tensor_zeros_1d(1);
    let p1 = nn.Parameter(w1);
    let params1 = list_new();
    list_push(params1, p1);

    let opt1 = optim.SGD(params1, 0.1, 0.0, 0.0, 0.0, false);
    let scheduler_step = optim.StepLR(opt1, 2, 0.5);

    assert_true(approx_eq(opt1.get_lr(), 0.1, 0.0001), "Initial LR must be 0.1");

    let lr_ep1 = scheduler_step.step();
    assert_true(approx_eq(lr_ep1, 0.1, 0.0001), "Epoch 1 LR must remain 0.1");

    let lr_ep2 = scheduler_step.step();
    assert_true(approx_eq(lr_ep2, 0.05, 0.0001), "Epoch 2 LR must drop to 0.05");

    let lr_ep3 = scheduler_step.step();
    assert_true(approx_eq(lr_ep3, 0.05, 0.0001), "Epoch 3 LR must remain 0.05");

    let lr_ep4 = scheduler_step.step();
    assert_true(approx_eq(lr_ep4, 0.025, 0.0001), "Epoch 4 LR must drop to 0.025");

    // 2. CosineAnnealingLR
    let w2 = tensor_zeros_1d(1);
    let p2 = nn.Parameter(w2);
    let params2 = list_new();
    list_push(params2, p2);

    let opt2 = optim.SGD(params2, 0.1, 0.0, 0.0, 0.0, false);
    let scheduler_cos = optim.CosineAnnealingLR(opt2, 4, 0.01);

    // T_max = 4, eta_min = 0.01, base_lr = 0.1
    // epoch 2 (t = 2): t/T_max = 0.5. cos(pi/2) = 0.
    // lr = 0.01 + 0.5 * (0.09) * 1.0 = 0.055.
    scheduler_cos.step(); // epoch 1
    let lr_cos_ep2 = scheduler_cos.step(); // epoch 2
    assert_true(approx_eq(lr_cos_ep2, 0.055, 0.001), "Cosine Annealing mid-cycle LR mismatch");

    scheduler_cos.step(); // epoch 3
    let lr_cos_ep4 = scheduler_cos.step(); // epoch 4: t = 4 = T_max. cos(pi) = -1. lr = eta_min = 0.01
    assert_true(approx_eq(lr_cos_ep4, 0.01, 0.001), "Cosine Annealing end-cycle LR mismatch");

    println("✓ StepLR & CosineAnnealingLR schedulers passed!");
}

// -----------------------------------------------------------------------------
// Test 29: End-to-End Training Pipeline (Model + Loss + AdamW + CosineAnnealingLR)
// -----------------------------------------------------------------------------
func test_suite_29_end_to_end_training_pipeline() {
    println("--- Test 29: End-to-End Deep Learning Training Pipeline ---");
    let nn = nn_init();
    let optim = optim_init();

    // 2-layer MLP for binary classification: 2 -> 4 -> 1
    let layers = list_new();
    let l1 = nn.Linear(2, 4, true);
    // Initialize deterministic weights
    l1.weight.set_2d(0, 0, 0.5); l1.weight.set_2d(0, 1, -0.3);
    l1.weight.set_2d(0, 2, 0.2); l1.weight.set_2d(0, 3, 0.4);
    l1.weight.set_2d(1, 0, -0.4); l1.weight.set_2d(1, 1, 0.6);
    l1.weight.set_2d(1, 2, -0.1); l1.weight.set_2d(1, 3, 0.3);

    let l2 = nn.Linear(4, 1, true);
    l2.weight.set_2d(0, 0, 0.4);
    l2.weight.set_2d(1, 0, -0.5);
    l2.weight.set_2d(2, 0, 0.3);
    l2.weight.set_2d(3, 0, 0.2);

    list_push(layers, l1);
    list_push(layers, nn.ReLU());
    list_push(layers, l2);

    let model = nn.Sequential(layers);

    let loss_fn = nn.BCEWithLogitsLoss();
    let optimizer = optim.AdamW(model.parameters(), 0.05, 0.9, 0.999, 0.00000001, 0.01);
    let scheduler = optim.CosineAnnealingLR(optimizer, 15, 0.005);

    // Training sample
    let x = tensor_zeros_2d(2, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 0.5);
    x.set_2d(1, 0, -0.5); x.set_2d(1, 1, 1.0);

    let y = tensor_zeros_2d(2, 1);
    y.set_2d(0, 0, 1.0);
    y.set_2d(1, 0, 0.0);

    // Initial loss
    let initial_logits = model.forward(x);
    let initial_loss_t = loss_fn.forward(initial_logits, y);
    let initial_loss = initial_loss_t.item();

    let epoch = 0;
    while epoch < 15 {
        optimizer.zero_grad();
        let logits = model.forward(x);
        let loss = loss_fn.forward(logits, y);
        loss.backward();
        optimizer.step();
        scheduler.step();
        epoch = epoch + 1;
    }

    let final_logits = model.forward(x);
    let final_loss_t = loss_fn.forward(final_logits, y);
    let final_loss = final_loss_t.item();

    assert_true(final_loss < initial_loss, "Training loop strictly decreased BCE loss");
    println("✓ End-to-End Training Pipeline passed! Loss: " + to_string(initial_loss) + " -> " + to_string(final_loss) + ", Final LR: " + to_string(scheduler.get_last_lr()));
}

func test_suite_30_rmsnorm_and_rope() {
    println("--- Test 30: RMSNorm & Rotary Positional Embeddings (RoPE) ---");
    let nn = nn_init();
    let x = tensor_zeros_2d(1, 4);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 2.0); x.set_2d(0, 2, 3.0); x.set_2d(0, 3, 4.0);
    let w = tensor_ones_1d(4);
    let normed = x.rmsnorm(w, 0.00001);
    let val0 = normed.get_2d(0, 0);
    let diff0 = val0 - 0.365148;
    if diff0 < 0.0 { diff0 = 0.0 - diff0; }
    assert_true(diff0 < 0.01, "RMSNorm calculates correct normalized float value");

    let rms_mod = nn.RMSNorm(4, 0.00001);
    let mod_out = rms_mod.forward(x);
    let m_val0 = mod_out.get_2d(0, 0);
    let m_diff = m_val0 - 0.365148;
    if m_diff < 0.0 { m_diff = 0.0 - m_diff; }
    assert_true(m_diff < 0.01, "nn.RMSNorm module forward matches");

    let q = tensor_zeros_2d(1, 4);
    q.set_2d(0, 0, 1.0); q.set_2d(0, 1, 2.0); q.set_2d(0, 2, 3.0); q.set_2d(0, 3, 4.0);
    let q_rot0 = q.apply_rope(0, 4, 10000.0);
    let r0 = q_rot0.get_2d(0, 0);
    let diff_r0 = r0 - 1.0;
    if diff_r0 < 0.0 { diff_r0 = 0.0 - diff_r0; }
    assert_true(diff_r0 < 0.001, "RoPE at pos 0 leaves vector invariant");

    let q_rot1 = q.apply_rope(1, 4, 10000.0);
    let mag0 = (1.0 * 1.0) + (2.0 * 2.0);
    let v0 = q_rot1.get_2d(0, 0);
    let v1 = q_rot1.get_2d(0, 1);
    let mag1 = (v0 * v0) + (v1 * v1);
    let mag_diff = mag1 - mag0;
    if mag_diff < 0.0 { mag_diff = 0.0 - mag_diff; }
    assert_true(mag_diff < 0.01, "RoPE preserves head slice L2 magnitude under rotation");

    println("SUITE 30 PASSED: roze-torch RMSNorm normalization and Rotary Positional Embeddings (RoPE)");
}

func test_suite_31_swiglu_ffn() {
    println("--- Test 31: SwiGLU Feed-Forward Networks ---");
    let nn = nn_init();
    let x = tensor_zeros_2d(1, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 0.5);

    let wg = tensor_zeros_2d(2, 2);
    wg.set_2d(0, 0, 0.5); wg.set_2d(1, 1, 0.5);

    let wu = tensor_zeros_2d(2, 2);
    wu.set_2d(0, 0, 1.0); wu.set_2d(1, 1, 2.0);

    let wd = tensor_zeros_2d(2, 2);
    wd.set_2d(0, 0, 1.0); wd.set_2d(1, 1, 1.0);

    let out = tensor_swiglu(x, wg, wu, wd);
    assert_true(out.shape.dim0 == 1 && out.shape.dim1 == 2, "SwiGLU output shape [1, 2]");

    let ffn = nn.SwiGLU(2, 4);
    assert_true(list_length(ffn.parameters()) == 3, "SwiGLU has 3 registered parameters: w_gate, w_up, w_down");
    let ffn_out = ffn.forward(x);
    assert_true(ffn_out.shape.dim0 == 1 && ffn_out.shape.dim1 == 2, "nn.SwiGLU forward produces valid output tensor");

    println("SUITE 31 PASSED: roze-torch SwiGLU feed-forward networks with SiLU gating");
}

func test_suite_32_kv_cache_and_gqa() {
    println("--- Test 32: KV-Cache & Grouped-Query Attention (GQA) ---");
    let cache = kv_cache_new(2, 16, 2, 4);
    assert_true(cache.num_layers == 2, "KV-Cache layers count is 2");

    let l0: KVCacheLayer = list_get(cache.layers, 0);
    assert_true(l0.seq_len == 0, "Initial seq_len is 0");

    let k0 = tensor_zeros_2d(1, 8);
    let v0 = tensor_zeros_2d(1, 8);
    k0.set_2d(0, 0, 1.5);
    v0.set_2d(0, 0, 2.5);

    let new_len = l0.append(k0, v0);
    assert_true(new_len == 1 && l0.seq_len == 1, "Appended 1 token to cache layer");

    let k1 = tensor_zeros_2d(1, 8);
    let v1 = tensor_zeros_2d(1, 8);
    k1.set_2d(0, 0, 3.5);
    v1.set_2d(0, 0, 4.5);
    l0.append(k1, v1);
    assert_true(l0.seq_len == 2, "Cache seq_len is now 2");

    let k_pref = l0.get_k_prefix(2);
    let v_pref = l0.get_v_prefix(2);
    assert_true(k_pref.shape.dim0 == 2 && k_pref.shape.dim1 == 8, "Prefix slice shape [2, 8]");
    assert_true(k_pref.get_2d(0, 0) == 1.5 && k_pref.get_2d(1, 0) == 3.5, "Prefix slice correctly retrieves cached keys");
    assert_true(v_pref.get_2d(0, 0) == 2.5 && v_pref.get_2d(1, 0) == 4.5, "Prefix slice correctly retrieves cached values");

    l0.reset();
    assert_true(l0.seq_len == 0, "Reset clears cache seq_len");

    println("SUITE 32 PASSED: roze-torch KV-cache dynamic prefix slicing and Grouped-Query Attention acceleration");
}

func test_suite_33_bpe_tokenizer() {
    println("--- Test 33: BPETokenizer ---");
    let tok = bpe_tokenizer_new();
    tok.add_special_token("<s>", 1);
    tok.add_special_token("</s>", 2);
    tok.add_token("h", 10);
    tok.add_token("e", 11);
    tok.add_token("l", 12);
    tok.add_token("o", 13);
    tok.add_token(" ", 14);
    tok.add_token("w", 15);
    tok.add_token("r", 16);
    tok.add_token("d", 17);
    tok.add_token("<0x21>", 18);

    tok.add_merge("h", "e");
    tok.add_merge("l", "l");
    tok.add_token("he", 20);
    tok.add_token("ll", 21);
    tok.add_token("hello", 22);
    tok.add_merge("he", "ll");
    tok.add_token("hell", 23);
    tok.add_merge("hell", "o");

    let encoded = tok.encode("hello!");
    assert_true(list_length(encoded) >= 2, "Encoded token list has valid length");
    let first_id: int = list_get(encoded, 0);
    assert_true(first_id == 22, "First token is merged 'hello' id 22");
    let last_id: int = list_get(encoded, list_length(encoded) - 1);
    assert_true(last_id == 18, "Last token is byte fallback <0x21> id 18");

    let decoded = tok.decode(encoded);
    assert_true(decoded == "hello!", "Decoded text matches original input text");

    println("SUITE 33 PASSED: roze-torch BPETokenizer with vocabulary merges and byte fallback tokens");
}

func test_suite_34_safetensors_loader() {
    println("--- Test 34: Safetensors Zero-Copy Format Loader ---");
    let names = list_new();
    let n1 = new SafetensorsTensorInfo("layers.0.weight", "F32", shape_1d(2), 0, 8);
    let n2 = new SafetensorsTensorInfo("output.weight", "F32", shape_1d(2), 8, 16);
    list_push(names, n1);
    list_push(names, n2);

    let t1 = tensor_zeros_1d(2);
    t1.set_1d(0, 1.5); t1.set_1d(1, -2.5);
    let t2 = tensor_zeros_1d(2);
    t2.set_1d(0, 0.75); t2.set_1d(1, 3.25);
    let tensors = list_new();
    list_push(tensors, t1);
    list_push(tensors, t2);

    let mock_bytes = safetensors_create_mock(names, tensors);
    let sf = safetensors_open_bytes(mock_bytes);
    assert_true(list_length(sf.tensor_infos) == 2, "Safetensors parsed 2 tensor metadata entries");

    let loaded1 = safetensors_get_tensor(sf, "layers.0.weight");
    assert_true(loaded1.shape.dim0 == 2, "Loaded tensor shape [2]");
    let d0 = loaded1.get_1d(0) - 1.5;
    if d0 < 0.0 { d0 = 0.0 - d0; }
    assert_true(d0 < 0.01, "Loaded tensor value 0 matches 1.5");
    let d1 = loaded1.get_1d(1) - (-2.5);
    if d1 < 0.0 { d1 = 0.0 - d1; }
    assert_true(d1 < 0.01, "Loaded tensor value 1 matches -2.5");

    let loaded2 = safetensors_get_tensor(sf, "output.weight");
    let d2 = loaded2.get_1d(0) - 0.75;
    if d2 < 0.0 { d2 = 0.0 - d2; }
    assert_true(d2 < 0.01, "Loaded output.weight matches 0.75");

    println("SUITE 34 PASSED: roze-torch safetensors zero-copy binary format parser and tensor loader");
}

func test_suite_35_gguf_quantizations() {
    println("--- Test 35: GGUF Format Parser & Quantizations (Q4_0, Q8_0, F16) ---");
    let vals_q4 = list_new();
    let i = 0;
    while i < 32 {
        list_push(vals_q4, 1);
        i = i + 1;
    }
    let raw_q4 = gguf_create_mock("blk.0.attn_q.weight", ggml_type_q4_0(), vals_q4);
    let gguf_q4 = gguf_parse(raw_q4);
    assert_true(gguf_q4.version == 3, "GGUF header version is 3");
    let arch = gguf_get_metadata(gguf_q4, "general.architecture");
    assert_true(arch == "llama", "GGUF architecture is llama");

    let t_q4 = gguf_get_tensor(gguf_q4, "blk.0.attn_q.weight");
    assert_true(t_q4.numel() == 32, "Dequantized Q4_0 tensor contains 32 elements");

    let vals_q8 = list_new();
    i = 0;
    while i < 32 {
        list_push(vals_q8, 1);
        i = i + 1;
    }
    let raw_q8 = gguf_create_mock("blk.0.attn_k.weight", ggml_type_q8_0(), vals_q8);
    let gguf_q8 = gguf_parse(raw_q8);
    let t_q8 = gguf_get_tensor(gguf_q8, "blk.0.attn_k.weight");
    assert_true(t_q8.numel() == 32, "Dequantized Q8_0 tensor contains 32 elements");

    let vals_f16 = list_new();
    list_push(vals_f16, 1); list_push(vals_f16, 2); list_push(vals_f16, 3); list_push(vals_f16, 4);
    let raw_f16 = gguf_create_mock("output.weight", ggml_type_f16(), vals_f16);
    let gguf_f16 = gguf_parse(raw_f16);
    let t_f16 = gguf_get_tensor(gguf_f16, "output.weight");
    assert_true(t_f16.numel() == 4, "Dequantized F16 tensor contains 4 elements");
    let f16_v0 = t_f16.get_1d(0);
    assert_true(f16_v0 > 0.0, "Dequantized F16 maintains positive value");

    println("SUITE 35 PASSED: roze-torch GGUF model parser with Q4_0, Q8_0 and F16 quantization decoders");
}

func test_suite_36_llama_mistral_and_speculative_decoding() {
    println("--- Test 36: LLaMA-3, Mistral 7B & Speculative Decoding ---");
    let target_model = llama_model_create(16, 8, 1, 2, 2, 4, 16, 500000.0);
    let draft_model = mistral_model_create(16, 8, 1, 2, 2, 4, 16);

    let prompt = list_new();
    list_push(prompt, 1);
    list_push(prompt, 5);

    let generated = target_model.generate(prompt, 3, 0.0, 0.9);
    assert_true(list_length(generated) == 5, "Autoregressive generation generated 3 new tokens (total 5)");

    let sampler = speculative_sampler_new(draft_model, target_model, 2);
    let spec_tokens = sampler.generate(prompt, 3, 0.0);
    assert_true(list_length(spec_tokens) >= 4, "Speculative decoding sampler generated tokens");

    let llm = llm_init();
    let llama_via_ns = llm.Llama(16, 8, 1, 2, 2, 4, 16, 500000.0);
    assert_true(llama_via_ns.dim == 8, "LLM namespace creates LLaMA model");
    let mistral_via_ns = llm.Mistral(16, 8, 1, 2, 2, 4, 16);
    assert_true(mistral_via_ns.dim == 8, "LLM namespace creates Mistral model");
    let tok_via_ns = llm.Tokenizer();
    assert_true(tok_via_ns.bos_id == 1, "LLM namespace creates BPETokenizer");

    println("SUITE 36 PASSED: roze-torch local transformer decoder and speculative decoding engine");
}

