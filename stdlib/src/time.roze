func time_month_september() -> int { return 9; }
func time_month_october() -> int { return 10; }
func time_month_november() -> int { return 11; }
func time_month_december() -> int { return 12; }

func time_day_monday() -> int { return 1; }
func time_day_tuesday() -> int { return 2; }
func time_day_wednesday() -> int { return 3; }
func time_day_thursday() -> int { return 4; }
func time_day_friday() -> int { return 5; }
func time_day_saturday() -> int { return 6; }
