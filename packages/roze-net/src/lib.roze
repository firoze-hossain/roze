}

func sec_scan_scope_allow_cidr(scope: ScanScope, cidr: string) {
    list_push(scope.allowed_cidrs, scope_cidr_new(cidr));
    sec_scan_scope_log(scope, "SCOPE_ALLOW_CIDR", cidr, "CONFIGURED", "Added authorized CIDR boundary");
