// compiler/tests/fixtures/std_torch.roze
//
// M8-T01: Tensor Computation - N-Dimensional Tensor Engine & Vector Arithmetic (roze-torch)
// 1:1 mathematical and architectural parity with NumPy ndarray and PyTorch Tensor.

import "torch";

func assert_true(cond: bool, msg: string) {
    if !cond {
        println("ASSERTION FAILED: " + msg);
    }
}

func approx_eq(a: float, b: float, eps: float) -> bool {
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    return diff <= eps;
}

// -----------------------------------------------------------------------------
// Suite 1: Shapes & Strides for Arbitrary Ranks (0D to 6D)
// -----------------------------------------------------------------------------
func test_suite_1_shapes_and_strides() {
    // 0D Scalar
    let s0 = shape_0d();
    assert_true(s0.rank == 0, "0D rank == 0");
    assert_true(s0.numel() == 1, "0D numel == 1");
    let t0 = tensor_scalar(42.0, dtype_float32());
    assert_true(t0.rank() == 0, "Scalar rank == 0");
    assert_true(approx_eq(t0.item(), 42.0, 0.001), "Scalar item == 42.0");

    // 1D Vector
    let t1 = tensor_zeros_1d(5);
    assert_true(t1.rank() == 1, "1D rank == 1");
    assert_true(t1.numel() == 5, "1D numel == 5");
    assert_true(t1.is_contiguous(), "1D zeros contiguous");
    t1.set_1d(2, 7.5);
    assert_true(approx_eq(t1.get_1d(2), 7.5, 0.001), "1D get/set");

    // 2D Matrix
    let t2 = tensor_zeros_2d(3, 4);
    assert_true(t2.rank() == 2, "2D rank == 2");
    assert_true(t2.numel() == 12, "2D numel == 12");
    assert_true(t2.strides.s0 == 4 && t2.strides.s1 == 1, "2D strides");
    t2.set_2d(2, 3, 9.25);
    assert_true(approx_eq(t2.get_2d(2, 3), 9.25, 0.001), "2D get/set");

    // 3D Volume
    let t3 = tensor_zeros_3d(2, 3, 4);
    assert_true(t3.rank() == 3, "3D rank == 3");
    assert_true(t3.numel() == 24, "3D numel == 24");
    assert_true(t3.strides.s0 == 12 && t3.strides.s1 == 4 && t3.strides.s2 == 1, "3D strides");
    t3.set_3d(1, 2, 3, 19.5);
    assert_true(approx_eq(t3.get_3d(1, 2, 3), 19.5, 0.001), "3D get/set");

    // 4D, 5D, 6D Tensors
    let t4 = tensor_zeros_4d(2, 3, 2, 2);
    assert_true(t4.rank() == 4 && t4.numel() == 24, "4D rank/numel");
    let t5 = tensor_zeros_5d(2, 2, 2, 2, 2);
    assert_true(t5.rank() == 5 && t5.numel() == 32, "5D rank/numel");
    let t6 = tensor_zeros_6d(2, 1, 2, 1, 2, 2);
    assert_true(t6.rank() == 6 && t6.numel() == 16, "6D rank/numel");

    println("SUITE 1 PASSED: roze-torch N-dimensional shapes and arbitrary ranks (0D to 6D)");
}

// -----------------------------------------------------------------------------
// Suite 2: All 8 Dtypes & Bitwise Half/BFloat Conversions
// -----------------------------------------------------------------------------
func test_suite_2_dtypes() {
    // Float32 & Float64
    let tf32 = tensor_zeros(shape_1d(2), dtype_float32());
    tf32.set_1d(0, 12.34);
    assert_true(approx_eq(tf32.get_1d(0), 12.34, 0.01), "f32 read/write");

    let tf64 = tensor_zeros(shape_1d(2), dtype_float64());
    tf64.set_1d(0, 987654.321);
    assert_true(approx_eq(tf64.get_1d(0), 987654.321, 0.0001), "f64 read/write");

    // Float16 (IEEE 754 half-precision)
    let tf16 = tensor_zeros(shape_1d(3), dtype_float16());
    tf16.set_1d(0, 1.5);
    tf16.set_1d(1, -2.5);
    tf16.set_1d(2, 100.0);
    assert_true(approx_eq(tf16.get_1d(0), 1.5, 0.01), "f16 1.5");
    assert_true(approx_eq(tf16.get_1d(1), -2.5, 0.01), "f16 -2.5");
    assert_true(approx_eq(tf16.get_1d(2), 100.0, 0.1), "f16 100.0");

    // BFloat16
    let tbf16 = tensor_zeros(shape_1d(2), dtype_bfloat16());
    tbf16.set_1d(0, 3.14);
    tbf16.set_1d(1, -42.0);
    assert_true(approx_eq(tbf16.get_1d(0), 3.14, 0.05), "bf16 3.14");
    assert_true(approx_eq(tbf16.get_1d(1), -42.0, 0.1), "bf16 -42.0");

    // Int32 & Int64
    let ti32 = tensor_zeros(shape_1d(2), dtype_int32());
    ti32.set_1d(0, 12345.0);
    ti32.set_1d(1, -6789.0);
    assert_true(ti32.get_1d(0) == 12345.0, "i32 positive");
    assert_true(ti32.get_1d(1) == -6789.0, "i32 negative");

    let ti64 = tensor_zeros(shape_1d(1), dtype_int64());
    ti64.set_1d(0, 1000000.0);
    assert_true(ti64.get_1d(0) == 1000000.0, "i64");

    // UInt8 & Bool
    let tu8 = tensor_zeros(shape_1d(2), dtype_uint8());
    tu8.set_1d(0, 255.0);
    tu8.set_1d(1, 42.0);
    assert_true(tu8.get_1d(0) == 255.0 && tu8.get_1d(1) == 42.0, "u8");

    let tbool = tensor_zeros(shape_1d(2), dtype_bool());
    tbool.set_1d(0, 1.0);
    tbool.set_1d(1, 0.0);
    assert_true(tbool.get_1d(0) == 1.0 && tbool.get_1d(1) == 0.0, "bool");

    println("SUITE 2 PASSED: roze-torch 8 dtypes and IEEE-754 half/bfloat16 precision");
}

// -----------------------------------------------------------------------------
// Suite 3: Strided Slicing with Negative Indices & Steps (Zero-Copy Views)
// -----------------------------------------------------------------------------
func test_suite_3_slicing() {
    let t = tensor_zeros_1d(6);
    let i = 0;
    while i < 6 {
        t.set_1d(i, i * 10.0);
        i = i + 1;
    }

    // Subslice [1:4]
    let s_sub = tensor_slice_1d(t, slice_range(1, 4));
    assert_true(s_sub.numel() == 3, "slice [1:4] numel");
    assert_true(approx_eq(s_sub.get_1d(0), 10.0, 0.001), "slice [1:4] elem 0");
    assert_true(approx_eq(s_sub.get_1d(2), 30.0, 0.001), "slice [1:4] elem 2");

    // Negative indices [-4:-1]
    let s_neg = tensor_slice_1d(t, slice_range(-4, -1));
    assert_true(s_neg.numel() == 3, "slice [-4:-1] numel");
    assert_true(approx_eq(s_neg.get_1d(0), 20.0, 0.001), "slice [-4:-1] elem 0");
    assert_true(approx_eq(s_neg.get_1d(2), 40.0, 0.001), "slice [-4:-1] elem 2");

    // Step slicing [::2]
    let s_step = tensor_slice_1d(t, slice_new(0, 6, 2));
    assert_true(s_step.numel() == 3, "slice [::2] numel");
    assert_true(approx_eq(s_step.get_1d(0), 0.0, 0.001), "slice [::2] elem 0");
    assert_true(approx_eq(s_step.get_1d(2), 40.0, 0.001), "slice [::2] elem 2");

    // Negative step (Reverse slice) [::-1]
    let sl_rev = slice_reverse();
    let s_rev = tensor_slice_1d(t, sl_rev);
    assert_true(s_rev.numel() == 6, "reverse numel");
    assert_true(approx_eq(s_rev.get_1d(0), 50.0, 0.001), "reverse elem 0");
    assert_true(approx_eq(s_rev.get_1d(5), 0.0, 0.001), "reverse elem 5");

    // 2D Slicing: 3x3 matrix subslice [1:3, 0:2] -> 2x2
    let m = tensor_zeros_2d(3, 3);
    m.set_2d(0, 0, 1.0); m.set_2d(0, 1, 2.0); m.set_2d(0, 2, 3.0);
    m.set_2d(1, 0, 4.0); m.set_2d(1, 1, 5.0); m.set_2d(1, 2, 6.0);
    m.set_2d(2, 0, 7.0); m.set_2d(2, 1, 8.0); m.set_2d(2, 2, 9.0);

    let sm = tensor_slice_2d(m, slice_range(1, 3), slice_range(0, 2));
    assert_true(sm.shape.dim0 == 2 && sm.shape.dim1 == 2, "2d slice shape");
    assert_true(approx_eq(sm.get_2d(0, 0), 4.0, 0.001), "sm(0,0)");
    assert_true(approx_eq(sm.get_2d(1, 1), 8.0, 0.001), "sm(1,1)");

    // Select row view
    let r1 = tensor_select(m, 0, 1);
    assert_true(r1.numel() == 3, "select row numel");
    assert_true(approx_eq(r1.get_1d(0), 4.0, 0.001), "r1(0)");

    println("SUITE 3 PASSED: roze-torch zero-copy strided slicing with negative indices and steps");
}

// -----------------------------------------------------------------------------
// Suite 4: Broadcasting Engine & Elementwise Binary Arithmetic
// -----------------------------------------------------------------------------
func test_suite_4_broadcasting() {
    // (2, 3) + (1, 3) broadcasting
    let a = tensor_ones_2d(2, 3);
    let b = tensor_zeros_2d(1, 3);
    b.set_2d(0, 0, 10.0);
    b.set_2d(0, 1, 20.0);
    b.set_2d(0, 2, 30.0);

    let c = tensor_add(a, b);
    assert_true(c.shape.dim0 == 2 && c.shape.dim1 == 3, "broadcast add shape");
    assert_true(approx_eq(c.get_2d(0, 0), 11.0, 0.001), "c(0,0) == 11");
    assert_true(approx_eq(c.get_2d(1, 2), 31.0, 0.001), "c(1,2) == 31");

    // Sub, Scale, Mul, Div
    let sub = tensor_sub(c, a);
    assert_true(approx_eq(sub.get_2d(0, 0), 10.0, 0.001), "sub");

    let scaled = tensor_scale(sub, 2.0);
    assert_true(approx_eq(scaled.get_2d(0, 0), 20.0, 0.001), "scale");

    let mul = tensor_mul(a, b);
    assert_true(approx_eq(mul.get_2d(1, 1), 20.0, 0.001), "mul");

    let div = tensor_div(mul, b);
    assert_true(approx_eq(div.get_2d(1, 1), 1.0, 0.001), "div");

    println("SUITE 4 PASSED: roze-torch NumPy/PyTorch broadcasting semantics and vector arithmetic");
}

// -----------------------------------------------------------------------------
// Suite 5: Transposition, Permutation & Contiguous Re-allocation
// -----------------------------------------------------------------------------
func test_suite_5_transpose_and_contiguous() {
    let a = tensor_zeros_2d(2, 3);
    a.set_2d(0, 0, 1.0); a.set_2d(0, 1, 2.0); a.set_2d(0, 2, 3.0);
    a.set_2d(1, 0, 4.0); a.set_2d(1, 1, 5.0); a.set_2d(1, 2, 6.0);

    let at = tensor_t(a);
    assert_true(at.shape.dim0 == 3 && at.shape.dim1 == 2, "transpose shape");
    assert_true(approx_eq(at.get_2d(0, 0), 1.0, 0.001), "at(0,0)");
    assert_true(approx_eq(at.get_2d(1, 0), 2.0, 0.001), "at(1,0)");
    assert_true(approx_eq(at.get_2d(2, 1), 6.0, 0.001), "at(2,1)");
    assert_true(!at.is_contiguous(), "transposed view non-contiguous");

    let contig = tensor_contiguous(at);
    assert_true(contig.is_contiguous(), "contig copy contiguous");
    assert_true(approx_eq(contig.get_2d(2, 1), 6.0, 0.001), "contig(2,1)");

    let vol = tensor_zeros_3d(2, 3, 4);
    vol.set_3d(1, 2, 3, 99.0);
    let perm = tensor_permute_3d(vol, 2, 0, 1);
    assert_true(perm.shape.dim0 == 4 && perm.shape.dim1 == 2 && perm.shape.dim2 == 3, "permute shape");
    assert_true(approx_eq(perm.get_3d(3, 1, 2), 99.0, 0.001), "permute value");

    println("SUITE 5 PASSED: roze-torch matrix transposition, permutation and contiguous reallocation");
}

// -----------------------------------------------------------------------------
// Suite 6: Shape Transformations (Reshape, Flatten, Squeeze, Unsqueeze)
// -----------------------------------------------------------------------------
func test_suite_6_shape_transformations() {
    let a = tensor_zeros_2d(2, 3);
    a.set_2d(0, 0, 1.0); a.set_2d(0, 1, 2.0); a.set_2d(0, 2, 3.0);
    a.set_2d(1, 0, 4.0); a.set_2d(1, 1, 5.0); a.set_2d(1, 2, 6.0);

    let reshaped = tensor_reshape(a, shape_1d(6));
    assert_true(reshaped.rank() == 1 && reshaped.numel() == 6, "reshape 1D");
    assert_true(approx_eq(reshaped.get_1d(3), 4.0, 0.001), "reshape elem 3");

    let flat = tensor_flatten(a, 0, 1);
    assert_true(flat.rank() == 1 && flat.numel() == 6, "flatten");

    let unsq = tensor_unsqueeze(a, 0);
    assert_true(unsq.rank() == 3 && unsq.shape.dim0 == 1 && unsq.shape.dim1 == 2 && unsq.shape.dim2 == 3, "unsqueeze 0");

    let sq = tensor_squeeze(unsq, 0);
    assert_true(sq.rank() == 2 && sq.shape.dim0 == 2 && sq.shape.dim1 == 3, "squeeze 0");

    println("SUITE 6 PASSED: roze-torch shape transformations (reshape, flatten, squeeze, unsqueeze)");
}

// -----------------------------------------------------------------------------
// Suite 7: Tensor Contraction & Linear Algebra (dot, matmul GEMM, bmm, tensordot)
// -----------------------------------------------------------------------------
func test_suite_7_linear_algebra() {
    // Vector Dot Product
    let v1 = tensor_zeros_1d(3);
    v1.set_1d(0, 1.0); v1.set_1d(1, 2.0); v1.set_1d(2, 3.0);
    let v2 = tensor_zeros_1d(3);
    v2.set_1d(0, 4.0); v2.set_1d(1, 5.0); v2.set_1d(2, 6.0);
    let dot_prod = tensor_dot(v1, v2);
    assert_true(approx_eq(dot_prod, 32.0, 0.001), "dot prod == 32");

    // Matrix Multiplication GEMM: (2, 3) x (3, 2) -> (2, 2)
    let a = tensor_zeros_2d(2, 3);
    a.set_2d(0, 0, 1.0); a.set_2d(0, 1, 2.0); a.set_2d(0, 2, 3.0);
    a.set_2d(1, 0, 4.0); a.set_2d(1, 1, 5.0); a.set_2d(1, 2, 6.0);

    let b = tensor_zeros_2d(3, 2);
    b.set_2d(0, 0, 7.0); b.set_2d(0, 1, 8.0);
    b.set_2d(1, 0, 9.0); b.set_2d(1, 1, 1.0);
    b.set_2d(2, 0, 2.0); b.set_2d(2, 1, 3.0);

    let mm = tensor_matmul(a, b);
    assert_true(mm.shape.dim0 == 2 && mm.shape.dim1 == 2, "matmul shape");
    assert_true(approx_eq(mm.get_2d(0, 0), 31.0, 0.001), "GEMM (0,0)");
    assert_true(approx_eq(mm.get_2d(0, 1), 19.0, 0.001), "GEMM (0,1)");
    assert_true(approx_eq(mm.get_2d(1, 0), 85.0, 0.001), "GEMM (1,0)");
    assert_true(approx_eq(mm.get_2d(1, 1), 55.0, 0.001), "GEMM (1,1)");

    // Batched Matrix Multiply (BMM)
    let b_a = tensor_zeros_3d(2, 2, 3);
    let b_b = tensor_zeros_3d(2, 3, 2);
    let bi = 0;
    while bi < 2 {
        let r = 0;
        while r < 2 {
            let k = 0;
            while k < 3 {
                b_a.set_3d(bi, r, k, a.get_2d(r, k));
                k = k + 1;
            }
            r = r + 1;
        }
        let k2 = 0;
        while k2 < 3 {
            let c = 0;
            while c < 2 {
                b_b.set_3d(bi, k2, c, b.get_2d(k2, c));
                c = c + 1;
            }
            k2 = k2 + 1;
        }
        bi = bi + 1;
    }
    let bmm_out = tensor_bmm(b_a, b_b);
    assert_true(bmm_out.shape.dim0 == 2 && bmm_out.shape.dim1 == 2 && bmm_out.shape.dim2 == 2, "BMM shape");
    assert_true(approx_eq(bmm_out.get_3d(0, 0, 0), 31.0, 0.001), "BMM batch 0");
    assert_true(approx_eq(bmm_out.get_3d(1, 1, 1), 55.0, 0.001), "BMM batch 1");

    let td = tensor_tensordot(a, b, 1);
    assert_true(approx_eq(td.get_2d(0, 0), 31.0, 0.001), "Tensordot (0,0)");

    println("SUITE 7 PASSED: roze-torch tensor contractions (dot, matmul GEMM, bmm, tensordot)");
}

// -----------------------------------------------------------------------------
// Suite 8: Mathematical Reductions & Vector Norms
// -----------------------------------------------------------------------------
func test_suite_8_reductions() {
    let t = tensor_zeros_2d(2, 2);
    t.set_2d(0, 0, 1.0);
    t.set_2d(0, 1, -2.0);
    t.set_2d(1, 0, 3.0);
    t.set_2d(1, 1, -4.0);

    let sum_val = tensor_sum(t);
    assert_true(approx_eq(sum_val, -2.0, 0.001), "Sum == -2");

    let mean_val = tensor_mean(t);
    assert_true(approx_eq(mean_val, -0.5, 0.001), "Mean == -0.5");

    let max_val = tensor_max(t);
    assert_true(approx_eq(max_val, 3.0, 0.001), "Max == 3");

    let min_val = tensor_min(t);
    assert_true(approx_eq(min_val, -4.0, 0.001), "Min == -4");

    let l1 = tensor_norm_l1(t);
    assert_true(approx_eq(l1, 10.0, 0.001), "L1 norm == 10");

    let l2 = tensor_norm_l2(t);
    assert_true(approx_eq(l2, 5.4772, 0.01), "L2 norm");

    let col_sum = tensor_sum_dim(t, 0, false);
    assert_true(col_sum.numel() == 2, "Dim 0 sum length");
    assert_true(approx_eq(col_sum.get_1d(0), 4.0, 0.001), "Col sum 0");
    assert_true(approx_eq(col_sum.get_1d(1), -6.0, 0.001), "Col sum 1");

    println("SUITE 8 PASSED: roze-torch mathematical reductions and L1/L2 vector norms");
}

// -----------------------------------------------------------------------------
// Suite 9: Neural Activations, Layers & Optimization
// -----------------------------------------------------------------------------
func test_suite_9_neural_network() {
    let t = tensor_zeros_1d(3);
    t.set_1d(0, -3.0);
    t.set_1d(1, 0.0);
    t.set_1d(2, 3.0);

    // Activations
    let r = tensor_relu(t);
    assert_true(approx_eq(r.get_1d(0), 0.0, 0.001) && approx_eq(r.get_1d(2), 3.0, 0.001), "ReLU");

    let sig = tensor_sigmoid(t);
    assert_true(approx_eq(sig.get_1d(1), 0.5, 0.01), "Sigmoid");

    let th = tensor_tanh(t);
    assert_true(approx_eq(th.get_1d(1), 0.0, 0.01), "Tanh");

    let gelu_out = tensor_gelu(t);
    assert_true(approx_eq(gelu_out.get_1d(1), 0.0, 0.01), "GELU");

    let silu_out = tensor_silu(t);
    assert_true(approx_eq(silu_out.get_1d(1), 0.0, 0.01), "SiLU");

    let sm = tensor_softmax(t);
    let sm_sum = tensor_sum(sm);
    assert_true(approx_eq(sm_sum, 1.0, 0.01), "Softmax sum == 1.0");

    // Linear Layer Forward Pass
    let layer = linear_new(3, 2);
    let inp = tensor_ones_2d(1, 3);
    let out = linear_forward(layer, inp);
    assert_true(out.shape.dim0 == 1 && out.shape.dim1 == 2, "Linear forward shape");

    let target = tensor_zeros_2d(1, 2);
    let loss = mse_loss(out, target);
    assert_true(loss >= 0.0, "MSE loss >= 0");

    sgd_step(layer, 0.01);

    println("SUITE 9 PASSED: roze-torch neural activations, linear layer and SGD optimizer");
}

// -----------------------------------------------------------------------------
// Suite 10: Dynamic Autograd Tape Recording & GradFn Inspection (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_10_autograd_tape_and_grad_fn() {
    let a = tensor_scalar(2.0, dtype_float32());
    let b = tensor_scalar(3.0, dtype_float32());
    a.set_requires_grad(true);
    b.set_requires_grad(true);

    assert_true(a.get_is_leaf(), "a must be leaf");
    assert_true(b.get_is_leaf(), "b must be leaf");
    assert_true(a.get_grad_fn() == null, "Leaf tensor has null grad_fn");

    let c = tensor_add(a, b);
    assert_true(c.requires_grad, "c requires grad");
    assert_true(!c.get_is_leaf(), "c not leaf");
    assert_true(c.get_grad_fn() != null, "c has grad_fn");
    assert_true(c.get_grad_fn().name() == "<AddBackward0>", "c grad_fn <AddBackward0>");

    let d = tensor_mul(a, b);
    assert_true(d.get_grad_fn().name() == "<MulBackward0>", "d grad_fn <MulBackward0>");

    let e = tensor_sub(a, b);
    assert_true(e.get_grad_fn().name() == "<SubBackward0>", "e grad_fn <SubBackward0>");
    let f = tensor_div(a, b);
    assert_true(f.get_grad_fn().name() == "<DivBackward0>", "f grad_fn <DivBackward0>");

    let g = tensor_scale(a, 4.0);
    assert_true(g.get_grad_fn().name() == "<ScaleBackward0>", "g grad_fn <ScaleBackward0>");

    let r = tensor_relu(a);
    assert_true(r.get_grad_fn().name() == "<ReluBackward0>", "r grad_fn <ReluBackward0>");
    let sig = tensor_sigmoid(a);
    assert_true(sig.get_grad_fn().name() == "<SigmoidBackward0>", "sig grad_fn <SigmoidBackward0>");
    let th = tensor_tanh(a);
    assert_true(th.get_grad_fn().name() == "<TanhBackward0>", "th grad_fn <TanhBackward0>");

    let p = tensor_pow(a, 3.0);
    assert_true(p.get_grad_fn().name() == "<PowBackward0>", "p grad_fn <PowBackward0>");
    let s = tensor_sum_tensor(a);
    assert_true(s.get_grad_fn().name() == "<SumBackward0>", "s grad_fn <SumBackward0>");

    println("SUITE 10 PASSED: roze-torch dynamic autograd tape recording and grad_fn inspection");
}

// -----------------------------------------------------------------------------
// Suite 11: Reverse-Mode Scalar & Vector Automatic Differentiation (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_11_scalar_and_vector_backprop() {
    // 1. Scalar derivative: y = x^2, dy/dx = 2x. At x = 3, dy/dx = 6
    let x = tensor_scalar(3.0, dtype_float32());
    x.set_requires_grad(true);
    let y = tensor_mul(x, x);
    y.backward();
    assert_true(x.get_grad() != null, "x has grad");
    assert_true(approx_eq(x.get_grad().item(), 6.0, 0.001), "dy/dx for x^2 at 3 == 6.0");

    // 2. Polynomial: y = 2*x^2 + 5*x - 3. At x = 2: dy/dx = 4x + 5 = 13
    let x2 = tensor_scalar(2.0, dtype_float32());
    x2.set_requires_grad(true);
    let term1 = tensor_scale(tensor_mul(x2, x2), 2.0);
    let term2 = tensor_scale(x2, 5.0);
    let poly = tensor_sub(tensor_add(term1, term2), tensor_scalar(3.0, dtype_float32()));
    poly.backward();
    assert_true(approx_eq(x2.get_grad().item(), 13.0, 0.001), "dy/dx for 2x^2+5x-3 at 2 == 13.0");

    // 3. Vector arithmetic: v = [1.0, 2.0, 3.0], out = 2.0 * v + 1.0, loss = sum(out)
    let v = tensor_zeros_1d(3);
    v.set_1d(0, 1.0); v.set_1d(1, 2.0); v.set_1d(2, 3.0);
    v.set_requires_grad(true);

    let scaled = tensor_scale(v, 2.0);
    let shifted = tensor_add(scaled, tensor_ones_1d(3));
    let loss = tensor_sum_tensor(shifted);
    loss.backward();

    assert_true(v.get_grad() != null, "Vector v has grad");
    assert_true(approx_eq(v.get_grad().get_1d(0), 2.0, 0.001), "v.grad[0] == 2.0");
    assert_true(approx_eq(v.get_grad().get_1d(1), 2.0, 0.001), "v.grad[1] == 2.0");
    assert_true(approx_eq(v.get_grad().get_1d(2), 2.0, 0.001), "v.grad[2] == 2.0");

    println("SUITE 11 PASSED: roze-torch reverse-mode scalar and vector automatic differentiation");
}

// -----------------------------------------------------------------------------
// Suite 12: Branched DAG Gradient Accumulation & zero_grad (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_12_branching_and_accumulation() {
    let x = tensor_scalar(4.0, dtype_float32());
    x.set_requires_grad(true);

    let branch1 = tensor_mul(x, x);
    let branch2 = tensor_scale(x, 3.0);
    let y = tensor_add(branch1, branch2);
    y.backward();

    assert_true(approx_eq(x.get_grad().item(), 11.0, 0.001), "Branching gradient == 11.0");

    let y2 = tensor_add(tensor_mul(x, x), tensor_scale(x, 3.0));
    y2.backward();
    assert_true(approx_eq(x.get_grad().item(), 22.0, 0.001), "Accumulates without zero_grad == 22.0");

    x.zero_grad();
    assert_true(x.get_grad() == null, "zero_grad resets grad");

    let y3 = tensor_add(tensor_mul(x, x), tensor_scale(x, 3.0));
    y3.backward();
    assert_true(approx_eq(x.get_grad().item(), 11.0, 0.001), "Fresh gradient == 11.0");

    println("SUITE 12 PASSED: roze-torch branched DAG gradient accumulation and zero_grad");
}

// -----------------------------------------------------------------------------
// Suite 13: Matrix GEMM Backpropagation (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_13_matrix_gemm_backprop() {
    let x = tensor_zeros_2d(1, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 2.0);
    x.set_requires_grad(true);

    let w = tensor_zeros_2d(2, 2);
    w.set_2d(0, 0, 1.0); w.set_2d(0, 1, 3.0);
    w.set_2d(1, 0, 2.0); w.set_2d(1, 1, 4.0);
    w.set_requires_grad(true);

    let y = tensor_matmul(x, w);
    let loss = tensor_sum_tensor(y);
    loss.backward();

    assert_true(approx_eq(x.get_grad().get_2d(0, 0), 4.0, 0.001), "dL/dX[0,0] == 4.0");
    assert_true(approx_eq(x.get_grad().get_2d(0, 1), 6.0, 0.001), "dL/dX[0,1] == 6.0");

    assert_true(approx_eq(w.get_grad().get_2d(0, 0), 1.0, 0.001), "dL/dW[0,0] == 1.0");
    assert_true(approx_eq(w.get_grad().get_2d(0, 1), 1.0, 0.001), "dL/dW[0,1] == 1.0");
    assert_true(approx_eq(w.get_grad().get_2d(1, 0), 2.0, 0.001), "dL/dW[1,0] == 2.0");
    assert_true(approx_eq(w.get_grad().get_2d(1, 1), 2.0, 0.001), "dL/dW[1,1] == 2.0");

    println("SUITE 13 PASSED: roze-torch matrix GEMM backward pass and multi-dimensional backpropagation");
}

// -----------------------------------------------------------------------------
// Suite 14: Neural Network Training Loop with Real SGD (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_14_mlp_training_loop() {
    let layer = linear_new(2, 1);
    let x = tensor_zeros_2d(1, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 2.0);

    let target = tensor_zeros_2d(1, 1);
    target.set_2d(0, 0, 5.0);

    let pred_init = linear_forward(layer, x);
    let init_loss_val = tensor_mse_loss(pred_init, target).item();

    let iter = 0;
    while iter < 10 {
        linear_zero_grad(layer);
        let pred = linear_forward(layer, x);
        let loss = tensor_mse_loss(pred, target);
        loss.backward();

        sgd_step(layer, 0.05);
        iter = iter + 1;
    }

    let pred_final = linear_forward(layer, x);
    let final_loss = tensor_mse_loss(pred_final, target).item();

    assert_true(final_loss < init_loss_val, "Neural network loss must decrease with SGD");

    println("SUITE 14 PASSED: roze-torch neural network training loop with in-place gradient accumulation and SGD");
}

// -----------------------------------------------------------------------------
// Suite 15: no_grad() Execution Scope (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_15_no_grad_scope() {
    let a = tensor_scalar(5.0, dtype_float32());
    let b = tensor_scalar(3.0, dtype_float32());
    a.set_requires_grad(true);
    b.set_requires_grad(true);

    let prev = no_grad_scope_begin();
    assert_true(!autograd_is_grad_enabled(), "Disabled in no_grad");

    let c = tensor_add(a, b);
    assert_true(!c.requires_grad, "c no requires_grad");
    assert_true(c.get_grad_fn() == null, "c no grad_fn");

    no_grad_scope_end(prev);
    assert_true(autograd_is_grad_enabled(), "Re-enabled after no_grad");

    let d = tensor_add(a, b);
    assert_true(d.requires_grad, "d requires_grad");
    assert_true(d.get_grad_fn() != null, "d has grad_fn");

    println("SUITE 15 PASSED: roze-torch no_grad execution scopes and dynamic graph isolation");
}

// -----------------------------------------------------------------------------
// Suite 16: Custom Autograd Functions (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_16_custom_functions() {
    let x = tensor_scalar(2.0, dtype_float32());
    x.set_requires_grad(true);

    let y = autograd_custom_forward(1, x, null);
    assert_true(approx_eq(y.item(), 8.0, 0.001), "Cube forward == 8.0");
    y.backward();
    assert_true(approx_eq(x.get_grad().item(), 12.0, 0.001), "Cube deriv == 12.0");

    x.zero_grad();
    let y2 = autograd_custom_forward(2, x, null);
    y2.backward();
    assert_true(approx_eq(x.get_grad().item(), 2.0, 0.001), "Affine deriv == 2.0");

    println("SUITE 16 PASSED: roze-torch custom autograd function definition and dispatch");
}

// -----------------------------------------------------------------------------
// Suite 17: Universal Numerical Gradient Checking (Finite Differences) (M8-T02)
// -----------------------------------------------------------------------------
func test_suite_17_numerical_gradcheck() {
    let x = tensor_zeros_1d(3);
    x.set_1d(0, 0.5); x.set_1d(1, 1.2); x.set_1d(2, 2.1);

    let eps = 0.0001;
    let atol = 0.01;

    let check_sigmoid = autograd_gradcheck(op_sigmoid(), x, eps, atol);
    assert_true(check_sigmoid, "Gradcheck Sigmoid");

    let check_tanh = autograd_gradcheck(op_tanh(), x, eps, atol);
    assert_true(check_tanh, "Gradcheck Tanh");

    let check_relu = autograd_gradcheck(op_relu(), x, eps, atol);
    assert_true(check_relu, "Gradcheck ReLU");

    let check_gelu = autograd_gradcheck(op_gelu(), x, eps, atol);
    assert_true(check_gelu, "Gradcheck GELU");

    let check_silu = autograd_gradcheck(op_silu(), x, eps, atol);
    assert_true(check_silu, "Gradcheck SiLU");

    let check_pow = autograd_gradcheck(op_pow(), x, eps, atol);
    assert_true(check_pow, "Gradcheck Pow");

    let check_exp = autograd_gradcheck(op_exp(), x, eps, atol);
    assert_true(check_exp, "Gradcheck Exp");

    println("SUITE 17 PASSED: roze-torch universal numerical gradient checking against central finite differences");
}

// -----------------------------------------------------------------------------
// Suite 18: nn.Linear & Parameter Registration (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_18_nn_linear() {
    let lin = nn_linear(4, 2, true);
    assert_true(lin.in_features == 4 && lin.out_features == 2, "Linear in/out");
    assert_true(lin.has_bias, "Linear bias flag");
    assert_true(list_length(lin.parameters()) == 2, "Linear parameter count");

    let x2d = tensor_ones_2d(3, 4);
    let y2d = lin.forward(x2d);
    assert_true(y2d.shape.dim0 == 3 && y2d.shape.dim1 == 2, "Linear 2D forward shape");

    let x1d = tensor_ones_1d(4);
    let y1d = lin.forward(x1d);
    assert_true(y1d.shape.dim0 == 2, "Linear 1D forward shape");

    let x3d = tensor_ones_3d(2, 5, 4);
    let y3d = lin.forward(x3d);
    assert_true(y3d.shape.dim0 == 2 && y3d.shape.dim1 == 5 && y3d.shape.dim2 == 2, "Linear 3D forward shape");

    lin.eval();
    assert_true(!lin.is_training(), "Linear eval mode");
    lin.train();
    assert_true(lin.is_training(), "Linear train mode");

    let lin_nb = nn_linear(4, 2, false);
    assert_true(!lin_nb.has_bias && list_length(lin_nb.parameters()) == 1, "Linear without bias");

    println("SUITE 18 PASSED: roze-torch nn.Linear and Parameter registration");
}

// -----------------------------------------------------------------------------
// Suite 19: nn.Conv2d, nn.MaxPool2d & nn.AvgPool2d (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_19_nn_conv_and_pooling() {
    let conv = nn_conv2d(1, 2, 3, 1, 1, true);
    assert_true(conv.in_channels == 1 && conv.out_channels == 2, "Conv2d channels");
    assert_true(list_length(conv.parameters()) == 2, "Conv2d params");

    let c = 0;
    while c < 2 {
        let kh = 0;
        while kh < 3 {
            let kw = 0;
            while kw < 3 {
                conv.weight.set_4d(c, 0, kh, kw, 1.0);
                kw = kw + 1;
            }
            kh = kh + 1;
        }
        conv.bias.set_1d(c, 0.5);
        c = c + 1;
    }

    let in_img = tensor_ones_4d(1, 1, 4, 4);
    let out_conv = conv.forward(in_img);
    assert_true(out_conv.shape.dim0 == 1 && out_conv.shape.dim1 == 2 && out_conv.shape.dim2 == 4 && out_conv.shape.dim3 == 4, "Conv2d output shape");
    assert_true(approx_eq(out_conv.get_4d(0, 0, 1, 1), 9.5, 0.001), "Conv2d center val == 9.5");
    assert_true(approx_eq(out_conv.get_4d(0, 0, 0, 0), 4.5, 0.001), "Conv2d corner val == 4.5");

    let pool_in = tensor_zeros_4d(1, 1, 4, 4);
    pool_in.set_4d(0, 0, 0, 1, 15.0);
    pool_in.set_4d(0, 0, 1, 3, 25.0);
    pool_in.set_4d(0, 0, 2, 0, 35.0);
    pool_in.set_4d(0, 0, 3, 3, 45.0);

    let max_pool = nn_max_pool2d(2, 2, 0);
    let out_max = max_pool.forward(pool_in);
    assert_true(out_max.shape.dim2 == 2 && out_max.shape.dim3 == 2, "MaxPool shape");
    assert_true(approx_eq(out_max.get_4d(0, 0, 0, 0), 15.0, 0.001), "MaxPool (0, 0) == 15.0");
    assert_true(approx_eq(out_max.get_4d(0, 0, 1, 1), 45.0, 0.001), "MaxPool (1, 1) == 45.0");

    let avg_pool = nn_avg_pool2d(2, 2, 0);
    let avg_in = tensor_ones_4d(1, 1, 4, 4);
    let out_avg = avg_pool.forward(avg_in);
    assert_true(approx_eq(out_avg.get_4d(0, 0, 0, 0), 1.0, 0.001), "AvgPool == 1.0");

    println("SUITE 19 PASSED: roze-torch nn.Conv2d, nn.MaxPool2d and nn.AvgPool2d");
}

// -----------------------------------------------------------------------------
// Suite 20: nn.BatchNorm2d, nn.LayerNorm & nn.Dropout (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_20_nn_norm_and_dropout() {
    let bn = nn_batch_norm2d(2, 0.00001, 0.1);
    assert_true(bn.num_features == 2 && list_length(bn.parameters()) == 2, "BatchNorm setup");

    let bn_in = tensor_zeros_4d(2, 2, 2, 2);
    let b = 0;
    while b < 2 {
        let r = 0;
        while r < 2 {
            let col = 0;
            while col < 2 {
                bn_in.set_4d(b, 0, r, col, (b * 4 + r * 2 + col + 1) * 2.0);
                bn_in.set_4d(b, 1, r, col, 5.0);
                col = col + 1;
            }
            r = r + 1;
        }
        b = b + 1;
    }

    bn.train();
    let bn_out = bn.forward(bn_in);
    assert_true(bn_out.shape.equals(bn_in.shape), "BatchNorm train shape");
    assert_true(bn.running_mean.get_1d(0) != 0.0, "BatchNorm running mean updated");

    bn.eval();
    let bn_eval_out = bn.forward(bn_in);
    assert_true(bn_eval_out.shape.equals(bn_in.shape), "BatchNorm eval shape");

    let ln = nn_layer_norm(4, 0.00001);
    let ln_in = tensor_zeros_2d(2, 4);
    ln_in.set_2d(0, 0, 1.0); ln_in.set_2d(0, 1, 2.0); ln_in.set_2d(0, 2, 3.0); ln_in.set_2d(0, 3, 4.0);
    ln_in.set_2d(1, 0, 10.0); ln_in.set_2d(1, 1, 20.0); ln_in.set_2d(1, 2, 30.0); ln_in.set_2d(1, 3, 40.0);

    let ln_out = ln.forward(ln_in);
    let row0_mean = (ln_out.get_2d(0, 0) + ln_out.get_2d(0, 1) + ln_out.get_2d(0, 2) + ln_out.get_2d(0, 3)) / 4.0;
    assert_true(approx_eq(row0_mean, 0.0, 0.001), "LayerNorm normalized mean approx 0.0");

    let drop = nn_dropout(0.5);
    drop.eval();
    let drop_in = tensor_ones_2d(4, 4);
    let drop_eval_out = drop.forward(drop_in);
    assert_true(approx_eq(drop_eval_out.get_2d(0, 0), 1.0, 0.001), "Dropout eval identity");

    println("SUITE 20 PASSED: roze-torch nn.BatchNorm2d, nn.LayerNorm and nn.Dropout");
}

// -----------------------------------------------------------------------------
// Suite 21: nn.Embedding & nn.MultiheadAttention (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_21_nn_embedding_and_attention() {
    let emb = nn_embedding(10, 8);
    assert_true(emb.num_embeddings == 10 && emb.embedding_dim == 8, "Embedding setup");

    let t = 0;
    while t < 10 {
        let d = 0;
        while d < 8 {
            emb.weight.set_2d(t, d, (t * 10.0) + (d * 1.0));
            d = d + 1;
        }
        t = t + 1;
    }

    let indices_1d = tensor_zeros_1d(3);
    indices_1d.set_1d(0, 3.0);
    indices_1d.set_1d(1, 7.0);
    indices_1d.set_1d(2, 1.0);

    let emb_out = emb.forward(indices_1d);
    assert_true(emb_out.shape.dim0 == 3 && emb_out.shape.dim1 == 8, "Embedding out shape (3, 8)");
    assert_true(approx_eq(emb_out.get_2d(0, 0), 30.0, 0.001), "Token 3 embed == 30.0");
    assert_true(approx_eq(emb_out.get_2d(1, 0), 70.0, 0.001), "Token 7 embed == 70.0");

    let mha = nn_multihead_attention(8, 2, 0.0, true);
    assert_true(mha.embed_dim == 8 && mha.num_heads == 2, "MHA setup");
    assert_true(list_length(mha.parameters()) == 8, "MHA param count == 8");

    let query_in = tensor_ones_2d(4, 8);
    let attn_out = mha.forward(query_in);
    assert_true(attn_out.shape.dim0 == 4 && attn_out.shape.dim1 == 8, "MHA out shape (4, 8)");

    println("SUITE 21 PASSED: roze-torch nn.Embedding and nn.MultiheadAttention");
}

// -----------------------------------------------------------------------------
// Suite 22: nn.Sequential & Neural Activations (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_22_nn_sequential_and_activations() {
    let x = tensor_zeros_1d(3);
    x.set_1d(0, -2.0); x.set_1d(1, 0.0); x.set_1d(2, 3.0);

    assert_true(approx_eq(relu(x).get_1d(0), 0.0, 0.001), "relu(-2) == 0");
    assert_true(approx_eq(sigmoid(x).get_1d(1), 0.5, 0.001), "sigmoid(0) == 0.5");
    assert_true(approx_eq(softmax(x, 0).get_1d(0) + softmax(x, 0).get_1d(1) + softmax(x, 0).get_1d(2), 1.0, 0.001), "softmax sums to 1.0");

    let l1 = nn_linear(4, 6, true);
    let act1 = nn_relu();
    let drop = nn_dropout(0.0);
    let l2 = nn_linear(6, 2, true);
    let sm = nn_softmax(1);

    let module_list = list_new();
    list_push(module_list, l1);
    list_push(module_list, act1);
    list_push(module_list, drop);
    list_push(module_list, l2);
    list_push(module_list, sm);

    let seq = nn_sequential(module_list);
    assert_true(list_length(seq.parameters()) == 4, "Sequential param count == 4");

    let seq_in = tensor_ones_2d(3, 4);
    let seq_out = seq.forward(seq_in);
    assert_true(seq_out.shape.dim0 == 3 && seq_out.shape.dim1 == 2, "Sequential out shape (3, 2)");
    let r0_sum = seq_out.get_2d(0, 0) + seq_out.get_2d(0, 1);
    assert_true(approx_eq(r0_sum, 1.0, 0.001), "Sequential row probabilities sum to 1.0");

    seq.eval();
    assert_true(!seq.is_training(), "Sequential eval mode");
    seq.train();
    assert_true(seq.is_training(), "Sequential train mode");

    println("SUITE 22 PASSED: roze-torch nn.Sequential and neural activation modules");
}

// -----------------------------------------------------------------------------
// Suite 23: NN Namespace & End-to-End Deep Learning Training Loop (M8-T03)
// -----------------------------------------------------------------------------
func test_suite_23_nn_namespace_and_training() {
    let nn = nn_init();
    let lin = nn.Linear(3, 2, true);
    assert_true(lin.in_features == 3 && lin.out_features == 2, "nn.Linear via namespace");

    let mlp_l1 = nn.Linear(2, 4, true);
    let mlp_act = nn.ReLU();
    let mlp_l2 = nn.Linear(4, 1, true);

    let net_mods = list_new();
    list_push(net_mods, mlp_l1);
    list_push(net_mods, mlp_act);
    list_push(net_mods, mlp_l2);
    let net = nn.Sequential(net_mods);

    let x_train = tensor_zeros_2d(4, 2);
    x_train.set_2d(0, 0, 1.0); x_train.set_2d(0, 1, 2.0);
    x_train.set_2d(1, 0, 2.0); x_train.set_2d(1, 1, 1.0);
    x_train.set_2d(2, 0, 3.0); x_train.set_2d(2, 1, 0.0);
    x_train.set_2d(3, 0, 0.0); x_train.set_2d(3, 1, 3.0);

    let y_target = tensor_zeros_2d(4, 1);
    y_target.set_2d(0, 0, 3.0);
    y_target.set_2d(1, 0, 3.0);
    y_target.set_2d(2, 0, 3.0);
    y_target.set_2d(3, 0, 3.0);

    let initial_pred = net.forward(x_train);
    let initial_loss_t = tensor_mse_loss(initial_pred, y_target);
    let initial_loss = initial_loss_t.item();

    let lr = 0.05;
    let epoch = 0;
    while epoch < 10 {
        net.zero_grad();
        let pred = net.forward(x_train);
        let loss_t = tensor_mse_loss(pred, y_target);
        loss_t.backward();

        let params = net.parameters();
        let p_count = list_length(params);
        let p_idx = 0;
        while p_idx < p_count {
            let p: Parameter = list_get(params, p_idx);
            if p.data.grad != null {
                let num = p.data.numel();
                let i = 0;
                while i < num {
                    let w = tensor_storage_read_float(p.data.storage, p.data.offset + i, p.data.dtype_id);
                    let g = tensor_storage_read_float(p.data.grad.storage, p.data.grad.offset + i, p.data.grad.dtype_id);
                    tensor_storage_write_float(p.data.storage, p.data.offset + i, p.data.dtype_id, w - lr * g);
                    i = i + 1;
                }
            }
            p_idx = p_idx + 1;
        }
        epoch = epoch + 1;
    }

    let final_pred = net.forward(x_train);
    let final_loss_t = tensor_mse_loss(final_pred, y_target);
    let final_loss = final_loss_t.item();

    assert_true(final_loss < initial_loss, "Loss decreased");
    println("SUITE 23 PASSED: roze-torch nn namespace singleton and end-to-end backpropagation");
}

// -----------------------------------------------------------------------------
// Suite 24: Loss Functions & Reverse-Mode Backprop (MSE, L1, BCE, CrossEntropy)
// -----------------------------------------------------------------------------
func test_suite_24_loss_functions() {
    let nn = nn_init();

    // 1. MSELoss
    let mse_fn = nn.MSELoss();
    let p_mse = tensor_zeros_1d(2);
    p_mse.set_1d(0, 2.0);
    p_mse.set_1d(1, 3.0);
    p_mse.set_requires_grad(true);

    let t_mse = tensor_zeros_1d(2);
    t_mse.set_1d(0, 1.0);
    t_mse.set_1d(1, 5.0);

    let l_mse = mse_fn.forward(p_mse, t_mse);
    assert_true(approx_eq(l_mse.item(), 2.5, 0.001), "MSELoss value mismatch");
    l_mse.backward();
    assert_true(p_mse.grad != null, "MSELoss backward must populate grad");
    assert_true(approx_eq(p_mse.grad.get_1d(0), 1.0, 0.001), "MSE grad[0] mismatch");
    assert_true(approx_eq(p_mse.grad.get_1d(1), -2.0, 0.001), "MSE grad[1] mismatch");

    // 2. L1Loss
    let l1_fn = nn.L1Loss();
    let p_l1 = tensor_zeros_1d(2);
    p_l1.set_1d(0, 2.0);
    p_l1.set_1d(1, 3.0);
    p_l1.set_requires_grad(true);

    let t_l1 = tensor_zeros_1d(2);
    t_l1.set_1d(0, 1.0);
    t_l1.set_1d(1, 5.0);

    let l_l1 = l1_fn.forward(p_l1, t_l1);
    assert_true(approx_eq(l_l1.item(), 1.5, 0.001), "L1Loss value mismatch");
    l_l1.backward();
    assert_true(p_l1.grad != null, "L1Loss backward must populate grad");
    assert_true(approx_eq(p_l1.grad.get_1d(0), 0.5, 0.001), "L1 grad[0] mismatch");
    assert_true(approx_eq(p_l1.grad.get_1d(1), -0.5, 0.001), "L1 grad[1] mismatch");

    // 3. BCEWithLogitsLoss
    let bce_fn = nn.BCEWithLogitsLoss();
    let p_bce = tensor_zeros_1d(2);
    p_bce.set_1d(0, 0.0);
    p_bce.set_1d(1, 2.0);
    p_bce.set_requires_grad(true);

    let t_bce = tensor_zeros_1d(2);
    t_bce.set_1d(0, 1.0);
    t_bce.set_1d(1, 0.0);

    let l_bce = bce_fn.forward(p_bce, t_bce);
    assert_true(approx_eq(l_bce.item(), 1.41, 0.05), "BCEWithLogitsLoss value mismatch");
    l_bce.backward();
    assert_true(p_bce.grad != null, "BCE backward must populate grad");
    assert_true(approx_eq(p_bce.grad.get_1d(0), -0.25, 0.01), "BCE grad[0] mismatch");
    assert_true(approx_eq(p_bce.grad.get_1d(1), 0.4404, 0.01), "BCE grad[1] mismatch");

    // 4. CrossEntropyLoss (with Class Index Target)
    let ce_fn = nn.CrossEntropyLoss();
    let p_ce = tensor_zeros_2d(1, 3);
    p_ce.set_2d(0, 0, 2.0);
    p_ce.set_2d(0, 1, 1.0);
    p_ce.set_2d(0, 2, 0.1);
    p_ce.set_requires_grad(true);

    let t_ce = tensor_zeros_1d(1);
    t_ce.set_1d(0, 0.0);

    let l_ce = ce_fn.forward(p_ce, t_ce);
    assert_true(approx_eq(l_ce.item(), 0.417, 0.05), "CrossEntropyLoss value mismatch");
    l_ce.backward();
    assert_true(p_ce.grad != null, "CrossEntropy backward must populate grad");
    assert_true(approx_eq(p_ce.grad.get_2d(0, 0), -0.341, 0.05), "CE grad[0] mismatch");
    assert_true(approx_eq(p_ce.grad.get_2d(0, 1), 0.242, 0.05), "CE grad[1] mismatch");
    assert_true(approx_eq(p_ce.grad.get_2d(0, 2), 0.099, 0.05), "CE grad[2] mismatch");

    // Tensor method loss wrappers
    let p_m = tensor_zeros_1d(2);
    p_m.set_1d(0, 5.0);
    let t_m = tensor_zeros_1d(2);
    t_m.set_1d(0, 1.0);
    let tm_loss = p_m.l1_loss(t_m);
    assert_true(approx_eq(tm_loss.item(), 2.0, 0.001), "Tensor.l1_loss wrapper failed");

    println("SUITE 24 PASSED: roze-torch numerical loss functions and autograd backpropagation (MSE, L1, BCE, CrossEntropy)");
}

// -----------------------------------------------------------------------------
// Suite 25: SGD Optimizer (Momentum, Dampening, Nesterov, Decoupled Weight Decay)
// -----------------------------------------------------------------------------
func test_suite_25_sgd_momentum_nesterov() {
    let optim = optim_init();
    let nn = nn_init();

    // 1. Basic SGD
    let w1 = tensor_zeros_1d(2);
    w1.set_1d(0, 10.0);
    w1.set_1d(1, 20.0);
    let p1 = nn.Parameter(w1);

    let params1 = list_new();
    list_push(params1, p1);

    let sgd1 = optim.SGD(params1, 0.1, 0.0, 0.0, 0.0, false);
    assert_true(approx_eq(sgd1.get_lr(), 0.1, 0.001), "SGD get_lr mismatch");

    let g1 = tensor_zeros_1d(2);
    g1.set_1d(0, 1.0);
    g1.set_1d(1, 2.0);
    p1.data.grad = g1;

    sgd1.step();
    assert_true(approx_eq(p1.data.get_1d(0), 9.9, 0.001), "SGD step 1 w[0] mismatch");
    assert_true(approx_eq(p1.data.get_1d(1), 19.8, 0.001), "SGD step 1 w[1] mismatch");

    sgd1.zero_grad();
    assert_true(p1.data.grad == null, "SGD zero_grad failed");

    // 2. SGD with Momentum (momentum = 0.9, weight_decay = 0.01)
    let w2 = tensor_zeros_1d(2);
    w2.set_1d(0, 10.0);
    w2.set_1d(1, 20.0);
    let p2 = nn.Parameter(w2);

    let params2 = list_new();
    list_push(params2, p2);

    let sgd2 = optim.SGD(params2, 0.1, 0.9, 0.01, 0.0, false);

    let g2_1 = tensor_zeros_1d(2);
    g2_1.set_1d(0, 1.0);
    g2_1.set_1d(1, 2.0);
    p2.data.grad = g2_1;

    sgd2.step();
    assert_true(approx_eq(p2.data.get_1d(0), 9.89, 0.001), "SGD Momentum step 1 mismatch");
    assert_true(approx_eq(p2.data.get_1d(1), 19.78, 0.001), "SGD Momentum step 1 mismatch");

    let g2_2 = tensor_zeros_1d(2);
    g2_2.set_1d(0, 1.0);
    g2_2.set_1d(1, 2.0);
    p2.data.grad = g2_2;

    sgd2.step();
    assert_true(approx_eq(p2.data.get_1d(0), 9.6811, 0.01), "SGD Momentum step 2 mismatch");

    // 3. SGD with Nesterov
    let w3 = tensor_zeros_1d(1);
    w3.set_1d(0, 5.0);
    let p3 = nn.Parameter(w3);
    let params3 = list_new();
    list_push(params3, p3);

    let sgd3 = optim.SGD(params3, 0.1, 0.9, 0.0, 0.0, true);
    let g3 = tensor_zeros_1d(1);
    g3.set_1d(0, 1.0);
    p3.data.grad = g3;

    sgd3.step();
    assert_true(approx_eq(p3.data.get_1d(0), 4.81, 0.001), "SGD Nesterov step mismatch");

    println("SUITE 25 PASSED: roze-torch SGD optimizer with momentum, dampening, Nesterov and weight decay");
}

// -----------------------------------------------------------------------------
// Suite 26: Adam & AdamW Optimizers (Decoupled Weight Decay Parity)
// -----------------------------------------------------------------------------
func test_suite_26_adam_and_adamw() {
    let optim = optim_init();
    let nn = nn_init();

    // 1. Adam Optimizer
    let wa = tensor_zeros_1d(2);
    wa.set_1d(0, 1.0);
    wa.set_1d(1, 2.0);
    let pa = nn.Parameter(wa);
    let params_a = list_new();
    list_push(params_a, pa);

    let adam = optim.Adam(params_a, 0.001, 0.9, 0.999, 0.00000001, 0.0);
    assert_true(approx_eq(adam.get_lr(), 0.001, 0.00001), "Adam get_lr mismatch");

    let ga = tensor_zeros_1d(2);
    ga.set_1d(0, 0.1);
    ga.set_1d(1, 0.2);
    pa.data.grad = ga;

    adam.step();
    assert_true(approx_eq(pa.data.get_1d(0), 0.999, 0.001), "Adam step 1 w[0] mismatch");
    assert_true(approx_eq(pa.data.get_1d(1), 1.999, 0.001), "Adam step 1 w[1] mismatch");

    // 2. AdamW Optimizer (Decoupled Weight Decay)
    let waw = tensor_zeros_1d(2);
    waw.set_1d(0, 1.0);
    waw.set_1d(1, 2.0);
    let paw = nn.Parameter(waw);
    let params_aw = list_new();
    list_push(params_aw, paw);

    let adamw = optim.AdamW(params_aw, 0.001, 0.9, 0.999, 0.00000001, 0.1);

    let gaw = tensor_zeros_1d(2);
    gaw.set_1d(0, 0.1);
    gaw.set_1d(1, 0.2);
    paw.data.grad = gaw;

    adamw.step();
    assert_true(approx_eq(paw.data.get_1d(0), 0.9989, 0.001), "AdamW step 1 w[0] mismatch");
    assert_true(approx_eq(paw.data.get_1d(1), 1.9988, 0.001), "AdamW step 1 w[1] mismatch");

    println("SUITE 26 PASSED: roze-torch Adam and AdamW optimizers with decoupled weight decay parity");
}

// -----------------------------------------------------------------------------
// Suite 27: RMSprop & Adagrad Optimizers
// -----------------------------------------------------------------------------
func test_suite_27_rmsprop_and_adagrad() {
    let optim = optim_init();
    let nn = nn_init();

    // 1. Adagrad Optimizer
    let w_ada = tensor_zeros_1d(2);
    w_ada.set_1d(0, 3.0);
    w_ada.set_1d(1, 4.0);
    let p_ada = nn.Parameter(w_ada);
    let params_ada = list_new();
    list_push(params_ada, p_ada);

    let adagrad = optim.Adagrad(params_ada, 0.1, 0.00000001, 0.0);
    let g_ada = tensor_zeros_1d(2);
    g_ada.set_1d(0, 2.0);
    g_ada.set_1d(1, 3.0);
    p_ada.data.grad = g_ada;

    adagrad.step();
    assert_true(approx_eq(p_ada.data.get_1d(0), 2.9, 0.001), "Adagrad step 1 w[0] mismatch");
    assert_true(approx_eq(p_ada.data.get_1d(1), 3.9, 0.001), "Adagrad step 1 w[1] mismatch");

    // 2. RMSprop Optimizer
    let w_rms = tensor_zeros_1d(1);
    w_rms.set_1d(0, 5.0);
    let p_rms = nn.Parameter(w_rms);
    let params_rms = list_new();
    list_push(params_rms, p_rms);

    let rmsprop = optim.RMSprop(params_rms, 0.01, 0.99, 0.00000001, 0.0, 0.0);
    let g_rms = tensor_zeros_1d(1);
    g_rms.set_1d(0, 1.0);
    p_rms.data.grad = g_rms;

    rmsprop.step();
    assert_true(approx_eq(p_rms.data.get_1d(0), 4.9, 0.001), "RMSprop step 1 w[0] mismatch");

    println("SUITE 27 PASSED: roze-torch RMSprop and Adagrad adaptive optimizers");
}

// -----------------------------------------------------------------------------
// Suite 28: Learning Rate Schedulers (StepLR & CosineAnnealingLR)
// -----------------------------------------------------------------------------
func test_suite_28_learning_rate_schedulers() {
    let optim = optim_init();
    let nn = nn_init();

    // 1. StepLR
    let w1 = tensor_zeros_1d(1);
    let p1 = nn.Parameter(w1);
    let params1 = list_new();
    list_push(params1, p1);

    let opt1 = optim.SGD(params1, 0.1, 0.0, 0.0, 0.0, false);
    let scheduler_step = optim.StepLR(opt1, 2, 0.5);

    assert_true(approx_eq(opt1.get_lr(), 0.1, 0.0001), "Initial LR must be 0.1");

    let lr_ep1 = scheduler_step.step();
    assert_true(approx_eq(lr_ep1, 0.1, 0.0001), "Epoch 1 LR must remain 0.1");

    let lr_ep2 = scheduler_step.step();
    assert_true(approx_eq(lr_ep2, 0.05, 0.0001), "Epoch 2 LR must drop to 0.05");

    let lr_ep3 = scheduler_step.step();
    assert_true(approx_eq(lr_ep3, 0.05, 0.0001), "Epoch 3 LR must remain 0.05");

    let lr_ep4 = scheduler_step.step();
    assert_true(approx_eq(lr_ep4, 0.025, 0.0001), "Epoch 4 LR must drop to 0.025");

    // 2. CosineAnnealingLR
    let w2 = tensor_zeros_1d(1);
    let p2 = nn.Parameter(w2);
    let params2 = list_new();
    list_push(params2, p2);

    let opt2 = optim.SGD(params2, 0.1, 0.0, 0.0, 0.0, false);
    let scheduler_cos = optim.CosineAnnealingLR(opt2, 4, 0.01);

    scheduler_cos.step();
    let lr_cos_ep2 = scheduler_cos.step();
    assert_true(approx_eq(lr_cos_ep2, 0.055, 0.001), "Cosine Annealing mid-cycle LR mismatch");

    scheduler_cos.step();
    let lr_cos_ep4 = scheduler_cos.step();
    assert_true(approx_eq(lr_cos_ep4, 0.01, 0.001), "Cosine Annealing end-cycle LR mismatch");

    println("SUITE 28 PASSED: roze-torch learning rate schedulers (StepLR and CosineAnnealingLR)");
}

// -----------------------------------------------------------------------------
// Suite 29: End-to-End Training Pipeline (Model + Loss + AdamW + CosineAnnealingLR)
// -----------------------------------------------------------------------------
func test_suite_29_end_to_end_training_pipeline() {
    let nn = nn_init();
    let optim = optim_init();

    let layers = list_new();
    let l1 = nn.Linear(2, 4, true);
    l1.weight.set_2d(0, 0, 0.5); l1.weight.set_2d(0, 1, -0.3);
    l1.weight.set_2d(0, 2, 0.2); l1.weight.set_2d(0, 3, 0.4);
    l1.weight.set_2d(1, 0, -0.4); l1.weight.set_2d(1, 1, 0.6);
    l1.weight.set_2d(1, 2, -0.1); l1.weight.set_2d(1, 3, 0.3);

    let l2 = nn.Linear(4, 1, true);
    l2.weight.set_2d(0, 0, 0.4);
    l2.weight.set_2d(1, 0, -0.5);
    l2.weight.set_2d(2, 0, 0.3);
    l2.weight.set_2d(3, 0, 0.2);

    list_push(layers, l1);
    list_push(layers, nn.ReLU());
    list_push(layers, l2);

    let model = nn.Sequential(layers);

    let loss_fn = nn.BCEWithLogitsLoss();
    let optimizer = optim.AdamW(model.parameters(), 0.05, 0.9, 0.999, 0.00000001, 0.01);
    let scheduler = optim.CosineAnnealingLR(optimizer, 15, 0.005);

    let x = tensor_zeros_2d(2, 2);
    x.set_2d(0, 0, 1.0); x.set_2d(0, 1, 0.5);
    x.set_2d(1, 0, -0.5); x.set_2d(1, 1, 1.0);

    let y = tensor_zeros_2d(2, 1);
    y.set_2d(0, 0, 1.0);
    y.set_2d(1, 0, 0.0);

    let initial_logits = model.forward(x);
    let initial_loss_t = loss_fn.forward(initial_logits, y);
    let initial_loss = initial_loss_t.item();

    let epoch = 0;
    while epoch < 15 {
        optimizer.zero_grad();
        let logits = model.forward(x);
        let loss = loss_fn.forward(logits, y);
        loss.backward();
        optimizer.step();
        scheduler.step();
        epoch = epoch + 1;
    }

    let final_logits = model.forward(x);
    let final_loss_t = loss_fn.forward(final_logits, y);
    let final_loss = final_loss_t.item();

    assert_true(final_loss < initial_loss, "Training loop strictly decreased BCE loss");
    println("SUITE 29 PASSED: roze-torch end-to-end training pipeline with model, loss, optimizer and scheduler");
}

