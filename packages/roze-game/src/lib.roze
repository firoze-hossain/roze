// ==============================================================================
// SECTION 1: Mathematics & Primitives (Vector2, Vector3, Color, Rectangle)
// ==============================================================================

class Vector2 {
    x: float,
    y: float
}

func vec2_new(x: float, y: float) -> Vector2 {
    return new Vector2(x, y);
}

func vec2_add(a: Vector2, b: Vector2) -> Vector2 {
    return new Vector2(a.x + b.x, a.y + b.y);
}

func vec2_sub(a: Vector2, b: Vector2) -> Vector2 {
    return new Vector2(a.x - b.x, a.y - b.y);
}

func vec2_scale(a: Vector2, scalar: float) -> Vector2 {
    return new Vector2(a.x * scalar, a.y * scalar);
}

func game_sqrt(x: float) -> float {
    if x <= 0.0 {
        return 0.0;
    }
    let guess = x / 2.0;
    if guess == 0.0 {
        guess = 1.0;
    }
    let iter = 0;
    while iter < 10 {
        guess = (guess + (x / guess)) / 2.0;
        iter = iter + 1;
    }
    return guess;
}

func vec2_length(a: Vector2) -> float {
    return game_sqrt((a.x * a.x) + (a.y * a.y));
}

class Vector3 {
    x: float,
    y: float,
    z: float
}

func vec3_new(x: float, y: float, z: float) -> Vector3 {
    return new Vector3(x, y, z);
}

class Color {
    r: int,
    g: int,
    b: int,
    a: int
}

func color_rgb(r: int, g: int, b: int) -> Color {
    return new Color(r, g, b, 255);
}

func color_rgba(r: int, g: int, b: int, a: int) -> Color {
    return new Color(r, g, b, a);
}

// Builtin Raylib Color Constants
func color_white() -> Color { return new Color(255, 255, 255, 255); }
func color_black() -> Color { return new Color(0, 0, 0, 255); }
func color_red() -> Color { return new Color(230, 41, 55, 255); }
func color_green() -> Color { return new Color(0, 228, 48, 255); }
func color_blue() -> Color { return new Color(0, 121, 241, 255); }
func color_gold() -> Color { return new Color(255, 203, 0, 255); }
func color_darkgray() -> Color { return new Color(80, 80, 80, 255); }
func color_maroon() -> Color { return new Color(190, 33, 55, 255); }

class Rectangle {
    x: float,
    y: float,
    width: float,
    height: float
}

func rect_new(x: float, y: float, w: float, h: float) -> Rectangle {
    return new Rectangle(x, y, w, h);
}

class Camera2D {
    offset: Vector2,
    target: Vector2,
    rotation: float,
    zoom: float
}

func camera2d_new(target: Vector2, offset: Vector2, zoom: float) -> Camera2D {
    return new Camera2D(offset, target, 0.0, zoom);
}

