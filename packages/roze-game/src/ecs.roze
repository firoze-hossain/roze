// Component Getters
func world_has_component(w: World, e: Entity, mask_bit: int) -> bool {
    if !world_is_alive(w, e) { return false; }
    let arch_id: int = list_get(w.entity_archetype_ids, e.id);
    let arch: Archetype = list_get(w.archetypes, arch_id);
    return bit_and(arch.mask, mask_bit) == mask_bit;
}

