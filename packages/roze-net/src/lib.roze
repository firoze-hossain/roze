// 8. TCP
func TCP() -> Packet {
    return TCP_flags(12345, 80, "S");
}
func TCP_ports(sport: int, dport: int) -> Packet {
    return TCP_flags(sport, dport, "S");
}
func TCP_flags(sport: int, dport: int, flags: string) -> Packet {
    let f_mask = tcp_parse_flags(flags);
    return TCP_custom(sport, dport, 1000, 0, f_mask);
}
func TCP_custom(sport: int, dport: int, seq: int, ack: int, flags: int) -> Packet {
    let f_str = tcp_flags_to_string(flags);
    let layer = packet_layer_new(layer_id_tcp(), "TCP", sport, dport, seq, ack, flags, 65535, 0, 0, f_str, "", "", "", "", raw_packet_new(0));
    return packet_from_single_layer(layer);
}

