// stdlib/src/collections.roze
//
// Roze Advanced High-Performance Standard Collections (M2-T03)
// Provides:
//   - VecDeque<T>: Double-ended queue with growable circular ring buffer, O(1) push/pop front/back.
//   - BTreeMap<K, V>: Ordered self-balancing search tree key-value map with logarithmic ops and sorted keys.
//   - BTreeSet<T>: Ordered unique set with logarithmic lookup, insertion, and sorted iteration.
//   - BinaryHeap<T>: Priority queue max-heap with O(log n) push/pop and O(1) peek.
//   - IndexMap<K, V>: Fast hash map preserving insertion order with O(1) key and index-based access.
//   - RingBuffer<T>: Fixed-capacity circular buffer for low-latency streaming and sliding windows.
//   - BitSet: Dense 64-bit word bit vector with population count and bitwise set algebra.
//   - List<T> / Map<K, V>: Built-in dynamic list and hash table.
//
// Full parity with Rust std::collections and Java 25 java.util collections hierarchy.

// ---- VecDeque Factory Functions ----
func new_vec_deque<T>() -> VecDeque<T> {
    return vec_deque_new();
}

func new_vec_deque_with_capacity<T>(cap: int) -> VecDeque<T> {
    return vec_deque_with_capacity(cap);
}

// ---- BTreeMap Factory Functions ----
func new_btree_map<K, V>() -> BTreeMap<K, V> {
    return btree_map_new();
}

// ---- BTreeSet Factory Functions ----
func new_btree_set<T>() -> BTreeSet<T> {
    return btree_set_new();
}

// ---- BinaryHeap Factory Functions ----
func new_binary_heap<T>() -> BinaryHeap<T> {
    return binary_heap_new();
}

// ---- IndexMap Factory Functions ----
func new_index_map<K, V>() -> IndexMap<K, V> {
    return index_map_new();
}

// ---- RingBuffer Factory Functions ----
func new_ring_buffer<T>(capacity: int) -> RingBuffer<T> {
    return ring_buffer_new(capacity);
}

// ---- BitSet Factory Functions ----
func new_bit_set() -> BitSet {
    return bit_set_new();
}

func new_bit_set_with_capacity(cap: int) -> BitSet {
    return bit_set_with_capacity(cap);
}
