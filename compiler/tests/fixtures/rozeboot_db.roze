import "rozeboot";

func main() {
    let ds = datasource_new("jdbc:h2:mem:rozeboot_db;DB_CLOSE_DELAY=-1", 3);

    // Initial pool stats
    let s1 = datasource_stats(ds);
    println(map_get(s1, "active"));

    // Create table & insert data
    datasource_execute(ds, "CREATE TABLE products (id INT AUTO_INCREMENT PRIMARY KEY, title VARCHAR(100), price INT);");
    datasource_execute(ds, "INSERT INTO products (title, price) VALUES ('Roze Book', 49);");
    datasource_execute(ds, "INSERT INTO products (title, price) VALUES ('Roze Keyboard', 129);");

    // Raw query
    let rows = datasource_query(ds, "SELECT title, price FROM products ORDER BY id;");
    println(list_length(rows));
    let first_row = list_get(rows, 0);
    println(map_get(first_row, "title"));
    println(map_get(first_row, "price"));

    // ORM QueryBuilder integration
    let qb = query_table("products");
    let cols = list_new();
    list_push(cols, "title");
    list_push(cols, "price");
    query_select(qb, cols);
    query_where(qb, "title", "=", "Roze Keyboard");

    let match_row = query_first(qb, ds);
    println(map_get(match_row, "title"));
    println(map_get(match_row, "price"));

    datasource_close(ds);
    let s2 = datasource_stats(ds);
    println(map_get(s2, "closed"));
}
