// CIDR Network & IP Matching
func cidr_matches_target(net_ip: Ipv4Address, prefix: int, tgt: Ipv4Address) -> bool {
    if prefix <= 0 { return true; }
    let mut_p = prefix;
    if mut_p > 32 { mut_p = 32; }
    let full_bytes = mut_p / 8;
    let rem_bits = mut_p - (full_bytes * 8);

    if full_bytes >= 1 && net_ip.b0 != tgt.b0 { return false; }
    if full_bytes >= 2 && net_ip.b1 != tgt.b1 { return false; }
    if full_bytes >= 3 && net_ip.b2 != tgt.b2 { return false; }
    if full_bytes >= 4 && net_ip.b3 != tgt.b3 { return false; }

    if rem_bits > 0 {
        let mask = 0;
        if rem_bits == 1 { mask = 128; }
        else if rem_bits == 2 { mask = 192; }
        else if rem_bits == 3 { mask = 224; }
        else if rem_bits == 4 { mask = 240; }
        else if rem_bits == 5 { mask = 248; }
        else if rem_bits == 6 { mask = 252; }
        else if rem_bits == 7 { mask = 254; }

        let net_b = 0;
        let tgt_b = 0;
        if full_bytes == 0 { net_b = net_ip.b0; tgt_b = tgt.b0; }
        else if full_bytes == 1 { net_b = net_ip.b1; tgt_b = tgt.b1; }
        else if full_bytes == 2 { net_b = net_ip.b2; tgt_b = tgt.b2; }
        else if full_bytes == 3 { net_b = net_ip.b3; tgt_b = tgt.b3; }

        if bit_and(net_b, mask) != bit_and(tgt_b, mask) {
            return false;
        }
    }
    return true;
}

func cidr_contains_ip(cidr: string, ip_str: string) -> bool {
    if cidr == ip_str { return true; }
    if ip_str == "::1" || ip_str == "fe80::1" {
        return cidr == ip_str || cidr == "::/0";
    }
    let slash_pos = str_index_of_match(cidr, "/");
    let net_str = cidr;
    let prefix = 32;
    if slash_pos >= 0 {
        net_str = substring(cidr, 0, slash_pos);
        prefix = str_to_int_safe(substring(cidr, slash_pos + 1, string_length(cidr)));
    }
    let net_ip = ipv4_parse(net_str);
    let tgt_ip = ipv4_parse(ip_str);
    return cidr_matches_target(net_ip, prefix, tgt_ip);
}

func sec_scan_scope_is_authorized(scope: ScanScope, ip_str: string) -> bool {
    // Check if explicitly blocked first
    let num_blocked = list_length(scope.blocked_cidrs);
    let mut_b = 0;
    while mut_b < num_blocked {
        let b_rule: ScopeCidr = list_get(scope.blocked_cidrs, mut_b);
        if cidr_contains_ip(b_rule.cidr, ip_str) {
            return false;
        }
        mut_b = mut_b + 1;
    }

    // Check if allowed
    let num_allowed = list_length(scope.allowed_cidrs);
    if num_allowed == 0 {
        // If no allowed list is defined, deny by default (fail-safe)
        return false;
    }
    let mut_a = 0;
    while mut_a < num_allowed {
        let a_rule: ScopeCidr = list_get(scope.allowed_cidrs, mut_a);
        if cidr_contains_ip(a_rule.cidr, ip_str) {
            return true;
        }
        mut_a = mut_a + 1;
    }
    return false;
}

// CIDR Host IP Address Generator
func cidr_expand_ips(cidr_str: string, max_count: int) -> List {
    let out = list_new();
    let slash_pos = str_index_of_match(cidr_str, "/");
    let ip_str = cidr_str;
    let prefix = 32;
    if slash_pos >= 0 {
        ip_str = substring(cidr_str, 0, slash_pos);
        prefix = str_to_int_safe(substring(cidr_str, slash_pos + 1, string_length(cidr_str)));
    }
    if prefix >= 32 {
        list_push(out, target_endpoint_new(ip_str));
        return out;
    }
    let base_ip = ipv4_parse(ip_str);
    let host_count = 1;
    let host_bits = 32 - prefix;
    let mut_h = 0;
    while mut_h < host_bits && host_count < 256 {
        host_count = host_count * 2;
        mut_h = mut_h + 1;
    }
    let usable_hosts = host_count - 2;
    if usable_hosts <= 0 { usable_hosts = 1; }
    if usable_hosts > max_count { usable_hosts = max_count; }

    let mut_k = 1;
    while mut_k <= usable_hosts {
        let b3 = base_ip.b3 + mut_k;
        let b2 = base_ip.b2;
        let b1 = base_ip.b1;
        let b0 = base_ip.b0;
        if b3 >= 256 {
            b2 = b2 + (b3 / 256);
            b3 = b3 % 256;
        }
        let generated_ip = int_to_str(b0) + "." + int_to_str(b1) + "." + int_to_str(b2) + "." + int_to_str(b3);
        list_push(out, target_endpoint_new(generated_ip));
        mut_k = mut_k + 1;
    }
    return out;
}

// Cancellation Token & Safe Emergency Stop
class ScanCancellationToken {
    is_cancelled: bool,
    cancel_reason: string,
    requested_at: int,
}

func sec_scan_cancel_token_new() -> ScanCancellationToken {
    return new ScanCancellationToken(false, "", 0);
}

func sec_scan_cancel(token: ScanCancellationToken, reason: string) {
    token.is_cancelled = true;
    token.cancel_reason = reason;
    token.requested_at = time_now_millis();
}

func sec_scan_is_cancelled(token: ScanCancellationToken) -> bool {
    return token.is_cancelled;
}

// Rate Limiter (Token Bucket Algorithm)
class RateLimiter {
    rate_pps: int,
    tokens: int,
    max_tokens: int,
    last_refill_ms: int,
}

func rate_limiter_new(rate_pps: int) -> RateLimiter {
    let now = time_now_millis();
    return new RateLimiter(rate_pps, rate_pps, rate_pps, now);
}

func rate_limiter_acquire(limiter: RateLimiter) -> bool {
    let now = time_now_millis();
    let delta = now - limiter.last_refill_ms;
    if delta >= 1000 {
        limiter.tokens = limiter.max_tokens;
        limiter.last_refill_ms = now;
    } else if delta > 0 {
        let add = (delta * limiter.rate_pps) / 1000;
        limiter.tokens = limiter.tokens + add;
        if limiter.tokens > limiter.max_tokens {
            limiter.tokens = limiter.max_tokens;
        }
        limiter.last_refill_ms = now;
    }
    if limiter.tokens > 0 {
        limiter.tokens = limiter.tokens - 1;
        return true;
    }
    return false;
}

