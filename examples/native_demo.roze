// examples/native_demo.roze
// Demonstrates the native (Cranelift) backend -- compiles to a real,
// standalone executable, no JVM/JDK involved at all.
// Try it: roze run examples/native_demo.roze --target native
//
// Uses what the native backend supports today: int/bool/string
// functions, arithmetic, string concatenation and equality (under
// ARC -- see docs/MEMORY_MODEL_DECISION.md), if/while/for, and calling
// other functions. Not supported yet: list/map, and every Core/
// Collections/IO/Web/Database intrinsic (JVM-specific today).

func fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func sign(x: int) -> int {
    if x > 0 {
        return 1;
    } else if x < 0 {
        return -1;
    } else {
        return 0;
    }
}

func sum_to(n: int) -> int {
    let total = 0;
    for let i = 1; i <= n; i = i + 1 {
        total = total + i;
    }
    return total;
}

func greet(name: string) -> string {
    return "Hello, " + name + "!";
}

func main() {
    println("Hello from the native backend!");

    println(fib(10));
    println(sign(-5));
    println(sum_to(100));

    let x = 5;
    let y = 10;
    println(x < y && y > 0);
    println(x > y || y > 0);

    let i = 0;
    while i < 3 {
        println(i);
        i = i + 1;
    }

    let greeting = greet("Roze");
    println(greeting);
    println(greeting == "Hello, Roze!");
}
