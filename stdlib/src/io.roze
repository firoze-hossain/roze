// stdlib/src/io.roze
//
// Roze Standard I/O Streams and File Helpers (M4-T04)
// Full architectural parity with Rust std::io and Java 25 java.io / java.nio.file.

import "fs";

// ---- Seek Whence Constants ----
func seek_set() -> int { return 0; }
func seek_start() -> int { return 0; }
func seek_cur() -> int { return 1; }
func seek_current() -> int { return 1; }
func seek_end() -> int { return 2; }

// ---- Standard I/O Streams ----
func stdin_read_line() -> string {
    return fs_stdin_read_line();
}

func stdout_write(s: string) -> int {
    return fs_stdout_write(s);
}

func stdout_flush() -> void {
    fs_stdout_flush();
}

func stderr_write(s: string) -> int {
    return fs_stderr_write(s);
}

func stderr_write_line(s: string) -> int {
    let res = fs_stderr_write(s + "\n");
    fs_stderr_flush();
    return res;
}

func stderr_flush() -> void {
    fs_stderr_flush();
}

func print(s: string) -> void {
    fs_stdout_write(s);
}

func eprint(s: string) -> void {
    fs_stderr_write(s);
}

func eprintln(s: string) -> void {
    fs_stderr_write(s + "\n");
    fs_stderr_flush();
}
