}
func SNMP_Get(community: string, oid: string, req_id: int) -> Packet {
    let layer = packet_layer_new(layer_id_snmp(), "SNMP", 1, 160, req_id, 0, 0, 0, 0, 0, community, oid, "", "", "", raw_packet_new(0)); // 160 = 0xA0 GetRequest
    return packet_from_single_layer(layer);
}
func SNMP_Response(community: string, oid: string, val: string, req_id: int) -> Packet {
    let layer = packet_layer_new(layer_id_snmp(), "SNMP", 1, 162, req_id, 0, 0, 0, 0, 0, community, oid, val, "", "", raw_packet_new(0)); // 162 = 0xA2 Response
    return packet_from_single_layer(layer);
}
func SNMP_custom(version: int, community: string, pdu_type: int, req_id: int, oid: string, val: string) -> Packet {
    let layer = packet_layer_new(layer_id_snmp(), "SNMP", version, pdu_type, req_id, 0, 0, 0, 0, 0, community, oid, val, "", "", raw_packet_new(0));
    return packet_from_single_layer(layer);
}

// 14. HTTP/1.1
func HTTP() -> Packet {
    return HTTP_Get("/", "localhost");
}
