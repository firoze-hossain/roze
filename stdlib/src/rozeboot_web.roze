func h3_frame_goaway() -> int { return 7; }
func h3_frame_max_push_id() -> int { return 13; }

// WebSocket Opcodes (RFC 6455 Section 5.2)
func ws_opcode_continuation() -> int { return 0; }
func ws_opcode_text() -> int { return 1; }
func ws_opcode_binary() -> int { return 2; }
func ws_opcode_close() -> int { return 8; }
func ws_opcode_ping() -> int { return 9; }
func ws_opcode_pong() -> int { return 10; }

