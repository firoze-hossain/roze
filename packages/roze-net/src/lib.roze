// 1. Ethernet II
func Ether() -> Packet {
    return Ether_custom("ff:ff:ff:ff:ff:ff", "00:00:00:00:00:00", 2048); // 0x0800
}
func Ether_macs(dst: string, src: string) -> Packet {
    return Ether_custom(dst, src, 2048);
}
func Ether_custom(dst: string, src: string, ethertype: int) -> Packet {
    let layer = packet_layer_new(layer_id_ether(), "Ether", ethertype, 0, 0, 0, 0, 0, 0, 0, dst, src, "", "", "", raw_packet_new(0));
    return packet_from_single_layer(layer);
}

// 2. 802.1Q VLAN
func Dot1Q() -> Packet {
    return Dot1Q_vlan(1);
}
func Dot1Q_vlan(vlan: int) -> Packet {
    return Dot1Q_custom(vlan, 0, 2048);
}
func Dot1Q_custom(vlan: int, prio: int, ethertype: int) -> Packet {
    let layer = packet_layer_new(layer_id_dot1q(), "Dot1Q", vlan, prio, 33024, ethertype, 0, 0, 0, 0, "", "", "", "", "", raw_packet_new(0)); // 0x8100
    return packet_from_single_layer(layer);
}
func VLAN(vlan: int) -> Packet {
    return Dot1Q_vlan(vlan);
}

