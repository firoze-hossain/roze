// ==============================================================================
// SECTION 3: Environment, Properties & Profile Engine
// ==============================================================================

class PropertyEntry {
    key: string,
    val: string
}

func property_entry_new(k: string, v: string) -> PropertyEntry {
    return new PropertyEntry(k, v);
}

class ProfileEntry {
    name: string
}

func profile_entry_new(name: string) -> ProfileEntry {
    return new ProfileEntry(name);
}

class Environment {
    properties: list, // list of PropertyEntry
    active_profiles: list // list of ProfileEntry
}

func env_new() -> Environment {
    let props = list_new();
    let profs = list_new();
    return new Environment(props, profs);
}

func env_set_property(env: Environment, key: string, val: string) {
    let total = list_length(env.properties);
    let i = 0;
    while i < total {
        let p: PropertyEntry = list_get(env.properties, i);
        if p.key == key {
            p.val = val;
            return;
        }
        i = i + 1;
    }
    list_push(env.properties, new PropertyEntry(key, val));
}

func env_contains_property(env: Environment, key: string) -> bool {
    let total = list_length(env.properties);
    let i = 0;
    while i < total {
        let p: PropertyEntry = list_get(env.properties, i);
        if p.key == key {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func env_get_property(env: Environment, key: string, default_val: string) -> string {
    let total = list_length(env.properties);
    let i = 0;
    while i < total {
        let p: PropertyEntry = list_get(env.properties, i);
        if p.key == key {
            return p.val;
        }
        i = i + 1;
    }
    return default_val;
}

func env_add_active_profile(env: Environment, profile: string) {
    if !env_is_profile_active(env, profile) {
        list_push(env.active_profiles, new ProfileEntry(profile));
    }
}

func env_is_profile_active(env: Environment, profile: string) -> bool {
    let total = list_length(env.active_profiles);
    let i = 0;
    while i < total {
        let p: ProfileEntry = list_get(env.active_profiles, i);
        if p.name == profile {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func env_get_active_profiles(env: Environment) -> list {
    return env.active_profiles;
}

// Resolves ${property.name:default_value} expressions
func env_resolve_placeholders(env: Environment, expr: string) -> string {
    let mut_expr = expr;
    while ioc_str_contains(mut_expr, "${") {
        let start_idx = ioc_str_index_of(mut_expr, "${");
        let end_idx = -1;
        let expr_len = string_length(mut_expr);
        let i = start_idx + 2;
        while i < expr_len {
            let c: int = string_char_at(mut_expr, i);
            if c == 125 { // '}'
                end_idx = i;
                i = expr_len; // break loop
            }
            i = i + 1;
        }

        if end_idx == -1 {
            // Unclosed placeholder, return as is
            return mut_expr;
        }

        let inside = ioc_sub_str(mut_expr, start_idx + 2, end_idx);
        let colon_idx = ioc_str_index_of(inside, ":");
        let key = inside;
        let default_val = "";
        if colon_idx != -1 {
            key = ioc_sub_str(inside, 0, colon_idx);
            default_val = ioc_sub_str(inside, colon_idx + 1, string_length(inside));
        }

        let resolved_val = env_get_property(env, key, default_val);
        let prefix = ioc_sub_str(mut_expr, 0, start_idx);
        let suffix = ioc_sub_str(mut_expr, end_idx + 1, expr_len);
        mut_expr = prefix + resolved_val + suffix;
    }
    return mut_expr;
}

// ==============================================================================
// SECTION 4: Condition Rules & Evaluator
// ==============================================================================

class ConditionRule {
    condition_type: string, // "property", "missing_bean", "on_bean", "profile"
    property_key: string,
    expected_value: string,
    match_if_missing: bool,
    target_identifier: string
}

func cond_on_property(key: string, having_val: string, match_if_missing: bool) -> ConditionRule {
    return new ConditionRule("property", key, having_val, match_if_missing, "");
}

func cond_on_missing_bean(target_id: string) -> ConditionRule {
    return new ConditionRule("missing_bean", "", "", false, target_id);
}

func cond_on_bean(target_id: string) -> ConditionRule {
    return new ConditionRule("on_bean", "", "", false, target_id);
}

func cond_on_profile(profile_name: string) -> ConditionRule {
    return new ConditionRule("profile", "", "", false, profile_name);
}

// ==============================================================================
// SECTION 5: Advanced BeanDefinition Model
// ==============================================================================

class DependencyRef {
    target_bean_name: string,
    field_name: string,
    qualifier: string,
    required: bool
}

func dependency_ref_new(target_name: string, field: string, qualifier: string, req: bool) -> DependencyRef {
    return new DependencyRef(target_name, field, qualifier, req);
}

class ValueBinding {
    field_name: string,
    expression: string,
    resolved_value: string
}

func value_binding_new(field: string, expr: string) -> ValueBinding {
    return new ValueBinding(field, expr, "");
}

class BeanDefinition {
    name: string,
    type_name: string,
    scope: int, // 1 = Singleton, 2 = Prototype
    dependencies: list, // list of DependencyRef
    value_bindings: list, // list of ValueBinding
    conditions: list, // list of ConditionRule
    is_primary: bool,
    is_lazy: bool,
    order: int,
    post_construct_hook: string,
    pre_destroy_hook: string,
    factory_bean_name: string,
    factory_method_name: string,
    state: int,
    instance: Unknown,
    is_instantiated: bool,
    is_initialized: bool,
    active: bool,
    creation_count: int
}

func bean_definition_new(name: string, type_name: string, scope: int) -> BeanDefinition {
    let deps = list_new();
    let vals = list_new();
    let conds = list_new();
    return new BeanDefinition(
        name,
        type_name,
        scope,
        deps,
        vals,
        conds,
        false, // is_primary
        false, // is_lazy
        0,     // order
        "",    // post_construct_hook
        "",    // pre_destroy_hook
        "",    // factory_bean_name
        "",    // factory_method_name
        bean_state_uninstantiated(),
        null,  // instance
        false, // is_instantiated
        false, // is_initialized
        true,  // active
        0      // creation_count
    );
}

func bean_def_add_dependency(def: BeanDefinition, dep_name: string) {
    list_push(def.dependencies, new DependencyRef(dep_name, dep_name, "", true));
}

func bean_def_add_dependency_ref(def: BeanDefinition, dep_name: string, field: string, qualifier: string, req: bool) {
    list_push(def.dependencies, new DependencyRef(dep_name, field, qualifier, req));
}

func bean_def_add_value(def: BeanDefinition, field_name: string, expr: string) {
    list_push(def.value_bindings, new ValueBinding(field_name, expr, ""));
}

func bean_def_add_condition(def: BeanDefinition, rule: ConditionRule) {
    list_push(def.conditions, rule);
}

func bean_def_set_hooks(def: BeanDefinition, post_construct: string, pre_destroy: string) {
    def.post_construct_hook = post_construct;
    def.pre_destroy_hook = pre_destroy;
}

func bean_def_set_primary(def: BeanDefinition, is_prim: bool) {
    def.is_primary = is_prim;
}

func bean_def_set_lazy(def: BeanDefinition, is_lazy: bool) {
    def.is_lazy = is_lazy;
}

func bean_def_set_order(def: BeanDefinition, order: int) {
    def.order = order;
}

func bean_def_set_factory(def: BeanDefinition, factory_bean: string, factory_method: string) {
    def.factory_bean_name = factory_bean;
    def.factory_method_name = factory_method;
}

