// --- Data Classes ---
class Token {
    kind: int,
    text: string,
    int_val: int,
    line: int,
    col: int,
    next: Token
}

class AstNode {
    kind: int,
    name: string,
    type_name: string,
    op: string,
    int_val: int,
    str_val: string,
    child1: AstNode,
    child2: AstNode,
    child3: AstNode,
    child4: AstNode,
    next: AstNode,
    line: int,
    col: int
}

class Symbol {
    name: string,
    type_name: string,
    kind: int,
    scope_level: int,
    is_mut: int,
    borrow_state: int,
    decl_node: AstNode,
    next: Symbol
}

class ClassField {
    name: string,
    type_name: string,
    next: ClassField
}

class ClassDef {
    name: string,
    fields: ClassField,
    next: ClassDef
}

class TraitMethod {
    name: string,
    ret_type: string,
    param_types: string,
    next: TraitMethod
}

class TraitDef {
    name: string,
    methods: TraitMethod,
    next: TraitDef
}

class ImplDef {
    trait_name: string,
    target_type: string,
    methods: TraitMethod,
    next: ImplDef
}

class MonoEntry {
    generic_name: string,
    concrete_type: string,
    specialized_name: string,
    next: MonoEntry
}

class BorrowVar {
    name: string,
    type_name: string,
    state: int,
    moved_to: string,
    line: int,
    next: BorrowVar
}

class SsaBlockRef {
    name: string,
    next: SsaBlockRef
}

class SsaInst {
    id: int,
    kind: int,
    dest: string,
    type_name: string,
    op: string,
    arg1: string,
    arg2: string,
    arg3: string,
    int_val: int,
    str_val: string,
    target_label: string,
    false_label: string,
    is_dead: int,
    next: SsaInst
}

class BasicBlock {
    id: int,
    label: string,
    inst_head: SsaInst,
    inst_tail: SsaInst,
    inst_count: int,
    pred_count: int,
    succ_count: int,
    preds: SsaBlockRef,
    succs: SsaBlockRef,
    is_terminated: int,
    next: BasicBlock
}

class SsaParam {
    name: string,
    type_name: string,
    next: SsaParam
}

class SsaFunction {
    name: string,
    ret_type: string,
    params: SsaParam,
    block_head: BasicBlock,
    block_tail: BasicBlock,
    block_count: int,
    var_counter: int,
    is_inlinable: int,
    next: SsaFunction
}

class SsaProgram {
    functions: SsaFunction,
    next: SsaProgram
}

class ConstBinding {
    name: string,
    kind: int,
    int_val: int,
    str_val: string,
    next: ConstBinding
}

class InlinableFunc {
    name: string,
    ret_type: string,
    params: AstNode,
    ret_expr: AstNode,
    next: InlinableFunc
}

class OptStats {
    const_folded: int,
    dead_stmts_removed: int,
    funcs_inlined: int,
    loops_hoisted: int
}

class BinaryBuffer {
    hex_data: string,
    size: int
}

class NativeSection {
    name: string,
    sec_type: int,
    flags: int,
    vaddr: int,
    offset: int,
    size: int,
    align: int,
    data: BinaryBuffer,
    next: NativeSection
}

class NativeSymbol {
    name: string,
    value: int,
    size: int,
    sec_index: int,
    sym_type: int,
    binding: int,
    next: NativeSymbol
}

class NativeReloc {
    offset: int,
    sym_index: int,
    rel_type: int,
    addend: int,
    next: NativeReloc
}

func make_token(kind: int, text: string, int_val: int, line: int, col: int) -> Token {
    return new Token(kind, text, int_val, line, col, null);
}

func make_ast_node(kind: int, name: string, type_name: string, line: int, col: int) -> AstNode {
    return new AstNode(kind, name, type_name, "", 0, "", null, null, null, null, null, line, col);
}

func clone_ast_node(node: AstNode) -> AstNode {
    if node == null { return null; }
    let copy = make_ast_node(node.kind, node.name, node.type_name, node.line, node.col);
    copy.op = node.op;
    copy.int_val = node.int_val;
    copy.str_val = node.str_val;
    copy.child1 = clone_ast_node(node.child1);
    copy.child2 = clone_ast_node(node.child2);
    copy.child3 = clone_ast_node(node.child3);
    copy.child4 = clone_ast_node(node.child4);
    copy.next = clone_ast_node(node.next);
    return copy;
}

func clone_single_node(node: AstNode) -> AstNode {
    if node == null { return null; }
    let copy = make_ast_node(node.kind, node.name, node.type_name, node.line, node.col);
    copy.op = node.op;
    copy.int_val = node.int_val;
    copy.str_val = node.str_val;
    copy.child1 = clone_ast_node(node.child1);
    copy.child2 = clone_ast_node(node.child2);
    copy.child3 = clone_ast_node(node.child3);
    copy.child4 = clone_ast_node(node.child4);
    copy.next = null;
    return copy;
}

func make_symbol(name: string, type_name: string, kind: int, scope_level: int, is_mut: int, next: Symbol) -> Symbol {
    return new Symbol(name, type_name, kind, scope_level, is_mut, 1, null, next);
}

func token_kind_to_str(kind: int) -> string {
    if kind == TOK_EOF() { return "EOF"; }
    if kind == TOK_IDENT() { return "IDENT"; }
    if kind == TOK_INT() { return "INT"; }
    if kind == TOK_STRING() { return "STRING"; }
    if kind == TOK_BOOL() { return "BOOL"; }
    if kind == TOK_CHAR() { return "CHAR"; }
    if kind == TOK_FUNC() { return "func"; }
    if kind == TOK_LET() { return "let"; }
    if kind == TOK_VAR() { return "var"; }
    if kind == TOK_IF() { return "if"; }
    if kind == TOK_ELSE() { return "else"; }
    if kind == TOK_WHILE() { return "while"; }
    if kind == TOK_FOR() { return "for"; }
    if kind == TOK_RETURN() { return "return"; }
    if kind == TOK_CLASS() { return "class"; }
    if kind == TOK_NEW() { return "new"; }
    if kind == TOK_EXTERN() { return "extern"; }
    if kind == TOK_IMPORT() { return "import"; }
    if kind == TOK_NULL() { return "null"; }
    if kind == TOK_ENUM() { return "enum"; }
    if kind == TOK_MATCH() { return "match"; }
    if kind == TOK_TRAIT() { return "trait"; }
    if kind == TOK_IMPL() { return "impl"; }
    if kind == TOK_UNSAFE() { return "unsafe"; }
    if kind == TOK_COMPTIME() { return "comptime"; }
    if kind == TOK_ASYNC() { return "async"; }
    if kind == TOK_AWAIT() { return "await"; }
    return "TOKEN";
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler - Lexer (M6-T01 Pure Roze Frontend)
// ==============================================================================


func is_digit(ch: int) -> bool {
    return ch >= 48 && ch <= 57; // '0' .. '9'
}

func is_alpha(ch: int) -> bool {
    if ch >= 65 && ch <= 90 { return true; } // 'A' .. 'Z'
    if ch >= 97 && ch <= 122 { return true; } // 'a' .. 'z'
    if ch == 95 { return true; } // '_'
    return false;
}

func is_alnum(ch: int) -> bool {
    return is_alpha(ch) || is_digit(ch);
}

func keyword_kind(text: string) -> int {
    if text == "func" { return TOK_FUNC(); }
    if text == "let" { return TOK_LET(); }
    if text == "var" { return TOK_VAR(); }
    if text == "mut" { return TOK_MUT(); }
    if text == "const" { return TOK_CONST(); }
    if text == "if" { return TOK_IF(); }
    if text == "else" { return TOK_ELSE(); }
    if text == "while" { return TOK_WHILE(); }
    if text == "for" { return TOK_FOR(); }
    if text == "return" { return TOK_RETURN(); }
    if text == "class" { return TOK_CLASS(); }
    if text == "new" { return TOK_NEW(); }
    if text == "extern" { return TOK_EXTERN(); }
    if text == "import" { return TOK_IMPORT(); }
    if text == "enum" { return TOK_ENUM(); }
    if text == "match" { return TOK_MATCH(); }
    if text == "trait" { return TOK_TRAIT(); }
    if text == "impl" { return TOK_IMPL(); }
    if text == "this" { return TOK_THIS(); }
    if text == "unsafe" { return TOK_UNSAFE(); }
    if text == "raw" { return TOK_RAW(); }
    if text == "comptime" { return TOK_COMPTIME(); }
    if text == "async" { return TOK_ASYNC(); }
    if text == "await" { return TOK_AWAIT(); }
    if text == "asm" { return TOK_ASM(); }
    if text == "type" { return TOK_TYPE(); }
    if text == "where" { return TOK_WHERE(); }
    if text == "in" { return TOK_IN(); }
    if text == "null" { return TOK_NULL(); }
    if text == "true" { return TOK_BOOL(); }
    if text == "false" { return TOK_BOOL(); }
    return TOK_IDENT();
}

func tokenize(source: string) -> Token {
    let head: Token = null;
    let tail: Token = null;

    let len = rz_str_len(source);
    let pos = 0;
    let line = 1;
    let col = 1;

    while pos < len {
        let ch = rz_char_at(source, pos);

        // Skip whitespace
        if ch == 32 || ch == 9 || ch == 13 { // space, tab, \r
            pos = pos + 1;
            col = col + 1;
        } else if ch == 10 { // newline
            pos = pos + 1;
            line = line + 1;
            col = 1;
        } else if ch == 47 { // '/' check for comments or division
            let next_ch = rz_char_at(source, pos + 1);
            if next_ch == 47 { // '//' single line comment
                pos = pos + 2;
                col = col + 2;
                while pos < len && rz_char_at(source, pos) != 10 {
                    pos = pos + 1;
                    col = col + 1;
                }
            } else if next_ch == 42 { // '/*' multi-line comment with nesting support
                pos = pos + 2;
                col = col + 2;
                let comment_depth = 1;
                while pos < len && comment_depth > 0 {
                    let c = rz_char_at(source, pos);
                    let n = rz_char_at(source, pos + 1);
                    if c == 10 {
                        line = line + 1;
                        col = 1;
                        pos = pos + 1;
                    } else if c == 47 && n == 42 { // nested '/*'
                        comment_depth = comment_depth + 1;
                        pos = pos + 2;
                        col = col + 2;
                    } else if c == 42 && n == 47 { // '*/'
                        comment_depth = comment_depth - 1;
                        pos = pos + 2;
                        col = col + 2;
                    } else {
                        pos = pos + 1;
                        col = col + 1;
                    }
                }
            } else {
                // Division operator '/'
                let tok = make_token(TOK_SLASH(), "/", 0, line, col);
                if head == null { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
                pos = pos + 1;
                col = col + 1;
            }
        } else if is_alpha(ch) {
            // Identifier or keyword
            let start_pos = pos;
            let start_col = col;
            while pos < len && is_alnum(rz_char_at(source, pos)) {
                pos = pos + 1;
                col = col + 1;
            }
            let word = rz_substring(source, start_pos, pos - start_pos);
            let kind = keyword_kind(word);
            let int_val = 0;
            if word == "true" { int_val = 1; }
            let tok = make_token(kind, word, int_val, line, start_col);
            if head == null { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
        } else if is_digit(ch) {
            // Number literal (Decimal, Hex 0x..., or Binary 0b...)
            let start_pos = pos;
            let start_col = col;
            let val = 0;
            let next_ch = rz_char_at(source, pos + 1);

            if ch == 48 && (next_ch == 120 || next_ch == 88) { // 0x or 0X (Hex)
                pos = pos + 2;
                col = col + 2;
                let reading_hex = true;
                while pos < len && reading_hex {
                    let hc = rz_char_at(source, pos);
                    if hc >= 48 && hc <= 57 {
                        val = val * 16 + (hc - 48);
                        pos = pos + 1; col = col + 1;
                    } else if hc >= 97 && hc <= 102 { // a-f
                        val = val * 16 + (hc - 97 + 10);
                        pos = pos + 1; col = col + 1;
                    } else if hc >= 65 && hc <= 70 { // A-F
                        val = val * 16 + (hc - 65 + 10);
                        pos = pos + 1; col = col + 1;
                    } else if hc == 95 { // '_' separator
                        pos = pos + 1; col = col + 1;
                    } else {
                        reading_hex = false;
                    }
                }
            } else if ch == 48 && (next_ch == 98 || next_ch == 66) { // 0b or 0B (Binary)
                pos = pos + 2;
                col = col + 2;
                let reading_bin = true;
                while pos < len && reading_bin {
                    let bc = rz_char_at(source, pos);
                    if bc == 48 || bc == 49 { // '0' or '1'
                        val = val * 2 + (bc - 48);
                        pos = pos + 1; col = col + 1;
                    } else if bc == 95 {
                        pos = pos + 1; col = col + 1;
                    } else {
                        reading_bin = false;
                    }
                }
            } else {
                // Decimal
                while pos < len && (is_digit(rz_char_at(source, pos)) || rz_char_at(source, pos) == 95) {
                    let dc = rz_char_at(source, pos);
                    if dc != 95 {
                        let d = dc - 48;
                        val = val * 10 + d;
                    }
                    pos = pos + 1;
                    col = col + 1;
                }
            }
            let num_str = rz_substring(source, start_pos, pos - start_pos);
            let tok = make_token(TOK_INT(), num_str, val, line, start_col);
            if head == null { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
        } else if ch == 34 { // '"' String literal
            let start_col = col;
            pos = pos + 1; // skip opening quote
            col = col + 1;
            let str_val = "";
            let closed = false;
            while pos < len && closed == false {
                let c = rz_char_at(source, pos);
                if c == 34 { // closing quote
                    closed = true;
                    pos = pos + 1;
                    col = col + 1;
                } else if c == 92 { // escape '\'
                    pos = pos + 1;
                    col = col + 1;
                    let esc = rz_char_at(source, pos);
                    if esc == 110 { // 'n'
                        str_val = str_val + "\n";
                    } else if esc == 116 { // 't'
                        str_val = str_val + "\t";
                    } else if esc == 114 { // 'r'
                        str_val = str_val + "\r";
                    } else if esc == 34 { // '"'
                        str_val = str_val + "\"";
                    } else if esc == 92 { // '\'
                        str_val = str_val + "\\";
                    } else if esc == 48 { // '0'
                        str_val = str_val + "\0";
                    } else {
                        str_val = str_val + rz_char_to_str(esc);
                    }
                    pos = pos + 1;
                    col = col + 1;
                } else if c == 10 {
                    line = line + 1;
                    col = 1;
                    pos = pos + 1;
                    str_val = str_val + "\n";
                } else {
                    str_val = str_val + rz_char_to_str(c);
                    pos = pos + 1;
                    col = col + 1;
                }
            }
            let tok = make_token(TOK_STRING(), str_val, 0, line, start_col);
            if head == null { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
        } else if ch == 39 { // '\'' Character literal
            let start_col = col;
            pos = pos + 1;
            col = col + 1;
            let c = rz_char_at(source, pos);
            let char_val = 0;
            let char_str = "";
            if c == 92 { // escape '\'
                pos = pos + 1; col = col + 1;
                let esc = rz_char_at(source, pos);
                if esc == 110 { char_val = 10; char_str = "\n"; }
                else if esc == 116 { char_val = 9; char_str = "\t"; }
                else if esc == 114 { char_val = 13; char_str = "\r"; }
                else if esc == 48 { char_val = 0; char_str = "\0"; }
                else if esc == 39 { char_val = 39; char_str = "'"; }
                else if esc == 92 { char_val = 92; char_str = "\\"; }
                else { char_val = esc; char_str = rz_char_to_str(esc); }
            } else {
                char_val = c;
                char_str = rz_char_to_str(c);
            }
            pos = pos + 1; col = col + 1;
            if pos < len && rz_char_at(source, pos) == 39 {
                pos = pos + 1; col = col + 1;
            }
            let tok = make_token(TOK_CHAR(), char_str, char_val, line, start_col);
            if head == null { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
        } else {
            // Symbols and operators
            let tok_kind = 0;
            let tok_text = "";
            let advance = 1;

            let next_c = rz_char_at(source, pos + 1);

            if ch == 43 { tok_kind = TOK_PLUS(); tok_text = "+"; }
            else if ch == 45 {
                if next_c == 62 { tok_kind = TOK_ARROW(); tok_text = "->"; advance = 2; }
                else { tok_kind = TOK_MINUS(); tok_text = "-"; }
            }
            else if ch == 42 { tok_kind = TOK_STAR(); tok_text = "*"; }
            else if ch == 37 { tok_kind = TOK_PERCENT(); tok_text = "%"; }
            else if ch == 61 {
                if next_c == 61 { tok_kind = TOK_EQ(); tok_text = "=="; advance = 2; }
                else if next_c == 62 { tok_kind = TOK_FAT_ARROW(); tok_text = "=>"; advance = 2; }
                else { tok_kind = TOK_ASSIGN(); tok_text = "="; }
            }
            else if ch == 33 {
                if next_c == 61 { tok_kind = TOK_NE(); tok_text = "!="; advance = 2; }
                else { tok_kind = TOK_BANG(); tok_text = "!"; }
            }
            else if ch == 60 {
                if next_c == 61 { tok_kind = TOK_LE(); tok_text = "<="; advance = 2; }
                else if next_c == 60 { tok_kind = TOK_LSHIFT(); tok_text = "<<"; advance = 2; }
                else { tok_kind = TOK_LT(); tok_text = "<"; }
            }
            else if ch == 62 {
                if next_c == 61 { tok_kind = TOK_GE(); tok_text = ">="; advance = 2; }
                else if next_c == 62 { tok_kind = TOK_RSHIFT(); tok_text = ">>"; advance = 2; }
                else { tok_kind = TOK_GT(); tok_text = ">"; }
            }
            else if ch == 38 {
                if next_c == 38 { tok_kind = TOK_AND(); tok_text = "&&"; advance = 2; }
                else { tok_kind = TOK_BIT_AND(); tok_text = "&"; }
            }
            else if ch == 124 {
                if next_c == 124 { tok_kind = TOK_OR(); tok_text = "||"; advance = 2; }
                else { tok_kind = TOK_BIT_OR(); tok_text = "|"; }
            }
            else if ch == 94 { tok_kind = TOK_BIT_XOR(); tok_text = "^"; }
            else if ch == 126 { tok_kind = TOK_BIT_NOT(); tok_text = "~"; }
            else if ch == 63 { tok_kind = TOK_QUESTION(); tok_text = "?"; }
            else if ch == 40 { tok_kind = TOK_LPAREN(); tok_text = "("; }
            else if ch == 41 { tok_kind = TOK_RPAREN(); tok_text = ")"; }
            else if ch == 123 { tok_kind = TOK_LBRACE(); tok_text = "{"; }
            else if ch == 125 { tok_kind = TOK_RBRACE(); tok_text = "}"; }
            else if ch == 91 { tok_kind = TOK_LBRACKET(); tok_text = "["; }
            else if ch == 93 { tok_kind = TOK_RBRACKET(); tok_text = "]"; }
            else if ch == 59 { tok_kind = TOK_SEMI(); tok_text = ";"; }
            else if ch == 44 { tok_kind = TOK_COMMA(); tok_text = ","; }
            else if ch == 58 {
                if next_c == 58 { tok_kind = TOK_COLON_COLON(); tok_text = "::"; advance = 2; }
                else { tok_kind = TOK_COLON(); tok_text = ":"; }
            }
            else if ch == 46 {
                if next_c == 46 {
                    let third_c = rz_char_at(source, pos + 2);
                    if third_c == 61 { tok_kind = TOK_DOT_DOT_EQ(); tok_text = "..="; advance = 3; }
                    else { tok_kind = TOK_DOT_DOT(); tok_text = ".."; advance = 2; }
                } else {
                    tok_kind = TOK_DOT(); tok_text = ".";
                }
            }
            else if ch == 64 { tok_kind = TOK_AT(); tok_text = "@"; }
            else if ch == 35 { tok_kind = TOK_HASH(); tok_text = "#"; }
            else if ch == 95 { tok_kind = TOK_UNDERSCORE(); tok_text = "_"; }

            if tok_kind > 0 {
                let tok = make_token(tok_kind, tok_text, 0, line, col);
                if head == null { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
                pos = pos + advance;
                col = col + advance;
            } else {
                // Unknown character, skip
                pos = pos + 1;
                col = col + 1;
            }
        }
    }

    let eof_tok = make_token(TOK_EOF(), "", 0, line, col);
    if head == null { head = eof_tok; } else { tail.next = eof_tok; }
    return head;
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler - Parser (M6-T01 Pure Roze Frontend)
// ==============================================================================


class Parser {
    curr: Token
}

func make_parser(tokens: Token) -> Parser {
    return new Parser(tokens);
}

func peek_kind(p: Parser) -> int {
    if p.curr == null { return TOK_EOF(); }
    return p.curr.kind;
}

func peek_next_kind(p: Parser) -> int {
    if p.curr == null || p.curr.next == null { return TOK_EOF(); }
    return p.curr.next.kind;
}

func peek_text(p: Parser) -> string {
    if p.curr == null { return ""; }
    return p.curr.text;
}

func peek_line(p: Parser) -> int {
    if p.curr == null { return 0; }
    return p.curr.line;
}

func peek_col(p: Parser) -> int {
    if p.curr == null { return 0; }
    return p.curr.col;
}

func advance_token(p: Parser) -> Token {
    let tok = p.curr;
    if p.curr != null {
        p.curr = p.curr.next;
    }
    return tok;
}

func check_token(p: Parser, kind: int) -> bool {
    return peek_kind(p) == kind;
}

func match_tok(p: Parser, kind: int) -> bool {
    if check_token(p, kind) {
        advance_token(p);
        return true;
    }
    return false;
}

func consume_tok(p: Parser, kind: int, msg: string) -> Token {
    if check_token(p, kind) {
        return advance_token(p);
    }
    println("❌ Parser Error: " + msg + " (got '" + peek_text(p) + "') at line " + rz_int_to_str(peek_line(p)));
    return advance_token(p);
}

// ------------------------------------------------------------------------------
// Expressions (Precedence Climbing)
// ------------------------------------------------------------------------------

func parse_primary(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);

    if check_token(p, TOK_INT()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_INT(), tok.text, "int", line, col);
        node.int_val = tok.int_val;
        return node;
    }
    if check_token(p, TOK_STRING()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_STR(), tok.text, "string", line, col);
        node.str_val = tok.text;
        return node;
    }
    if check_token(p, TOK_CHAR()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_CHAR(), tok.text, "char", line, col);
        node.int_val = tok.int_val;
        node.str_val = tok.text;
        return node;
    }
    if check_token(p, TOK_BOOL()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_BOOL(), tok.text, "bool", line, col);
        node.int_val = tok.int_val;
        return node;
    }
    if check_token(p, TOK_NULL()) {
        advance_token(p);
        return make_ast_node(NODE_LITERAL_NULL(), "null", "null", line, col);
    }
    if check_token(p, TOK_THIS()) {
        advance_token(p);
        return make_ast_node(NODE_IDENT(), "this", "this", line, col);
    }
    if check_token(p, TOK_COMPTIME()) {
        advance_token(p); // 'comptime'
        let inner = parse_primary(p);
        let node = make_ast_node(NODE_COMPTIME_EXPR(), "comptime", "void", line, col);
        node.child1 = inner;
        return node;
    }
    if check_token(p, TOK_AWAIT()) {
        advance_token(p); // 'await'
        let inner = parse_expression(p);
        let node = make_ast_node(NODE_AWAIT(), "await", "void", line, col);
        node.child1 = inner;
        return node;
    }
    if check_token(p, TOK_NEW()) {
        advance_token(p); // 'new'
        let class_name = consume_tok(p, TOK_IDENT(), "Expected class name after 'new'").text;

        // Check for generic type arguments: new ClassName<T>(...)
        let generic_arg = "";
        if check_token(p, TOK_LT()) {
            advance_token(p); // '<'
            while !check_token(p, TOK_GT()) && !check_token(p, TOK_EOF()) {
                if generic_arg == "" {
                    generic_arg = p.curr.text;
                } else {
                    generic_arg = generic_arg + "," + p.curr.text;
                }
                advance_token(p);
            }
            consume_tok(p, TOK_GT(), "Expected '>' after type arguments");
        }

        consume_tok(p, TOK_LPAREN(), "Expected '(' after class name");
        let node = make_ast_node(NODE_NEW(), class_name, class_name, line, col);
        node.op = generic_arg;

        let args_head: AstNode = null;
        let args_tail: AstNode = null;

        while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
            let arg = parse_expression(p);
            if args_head == null {
                args_head = arg;
                args_tail = arg;
            } else {
                args_tail.next = arg;
                args_tail = arg;
            }
            if check_token(p, TOK_COMMA()) {
                advance_token(p);
            }
        }
        consume_tok(p, TOK_RPAREN(), "Expected ')' after constructor arguments");
        node.child1 = args_head;
        return node;
    }

    // Closures: || { ... } or |x: int| -> int { ... }
    if check_token(p, TOK_OR()) {
        advance_token(p); // '||'
        let body = parse_block(p);
        let c_node = make_ast_node(NODE_CLOSURE(), "closure", "void", line, col);
        c_node.child3 = body;
        return c_node;
    }
    if check_token(p, TOK_BIT_OR()) {
        advance_token(p); // '|'
        let p_head: AstNode = null;
        let p_tail: AstNode = null;
        while !check_token(p, TOK_BIT_OR()) && !check_token(p, TOK_EOF()) {
            let p_name = consume_tok(p, TOK_IDENT(), "Expected parameter name in closure").text;
            let p_type = "void";
            if check_token(p, TOK_COLON()) {
                advance_token(p);
                p_type = advance_token(p).text;
            }
            let param = make_ast_node(NODE_PARAM(), p_name, p_type, line, col);
            if p_head == null { p_head = param; p_tail = param; } else { p_tail.next = param; p_tail = param; }
            if check_token(p, TOK_COMMA()) { advance_token(p); }
        }
        consume_tok(p, TOK_BIT_OR(), "Expected closing '|' in closure");
        let ret_type = "void";
        if check_token(p, TOK_ARROW()) {
            advance_token(p);
            ret_type = advance_token(p).text;
        }
        let body = parse_block(p);
        let c_node = make_ast_node(NODE_CLOSURE(), "closure", ret_type, line, col);
        c_node.child1 = p_head;
        c_node.child3 = body;
        return c_node;
    }

    // Macro Call: ident!(...) or ident! { ... } or ident![...]
    if check_token(p, TOK_IDENT()) && peek_next_kind(p) == TOK_BANG() {
        let m_name = advance_token(p).text;
        advance_token(p); // '!'
        let m_node = make_ast_node(NODE_MACRO_CALL(), m_name, "macro", line, col);

        let close_kind = TOK_RPAREN();
        if check_token(p, TOK_LPAREN()) { advance_token(p); close_kind = TOK_RPAREN(); }
        else if check_token(p, TOK_LBRACE()) { advance_token(p); close_kind = TOK_RBRACE(); }
        else if check_token(p, TOK_LBRACKET()) { advance_token(p); close_kind = TOK_RBRACKET(); }

        let a_head: AstNode = null;
        let a_tail: AstNode = null;
        while !check_token(p, close_kind) && !check_token(p, TOK_EOF()) {
            let arg = parse_expression(p);
            if a_head == null { a_head = arg; a_tail = arg; } else { a_tail.next = arg; a_tail = arg; }
            if check_token(p, TOK_COMMA()) { advance_token(p); }
        }
        consume_tok(p, close_kind, "Expected closing delimiter after macro call");
        m_node.child1 = a_head;
        return m_node;
    }

    if check_token(p, TOK_IDENT()) {
        let tok = advance_token(p);
        return make_ast_node(NODE_IDENT(), tok.text, "unknown", line, col);
    }
    if check_token(p, TOK_LPAREN()) {
        advance_token(p); // '('
        let expr = parse_expression(p);
        consume_tok(p, TOK_RPAREN(), "Expected ')' after expression");
        return expr;
    }

    println("❌ Parser Error: Unexpected token '" + peek_text(p) + "' at line " + rz_int_to_str(line));
    advance_token(p);
    return make_ast_node(NODE_LITERAL_NULL(), "null", "null", line, col);
}

func parse_postfix(p: Parser) -> AstNode {
    let expr = parse_primary(p);

    let looping = true;
    while looping {
        let line = peek_line(p);
        let col = peek_col(p);

        if check_token(p, TOK_LPAREN()) {
            // Function call: expr(args...)
            advance_token(p); // '('
            let call_node = make_ast_node(NODE_CALL(), expr.name, "void", line, col);
            call_node.child1 = expr;
            let a_head: AstNode = null;
            let a_tail: AstNode = null;
            while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
                let arg = parse_expression(p);
                if a_head == null { a_head = arg; a_tail = arg; } else { a_tail.next = arg; a_tail = arg; }
                if check_token(p, TOK_COMMA()) { advance_token(p); }
            }
            consume_tok(p, TOK_RPAREN(), "Expected ')' after function arguments");
            call_node.child2 = a_head;
            expr = call_node;
        } else if check_token(p, TOK_DOT()) {
            advance_token(p); // '.'
            let member_name = consume_tok(p, TOK_IDENT(), "Expected member name after '.'").text;

            // Method call: expr.method(args...)
            if check_token(p, TOK_LPAREN()) {
                advance_token(p); // '('
                let m_node = make_ast_node(NODE_METHOD_CALL(), member_name, "void", line, col);
                m_node.child1 = expr; // receiver
                let a_head: AstNode = null;
                let a_tail: AstNode = null;
                while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
                    let arg = parse_expression(p);
                    if a_head == null { a_head = arg; a_tail = arg; } else { a_tail.next = arg; a_tail = arg; }
                    if check_token(p, TOK_COMMA()) { advance_token(p); }
                }
                consume_tok(p, TOK_RPAREN(), "Expected ')' after method arguments");
                m_node.child2 = a_head;
                expr = m_node;
            } else {
                // Field access: expr.field
                let mem_node = make_ast_node(NODE_MEMBER(), member_name, "void", line, col);
                mem_node.child1 = expr;
                expr = mem_node;
            }
        } else if check_token(p, TOK_COLON_COLON()) {
            // Scope resolution: Enum::Variant
            advance_token(p); // '::'
            let sub_name = consume_tok(p, TOK_IDENT(), "Expected identifier after '::'").text;
            let sc_node = make_ast_node(NODE_IDENT(), expr.name + "::" + sub_name, "ident", line, col);
            expr = sc_node;
        } else if check_token(p, TOK_LBRACKET()) {
            // Indexing: expr[index]
            advance_token(p); // '['
            let idx_expr = parse_expression(p);
            consume_tok(p, TOK_RBRACKET(), "Expected ']' after index");
            let idx_node = make_ast_node(NODE_INDEX(), "index", "void", line, col);
            idx_node.child1 = expr;
            idx_node.child2 = idx_expr;
            expr = idx_node;
        } else if check_token(p, TOK_QUESTION()) {
            // Try operator: expr?
            advance_token(p); // '?'
            let try_node = make_ast_node(NODE_TRY(), "try", "void", line, col);
            try_node.child1 = expr;
            expr = try_node;
        } else {
            looping = false;
        }
    }

    return expr;
}

func parse_unary(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);

    if check_token(p, TOK_MINUS()) {
        advance_token(p);
        let operand = parse_unary(p);
        let node = make_ast_node(NODE_UNARY_OP(), "-", "int", line, col);
        node.op = "-";
        node.child1 = operand;
        return node;
    }
    if check_token(p, TOK_NOT()) || check_token(p, TOK_BANG()) {
        advance_token(p);
        let operand = parse_unary(p);
        let node = make_ast_node(NODE_UNARY_OP(), "!", "bool", line, col);
        node.op = "!";
        node.child1 = operand;
        return node;
    }
    if check_token(p, TOK_BIT_NOT()) {
        advance_token(p);
        let operand = parse_unary(p);
        let node = make_ast_node(NODE_UNARY_OP(), "~", "int", line, col);
        node.op = "~";
        node.child1 = operand;
        return node;
    }
    return parse_postfix(p);
}

func parse_factor(p: Parser) -> AstNode {
    let expr = parse_unary(p);
    while check_token(p, TOK_STAR()) || check_token(p, TOK_SLASH()) || check_token(p, TOK_PERCENT()) {
        let op_tok = advance_token(p);
        let right = parse_unary(p);
        let node = make_ast_node(NODE_BIN_OP(), op_tok.text, "int", op_tok.line, op_tok.col);
        node.op = op_tok.text;
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_term(p: Parser) -> AstNode {
    let expr = parse_factor(p);
    while check_token(p, TOK_PLUS()) || check_token(p, TOK_MINUS()) {
        let op_tok = advance_token(p);
        let right = parse_factor(p);
        let node = make_ast_node(NODE_BIN_OP(), op_tok.text, "int", op_tok.line, op_tok.col);
        node.op = op_tok.text;
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_shift(p: Parser) -> AstNode {
    let expr = parse_term(p);
    while check_token(p, TOK_LSHIFT()) || check_token(p, TOK_RSHIFT()) {
        let op_tok = advance_token(p);
        let right = parse_term(p);
        let node = make_ast_node(NODE_BIN_OP(), op_tok.text, "int", op_tok.line, op_tok.col);
        node.op = op_tok.text;
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_comparison(p: Parser) -> AstNode {
    let expr = parse_shift(p);
    while check_token(p, TOK_LT()) || check_token(p, TOK_LE()) || check_token(p, TOK_GT()) || check_token(p, TOK_GE()) {
        let op_tok = advance_token(p);
        let right = parse_shift(p);
        let node = make_ast_node(NODE_BIN_OP(), op_tok.text, "bool", op_tok.line, op_tok.col);
        node.op = op_tok.text;
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_equality(p: Parser) -> AstNode {
    let expr = parse_comparison(p);
    while check_token(p, TOK_EQ()) || check_token(p, TOK_NE()) {
        let op_tok = advance_token(p);
        let right = parse_comparison(p);
        let node = make_ast_node(NODE_BIN_OP(), op_tok.text, "bool", op_tok.line, op_tok.col);
        node.op = op_tok.text;
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_bitwise_and(p: Parser) -> AstNode {
    let expr = parse_equality(p);
    while check_token(p, TOK_BIT_AND()) {
        let op_tok = advance_token(p);
        let right = parse_equality(p);
        let node = make_ast_node(NODE_BIN_OP(), "&", "int", op_tok.line, op_tok.col);
        node.op = "&";
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_bitwise_xor(p: Parser) -> AstNode {
    let expr = parse_bitwise_and(p);
    while check_token(p, TOK_BIT_XOR()) {
        let op_tok = advance_token(p);
        let right = parse_bitwise_and(p);
        let node = make_ast_node(NODE_BIN_OP(), "^", "int", op_tok.line, op_tok.col);
        node.op = "^";
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_bitwise_or(p: Parser) -> AstNode {
    let expr = parse_bitwise_xor(p);
    while check_token(p, TOK_BIT_OR()) {
        let op_tok = advance_token(p);
        let right = parse_bitwise_xor(p);
        let node = make_ast_node(NODE_BIN_OP(), "|", "int", op_tok.line, op_tok.col);
        node.op = "|";
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_logical_and(p: Parser) -> AstNode {
    let expr = parse_bitwise_or(p);
    while check_token(p, TOK_AND()) {
        let op_tok = advance_token(p);
        let right = parse_bitwise_or(p);
        let node = make_ast_node(NODE_BIN_OP(), "&&", "bool", op_tok.line, op_tok.col);
        node.op = "&&";
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_logical_or(p: Parser) -> AstNode {
    let expr = parse_logical_and(p);
    while check_token(p, TOK_OR()) {
        let op_tok = advance_token(p);
        let right = parse_logical_and(p);
        let node = make_ast_node(NODE_BIN_OP(), "||", "bool", op_tok.line, op_tok.col);
        node.op = "||";
        node.child1 = expr;
        node.child2 = right;
        expr = node;
    }
    return expr;
}

func parse_expression(p: Parser) -> AstNode {
    return parse_logical_or(p);
}

// ------------------------------------------------------------------------------
// Match Patterns
// ------------------------------------------------------------------------------

func parse_pattern(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);

    if check_token(p, TOK_UNDERSCORE()) {
        advance_token(p);
        return make_ast_node(NODE_PATTERN(), "_", "wildcard", line, col);
    }
    if check_token(p, TOK_INT()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_INT(), tok.text, "int", line, col);
        node.int_val = tok.int_val;

        if check_token(p, TOK_DOT_DOT()) || check_token(p, TOK_DOT_DOT_EQ()) {
            let op = advance_token(p).text;
            let end_tok = advance_token(p);
            let end_node = make_ast_node(NODE_LITERAL_INT(), end_tok.text, "int", line, col);
            end_node.int_val = end_tok.int_val;
            let range_node = make_ast_node(NODE_PATTERN(), op, "range", line, col);
            range_node.child1 = node;
            range_node.child2 = end_node;
            return range_node;
        }
        return node;
    }
    if check_token(p, TOK_STRING()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_STR(), tok.text, "string", line, col);
        node.str_val = tok.text;
        return node;
    }
    if check_token(p, TOK_BOOL()) {
        let tok = advance_token(p);
        let node = make_ast_node(NODE_LITERAL_BOOL(), tok.text, "bool", line, col);
        node.int_val = tok.int_val;
        return node;
    }
    if check_token(p, TOK_IDENT()) {
        let name_tok = advance_token(p);
        let name = name_tok.text;

        if check_token(p, TOK_COLON_COLON()) {
            advance_token(p); // '::'
            let v_name = consume_tok(p, TOK_IDENT(), "Expected variant name").text;
            let pat = make_ast_node(NODE_PATTERN(), name + "::" + v_name, "variant", line, col);
            if check_token(p, TOK_LPAREN()) {
                advance_token(p);
                let b_head: AstNode = null;
                let b_tail: AstNode = null;
                while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
                    let b = parse_pattern(p);
                    if b_head == null { b_head = b; b_tail = b; } else { b_tail.next = b; b_tail = b; }
                    if check_token(p, TOK_COMMA()) { advance_token(p); }
                }
                consume_tok(p, TOK_RPAREN(), "Expected ')' in pattern");
                pat.child1 = b_head;
            }
            return pat;
        }

        if check_token(p, TOK_LBRACE()) {
            advance_token(p); // '{'
            let spat = make_ast_node(NODE_PATTERN(), name, "struct", line, col);
            let f_head: AstNode = null;
            let f_tail: AstNode = null;
            while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
                let f_tok = advance_token(p);
                let f_node = make_ast_node(NODE_IDENT(), f_tok.text, "ident", line, col);
                if f_head == null { f_head = f_node; f_tail = f_node; } else { f_tail.next = f_node; f_tail = f_node; }
                if check_token(p, TOK_COMMA()) { advance_token(p); }
            }
            consume_tok(p, TOK_RBRACE(), "Expected '}' in struct pattern");
            spat.child1 = f_head;
            return spat;
        }

        return make_ast_node(NODE_IDENT(), name, "ident", line, col);
    }

    let tok = advance_token(p);
    return make_ast_node(NODE_IDENT(), tok.text, "ident", line, col);
}

// ------------------------------------------------------------------------------
// Statements
// ------------------------------------------------------------------------------

func parse_var_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    advance_token(p); // consume 'let', 'var', or 'const'

    // Optional 'mut'
    if check_token(p, TOK_MUT()) {
        advance_token(p);
    }

    let name = consume_tok(p, TOK_IDENT(), "Expected variable name").text;
    let type_name = "";

    if check_token(p, TOK_COLON()) {
        advance_token(p); // ':'
        type_name = consume_tok(p, TOK_IDENT(), "Expected type name").text;
    }

    let init_expr: AstNode = null;
    if check_token(p, TOK_ASSIGN()) {
        advance_token(p); // '='
        init_expr = parse_expression(p);
    }

    if check_token(p, TOK_SEMI()) {
        advance_token(p);
    }

    let node = make_ast_node(NODE_VAR_DECL(), name, type_name, line, col);
    node.child1 = init_expr;
    return node;
}

func parse_if_stmt(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_IF(), "Expected 'if'");

    let has_paren = check_token(p, TOK_LPAREN());
    if has_paren { advance_token(p); }
    let cond = parse_expression(p);
    if has_paren { consume_tok(p, TOK_RPAREN(), "Expected ')' after if condition"); }

    let then_branch = parse_block(p);
    let else_branch: AstNode = null;

    if check_token(p, TOK_ELSE()) {
        advance_token(p); // 'else'
        if check_token(p, TOK_IF()) {
            else_branch = parse_if_stmt(p);
        } else {
            else_branch = parse_block(p);
        }
    }

    let node = make_ast_node(NODE_IF(), "if", "void", line, col);
    node.child1 = cond;
    node.child2 = then_branch;
    node.child3 = else_branch;
    return node;
}

func parse_while_stmt(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_WHILE(), "Expected 'while'");

    let has_paren = check_token(p, TOK_LPAREN());
    if has_paren { advance_token(p); }
    let cond = parse_expression(p);
    if has_paren { consume_tok(p, TOK_RPAREN(), "Expected ')' after while condition"); }

    let body = parse_block(p);
    let node = make_ast_node(NODE_WHILE(), "while", "void", line, col);
    node.child1 = cond;
    node.child2 = body;
    return node;
}

func parse_for_stmt(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_FOR(), "Expected 'for'");

    let has_paren = check_token(p, TOK_LPAREN());
    if has_paren { advance_token(p); }

    // Init
    let init_stmt: AstNode = null;
    if check_token(p, TOK_LET()) || check_token(p, TOK_VAR()) {
        init_stmt = parse_var_decl(p);
    } else if !check_token(p, TOK_SEMI()) {
        init_stmt = parse_statement(p);
    } else {
        advance_token(p); // ';'
    }

    // Condition
    let cond_expr: AstNode = null;
    if !check_token(p, TOK_SEMI()) {
        cond_expr = parse_expression(p);
    }
    if check_token(p, TOK_SEMI()) {
        advance_token(p); // ';'
    }

    // Update
    let update_stmt: AstNode = null;
    if !check_token(p, TOK_LBRACE()) && (!has_paren || !check_token(p, TOK_RPAREN())) {
        let u_line = peek_line(p);
        let u_col = peek_col(p);
        let var_name = consume_tok(p, TOK_IDENT(), "Expected variable name in for update").text;
        consume_tok(p, TOK_ASSIGN(), "Expected '=' in for update");
        let u_expr = parse_expression(p);
        let assign_node = make_ast_node(NODE_ASSIGN(), var_name, "void", u_line, u_col);
        assign_node.child1 = make_ast_node(NODE_IDENT(), var_name, "void", u_line, u_col);
        assign_node.child2 = u_expr;
        update_stmt = assign_node;
    }

    if has_paren {
        consume_tok(p, TOK_RPAREN(), "Expected ')' after for clauses");
    }

    let body = parse_block(p);
    let node = make_ast_node(NODE_FOR(), "for", "void", line, col);
    node.child1 = init_stmt;
    node.child2 = cond_expr;
    node.child3 = update_stmt;
    node.child4 = body;
    return node;
}

func parse_match_stmt(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_MATCH(), "Expected 'match'");

    let expr = parse_expression(p);
    consume_tok(p, TOK_LBRACE(), "Expected '{' after match expression");

    let match_node = make_ast_node(NODE_MATCH(), "match", "void", line, col);
    match_node.child1 = expr;

    let arm_head: AstNode = null;
    let arm_tail: AstNode = null;

    while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
        let arm_line = peek_line(p);
        let arm_col = peek_col(p);
        let pat_node = parse_pattern(p);

        let guard_node: AstNode = null;
        if check_token(p, TOK_IF()) {
            advance_token(p); // 'if'
            guard_node = parse_expression(p);
        }

        consume_tok(p, TOK_FAT_ARROW(), "Expected '=>' in match arm");

        let body_node: AstNode = null;
        if check_token(p, TOK_LBRACE()) {
            body_node = parse_block(p);
        } else {
            body_node = parse_statement(p);
        }

        let arm = make_ast_node(NODE_MATCH_ARM(), "arm", "void", arm_line, arm_col);
        arm.child1 = pat_node;
        arm.child2 = guard_node;
        arm.child3 = body_node;

        if arm_head == null { arm_head = arm; arm_tail = arm; } else { arm_tail.next = arm; arm_tail = arm; }
        if check_token(p, TOK_COMMA()) { advance_token(p); }
    }

    consume_tok(p, TOK_RBRACE(), "Expected '}' at end of match");
    match_node.child2 = arm_head;
    return match_node;
}

func parse_return_stmt(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_RETURN(), "Expected 'return'");

    let ret_val: AstNode = null;
    if !check_token(p, TOK_SEMI()) && !check_token(p, TOK_RBRACE()) {
        ret_val = parse_expression(p);
    }
    if check_token(p, TOK_SEMI()) {
        advance_token(p);
    }

    let node = make_ast_node(NODE_RETURN(), "return", "void", line, col);
    node.child1 = ret_val;
    return node;
}

func parse_block(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_LBRACE(), "Expected '{'");

    let head: AstNode = null;
    let tail: AstNode = null;

    while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
        let stmt = parse_statement(p);
        if stmt != null {
            if head == null {
                head = stmt;
                tail = stmt;
            } else {
                tail.next = stmt;
                tail = stmt;
            }
        }
    }

    consume_tok(p, TOK_RBRACE(), "Expected '}'");
    let node = make_ast_node(NODE_BLOCK(), "block", "void", line, col);
    node.child1 = head;
    return node;
}

func parse_statement(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);

    if check_token(p, TOK_LET()) || check_token(p, TOK_VAR()) || check_token(p, TOK_CONST()) {
        return parse_var_decl(p);
    }
    if check_token(p, TOK_IF()) {
        return parse_if_stmt(p);
    }
    if check_token(p, TOK_WHILE()) {
        return parse_while_stmt(p);
    }
    if check_token(p, TOK_FOR()) {
        return parse_for_stmt(p);
    }
    if check_token(p, TOK_MATCH()) {
        return parse_match_stmt(p);
    }
    if check_token(p, TOK_RETURN()) {
        return parse_return_stmt(p);
    }
    if check_token(p, TOK_LBRACE()) {
        return parse_block(p);
    }
    if check_token(p, TOK_UNSAFE()) {
        advance_token(p); // 'unsafe'
        let body = parse_block(p);
        let node = make_ast_node(NODE_UNSAFE_BLOCK(), "unsafe", "void", line, col);
        node.child1 = body;
        return node;
    }
    if check_token(p, TOK_COMPTIME()) {
        advance_token(p); // 'comptime'
        let body: AstNode = null;
        if check_token(p, TOK_LBRACE()) { body = parse_block(p); }
        else { body = parse_statement(p); }
        let node = make_ast_node(NODE_COMPTIME_STMT(), "comptime", "void", line, col);
        node.child1 = body;
        return node;
    }

    // Assignment or expression statement
    let expr = parse_expression(p);

    if check_token(p, TOK_ASSIGN()) {
        advance_token(p); // '='
        let val = parse_expression(p);
        if check_token(p, TOK_SEMI()) { advance_token(p); }

        let node = make_ast_node(NODE_ASSIGN(), expr.name, "void", line, col);
        node.child1 = expr;
        node.child2 = val;
        return node;
    }

    if check_token(p, TOK_SEMI()) {
        advance_token(p);
    }

    let node = make_ast_node(NODE_EXPR_STMT(), "expr", "void", line, col);
    node.child1 = expr;
    return node;
}

// ------------------------------------------------------------------------------
// Top-Level Declarations
// ------------------------------------------------------------------------------

func parse_func_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);

    let is_async = false;
    if check_token(p, TOK_ASYNC()) {
        advance_token(p); // 'async'
        is_async = true;
    }

    consume_tok(p, TOK_FUNC(), "Expected 'func'");
    let name = consume_tok(p, TOK_IDENT(), "Expected function name").text;

    // Optional generics: func name<T, U>(...)
    let fn_generic = "";
    if check_token(p, TOK_LT()) {
        advance_token(p); // '<'
        while !check_token(p, TOK_GT()) && !check_token(p, TOK_EOF()) {
            if fn_generic == "" {
                fn_generic = p.curr.text;
            } else {
                fn_generic = fn_generic + "," + p.curr.text;
            }
            advance_token(p);
        }
        consume_tok(p, TOK_GT(), "Expected '>' after function type parameters");
    }

    consume_tok(p, TOK_LPAREN(), "Expected '(' after function name");

    let params_head: AstNode = null;
    let params_tail: AstNode = null;

    while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
        let p_line = peek_line(p);
        let p_col = peek_col(p);
        let param_name = consume_tok(p, TOK_IDENT(), "Expected parameter name").text;
        let param_type = "void";

        if check_token(p, TOK_COLON()) {
            advance_token(p); // ':'
            param_type = consume_tok(p, TOK_IDENT(), "Expected parameter type").text;
        }

        let param_node = make_ast_node(NODE_PARAM(), param_name, param_type, p_line, p_col);
        if params_head == null {
            params_head = param_node;
            params_tail = param_node;
        } else {
            params_tail.next = param_node;
            params_tail = param_node;
        }

        if check_token(p, TOK_COMMA()) {
            advance_token(p);
        }
    }

    consume_tok(p, TOK_RPAREN(), "Expected ')' after parameters");

    let ret_type = "void";
    if check_token(p, TOK_ARROW()) {
        advance_token(p); // '->'
        ret_type = consume_tok(p, TOK_IDENT(), "Expected return type").text;
    }

    let body = parse_block(p);
    let node = make_ast_node(NODE_FUNC_DECL(), name, ret_type, line, col);
    node.op = fn_generic;
    node.child1 = params_head;
    node.child2 = body;
    if is_async { node.str_val = "async"; }
    return node;
}

func parse_extern_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_EXTERN(), "Expected 'extern'");

    // Optional ABI string: "C"
    let abi = "C";
    if check_token(p, TOK_STRING()) {
        abi = advance_token(p).text;
    }

    consume_tok(p, TOK_FUNC(), "Expected 'func'");
    let name = consume_tok(p, TOK_IDENT(), "Expected function name").text;
    consume_tok(p, TOK_LPAREN(), "Expected '(' after function name");

    let params_head: AstNode = null;
    let params_tail: AstNode = null;

    while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
        let p_line = peek_line(p);
        let p_col = peek_col(p);
        let param_name = consume_tok(p, TOK_IDENT(), "Expected parameter name").text;
        let param_type = "void";

        if check_token(p, TOK_COLON()) {
            advance_token(p); // ':'
            param_type = consume_tok(p, TOK_IDENT(), "Expected parameter type").text;
        }

        let param_node = make_ast_node(NODE_PARAM(), param_name, param_type, p_line, p_col);
        if params_head == null {
            params_head = param_node;
            params_tail = param_node;
        } else {
            params_tail.next = param_node;
            params_tail = param_node;
        }

        if check_token(p, TOK_COMMA()) {
            advance_token(p);
        }
    }

    consume_tok(p, TOK_RPAREN(), "Expected ')' after parameters");

    let ret_type = "void";
    if check_token(p, TOK_ARROW()) {
        advance_token(p); // '->'
        ret_type = consume_tok(p, TOK_IDENT(), "Expected return type").text;
    }

    consume_tok(p, TOK_SEMI(), "Expected ';' after extern function declaration");
    let node = make_ast_node(NODE_EXTERN_DECL(), name, ret_type, line, col);
    node.child1 = params_head;
    node.str_val = abi;
    return node;
}

func parse_class_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_CLASS(), "Expected 'class'");
    let name = consume_tok(p, TOK_IDENT(), "Expected class name").text;

    // Optional generics: class Name<T, U>
    let cls_generic = "";
    if check_token(p, TOK_LT()) {
        advance_token(p); // '<'
        while !check_token(p, TOK_GT()) && !check_token(p, TOK_EOF()) {
            if cls_generic == "" {
                cls_generic = p.curr.text;
            } else {
                cls_generic = cls_generic + "," + p.curr.text;
            }
            advance_token(p);
        }
        consume_tok(p, TOK_GT(), "Expected '>' after class type parameters");
    }

    consume_tok(p, TOK_LBRACE(), "Expected '{' after class name");

    let fields_head: AstNode = null;
    let fields_tail: AstNode = null;

    while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
        let f_line = peek_line(p);
        let f_col = peek_col(p);
        let field_name = consume_tok(p, TOK_IDENT(), "Expected field name").text;
        consume_tok(p, TOK_COLON(), "Expected ':' after field name");
        let field_type = consume_tok(p, TOK_IDENT(), "Expected field type").text;

        let field_node = make_ast_node(NODE_FIELD(), field_name, field_type, f_line, f_col);
        if fields_head == null {
            fields_head = field_node;
            fields_tail = field_node;
        } else {
            fields_tail.next = field_node;
            fields_tail = field_node;
        }

        if check_token(p, TOK_COMMA()) {
            advance_token(p);
        }
    }

    consume_tok(p, TOK_RBRACE(), "Expected '}' at end of class declaration");
    let node = make_ast_node(NODE_CLASS_DECL(), name, name, line, col);
    node.op = cls_generic;
    node.child1 = fields_head;
    return node;
}

func parse_enum_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_ENUM(), "Expected 'enum'");
    let name = consume_tok(p, TOK_IDENT(), "Expected enum name").text;

    if check_token(p, TOK_LT()) {
        advance_token(p); // '<'
        while !check_token(p, TOK_GT()) && !check_token(p, TOK_EOF()) {
            advance_token(p);
        }
        consume_tok(p, TOK_GT(), "Expected '>' after enum type parameters");
    }

    consume_tok(p, TOK_LBRACE(), "Expected '{' after enum name");

    let node = make_ast_node(NODE_ENUM_DECL(), name, name, line, col);
    let v_head: AstNode = null;
    let v_tail: AstNode = null;
    let tag = 0;

    while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
        if check_token(p, TOK_IDENT()) {
            let v_line = peek_line(p);
            let v_col = peek_col(p);
            let v_tok = advance_token(p);
            let v_node = make_ast_node(NODE_ENUM_VARIANT(), v_tok.text, name, v_line, v_col);
            v_node.int_val = tag;
            tag = tag + 1;

            if check_token(p, TOK_LPAREN()) {
                advance_token(p); // '('
                let p_head: AstNode = null;
                let p_tail: AstNode = null;
                while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
                    let pt_tok = advance_token(p);
                    let pt_node = make_ast_node(NODE_PARAM(), "", pt_tok.text, v_line, v_col);
                    if p_head == null { p_head = pt_node; p_tail = pt_node; } else { p_tail.next = pt_node; p_tail = pt_node; }
                    if check_token(p, TOK_COMMA()) { advance_token(p); }
                }
                consume_tok(p, TOK_RPAREN(), "Expected ')' after variant payload");
                v_node.child1 = p_head;
            }

            if v_head == null { v_head = v_node; v_tail = v_node; } else { v_tail.next = v_node; v_tail = v_node; }
        }
        if check_token(p, TOK_COMMA()) { advance_token(p); }
    }

    consume_tok(p, TOK_RBRACE(), "Expected '}' at end of enum");
    node.child1 = v_head;
    return node;
}

func parse_trait_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_TRAIT(), "Expected 'trait'");
    let name = consume_tok(p, TOK_IDENT(), "Expected trait name").text;

    if check_token(p, TOK_LT()) {
        advance_token(p); // '<'
        while !check_token(p, TOK_GT()) && !check_token(p, TOK_EOF()) {
            advance_token(p);
        }
        consume_tok(p, TOK_GT(), "Expected '>' after trait type parameters");
    }

    consume_tok(p, TOK_LBRACE(), "Expected '{' after trait name");

    let node = make_ast_node(NODE_TRAIT_DECL(), name, name, line, col);
    let m_head: AstNode = null;
    let m_tail: AstNode = null;

    while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
        if check_token(p, TOK_FUNC()) {
            let m_line = peek_line(p);
            let m_col = peek_col(p);
            advance_token(p); // 'func'
            let m_name = consume_tok(p, TOK_IDENT(), "Expected method name in trait").text;
            consume_tok(p, TOK_LPAREN(), "Expected '(' in trait method");

            let params_head: AstNode = null;
            let params_tail: AstNode = null;
            while !check_token(p, TOK_RPAREN()) && !check_token(p, TOK_EOF()) {
                let p_line = peek_line(p);
                let p_col = peek_col(p);
                let p_name = consume_tok(p, TOK_IDENT(), "Expected param name").text;
                let p_type = "void";
                if check_token(p, TOK_COLON()) {
                    advance_token(p); // ':'
                    p_type = advance_token(p).text;
                }
                let p_node = make_ast_node(NODE_PARAM(), p_name, p_type, p_line, p_col);
                if params_head == null { params_head = p_node; params_tail = p_node; } else { params_tail.next = p_node; params_tail = p_node; }
                if check_token(p, TOK_COMMA()) { advance_token(p); }
            }
            consume_tok(p, TOK_RPAREN(), "Expected ')' after trait method params");

            let ret_type = "void";
            if check_token(p, TOK_ARROW()) {
                advance_token(p); // '->'
                ret_type = advance_token(p).text;
            }

            let body_block: AstNode = null;
            if check_token(p, TOK_SEMI()) {
                advance_token(p); // ';'
            } else if check_token(p, TOK_LBRACE()) {
                body_block = parse_block(p);
            }

            let m_node = make_ast_node(NODE_FUNC_DECL(), m_name, ret_type, m_line, m_col);
            m_node.child1 = params_head;
            m_node.child2 = body_block;

            if m_head == null { m_head = m_node; m_tail = m_node; } else { m_tail.next = m_node; m_tail = m_node; }
        } else {
            advance_token(p);
        }
    }

    consume_tok(p, TOK_RBRACE(), "Expected '}' at end of trait");
    node.child1 = m_head;
    return node;
}

func parse_impl_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_IMPL(), "Expected 'impl'");
    let first_name = consume_tok(p, TOK_IDENT(), "Expected identifier after 'impl'").text;
    let trait_name = "";
    let class_name = first_name;

    if check_token(p, TOK_FOR()) {
        advance_token(p); // 'for'
        trait_name = first_name;
        class_name = consume_tok(p, TOK_IDENT(), "Expected class name after 'for'").text;
    }

    consume_tok(p, TOK_LBRACE(), "Expected '{' in impl block");
    let node = make_ast_node(NODE_IMPL_DECL(), class_name, class_name, line, col);
    node.str_val = trait_name;

    let m_head: AstNode = null;
    let m_tail: AstNode = null;

    while !check_token(p, TOK_RBRACE()) && !check_token(p, TOK_EOF()) {
        if check_token(p, TOK_FUNC()) {
            let m_node = parse_func_decl(p);
            if m_head == null { m_head = m_node; m_tail = m_node; } else { m_tail.next = m_node; m_tail = m_node; }
        } else {
            advance_token(p);
        }
    }

    consume_tok(p, TOK_RBRACE(), "Expected '}' at end of impl block");
    node.child1 = m_head;
    return node;
}

func parse_annotated_decl(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    let is_at = check_token(p, TOK_AT());
    advance_token(p); // consume '@' or '#'

    if !is_at && check_token(p, TOK_LBRACKET()) {
        advance_token(p); // '['
    }

    let annot_name = consume_tok(p, TOK_IDENT(), "Expected annotation name").text;
    let annot_arg = "";

    if check_token(p, TOK_LPAREN()) {
        advance_token(p); // '('
        if check_token(p, TOK_STRING()) || check_token(p, TOK_IDENT()) {
            annot_arg = advance_token(p).text;
        }
        consume_tok(p, TOK_RPAREN(), "Expected ')' after annotation argument");
    }

    if !is_at && check_token(p, TOK_RBRACKET()) {
        advance_token(p); // ']'
    }

    let inner_decl: AstNode = null;
    if check_token(p, TOK_AT()) || check_token(p, TOK_HASH()) {
        inner_decl = parse_annotated_decl(p);
    } else if check_token(p, TOK_FUNC()) || (check_token(p, TOK_ASYNC()) && peek_next_kind(p) == TOK_FUNC()) {
        inner_decl = parse_func_decl(p);
    } else if check_token(p, TOK_CLASS()) {
        inner_decl = parse_class_decl(p);
    } else if check_token(p, TOK_ENUM()) {
        inner_decl = parse_enum_decl(p);
    } else if check_token(p, TOK_TRAIT()) {
        inner_decl = parse_trait_decl(p);
    } else {
        inner_decl = parse_statement(p);
    }

    let node = make_ast_node(NODE_ANNOTATION(), annot_name, "annotation", line, col);
    node.str_val = annot_arg;
    node.child1 = inner_decl;
    return node;
}

func parse_import(p: Parser) -> AstNode {
    let line = peek_line(p);
    let col = peek_col(p);
    consume_tok(p, TOK_IMPORT(), "Expected 'import'");
    let path = consume_tok(p, TOK_STRING(), "Expected import path string").text;
    if check_token(p, TOK_SEMI()) {
        advance_token(p);
    }
    let node = make_ast_node(NODE_IMPORT(), path, "import", line, col);
    node.str_val = path;
    return node;
}

func parse_program(p: Parser) -> AstNode {
    let prog = make_ast_node(NODE_PROGRAM(), "main", "void", 1, 1);
    let head: AstNode = null;
    let tail: AstNode = null;

    while peek_kind(p) != TOK_EOF() {
        let decl: AstNode = null;

        if check_token(p, TOK_AT()) || check_token(p, TOK_HASH()) {
            decl = parse_annotated_decl(p);
        } else if check_token(p, TOK_FUNC()) || (check_token(p, TOK_ASYNC()) && peek_next_kind(p) == TOK_FUNC()) {
            decl = parse_func_decl(p);
        } else if check_token(p, TOK_EXTERN()) {
            decl = parse_extern_decl(p);
        } else if check_token(p, TOK_CLASS()) {
            decl = parse_class_decl(p);
        } else if check_token(p, TOK_ENUM()) {
            decl = parse_enum_decl(p);
        } else if check_token(p, TOK_TRAIT()) {
            decl = parse_trait_decl(p);
        } else if check_token(p, TOK_IMPL()) {
            decl = parse_impl_decl(p);
        } else if check_token(p, TOK_IMPORT()) {
            decl = parse_import(p);
        } else {
            decl = parse_statement(p);
        }

        if decl != null {
            if head == null {
                head = decl;
                tail = decl;
            } else {
                tail.next = decl;
                tail = decl;
            }
        }
    }

    prog.child1 = head;
    return prog;
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler - Procedural Macro & Compile-Time Expander (M6-T01)
// ==============================================================================
// Pure Roze Macro Expander & Metaprogramming Engine:
// 1. Built-in Macro Expansion:
//    - assert!(cond), assert!(cond, msg) -> desugars to assertion failure check
//    - panic!(msg)                       -> desugars to error report & termination
//    - stringify!(expr)                  -> desugars to string literal of AST node
//    - concat!(s1, s2, ...)              -> compile-time string concatenation
//    - env!(name)                        -> compile-time environment variable lookup
//    - dbg!(expr)                        -> debug print and value passthrough
// 2. Annotation & Attribute Desugaring:
//    - @derive(Debug)                    -> synthesizes to_string() class method
//    - @test                             -> registers function for test execution
//    - #[repr(C)]                        -> flags struct for C-ABI alignment
// 3. Comptime Constant Folding:
//    - Evaluates constant arithmetic and string concatenation at compile time
// ==============================================================================


func expand_macros_expr(expr: AstNode) -> AstNode {
    if expr == null { return null; }

    let kind = expr.kind;

    if kind == NODE_MACRO_CALL() {
        let m_name = expr.name;
        let line = expr.line;
        let col = expr.col;

        if m_name == "stringify" {
            let arg = expr.child1;
            let str_val = "";
            if arg != null {
                str_val = arg.name;
                if rz_str_len(str_val) == 0 {
                    str_val = arg.str_val;
                }
                if rz_str_len(str_val) == 0 {
                    str_val = rz_int_to_str(arg.int_val);
                }
            }
            let res = make_ast_node(NODE_LITERAL_STR(), str_val, "string", line, col);
            res.str_val = str_val;
            return res;
        }

        if m_name == "concat" {
            let arg = expr.child1;
            let full_str = "";
            while arg != null {
                let s = expand_macros_expr(arg);
                if s.kind == NODE_LITERAL_STR() {
                    full_str = full_str + s.str_val;
                } else if s.kind == NODE_IDENT() {
                    full_str = full_str + s.name;
                }
                arg = arg.next;
            }
            let res = make_ast_node(NODE_LITERAL_STR(), full_str, "string", line, col);
            res.str_val = full_str;
            return res;
        }

        if m_name == "env" {
            let arg = expr.child1;
            let var_name = "";
            if arg != null {
                if arg.kind == NODE_LITERAL_STR() { var_name = arg.str_val; }
                else if arg.kind == NODE_IDENT() { var_name = arg.name; }
            }
            let env_val = rz_get_env(var_name);
            let res = make_ast_node(NODE_LITERAL_STR(), env_val, "string", line, col);
            res.str_val = env_val;
            return res;
        }

        if m_name == "dbg" {
            let arg = expr.child1;
            if arg != null {
                let exp_arg = expand_macros_expr(arg);
                // println("[dbg] " + val) and return val
                let print_call = make_ast_node(NODE_CALL(), "println", "void", line, col);
                print_call.child2 = exp_arg;
                return exp_arg;
            }
        }

        return expr;
    }

    if kind == NODE_COMPTIME_EXPR() {
        // Evaluate constant inner expression
        let inner = expand_macros_expr(expr.child1);
        if inner != null {
            if inner.kind == NODE_BIN_OP() {
                let left = inner.child1;
                let right = inner.child2;
                if left.kind == NODE_LITERAL_INT() && right.kind == NODE_LITERAL_INT() {
                    let res_val = 0;
                    if inner.op == "+" { res_val = left.int_val + right.int_val; }
                    else if inner.op == "-" { res_val = left.int_val - right.int_val; }
                    else if inner.op == "*" { res_val = left.int_val * right.int_val; }
                    else if inner.op == "/" && right.int_val != 0 { res_val = left.int_val / right.int_val; }
                    let folded = make_ast_node(NODE_LITERAL_INT(), rz_int_to_str(res_val), "int", expr.line, expr.col);
                    folded.int_val = res_val;
                    return folded;
                }
                if left.kind == NODE_LITERAL_STR() && right.kind == NODE_LITERAL_STR() && inner.op == "+" {
                    let cat = left.str_val + right.str_val;
                    let folded_str = make_ast_node(NODE_LITERAL_STR(), cat, "string", expr.line, expr.col);
                    folded_str.str_val = cat;
                    return folded_str;
                }
            }
            return inner;
        }
        return expr;
    }

    if kind == NODE_BIN_OP() {
        expr.child1 = expand_macros_expr(expr.child1);
        expr.child2 = expand_macros_expr(expr.child2);

        // Constant folding for binary operations on integers
        if expr.child1 != null && expr.child2 != null {
            if expr.child1.kind == NODE_LITERAL_INT() && expr.child2.kind == NODE_LITERAL_INT() {
                let l_val = expr.child1.int_val;
                let r_val = expr.child2.int_val;
                let folded_val = 0;
                let can_fold = false;

                if expr.op == "+" { folded_val = l_val + r_val; can_fold = true; }
                else if expr.op == "-" { folded_val = l_val - r_val; can_fold = true; }
                else if expr.op == "*" { folded_val = l_val * r_val; can_fold = true; }
                else if expr.op == "/" && r_val != 0 { folded_val = l_val / r_val; can_fold = true; }

                if can_fold {
                    let folded_node = make_ast_node(NODE_LITERAL_INT(), rz_int_to_str(folded_val), "int", expr.line, expr.col);
                    folded_node.int_val = folded_val;
                    return folded_node;
                }
            }
        }
        return expr;
    }

    if kind == NODE_UNARY_OP() {
        expr.child1 = expand_macros_expr(expr.child1);
        return expr;
    }

    if kind == NODE_CALL() || kind == NODE_NEW() || kind == NODE_METHOD_CALL() {
        if expr.child1 != null { expr.child1 = expand_macros_expr(expr.child1); }
        let arg = expr.child2;
        while arg != null {
            let exp_arg = expand_macros_expr(arg);
            arg = arg.next;
        }
        return expr;
    }

    if kind == NODE_MEMBER() || kind == NODE_INDEX() || kind == NODE_TRY() {
        if expr.child1 != null { expr.child1 = expand_macros_expr(expr.child1); }
        if expr.child2 != null { expr.child2 = expand_macros_expr(expr.child2); }
        return expr;
    }

    return expr;
}

func expand_macros_stmt(stmt: AstNode) -> AstNode {
    if stmt == null { return null; }

    let kind = stmt.kind;

    if kind == NODE_EXPR_STMT() {
        let inner = stmt.child1;
        if inner != null && inner.kind == NODE_MACRO_CALL() {
            let m_name = inner.name;
            let line = stmt.line;
            let col = stmt.col;

            // assert!(cond) or assert!(cond, msg)
            if m_name == "assert" {
                let cond = inner.child1;
                let msg = "assertion failed";
                if cond != null && cond.next != null {
                    let msg_node = cond.next;
                    if msg_node.kind == NODE_LITERAL_STR() { msg = msg_node.str_val; }
                    else if msg_node.kind == NODE_IDENT() { msg = msg_node.name; }
                }

                // Desugar to: if (!cond) { println("Assertion failed: " + msg); }
                let not_cond = make_ast_node(NODE_UNARY_OP(), "!", "bool", line, col);
                not_cond.op = "!";
                not_cond.child1 = cond;

                let fail_msg = make_ast_node(NODE_LITERAL_STR(), "Assertion failed: " + msg, "string", line, col);
                fail_msg.str_val = "Assertion failed: " + msg;

                let print_call = make_ast_node(NODE_CALL(), "println", "void", line, col);
                print_call.child2 = fail_msg;

                let print_stmt = make_ast_node(NODE_EXPR_STMT(), "print", "void", line, col);
                print_stmt.child1 = print_call;

                let if_node = make_ast_node(NODE_IF(), "if", "void", line, col);
                if_node.child1 = not_cond;
                if_node.child2 = print_stmt;
                return if_node;
            }

            // panic!(msg)
            if m_name == "panic" {
                let msg_text = "explicit panic triggered";
                let arg = inner.child1;
                if arg != null {
                    if arg.kind == NODE_LITERAL_STR() { msg_text = arg.str_val; }
                    else if arg.kind == NODE_IDENT() { msg_text = arg.name; }
                }

                let p_msg = make_ast_node(NODE_LITERAL_STR(), "PANIC: " + msg_text, "string", line, col);
                p_msg.str_val = "PANIC: " + msg_text;

                let print_call = make_ast_node(NODE_CALL(), "println", "void", line, col);
                print_call.child2 = p_msg;

                let print_stmt = make_ast_node(NODE_EXPR_STMT(), "print", "void", line, col);
                print_stmt.child1 = print_call;
                return print_stmt;
            }
        }

        stmt.child1 = expand_macros_expr(stmt.child1);
        return stmt;
    }

    if kind == NODE_VAR_DECL() {
        if stmt.child1 != null {
            stmt.child1 = expand_macros_expr(stmt.child1);
        }
        return stmt;
    }

    if kind == NODE_ASSIGN() || kind == NODE_FIELD_ASSIGN() || kind == NODE_INDEX_ASSIGN() {
        if stmt.child1 != null { stmt.child1 = expand_macros_expr(stmt.child1); }
        if stmt.child2 != null { stmt.child2 = expand_macros_expr(stmt.child2); }
        return stmt;
    }

    if kind == NODE_IF() {
        stmt.child1 = expand_macros_expr(stmt.child1);
        stmt.child2 = expand_macros_stmt(stmt.child2);
        if stmt.child3 != null {
            stmt.child3 = expand_macros_stmt(stmt.child3);
        }
        return stmt;
    }

    if kind == NODE_WHILE() {
        stmt.child1 = expand_macros_expr(stmt.child1);
        stmt.child2 = expand_macros_stmt(stmt.child2);
        return stmt;
    }

    if kind == NODE_FOR() {
        if stmt.child1 != null { stmt.child1 = expand_macros_stmt(stmt.child1); }
        if stmt.child2 != null { stmt.child2 = expand_macros_expr(stmt.child2); }
        if stmt.child3 != null { stmt.child3 = expand_macros_stmt(stmt.child3); }
        if stmt.child4 != null { stmt.child4 = expand_macros_stmt(stmt.child4); }
        return stmt;
    }

    if kind == NODE_RETURN() {
        if stmt.child1 != null {
            stmt.child1 = expand_macros_expr(stmt.child1);
        }
        return stmt;
    }

    if kind == NODE_BLOCK() || kind == NODE_UNSAFE_BLOCK() || kind == NODE_COMPTIME_STMT() {
        let s = stmt.child1;
        while s != null {
            expand_macros_stmt(s);
            s = s.next;
        }
        return stmt;
    }

    if kind == NODE_MATCH() {
        stmt.child1 = expand_macros_expr(stmt.child1);
        let arm = stmt.child2;
        while arm != null {
            if arm.child2 != null { arm.child2 = expand_macros_expr(arm.child2); }
            if arm.child3 != null { arm.child3 = expand_macros_stmt(arm.child3); }
            arm = arm.next;
        }
        return stmt;
    }

    return stmt;
}

func expand_macros(prog: AstNode) -> AstNode {
    if prog == null { return null; }

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            if decl.child2 != null {
                decl.child2 = expand_macros_stmt(decl.child2);
            }
        } else if decl.kind == NODE_ANNOTATION() {
            let annot_name = decl.name;
            let target = decl.child1;

            if annot_name == "derive" && target != null && target.kind == NODE_CLASS_DECL() {
                // @derive(Debug): synthesize to_string method
                let class_name = target.name;
                let to_str_func = make_ast_node(NODE_FUNC_DECL(), class_name + "_to_string", "string", decl.line, decl.col);
                let this_param = make_ast_node(NODE_PARAM(), "this", class_name, decl.line, decl.col);
                to_str_func.child1 = this_param;

                let ret_str = make_ast_node(NODE_LITERAL_STR(), class_name + "{...}", "string", decl.line, decl.col);
                ret_str.str_val = class_name + "{...}";

                let ret_stmt = make_ast_node(NODE_RETURN(), "return", "string", decl.line, decl.col);
                ret_stmt.child1 = ret_str;

                let body_block = make_ast_node(NODE_BLOCK(), "block", "void", decl.line, decl.col);
                body_block.child1 = ret_stmt;
                to_str_func.child2 = body_block;

                // Append synthesized function to program declarations
                to_str_func.next = decl.next;
                decl.next = to_str_func;
            } else if annot_name == "test" && target != null && target.kind == NODE_FUNC_DECL() {
                // Tag test function with metadata
                target.str_val = "test_function";
            }

            if target != null && target.kind == NODE_FUNC_DECL() {
                if target.child2 != null {
                    target.child2 = expand_macros_stmt(target.child2);
                }
            }
        } else if decl.kind == NODE_IMPL_DECL() {
            let m = decl.child1;
            while m != null {
                if m.child2 != null {
                    m.child2 = expand_macros_stmt(m.child2);
                }
                m = m.next;
            }
        } else {
            expand_macros_stmt(decl);
        }
        decl = decl.next;
    }

    return prog;
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler - Semantic Analyzer & Type Checker (M6-T02)
// ==============================================================================
// Pure Roze Semantic Analysis Pipeline:
// 1. Scoped Symbol Tables & Lexical Environment (symbols.roze)
// 2. Trait Resolution & Interface Conformance Engine (trait_solver.roze)
// 3. Generic Monomorphizer & AST Specializer (monomorphizer.roze)
// 4. ARC Borrow Lifetime & Ownership Analyzer (borrow_checker.roze)
// 5. Bidirectional Type Checker & Type Inference Engine (typechecker.roze)
// ==============================================================================


class TypeChecker {
    symbols: Symbol,
    scope_level: int,
    error_count: int,
    warning_count: int,
    current_func_ret: string,
    current_func_name: string,
    classes: ClassDef,
    traits: TraitDef,
    impls: ImplDef,
    mono_table: MonoEntry,
    borrow_vars: BorrowVar
}

func make_type_checker() -> TypeChecker {
    return new TypeChecker(null, 0, 0, 0, "void", "", null, null, null, null, null);
}

// ------------------------------------------------------------------------------
// 1. Scoped Symbol Tables
// ------------------------------------------------------------------------------

func enter_scope(tc: TypeChecker) {
    tc.scope_level = tc.scope_level + 1;
}

func exit_scope(tc: TypeChecker) {
    while tc.symbols != null && tc.symbols.scope_level == tc.scope_level {
        tc.symbols = tc.symbols.next;
    }
    tc.scope_level = tc.scope_level - 1;
}

func define_symbol(tc: TypeChecker, name: string, type_name: string, kind: int) {
    let sym = new Symbol(name, type_name, kind, tc.scope_level, 0, BORROW_OWNED(), null, tc.symbols);
    tc.symbols = sym;
}

func define_symbol_with_decl(tc: TypeChecker, name: string, type_name: string, kind: int, is_mut: int, decl: AstNode) {
    let sym = new Symbol(name, type_name, kind, tc.scope_level, is_mut, BORROW_OWNED(), decl, tc.symbols);
    tc.symbols = sym;
}

func lookup_symbol(tc: TypeChecker, name: string) -> Symbol {
    let curr = tc.symbols;
    while curr != null {
        if curr.name == name {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func lookup_symbol_in_current_scope(tc: TypeChecker, name: string) -> Symbol {
    let curr = tc.symbols;
    while curr != null && curr.scope_level == tc.scope_level {
        if curr.name == name {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

// Class Field Registry
func register_class_def(tc: TypeChecker, name: string, fields: AstNode) {
    let f_head: ClassField = null;
    let f_tail: ClassField = null;
    let curr = fields;
    while curr != null {
        if curr.kind == NODE_FIELD() {
            let cf = new ClassField(curr.name, curr.type_name, null);
            if f_head == null {
                f_head = cf;
                f_tail = cf;
            } else {
                f_tail.next = cf;
                f_tail = cf;
            }
        }
        curr = curr.next;
    }
    let cdef = new ClassDef(name, f_head, tc.classes);
    tc.classes = cdef;
}

func lookup_class_def(tc: TypeChecker, name: string) -> ClassDef {
    let curr = tc.classes;
    while curr != null {
        if curr.name == name {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func lookup_class_field(tc: TypeChecker, class_name: string, field_name: string) -> string {
    let cdef = lookup_class_def(tc, class_name);
    if cdef == null { return ""; }
    let curr = cdef.fields;
    while curr != null {
        if curr.name == field_name {
            return curr.type_name;
        }
        curr = curr.next;
    }
    return "";
}

func tc_report_error(tc: TypeChecker, msg: string, line: int) {
    if line > 0 {
        println("❌ Type Error [Line " + rz_int_to_str(line) + "]: " + msg);
    } else {
        println("❌ Type Error: " + msg);
    }
    tc.error_count = tc.error_count + 1;
}

func tc_report_warning(tc: TypeChecker, msg: string, line: int) {
    if line > 0 {
        println("⚠️ Semantic Warning [Line " + rz_int_to_str(line) + "]: " + msg);
    } else {
        println("⚠️ Semantic Warning: " + msg);
    }
    tc.warning_count = tc.warning_count + 1;
}

// ------------------------------------------------------------------------------
// 2. Trait Solver & Interface Conformance
// ------------------------------------------------------------------------------

func register_trait_def(tc: TypeChecker, name: string, methods_ast: AstNode) {
    let m_head: TraitMethod = null;
    let m_tail: TraitMethod = null;
    let curr = methods_ast;
    while curr != null {
        if curr.kind == NODE_FUNC_DECL() {
            let m = new TraitMethod(curr.name, curr.type_name, curr.op, null);
            if m_head == null {
                m_head = m;
                m_tail = m;
            } else {
                m_tail.next = m;
                m_tail = m;
            }
        }
        curr = curr.next;
    }
    let tdef = new TraitDef(name, m_head, tc.traits);
    tc.traits = tdef;
}

func lookup_trait_def(tc: TypeChecker, name: string) -> TraitDef {
    let curr = tc.traits;
    while curr != null {
        if curr.name == name {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func register_impl_def(tc: TypeChecker, trait_name: string, target_type: string, methods_ast: AstNode) {
    let m_head: TraitMethod = null;
    let m_tail: TraitMethod = null;
    let curr = methods_ast;
    while curr != null {
        if curr.kind == NODE_FUNC_DECL() {
            let m = new TraitMethod(curr.name, curr.type_name, curr.op, null);
            if m_head == null {
                m_head = m;
                m_tail = m;
            } else {
                m_tail.next = m;
                m_tail = m;
            }
        }
        curr = curr.next;
    }
    let idef = new ImplDef(trait_name, target_type, m_head, tc.impls);
    tc.impls = idef;
}

func lookup_impl_def(tc: TypeChecker, trait_name: string, target_type: string) -> ImplDef {
    let curr = tc.impls;
    while curr != null {
        if curr.trait_name == trait_name && curr.target_type == target_type {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func verify_trait_conformance(tc: TypeChecker, impl_node: AstNode) {
    if impl_node == null { return; }
    let trait_name = impl_node.str_val;
    if trait_name == "" { return; }
    let target_type = impl_node.name;
    let line = impl_node.line;

    let tdef = lookup_trait_def(tc, trait_name);
    if tdef == null {
        tc_report_error(tc, "Implementation references undefined trait '" + trait_name + "'", line);
        return;
    }

    let req_m = tdef.methods;
    while req_m != null {
        let found = false;
        let impl_m = impl_node.child1;
        while impl_m != null {
            if impl_m.kind == NODE_FUNC_DECL() && impl_m.name == req_m.name {
                found = true;
                if req_m.ret_type != "void" && req_m.ret_type != "" && impl_m.type_name != req_m.ret_type {
                    tc_report_error(tc, "Method '" + req_m.name + "' in impl '" + trait_name + "' for '" + target_type + "' returns '" + impl_m.type_name + "', expected '" + req_m.ret_type + "'", impl_m.line);
                }
            }
            impl_m = impl_m.next;
        }
        if !found {
            tc_report_error(tc, "Type '" + target_type + "' does not fully implement trait '" + trait_name + "': missing required method '" + req_m.name + "'", line);
        }
        req_m = req_m.next;
    }
}

func resolve_trait_method(tc: TypeChecker, target_type: string, method_name: string) -> string {
    let curr = tc.impls;
    while curr != null {
        if curr.target_type == target_type {
            let m = curr.methods;
            while m != null {
                if m.name == method_name {
                    return m.ret_type;
                }
                m = m.next;
            }
        }
        curr = curr.next;
    }
    return "";
}

// ------------------------------------------------------------------------------
// 3. Generic Monomorphizer
// ------------------------------------------------------------------------------

func record_mono_entry(tc: TypeChecker, generic_name: string, concrete_type: string, spec_name: string) {
    let entry = new MonoEntry(generic_name, concrete_type, spec_name, tc.mono_table);
    tc.mono_table = entry;
}

func lookup_mono_entry(tc: TypeChecker, generic_name: string, concrete_type: string) -> string {
    let curr = tc.mono_table;
    while curr != null {
        if curr.generic_name == generic_name && curr.concrete_type == concrete_type {
            return curr.specialized_name;
        }
        curr = curr.next;
    }
    return "";
}

func substitute_type_in_ast(node: AstNode, param_name: string, concrete_type: string) {
    if node == null { return; }
    if node.type_name == param_name {
        node.type_name = concrete_type;
    }
    substitute_type_in_ast(node.child1, param_name, concrete_type);
    substitute_type_in_ast(node.child2, param_name, concrete_type);
    substitute_type_in_ast(node.child3, param_name, concrete_type);
    substitute_type_in_ast(node.child4, param_name, concrete_type);
    substitute_type_in_ast(node.next, param_name, concrete_type);
}

func find_generic_decl(prog: AstNode, name: string, kind: int) -> AstNode {
    let curr = prog.child1;
    while curr != null {
        if curr.kind == kind && curr.name == name && curr.op != "" {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func monomorphize_class_instantiation(tc: TypeChecker, prog: AstNode, new_node: AstNode) {
    if new_node == null || new_node.op == "" { return; }

    let gen_name = new_node.name;
    let concrete_type = new_node.op;
    let spec_name = gen_name + "__" + concrete_type;

    let existing = lookup_mono_entry(tc, gen_name, concrete_type);
    if existing == "" {
        let gen_cls = find_generic_decl(prog, gen_name, NODE_CLASS_DECL());
        if gen_cls != null {
            let spec_cls = clone_ast_node(gen_cls);
            spec_cls.next = null;
            spec_cls.name = spec_name;
            spec_cls.type_name = spec_name;
            let param_name = gen_cls.op;
            spec_cls.op = "";
            substitute_type_in_ast(spec_cls, param_name, concrete_type);

            let tail = prog.child1;
            while tail.next != null {
                tail = tail.next;
            }
            tail.next = spec_cls;
            record_mono_entry(tc, gen_name, concrete_type, spec_name);
        }
    }

    new_node.name = spec_name;
    new_node.type_name = spec_name;
    new_node.op = "";
}

func monomorphize_expr(tc: TypeChecker, prog: AstNode, expr: AstNode) {
    if expr == null { return; }

    if expr.kind == NODE_NEW() && expr.op != "" {
        monomorphize_class_instantiation(tc, prog, expr);
    }

    monomorphize_expr(tc, prog, expr.child1);
    monomorphize_expr(tc, prog, expr.child2);
    monomorphize_expr(tc, prog, expr.child3);
    monomorphize_expr(tc, prog, expr.child4);
    monomorphize_expr(tc, prog, expr.next);
}

func monomorphize_statement(tc: TypeChecker, prog: AstNode, stmt: AstNode) {
    if stmt == null { return; }

    monomorphize_expr(tc, prog, stmt.child1);
    monomorphize_expr(tc, prog, stmt.child2);
    monomorphize_expr(tc, prog, stmt.child3);
    monomorphize_expr(tc, prog, stmt.child4);

    monomorphize_statement(tc, prog, stmt.next);
}

func monomorphize_program(prog: AstNode) -> AstNode {
    if prog == null { return null; }
    let tc = make_type_checker();

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            monomorphize_statement(tc, prog, decl.child2);
        }
        decl = decl.next;
    }
    return prog;
}

// ------------------------------------------------------------------------------
// 4. ARC Borrow Lifetime Analyzer
// ------------------------------------------------------------------------------

func is_copy_type(type_name: string) -> int {
    if type_name == "int" || type_name == "bool" || type_name == "char" || type_name == "float" || type_name == "void" {
        return 1;
    }
    return 0;
}

func add_borrow_var(tc: TypeChecker, name: string, type_name: string, state: int, line: int) {
    let b = new BorrowVar(name, type_name, state, "", line, tc.borrow_vars);
    tc.borrow_vars = b;
}

func lookup_borrow_var(tc: TypeChecker, name: string) -> BorrowVar {
    let curr = tc.borrow_vars;
    while curr != null {
        if curr.name == name {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func mark_var_moved(tc: TypeChecker, from_var: string, to_var: string, line: int) {
    let b = lookup_borrow_var(tc, from_var);
    if b != null {
        if is_copy_type(b.type_name) == 0 {
            b.state = BORROW_MOVED();
            b.moved_to = to_var;
        }
    }
}

func restore_var_ownership(tc: TypeChecker, name: string) {
    let b = lookup_borrow_var(tc, name);
    if b != null {
        b.state = BORROW_OWNED();
        b.moved_to = "";
    }
}

func check_expr_borrow_use(tc: TypeChecker, expr: AstNode) {
    if expr == null { return; }

    if expr.kind == NODE_IDENT() {
        let b = lookup_borrow_var(tc, expr.name);
        if b != null && b.state == BORROW_MOVED() {
            tc_report_error(tc, "Use of moved value '" + expr.name + "' (ownership was transferred to '" + b.moved_to + "')", expr.line);
        }
    }

    check_expr_borrow_use(tc, expr.child1);
    check_expr_borrow_use(tc, expr.child2);
    check_expr_borrow_use(tc, expr.child3);
    check_expr_borrow_use(tc, expr.child4);
    check_expr_borrow_use(tc, expr.next);
}

func check_stmt_borrow(tc: TypeChecker, stmt: AstNode) {
    if stmt == null { return; }

    let kind = stmt.kind;

    if kind == NODE_VAR_DECL() {
        let init_expr = stmt.child1;
        if init_expr != null {
            check_expr_borrow_use(tc, init_expr);
            // If initialized from an existing identifier of ARC type, transfer ownership
            if init_expr.kind == NODE_IDENT() {
                mark_var_moved(tc, init_expr.name, stmt.name, stmt.line);
            }
        }
        add_borrow_var(tc, stmt.name, stmt.type_name, BORROW_OWNED(), stmt.line);
    } else if kind == NODE_ASSIGN() {
        let target = stmt.child1;
        let val = stmt.child2;
        if target != null && target.kind == NODE_IDENT() {
            restore_var_ownership(tc, target.name);
        }
        check_expr_borrow_use(tc, val);
        if val != null && val.kind == NODE_IDENT() && target != null && target.kind == NODE_IDENT() {
            mark_var_moved(tc, val.name, target.name, stmt.line);
        }
    } else {
        check_expr_borrow_use(tc, stmt.child1);
        check_expr_borrow_use(tc, stmt.child2);
        check_expr_borrow_use(tc, stmt.child3);
        check_expr_borrow_use(tc, stmt.child4);
    }

    check_stmt_borrow(tc, stmt.next);
}

func check_cyclic_reference_hazards(tc: TypeChecker) {
    let c1 = tc.classes;
    while c1 != null {
        let f1 = c1.fields;
        while f1 != null {
            if f1.type_name != c1.name {
                let target_cls = lookup_class_def(tc, f1.type_name);
                if target_cls != null {
                    let f2 = target_cls.fields;
                    while f2 != null {
                        if f2.type_name == c1.name {
                            tc_report_warning(tc, "Potential strong reference cycle detected between classes '" + c1.name + "' and '" + target_cls.name + "'. Consider using Weak<T> to prevent memory leaks.", 0);
                        }
                        f2 = f2.next;
                    }
                }
            }
            f1 = f1.next;
        }
        c1 = c1.next;
    }
}

func analyze_borrows(tc: TypeChecker, prog: AstNode) -> int {
    if prog == null { return 0; }
    tc.borrow_vars = null;

    check_cyclic_reference_hazards(tc);

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            tc.borrow_vars = null;
            check_stmt_borrow(tc, decl.child2);
        }
        decl = decl.next;
    }

    return tc.error_count;
}

// ------------------------------------------------------------------------------
// 5. Type Compatibility & Bidirectional Type Checking
// ------------------------------------------------------------------------------

func is_type_compatible(expected: string, actual: string) -> int {
    if expected == actual { return 1; }
    if expected == "void" && actual == "void" { return 1; }
    if expected == "any" || actual == "any" { return 1; }
    if actual == "unknown" || expected == "unknown" { return 1; }

    // Null compatibility with classes and pointer types
    if actual == "null" {
        if expected != "int" && expected != "bool" && expected != "char" && expected != "float" && expected != "void" {
            return 1;
        }
        return 0;
    }

    // Integer widening
    if expected == "int" {
        if actual == "i8" || actual == "u8" || actual == "i16" || actual == "u16" || actual == "i32" || actual == "u32" || actual == "i64" || actual == "u64" || actual == "usize" || actual == "isize" {
            return 1;
        }
    }
    // Float widening
    if expected == "float" {
        if actual == "f32" || actual == "f64" || actual == "int" {
            return 1;
        }
    }

    return 0;
}

func check_expression_type(tc: TypeChecker, expr: AstNode) -> string {
    if expr == null { return "void"; }

    let kind = expr.kind;

    if kind == NODE_LITERAL_INT() {
        return "int";
    }
    if kind == NODE_LITERAL_STR() {
        return "string";
    }
    if kind == NODE_LITERAL_BOOL() {
        return "bool";
    }
    if kind == NODE_LITERAL_CHAR() {
        return "char";
    }
    if kind == NODE_LITERAL_NULL() {
        return "null";
    }
    if kind == NODE_IDENT() {
        let sym = lookup_symbol(tc, expr.name);
        if sym == null {
            tc_report_error(tc, "Undefined identifier '" + expr.name + "'", expr.line);
            return "unknown";
        }
        expr.type_name = sym.type_name;
        return sym.type_name;
    }
    if kind == NODE_BIN_OP() {
        let t_left = check_expression_type(tc, expr.child1);
        let t_right = check_expression_type(tc, expr.child2);

        if expr.op == "+" {
            if t_left == "string" || t_right == "string" {
                expr.type_name = "string";
                return "string";
            }
            if t_left == "float" || t_right == "float" {
                expr.type_name = "float";
                return "float";
            }
            expr.type_name = "int";
            return "int";
        }
        if expr.op == "-" || expr.op == "*" || expr.op == "/" || expr.op == "%" {
            if t_left == "float" || t_right == "float" {
                expr.type_name = "float";
                return "float";
            }
            expr.type_name = "int";
            return "int";
        }
        if expr.op == "==" || expr.op == "!=" || expr.op == "<" || expr.op == "<=" || expr.op == ">" || expr.op == ">=" || expr.op == "&&" || expr.op == "||" {
            expr.type_name = "bool";
            return "bool";
        }
        if expr.op == "&" || expr.op == "|" || expr.op == "^" || expr.op == "<<" || expr.op == ">>" {
            expr.type_name = "int";
            return "int";
        }
        return "int";
    }
    if kind == NODE_UNARY_OP() {
        let t_operand = check_expression_type(tc, expr.child1);
        if expr.op == "!" {
            expr.type_name = "bool";
            return "bool";
        }
        expr.type_name = t_operand;
        return t_operand;
    }
    if kind == NODE_CALL() {
        let func_name = expr.name;
        if func_name == "println" {
            if expr.child2 != null {
                check_expression_type(tc, expr.child2);
            }
            expr.type_name = "void";
            return "void";
        }

        let sym = lookup_symbol(tc, func_name);
        if sym == null {
            tc_report_error(tc, "Call to undefined function '" + func_name + "'", expr.line);
            return "unknown";
        }

        // Validate argument types
        let arg = expr.child2;
        while arg != null {
            check_expression_type(tc, arg);
            arg = arg.next;
        }

        expr.type_name = sym.type_name;
        return sym.type_name;
    }
    if kind == NODE_NEW() {
        let class_sym = lookup_symbol(tc, expr.name);
        if class_sym == null {
            tc_report_error(tc, "Instantiation of undefined class '" + expr.name + "'", expr.line);
        }
        let arg = expr.child1;
        while arg != null {
            check_expression_type(tc, arg);
            arg = arg.next;
        }
        expr.type_name = expr.name;
        return expr.name;
    }
    if kind == NODE_MEMBER() {
        let obj_type = check_expression_type(tc, expr.child1);
        let m_name = expr.name;

        // Dynamic class field lookup
        let f_ty = lookup_class_field(tc, obj_type, m_name);
        if f_ty != "" {
            expr.type_name = f_ty;
            return f_ty;
        }

        // Trait method resolution
        let tr_ty = resolve_trait_method(tc, obj_type, m_name);
        if tr_ty != "" {
            expr.type_name = tr_ty;
            return tr_ty;
        }

        // Compiler internal classes fallback
        if obj_type == "TypeChecker" {
            if m_name == "symbols" { expr.type_name = "Symbol"; return "Symbol"; }
            if m_name == "scope_level" || m_name == "error_count" || m_name == "warning_count" { expr.type_name = "int"; return "int"; }
            if m_name == "current_func_ret" || m_name == "current_func_name" { expr.type_name = "string"; return "string"; }
            if m_name == "classes" { expr.type_name = "ClassDef"; return "ClassDef"; }
            if m_name == "traits" { expr.type_name = "TraitDef"; return "TraitDef"; }
            if m_name == "impls" { expr.type_name = "ImplDef"; return "ImplDef"; }
            if m_name == "mono_table" { expr.type_name = "MonoEntry"; return "MonoEntry"; }
            if m_name == "borrow_vars" { expr.type_name = "BorrowVar"; return "BorrowVar"; }
        }
        if obj_type == "Symbol" {
            if m_name == "next" { expr.type_name = "Symbol"; return "Symbol"; }
            if m_name == "name" || m_name == "type_name" { expr.type_name = "string"; return "string"; }
            if m_name == "kind" || m_name == "scope_level" || m_name == "is_mut" || m_name == "borrow_state" { expr.type_name = "int"; return "int"; }
            if m_name == "decl_node" { expr.type_name = "AstNode"; return "AstNode"; }
        }
        if obj_type == "ClassDef" {
            if m_name == "name" { expr.type_name = "string"; return "string"; }
            if m_name == "fields" { expr.type_name = "ClassField"; return "ClassField"; }
            if m_name == "next" { expr.type_name = "ClassDef"; return "ClassDef"; }
        }
        if obj_type == "ClassField" {
            if m_name == "name" || m_name == "type_name" { expr.type_name = "string"; return "string"; }
            if m_name == "next" { expr.type_name = "ClassField"; return "ClassField"; }
        }
        if obj_type == "TraitDef" {
            if m_name == "name" { expr.type_name = "string"; return "string"; }
            if m_name == "methods" { expr.type_name = "TraitMethod"; return "TraitMethod"; }
            if m_name == "next" { expr.type_name = "TraitDef"; return "TraitDef"; }
        }
        if obj_type == "TraitMethod" {
            if m_name == "name" || m_name == "ret_type" || m_name == "param_types" { expr.type_name = "string"; return "string"; }
            if m_name == "next" { expr.type_name = "TraitMethod"; return "TraitMethod"; }
        }
        if obj_type == "ImplDef" {
            if m_name == "trait_name" || m_name == "target_type" { expr.type_name = "string"; return "string"; }
            if m_name == "methods" { expr.type_name = "TraitMethod"; return "TraitMethod"; }
            if m_name == "next" { expr.type_name = "ImplDef"; return "ImplDef"; }
        }
        if obj_type == "MonoEntry" {
            if m_name == "generic_name" || m_name == "concrete_type" || m_name == "specialized_name" { expr.type_name = "string"; return "string"; }
            if m_name == "next" { expr.type_name = "MonoEntry"; return "MonoEntry"; }
        }
        if obj_type == "BorrowVar" {
            if m_name == "name" || m_name == "type_name" || m_name == "moved_to" { expr.type_name = "string"; return "string"; }
            if m_name == "state" || m_name == "line" { expr.type_name = "int"; return "int"; }
            if m_name == "next" { expr.type_name = "BorrowVar"; return "BorrowVar"; }
        }
        if obj_type == "Parser" {
            if m_name == "curr" { expr.type_name = "Token"; return "Token"; }
            if m_name == "pos" || m_name == "len" { expr.type_name = "int"; return "int"; }
        }
        if obj_type == "Token" {
            if m_name == "next" { expr.type_name = "Token"; return "Token"; }
            if m_name == "text" { expr.type_name = "string"; return "string"; }
            if m_name == "kind" || m_name == "int_val" || m_name == "line" || m_name == "col" { expr.type_name = "int"; return "int"; }
        }
        if obj_type == "AstNode" {
            if m_name == "child1" || m_name == "child2" || m_name == "child3" || m_name == "child4" || m_name == "next" { expr.type_name = "AstNode"; return "AstNode"; }
            if m_name == "kind" || m_name == "int_val" || m_name == "line" || m_name == "col" { expr.type_name = "int"; return "int"; }
            if m_name == "name" || m_name == "type_name" || m_name == "op" || m_name == "str_val" { expr.type_name = "string"; return "string"; }
        }
        if obj_type == "SsaBlockRef" {
            if m_name == "name" { expr.type_name = "string"; return "string"; }
            if m_name == "next" { expr.type_name = "SsaBlockRef"; return "SsaBlockRef"; }
        }
        if obj_type == "SsaInst" {
            if m_name == "id" || m_name == "kind" || m_name == "int_val" || m_name == "is_dead" { expr.type_name = "int"; return "int"; }
            if m_name == "dest" || m_name == "type_name" || m_name == "op" || m_name == "arg1" || m_name == "arg2" || m_name == "arg3" || m_name == "str_val" || m_name == "target_label" || m_name == "false_label" { expr.type_name = "string"; return "string"; }
            if m_name == "next" { expr.type_name = "SsaInst"; return "SsaInst"; }
        }
        if obj_type == "BasicBlock" {
            if m_name == "id" || m_name == "inst_count" || m_name == "pred_count" || m_name == "succ_count" || m_name == "is_terminated" { expr.type_name = "int"; return "int"; }
            if m_name == "label" { expr.type_name = "string"; return "string"; }
            if m_name == "inst_head" || m_name == "inst_tail" { expr.type_name = "SsaInst"; return "SsaInst"; }
            if m_name == "preds" || m_name == "succs" { expr.type_name = "SsaBlockRef"; return "SsaBlockRef"; }
            if m_name == "next" { expr.type_name = "BasicBlock"; return "BasicBlock"; }
        }
        if obj_type == "SsaParam" {
            if m_name == "name" || m_name == "type_name" { expr.type_name = "string"; return "string"; }
            if m_name == "next" { expr.type_name = "SsaParam"; return "SsaParam"; }
        }
        if obj_type == "SsaFunction" {
            if m_name == "name" || m_name == "ret_type" { expr.type_name = "string"; return "string"; }
            if m_name == "params" { expr.type_name = "SsaParam"; return "SsaParam"; }
            if m_name == "block_head" || m_name == "block_tail" { expr.type_name = "BasicBlock"; return "BasicBlock"; }
            if m_name == "block_count" || m_name == "var_counter" || m_name == "is_inlinable" { expr.type_name = "int"; return "int"; }
            if m_name == "next" { expr.type_name = "SsaFunction"; return "SsaFunction"; }
        }
        if obj_type == "SsaProgram" {
            if m_name == "functions" { expr.type_name = "SsaFunction"; return "SsaFunction"; }
            if m_name == "next" { expr.type_name = "SsaProgram"; return "SsaProgram"; }
        }
        if obj_type == "ConstBinding" {
            if m_name == "name" || m_name == "str_val" { expr.type_name = "string"; return "string"; }
            if m_name == "kind" || m_name == "int_val" { expr.type_name = "int"; return "int"; }
            if m_name == "next" { expr.type_name = "ConstBinding"; return "ConstBinding"; }
        }
        if obj_type == "InlinableFunc" {
            if m_name == "name" || m_name == "ret_type" { expr.type_name = "string"; return "string"; }
            if m_name == "params" || m_name == "ret_expr" { expr.type_name = "AstNode"; return "AstNode"; }
            if m_name == "next" { expr.type_name = "InlinableFunc"; return "InlinableFunc"; }
        }
        if obj_type == "OptStats" {
            if m_name == "const_folded" || m_name == "dead_stmts_removed" || m_name == "funcs_inlined" || m_name == "loops_hoisted" { expr.type_name = "int"; return "int"; }
        }
        if obj_type == "BinaryBuffer" {
            if m_name == "hex_data" { expr.type_name = "string"; return "string"; }
            if m_name == "size" { expr.type_name = "int"; return "int"; }
        }
        if obj_type == "NativeSection" {
            if m_name == "name" { expr.type_name = "string"; return "string"; }
            if m_name == "sec_type" || m_name == "flags" || m_name == "vaddr" || m_name == "offset" || m_name == "size" || m_name == "align" { expr.type_name = "int"; return "int"; }
            if m_name == "data" { expr.type_name = "BinaryBuffer"; return "BinaryBuffer"; }
            if m_name == "next" { expr.type_name = "NativeSection"; return "NativeSection"; }
        }
        if obj_type == "NativeSymbol" {
            if m_name == "name" { expr.type_name = "string"; return "string"; }
            if m_name == "value" || m_name == "size" || m_name == "sec_index" || m_name == "sym_type" || m_name == "binding" { expr.type_name = "int"; return "int"; }
            if m_name == "next" { expr.type_name = "NativeSymbol"; return "NativeSymbol"; }
        }
        if obj_type == "NativeReloc" {
            if m_name == "offset" || m_name == "sym_index" || m_name == "rel_type" || m_name == "addend" { expr.type_name = "int"; return "int"; }
            if m_name == "next" { expr.type_name = "NativeReloc"; return "NativeReloc"; }
        }

        expr.type_name = "int";
        return "int";
    }
    if kind == NODE_METHOD_CALL() {
        let obj_type = check_expression_type(tc, expr.child1);
        let arg = expr.child2;
        while arg != null {
            check_expression_type(tc, arg);
            arg = arg.next;
        }

        let tr_ty = resolve_trait_method(tc, obj_type, expr.name);
        if tr_ty != "" {
            expr.type_name = tr_ty;
            return tr_ty;
        }
        expr.type_name = "void";
        return "void";
    }
    if kind == NODE_INDEX() {
        check_expression_type(tc, expr.child1);
        check_expression_type(tc, expr.child2);
        expr.type_name = "int";
        return "int";
    }
    if kind == NODE_TRY() || kind == NODE_COMPTIME_EXPR() || kind == NODE_AWAIT() {
        let t_inner = check_expression_type(tc, expr.child1);
        expr.type_name = t_inner;
        return t_inner;
    }
    if kind == NODE_MACRO_CALL() {
        let arg = expr.child1;
        while arg != null {
            check_expression_type(tc, arg);
            arg = arg.next;
        }
        expr.type_name = "void";
        return "void";
    }
    if kind == NODE_CLOSURE() {
        expr.type_name = "closure";
        return "closure";
    }

    return "unknown";
}

// ------------------------------------------------------------------------------
// 6. Statement Type Checking
// ------------------------------------------------------------------------------

func check_statement_type(tc: TypeChecker, stmt: AstNode) {
    if stmt == null { return; }

    let kind = stmt.kind;

    if kind == NODE_VAR_DECL() {
        let val_type = "void";
        if stmt.child1 != null {
            val_type = check_expression_type(tc, stmt.child1);
        }
        let var_type = stmt.type_name;
        if var_type == "" || var_type == "unknown" {
            var_type = val_type;
            stmt.type_name = var_type;
        } else if val_type != "void" && val_type != "unknown" {
            if is_type_compatible(var_type, val_type) == 0 {
                tc_report_error(tc, "Mismatched types in variable declaration: expected '" + var_type + "', got '" + val_type + "'", stmt.line);
            }
        }
        define_symbol_with_decl(tc, stmt.name, var_type, SYM_VAR(), 1, stmt);
    } else if kind == NODE_ASSIGN() {
        let t_target = check_expression_type(tc, stmt.child1);
        let t_val = check_expression_type(tc, stmt.child2);
        if t_target != "unknown" && t_val != "unknown" {
            if is_type_compatible(t_target, t_val) == 0 {
                tc_report_error(tc, "Assignment type mismatch: cannot assign '" + t_val + "' to target of type '" + t_target + "'", stmt.line);
            }
        }
    } else if kind == NODE_FIELD_ASSIGN() {
        check_expression_type(tc, stmt.child1);
        check_expression_type(tc, stmt.child2);
    } else if kind == NODE_INDEX_ASSIGN() {
        check_expression_type(tc, stmt.child1);
        check_expression_type(tc, stmt.child2);
        if stmt.child3 != null { check_expression_type(tc, stmt.child3); }
    } else if kind == NODE_IF() {
        check_expression_type(tc, stmt.child1);
        check_statement_type(tc, stmt.child2);
        if stmt.child3 != null {
            check_statement_type(tc, stmt.child3);
        }
    } else if kind == NODE_WHILE() {
        check_expression_type(tc, stmt.child1);
        check_statement_type(tc, stmt.child2);
    } else if kind == NODE_FOR() {
        enter_scope(tc);
        if stmt.child1 != null { check_statement_type(tc, stmt.child1); }
        if stmt.child2 != null { check_expression_type(tc, stmt.child2); }
        if stmt.child3 != null { check_statement_type(tc, stmt.child3); }
        if stmt.child4 != null { check_statement_type(tc, stmt.child4); }
        exit_scope(tc);
    } else if kind == NODE_MATCH() {
        check_expression_type(tc, stmt.child1);
        let arm = stmt.child2;
        while arm != null {
            if arm.child2 != null { check_expression_type(tc, arm.child2); }
            if arm.child3 != null { check_statement_type(tc, arm.child3); }
            arm = arm.next;
        }
    } else if kind == NODE_UNSAFE_BLOCK() || kind == NODE_COMPTIME_STMT() {
        check_statement_type(tc, stmt.child1);
    } else if kind == NODE_ANNOTATION() {
        check_statement_type(tc, stmt.child1);
    } else if kind == NODE_IMPL_DECL() {
        let m = stmt.child1;
        while m != null {
            check_statement_type(tc, m);
            m = m.next;
        }
    } else if kind == NODE_RETURN() {
        let ret_type = "void";
        if stmt.child1 != null {
            ret_type = check_expression_type(tc, stmt.child1);
        }
        if tc.current_func_ret != "" && tc.current_func_ret != "void" && stmt.child1 == null {
            tc_report_error(tc, "Expected return value of type '" + tc.current_func_ret + "' in function '" + tc.current_func_name + "'", stmt.line);
        } else if tc.current_func_ret == "void" && stmt.child1 != null {
            tc_report_error(tc, "Cannot return a value from void function '" + tc.current_func_name + "'", stmt.line);
        } else if stmt.child1 != null && tc.current_func_ret != "" && tc.current_func_ret != "void" {
            if is_type_compatible(tc.current_func_ret, ret_type) == 0 {
                tc_report_error(tc, "Return type mismatch in function '" + tc.current_func_name + "': expected '" + tc.current_func_ret + "', got '" + ret_type + "'", stmt.line);
            }
        }
    } else if kind == NODE_BLOCK() {
        enter_scope(tc);
        let s = stmt.child1;
        while s != null {
            check_statement_type(tc, s);
            s = s.next;
        }
        exit_scope(tc);
    } else if kind == NODE_EXPR_STMT() {
        check_expression_type(tc, stmt.child1);
    }
}

// ------------------------------------------------------------------------------
// 7. Whole Program Semantic Analysis Pipeline
// ------------------------------------------------------------------------------

func check_program_types(tc: TypeChecker, prog: AstNode) -> int {
    if prog == null { return 0; }

    // Pass 1: Built-in runtime symbols
    define_symbol(tc, "rz_create_string", "string", SYM_FUNC());
    define_symbol(tc, "rz_str_concat", "string", SYM_FUNC());
    define_symbol(tc, "rz_str_len", "int", SYM_FUNC());
    define_symbol(tc, "rz_char_at", "int", SYM_FUNC());
    define_symbol(tc, "rz_substring", "string", SYM_FUNC());
    define_symbol(tc, "rz_char_to_str", "string", SYM_FUNC());
    define_symbol(tc, "rz_int_to_str", "string", SYM_FUNC());
    define_symbol(tc, "rz_str_eq", "int", SYM_FUNC());
    define_symbol(tc, "rz_read_file", "string", SYM_FUNC());
    define_symbol(tc, "rz_write_file", "int", SYM_FUNC());
    define_symbol(tc, "rz_write_binary_file", "int", SYM_FUNC());
    define_symbol(tc, "rz_file_exists", "int", SYM_FUNC());
    define_symbol(tc, "rz_exec", "int", SYM_FUNC());
    define_symbol(tc, "rz_get_arg_count", "int", SYM_FUNC());
    define_symbol(tc, "rz_get_arg", "string", SYM_FUNC());
    define_symbol(tc, "rz_get_env", "string", SYM_FUNC());
    define_symbol(tc, "rz_print_str", "void", SYM_FUNC());
    define_symbol(tc, "rz_print_int", "void", SYM_FUNC());
    define_symbol(tc, "rz_compiler_banner", "void", SYM_FUNC());
    define_symbol(tc, "println", "void", SYM_FUNC());

    // Pass 2: Pre-register user classes, enums, traits, impls, and functions
    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_CLASS_DECL() {
            define_symbol(tc, decl.name, decl.name, SYM_CLASS());
            register_class_def(tc, decl.name, decl.child1);
        } else if decl.kind == NODE_ENUM_DECL() {
            define_symbol(tc, decl.name, decl.name, SYM_ENUM());
        } else if decl.kind == NODE_TRAIT_DECL() {
            define_symbol(tc, decl.name, decl.name, SYM_TRAIT());
            register_trait_def(tc, decl.name, decl.child1);
        } else if decl.kind == NODE_IMPL_DECL() {
            let tr_name = decl.str_val;
            let tgt_type = decl.name;
            if tr_name != "" {
                define_symbol(tc, tr_name, tgt_type, SYM_IMPL());
                register_impl_def(tc, tr_name, tgt_type, decl.child1);
            }
        } else if decl.kind == NODE_FUNC_DECL() || decl.kind == NODE_EXTERN_DECL() {
            define_symbol_with_decl(tc, decl.name, decl.type_name, SYM_FUNC(), 0, decl);
        } else if decl.kind == NODE_ANNOTATION() && decl.child1 != null {
            let inner = decl.child1;
            if inner.kind == NODE_CLASS_DECL() {
                define_symbol(tc, inner.name, inner.name, SYM_CLASS());
                register_class_def(tc, inner.name, inner.child1);
            } else if inner.kind == NODE_ENUM_DECL() {
                define_symbol(tc, inner.name, inner.name, SYM_ENUM());
            } else if inner.kind == NODE_TRAIT_DECL() {
                define_symbol(tc, inner.name, inner.name, SYM_TRAIT());
                register_trait_def(tc, inner.name, inner.child1);
            } else if inner.kind == NODE_FUNC_DECL() || inner.kind == NODE_EXTERN_DECL() {
                define_symbol_with_decl(tc, inner.name, inner.type_name, SYM_FUNC(), 0, inner);
            }
        }
        decl = decl.next;
    }

    // Pass 3: Trait Conformance Verification
    decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_IMPL_DECL() {
            verify_trait_conformance(tc, decl);
        }
        decl = decl.next;
    }

    // Pass 4: Type Check Function Bodies & Statements
    decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            enter_scope(tc);
            tc.current_func_ret = decl.type_name;
            tc.current_func_name = decl.name;

            let param = decl.child1;
            while param != null {
                define_symbol_with_decl(tc, param.name, param.type_name, SYM_PARAM(), 0, param);
                param = param.next;
            }

            check_statement_type(tc, decl.child2);
            exit_scope(tc);
        } else if decl.kind == NODE_IMPL_DECL() {
            let m = decl.child1;
            while m != null {
                if m.kind == NODE_FUNC_DECL() {
                    enter_scope(tc);
                    tc.current_func_ret = m.type_name;
                    tc.current_func_name = m.name;
                    define_symbol(tc, "this", decl.name, SYM_PARAM());
                    let m_param = m.child1;
                    while m_param != null {
                        define_symbol_with_decl(tc, m_param.name, m_param.type_name, SYM_PARAM(), 0, m_param);
                        m_param = m_param.next;
                    }
                    check_statement_type(tc, m.child2);
                    exit_scope(tc);
                }
                m = m.next;
            }
        } else if decl.kind != NODE_CLASS_DECL() && decl.kind != NODE_ENUM_DECL() && decl.kind != NODE_TRAIT_DECL() && decl.kind != NODE_EXTERN_DECL() {
            check_statement_type(tc, decl);
        }
        decl = decl.next;
    }

    return tc.error_count;
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler - Optimizer & SSA IR Engine (ADV-06 M6-T03)
// ==============================================================================
// Pure Roze Optimizer Pipeline:
// 1. Typed SSA Intermediate Representation & Basic Block Construction
// 2. Control Flow Graph (CFG) Analysis & Edge Resolution
// 3. Constant Folding & Algebraic Simplification
// 4. Dead Code Elimination (DCE) & Branch Pruning
// 5. Leaf Function Inlining
// 6. Loop Invariant Code Motion (LICM / Hoisting)
// ==============================================================================


// --- Section 1: SSA IR Constructors & Basic Block Operations ---

func make_ssa_inst(id: int, kind: int, dest: string, type_name: string, op: string, arg1: string, arg2: string, int_val: int, str_val: string, target_label: string, false_label: string) -> SsaInst {
    return new SsaInst(id, kind, dest, type_name, op, arg1, arg2, "", int_val, str_val, target_label, false_label, 0, null);
}

func make_basic_block(id: int, label: string) -> BasicBlock {
    return new BasicBlock(id, label, null, null, 0, 0, 0, null, null, 0, null);
}

func make_ssa_param(name: string, type_name: string) -> SsaParam {
    return new SsaParam(name, type_name, null);
}

func make_ssa_function(name: string, ret_type: string) -> SsaFunction {
    return new SsaFunction(name, ret_type, null, null, null, 0, 0, 0, null);
}

func make_ssa_program() -> SsaProgram {
    return new SsaProgram(null, null);
}

func bb_append_inst(bb: BasicBlock, inst: SsaInst) {
    if bb == null || inst == null { return; }
    if bb.inst_head == null {
        bb.inst_head = inst;
        bb.inst_tail = inst;
    } else {
        bb.inst_tail.next = inst;
        bb.inst_tail = inst;
    }
    bb.inst_count = bb.inst_count + 1;
    if inst.kind == SSA_BR() || inst.kind == SSA_BR_COND() || inst.kind == SSA_RETURN() {
        bb.is_terminated = 1;
    }
}

func fn_append_bb(fn: SsaFunction, bb: BasicBlock) {
    if fn == null || bb == null { return; }
    if fn.block_head == null {
        fn.block_head = bb;
        fn.block_tail = bb;
    } else {
        fn.block_tail.next = bb;
        fn.block_tail = bb;
    }
    fn.block_count = fn.block_count + 1;
}

func fn_new_temp(fn: SsaFunction) -> string {
    let t = "%t" + rz_int_to_str(fn.var_counter);
    fn.var_counter = fn.var_counter + 1;
    return t;
}

func bb_add_pred(bb: BasicBlock, pred_label: string) {
    if bb == null || pred_label == "" { return; }
    let curr = bb.preds;
    while curr != null {
        if curr.name == pred_label { return; }
        curr = curr.next;
    }
    let ref = new SsaBlockRef(pred_label, bb.preds);
    bb.preds = ref;
    bb.pred_count = bb.pred_count + 1;
}

func bb_add_succ(bb: BasicBlock, succ_label: string) {
    if bb == null || succ_label == "" { return; }
    let curr = bb.succs;
    while curr != null {
        if curr.name == succ_label { return; }
        curr = curr.next;
    }
    let ref = new SsaBlockRef(succ_label, bb.succs);
    bb.succs = ref;
    bb.succ_count = bb.succ_count + 1;
}

func fn_find_bb(fn: SsaFunction, label: string) -> BasicBlock {
    let curr = fn.block_head;
    while curr != null {
        if curr.label == label { return curr; }
        curr = curr.next;
    }
    return null;
}

// --- Section 2: CFG Analysis & Dead Block Elimination ---

func resolve_cfg_edges(fn: SsaFunction) {
    if fn == null { return; }

    let bb = fn.block_head;
    while bb != null {
        let inst = bb.inst_head;
        while inst != null {
            if inst.kind == SSA_BR() {
                let tgt_label = inst.target_label;
                bb_add_succ(bb, tgt_label);
                let tgt_bb = fn_find_bb(fn, tgt_label);
                if tgt_bb != null {
                    bb_add_pred(tgt_bb, bb.label);
                }
            } else if inst.kind == SSA_BR_COND() {
                let t_label = inst.target_label;
                let f_label = inst.false_label;
                bb_add_succ(bb, t_label);
                bb_add_succ(bb, f_label);
                let t_bb = fn_find_bb(fn, t_label);
                if t_bb != null {
                    bb_add_pred(t_bb, bb.label);
                }
                let f_bb = fn_find_bb(fn, f_label);
                if f_bb != null {
                    bb_add_pred(f_bb, bb.label);
                }
            }
            inst = inst.next;
        }
        bb = bb.next;
    }
}

func eliminate_dead_basic_blocks(fn: SsaFunction) -> int {
    if fn == null || fn.block_head == null { return 0; }

    let removed = 0;
    let prev: BasicBlock = null;
    let curr = fn.block_head;

    while curr != null {
        let is_entry = 0;
        if curr.label == "entry" {
            is_entry = 1;
        }

        if is_entry == 0 && curr.pred_count == 0 {
            if prev == null {
                fn.block_head = curr.next;
            } else {
                prev.next = curr.next;
            }
            if fn.block_tail == curr {
                fn.block_tail = prev;
            }
            fn.block_count = fn.block_count - 1;
            removed = removed + 1;
            curr = curr.next;
        } else {
            prev = curr;
            curr = curr.next;
        }
    }

    return removed;
}

// --- Section 3: Textual SSA Emission ---

func dump_ssa_inst(inst: SsaInst) -> string {
    if inst == null || inst.is_dead == 1 { return ""; }
    let k = inst.kind;

    if k == SSA_CONST_INT() {
        return "    " + inst.dest + " = const_int " + rz_int_to_str(inst.int_val) + "\n";
    }
    if k == SSA_CONST_STR() {
        return "    " + inst.dest + " = const_str \"" + inst.str_val + "\"\n";
    }
    if k == SSA_CONST_BOOL() {
        if inst.int_val == 1 {
            return "    " + inst.dest + " = const_bool true\n";
        }
        return "    " + inst.dest + " = const_bool false\n";
    }
    if k == SSA_BIN_OP() {
        return "    " + inst.dest + " = " + inst.op + " " + inst.type_name + " " + inst.arg1 + ", " + inst.arg2 + "\n";
    }
    if k == SSA_UNARY_OP() {
        return "    " + inst.dest + " = " + inst.op + " " + inst.type_name + " " + inst.arg1 + "\n";
    }
    if k == SSA_CALL() {
        return "    " + inst.dest + " = call " + inst.type_name + " @" + inst.target_label + "(" + inst.arg1 + ")\n";
    }
    if k == SSA_ALLOC() {
        return "    " + inst.dest + " = alloca " + inst.type_name + "\n";
    }
    if k == SSA_LOAD() {
        return "    " + inst.dest + " = load " + inst.type_name + " " + inst.arg1 + "\n";
    }
    if k == SSA_STORE() {
        return "    store " + inst.type_name + " " + inst.arg1 + ", " + inst.dest + "\n";
    }
    if k == SSA_GET_FIELD() {
        return "    " + inst.dest + " = getfield " + inst.type_name + " " + inst.arg1 + "." + inst.arg2 + "\n";
    }
    if k == SSA_SET_FIELD() {
        return "    setfield " + inst.type_name + " " + inst.arg1 + "." + inst.arg2 + " = " + inst.arg3 + "\n";
    }
    if k == SSA_PHI() {
        return "    " + inst.dest + " = phi " + inst.type_name + " [" + inst.arg1 + "], [" + inst.arg2 + "]\n";
    }
    if k == SSA_BR() {
        return "    br label %" + inst.target_label + "\n";
    }
    if k == SSA_BR_COND() {
        return "    br i1 " + inst.arg1 + ", label %" + inst.target_label + ", label %" + inst.false_label + "\n";
    }
    if k == SSA_RETURN() {
        if inst.arg1 != "" {
            return "    ret " + inst.type_name + " " + inst.arg1 + "\n";
        }
        return "    ret void\n";
    }
    if k == SSA_NOP() {
        return "    nop\n";
    }
    return "";
}

func dump_basic_block(bb: BasicBlock) -> string {
    if bb == null { return ""; }
    let out = bb.label + ":\n";

    if bb.pred_count > 0 {
        out = out + "    ; preds: ";
        let p = bb.preds;
        let first = true;
        while p != null {
            if first == false { out = out + ", "; }
            out = out + "%" + p.name;
            first = false;
            p = p.next;
        }
        out = out + "\n";
    }

    let inst = bb.inst_head;
    while inst != null {
        out = out + dump_ssa_inst(inst);
        inst = inst.next;
    }
    return out;
}

func dump_ssa_function(fn: SsaFunction) -> string {
    if fn == null { return ""; }
    let out = "define " + fn.ret_type + " @" + fn.name + "(";
    let param = fn.params;
    let first = true;
    while param != null {
        if first == false { out = out + ", "; }
        out = out + param.type_name + " %" + param.name;
        first = false;
        param = param.next;
    }
    out = out + ") {\n";

    let bb = fn.block_head;
    while bb != null {
        out = out + dump_basic_block(bb);
        bb = bb.next;
    }
    out = out + "}\n\n";
    return out;
}

func dump_ssa_ir(prog: SsaProgram) -> string {
    if prog == null { return ""; }
    let out = "; ==============================================================================\n";
    out = out + "; 🌹 Roze SSA Intermediate Representation (ADV-06 M6-T03)\n";
    out = out + "; ==============================================================================\n\n";

    let fn = prog.functions;
    while fn != null {
        out = out + dump_ssa_function(fn);
        fn = fn.next;
    }
    return out;
}

// --- Section 4: AST to SSA Lowering ---

func lower_ast_expr_to_ssa(fn: SsaFunction, bb: BasicBlock, expr: AstNode) -> string {
    if expr == null { return ""; }
    let k = expr.kind;

    if k == NODE_LITERAL_INT() {
        let t = fn_new_temp(fn);
        let inst = make_ssa_inst(bb.inst_count, SSA_CONST_INT(), t, "int", "", "", "", expr.int_val, "", "", "");
        bb_append_inst(bb, inst);
        return t;
    }
    if k == NODE_LITERAL_STR() {
        let t = fn_new_temp(fn);
        let inst = make_ssa_inst(bb.inst_count, SSA_CONST_STR(), t, "string", "", "", "", 0, expr.str_val, "", "");
        bb_append_inst(bb, inst);
        return t;
    }
    if k == NODE_LITERAL_BOOL() {
        let t = fn_new_temp(fn);
        let inst = make_ssa_inst(bb.inst_count, SSA_CONST_BOOL(), t, "bool", "", "", "", expr.int_val, "", "", "");
        bb_append_inst(bb, inst);
        return t;
    }
    if k == NODE_IDENT() {
        return "%" + expr.name;
    }
    if k == NODE_BIN_OP() {
        let l = lower_ast_expr_to_ssa(fn, bb, expr.child1);
        let r = lower_ast_expr_to_ssa(fn, bb, expr.child2);
        let t = fn_new_temp(fn);
        let op_ty = expr.type_name;
        if op_ty == "" { op_ty = "int"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_BIN_OP(), t, op_ty, expr.op, l, r, 0, "", "", "");
        bb_append_inst(bb, inst);
        return t;
    }
    if k == NODE_UNARY_OP() {
        let sub = lower_ast_expr_to_ssa(fn, bb, expr.child1);
        let t = fn_new_temp(fn);
        let op_ty = expr.type_name;
        if op_ty == "" { op_ty = "int"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_UNARY_OP(), t, op_ty, expr.op, sub, "", 0, "", "", "");
        bb_append_inst(bb, inst);
        return t;
    }
    if k == NODE_CALL() {
        let args_str = "";
        let arg = expr.child2;
        let first = true;
        while arg != null {
            if first == false { args_str = args_str + ", "; }
            let a_res = lower_ast_expr_to_ssa(fn, bb, arg);
            args_str = args_str + a_res;
            first = false;
            arg = arg.next;
        }
        let t = fn_new_temp(fn);
        let ret_ty = expr.type_name;
        if ret_ty == "" { ret_ty = "void"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_CALL(), t, ret_ty, "", args_str, "", 0, "", expr.name, "");
        bb_append_inst(bb, inst);
        return t;
    }
    if k == NODE_MEMBER() {
        let obj = lower_ast_expr_to_ssa(fn, bb, expr.child1);
        let t = fn_new_temp(fn);
        let f_ty = expr.type_name;
        if f_ty == "" { f_ty = "int"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_GET_FIELD(), t, f_ty, "", obj, expr.name, 0, "", "", "");
        bb_append_inst(bb, inst);
        return t;
    }
    return "";
}

func lower_ast_stmt_to_ssa(fn: SsaFunction, bb: BasicBlock, stmt: AstNode) -> BasicBlock {
    if stmt == null { return bb; }
    let k = stmt.kind;

    if k == NODE_BLOCK() {
        let curr = stmt.child1;
        let curr_bb = bb;
        while curr != null {
            curr_bb = lower_ast_stmt_to_ssa(fn, curr_bb, curr);
            curr = curr.next;
        }
        return curr_bb;
    }

    if k == NODE_VAR_DECL() {
        let val_temp = lower_ast_expr_to_ssa(fn, bb, stmt.child1);
        let ty = stmt.type_name;
        if ty == "" { ty = "int"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_STORE(), "%" + stmt.name, ty, "", val_temp, "", 0, "", "", "");
        bb_append_inst(bb, inst);
        return bb;
    }

    if k == NODE_ASSIGN() {
        let val_temp = lower_ast_expr_to_ssa(fn, bb, stmt.child1);
        let ty = stmt.type_name;
        if ty == "" { ty = "int"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_STORE(), "%" + stmt.name, ty, "", val_temp, "", 0, "", "", "");
        bb_append_inst(bb, inst);
        return bb;
    }

    if k == NODE_RETURN() {
        let ret_val = "";
        if stmt.child1 != null {
            ret_val = lower_ast_expr_to_ssa(fn, bb, stmt.child1);
        }
        let ty = fn.ret_type;
        if ty == "" { ty = "void"; }
        let inst = make_ssa_inst(bb.inst_count, SSA_RETURN(), "", ty, "", ret_val, "", 0, "", "", "");
        bb_append_inst(bb, inst);
        return bb;
    }

    if k == NODE_EXPR_STMT() {
        lower_ast_expr_to_ssa(fn, bb, stmt.child1);
        return bb;
    }

    if k == NODE_IF() {
        let cond_val = lower_ast_expr_to_ssa(fn, bb, stmt.child1);
        let then_lbl = "then_" + rz_int_to_str(fn.block_count);
        let else_lbl = "else_" + rz_int_to_str(fn.block_count);
        let merge_lbl = "merge_" + rz_int_to_str(fn.block_count);

        let then_bb = make_basic_block(fn.block_count, then_lbl);
        fn_append_bb(fn, then_bb);
        let else_bb: BasicBlock = null;
        if stmt.child3 != null {
            else_bb = make_basic_block(fn.block_count, else_lbl);
            fn_append_bb(fn, else_bb);
        }
        let merge_bb = make_basic_block(fn.block_count, merge_lbl);
        fn_append_bb(fn, merge_bb);

        let false_target = merge_lbl;
        if else_bb != null { false_target = else_lbl; }

        let br_cond = make_ssa_inst(bb.inst_count, SSA_BR_COND(), "", "i1", "", cond_val, "", 0, "", then_lbl, false_target);
        bb_append_inst(bb, br_cond);

        let then_end = lower_ast_stmt_to_ssa(fn, then_bb, stmt.child2);
        if then_end != null && then_end.is_terminated == 0 {
            let br_merge = make_ssa_inst(then_end.inst_count, SSA_BR(), "", "", "", "", "", 0, "", merge_lbl, "");
            bb_append_inst(then_end, br_merge);
        }

        if else_bb != null {
            let else_end = lower_ast_stmt_to_ssa(fn, else_bb, stmt.child3);
            if else_end != null && else_end.is_terminated == 0 {
                let br_merge2 = make_ssa_inst(else_end.inst_count, SSA_BR(), "", "", "", "", "", 0, "", merge_lbl, "");
                bb_append_inst(else_end, br_merge2);
            }
        }

        return merge_bb;
    }

    if k == NODE_WHILE() {
        let hdr_lbl = "while_hdr_" + rz_int_to_str(fn.block_count);
        let body_lbl = "while_body_" + rz_int_to_str(fn.block_count);
        let exit_lbl = "while_exit_" + rz_int_to_str(fn.block_count);

        let hdr_bb = make_basic_block(fn.block_count, hdr_lbl);
        fn_append_bb(fn, hdr_bb);
        let body_bb = make_basic_block(fn.block_count, body_lbl);
        fn_append_bb(fn, body_bb);
        let exit_bb = make_basic_block(fn.block_count, exit_lbl);
        fn_append_bb(fn, exit_bb);

        let br_hdr = make_ssa_inst(bb.inst_count, SSA_BR(), "", "", "", "", "", 0, "", hdr_lbl, "");
        bb_append_inst(bb, br_hdr);

        let cond_val = lower_ast_expr_to_ssa(fn, hdr_bb, stmt.child1);
        let br_cond = make_ssa_inst(hdr_bb.inst_count, SSA_BR_COND(), "", "i1", "", cond_val, "", 0, "", body_lbl, exit_lbl);
        bb_append_inst(hdr_bb, br_cond);

        let body_end = lower_ast_stmt_to_ssa(fn, body_bb, stmt.child2);
        if body_end != null && body_end.is_terminated == 0 {
            let back_edge = make_ssa_inst(body_end.inst_count, SSA_BR(), "", "", "", "", "", 0, "", hdr_lbl, "");
            bb_append_inst(body_end, back_edge);
        }

        return exit_bb;
    }

    return bb;
}

func lower_ast_func_to_ssa(decl: AstNode) -> SsaFunction {
    if decl == null || decl.kind != NODE_FUNC_DECL() { return null; }

    let fn = make_ssa_function(decl.name, decl.type_name);

    let p = decl.child1;
    let p_head: SsaParam = null;
    let p_tail: SsaParam = null;
    while p != null {
        let param_ty = p.type_name;
        if param_ty == "" { param_ty = "int"; }
        let sp = make_ssa_param(p.name, param_ty);
        if p_head == null {
            p_head = sp;
            p_tail = sp;
        } else {
            p_tail.next = sp;
            p_tail = sp;
        }
        p = p.next;
    }
    fn.params = p_head;

    let entry_bb = make_basic_block(0, "entry");
    fn_append_bb(fn, entry_bb);

    let last_bb = lower_ast_stmt_to_ssa(fn, entry_bb, decl.child2);
    if last_bb != null && last_bb.is_terminated == 0 {
        let ret_inst = make_ssa_inst(last_bb.inst_count, SSA_RETURN(), "", fn.ret_type, "", "", "", 0, "", "", "");
        bb_append_inst(last_bb, ret_inst);
    }

    return fn;
}

func build_ssa_ir(prog: AstNode) -> SsaProgram {
    let ssa_prog = make_ssa_program();
    if prog == null { return ssa_prog; }

    let fn_head: SsaFunction = null;
    let fn_tail: SsaFunction = null;

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let ssa_fn = lower_ast_func_to_ssa(decl);
            if ssa_fn != null {
                if fn_head == null {
                    fn_head = ssa_fn;
                    fn_tail = ssa_fn;
                } else {
                    fn_tail.next = ssa_fn;
                    fn_tail = ssa_fn;
                }
            }
        }
        decl = decl.next;
    }

    ssa_prog.functions = fn_head;
    return ssa_prog;
}

// --- Section 5: Constant Folding & Propagation ---

func make_int_literal_node(val: int, line: int, col: int) -> AstNode {
    let node = make_ast_node(NODE_LITERAL_INT(), "", "int", line, col);
    node.int_val = val;
    return node;
}

func make_str_literal_node(val: string, line: int, col: int) -> AstNode {
    let node = make_ast_node(NODE_LITERAL_STR(), "", "string", line, col);
    node.str_val = val;
    return node;
}

func make_bool_literal_node(val: int, line: int, col: int) -> AstNode {
    let node = make_ast_node(NODE_LITERAL_BOOL(), "", "bool", line, col);
    node.int_val = val;
    return node;
}

func is_pure_expr(expr: AstNode) -> int {
    if expr == null { return 1; }
    let k = expr.kind;
    if k == NODE_LITERAL_INT() || k == NODE_LITERAL_STR() || k == NODE_LITERAL_BOOL() || k == NODE_LITERAL_NULL() {
        return 1;
    }
    if k == NODE_IDENT() {
        return 1;
    }
    if k == NODE_BIN_OP() {
        if is_pure_expr(expr.child1) == 1 && is_pure_expr(expr.child2) == 1 {
            return 1;
        }
        return 0;
    }
    if k == NODE_UNARY_OP() {
        return is_pure_expr(expr.child1);
    }
    return 0;
}

func eval_int_bin_op(op: string, a: int, b: int) -> int {
    if op == "+" { return a + b; }
    if op == "-" { return a - b; }
    if op == "*" { return a * b; }
    if op == "/" {
        if b != 0 { return a / b; }
        return 0;
    }
    if op == "%" {
        if b != 0 { return a % b; }
        return 0;
    }
    if op == "==" { if a == b { return 1; } return 0; }
    if op == "!=" { if a != b { return 1; } return 0; }
    if op == "<" { if a < b { return 1; } return 0; }
    if op == "<=" { if a <= b { return 1; } return 0; }
    if op == ">" { if a > b { return 1; } return 0; }
    if op == ">=" { if a >= b { return 1; } return 0; }
    return 0;
}

func fold_constants_expr(expr: AstNode, stats: OptStats) -> AstNode {
    if expr == null { return null; }

    expr.child1 = fold_constants_expr(expr.child1, stats);
    expr.child2 = fold_constants_expr(expr.child2, stats);
    expr.child3 = fold_constants_expr(expr.child3, stats);
    expr.child4 = fold_constants_expr(expr.child4, stats);

    let k = expr.kind;

    if k == NODE_UNARY_OP() {
        let sub = expr.child1;
        if sub != null {
            if expr.op == "!" && sub.kind == NODE_LITERAL_BOOL() {
                let folded_val = 0;
                if sub.int_val == 0 { folded_val = 1; }
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(folded_val, expr.line, expr.col);
            }
            if expr.op == "-" && sub.kind == NODE_LITERAL_INT() {
                stats.const_folded = stats.const_folded + 1;
                return make_int_literal_node(0 - sub.int_val, expr.line, expr.col);
            }
        }
        return expr;
    }

    if k == NODE_BIN_OP() {
        let left = expr.child1;
        let right = expr.child2;
        if left == null || right == null { return expr; }

        let lk = left.kind;
        let rk = right.kind;

        // Integer arithmetic & comparison folding
        if lk == NODE_LITERAL_INT() && rk == NODE_LITERAL_INT() {
            let op = expr.op;
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                let res = eval_int_bin_op(op, left.int_val, right.int_val);
                stats.const_folded = stats.const_folded + 1;
                return make_int_literal_node(res, expr.line, expr.col);
            }
            if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
                let res_bool = eval_int_bin_op(op, left.int_val, right.int_val);
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(res_bool, expr.line, expr.col);
            }
        }

        // String concatenation folding
        if lk == NODE_LITERAL_STR() && rk == NODE_LITERAL_STR() && expr.op == "+" {
            stats.const_folded = stats.const_folded + 1;
            return make_str_literal_node(left.str_val + right.str_val, expr.line, expr.col);
        }

        // Boolean constant logic folding
        if lk == NODE_LITERAL_BOOL() && rk == NODE_LITERAL_BOOL() {
            if expr.op == "&&" {
                let b_res = 0;
                if left.int_val == 1 && right.int_val == 1 { b_res = 1; }
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(b_res, expr.line, expr.col);
            }
            if expr.op == "||" {
                let b_res = 0;
                if left.int_val == 1 || right.int_val == 1 { b_res = 1; }
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(b_res, expr.line, expr.col);
            }
            if expr.op == "==" {
                let b_res = 0;
                if left.int_val == right.int_val { b_res = 1; }
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(b_res, expr.line, expr.col);
            }
            if expr.op == "!=" {
                let b_res = 0;
                if left.int_val != right.int_val { b_res = 1; }
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(b_res, expr.line, expr.col);
            }
        }

        // Algebraic Identity Simplifications
        if expr.op == "+" {
            if rk == NODE_LITERAL_INT() && right.int_val == 0 {
                stats.const_folded = stats.const_folded + 1;
                return left;
            }
            if lk == NODE_LITERAL_INT() && left.int_val == 0 {
                stats.const_folded = stats.const_folded + 1;
                return right;
            }
        }
        if expr.op == "-" {
            if rk == NODE_LITERAL_INT() && right.int_val == 0 {
                stats.const_folded = stats.const_folded + 1;
                return left;
            }
        }
        if expr.op == "*" {
            if rk == NODE_LITERAL_INT() && right.int_val == 1 {
                stats.const_folded = stats.const_folded + 1;
                return left;
            }
            if lk == NODE_LITERAL_INT() && left.int_val == 1 {
                stats.const_folded = stats.const_folded + 1;
                return right;
            }
            if rk == NODE_LITERAL_INT() && right.int_val == 0 && is_pure_expr(left) == 1 {
                stats.const_folded = stats.const_folded + 1;
                return make_int_literal_node(0, expr.line, expr.col);
            }
            if lk == NODE_LITERAL_INT() && left.int_val == 0 && is_pure_expr(right) == 1 {
                stats.const_folded = stats.const_folded + 1;
                return make_int_literal_node(0, expr.line, expr.col);
            }
        }
        if expr.op == "/" {
            if rk == NODE_LITERAL_INT() && right.int_val == 1 {
                stats.const_folded = stats.const_folded + 1;
                return left;
            }
        }
        if expr.op == "&&" {
            if lk == NODE_LITERAL_BOOL() && left.int_val == 1 {
                stats.const_folded = stats.const_folded + 1;
                return right;
            }
            if rk == NODE_LITERAL_BOOL() && right.int_val == 1 {
                stats.const_folded = stats.const_folded + 1;
                return left;
            }
            if lk == NODE_LITERAL_BOOL() && left.int_val == 0 && is_pure_expr(right) == 1 {
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(0, expr.line, expr.col);
            }
            if rk == NODE_LITERAL_BOOL() && right.int_val == 0 && is_pure_expr(left) == 1 {
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(0, expr.line, expr.col);
            }
        }
        if expr.op == "||" {
            if lk == NODE_LITERAL_BOOL() && left.int_val == 0 {
                stats.const_folded = stats.const_folded + 1;
                return right;
            }
            if rk == NODE_LITERAL_BOOL() && right.int_val == 0 {
                stats.const_folded = stats.const_folded + 1;
                return left;
            }
            if lk == NODE_LITERAL_BOOL() && left.int_val == 1 && is_pure_expr(right) == 1 {
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(1, expr.line, expr.col);
            }
            if rk == NODE_LITERAL_BOOL() && right.int_val == 1 && is_pure_expr(left) == 1 {
                stats.const_folded = stats.const_folded + 1;
                return make_bool_literal_node(1, expr.line, expr.col);
            }
        }
    }

    return expr;
}

// --- Section 6: Dead Code Elimination (DCE) ---

func has_ident_ref(node: AstNode, name: string) -> int {
    if node == null { return 0; }
    if node.kind == NODE_IDENT() && node.name == name {
        return 1;
    }
    if has_ident_ref(node.child1, name) == 1 { return 1; }
    if has_ident_ref(node.child2, name) == 1 { return 1; }
    if has_ident_ref(node.child3, name) == 1 { return 1; }
    if has_ident_ref(node.child4, name) == 1 { return 1; }
    if has_ident_ref(node.next, name) == 1 { return 1; }
    return 0;
}

func eliminate_dead_statements(stmt_list: AstNode, stats: OptStats) -> AstNode {
    if stmt_list == null { return null; }

    let head: AstNode = null;
    let tail: AstNode = null;
    let curr = stmt_list;
    let reached_return = 0;

    while curr != null {
        if reached_return == 1 {
            stats.dead_stmts_removed = stats.dead_stmts_removed + 1;
            curr = curr.next;
        } else {
            let next_stmt = curr.next;
            curr.next = null;

            let optimized_stmt = eliminate_dead_code_stmt(curr, stats);

            if optimized_stmt != null {
                if head == null {
                    head = optimized_stmt;
                    tail = optimized_stmt;
                } else {
                    let t = tail;
                    while t.next != null {
                        t = t.next;
                    }
                    t.next = optimized_stmt;
                    tail = optimized_stmt;
                }

                if optimized_stmt.kind == NODE_RETURN() {
                    reached_return = 1;
                }
            }

            curr = next_stmt;
        }
    }

    return head;
}

func eliminate_dead_code_stmt(stmt: AstNode, stats: OptStats) -> AstNode {
    if stmt == null { return null; }

    let k = stmt.kind;

    if k == NODE_BLOCK() {
        stmt.child1 = eliminate_dead_statements(stmt.child1, stats);
        return stmt;
    }

    if k == NODE_IF() {
        stmt.child1 = fold_constants_expr(stmt.child1, stats);
        let cond = stmt.child1;

        if cond != null && (cond.kind == NODE_LITERAL_BOOL() || cond.kind == NODE_LITERAL_INT()) {
            if cond.int_val == 1 {
                stats.dead_stmts_removed = stats.dead_stmts_removed + 1;
                let then_branch = stmt.child2;
                if then_branch != null {
                    return eliminate_dead_code_stmt(then_branch, stats);
                }
                return null;
            }
            if cond.int_val == 0 {
                stats.dead_stmts_removed = stats.dead_stmts_removed + 1;
                let else_branch = stmt.child3;
                if else_branch != null {
                    return eliminate_dead_code_stmt(else_branch, stats);
                }
                return null;
            }
        }

        stmt.child2 = eliminate_dead_code_stmt(stmt.child2, stats);
        stmt.child3 = eliminate_dead_code_stmt(stmt.child3, stats);
        return stmt;
    }

    if k == NODE_WHILE() {
        stmt.child1 = fold_constants_expr(stmt.child1, stats);
        let cond = stmt.child1;
        if cond != null && (cond.kind == NODE_LITERAL_BOOL() || cond.kind == NODE_LITERAL_INT()) && cond.int_val == 0 {
            stats.dead_stmts_removed = stats.dead_stmts_removed + 1;
            return null;
        }
        stmt.child2 = eliminate_dead_code_stmt(stmt.child2, stats);
        return stmt;
    }

    if k == NODE_FOR() {
        stmt.child1 = eliminate_dead_code_stmt(stmt.child1, stats);
        stmt.child2 = fold_constants_expr(stmt.child2, stats);
        stmt.child3 = eliminate_dead_code_stmt(stmt.child3, stats);
        stmt.child4 = eliminate_dead_code_stmt(stmt.child4, stats);
        return stmt;
    }

    if k == NODE_VAR_DECL() {
        stmt.child1 = fold_constants_expr(stmt.child1, stats);
        return stmt;
    }

    if k == NODE_ASSIGN() {
        stmt.child1 = fold_constants_expr(stmt.child1, stats);
        return stmt;
    }

    if k == NODE_RETURN() {
        stmt.child1 = fold_constants_expr(stmt.child1, stats);
        return stmt;
    }

    if k == NODE_EXPR_STMT() {
        stmt.child1 = fold_constants_expr(stmt.child1, stats);
        return stmt;
    }

    return stmt;
}

// --- Section 7: Leaf Function Inlining ---

func find_inlinable_func(head: InlinableFunc, name: string) -> InlinableFunc {
    let curr = head;
    while curr != null {
        if curr.name == name {
            return curr;
        }
        curr = curr.next;
    }
    return null;
}

func substitute_param_with_arg(expr: AstNode, param_name: string, arg_expr: AstNode) -> AstNode {
    if expr == null { return null; }

    if expr.kind == NODE_IDENT() && expr.name == param_name {
        return clone_single_node(arg_expr);
    }

    expr.child1 = substitute_param_with_arg(expr.child1, param_name, arg_expr);
    expr.child2 = substitute_param_with_arg(expr.child2, param_name, arg_expr);
    expr.child3 = substitute_param_with_arg(expr.child3, param_name, arg_expr);
    expr.child4 = substitute_param_with_arg(expr.child4, param_name, arg_expr);
    return expr;
}

func inline_call_expr(call_node: AstNode, inlinable_list: InlinableFunc, stats: OptStats) -> AstNode {
    if call_node == null || inlinable_list == null { return call_node; }

    if call_node.kind == NODE_CALL() {
        let fn_info = find_inlinable_func(inlinable_list, call_node.name);
        if fn_info != null {
            let ret_copy = clone_single_node(fn_info.ret_expr);
            let p = fn_info.params;
            let a = call_node.child2;
            let match_ok = 1;

            while p != null && a != null {
                ret_copy = substitute_param_with_arg(ret_copy, p.name, a);
                p = p.next;
                a = a.next;
            }

            if p != null || a != null {
                match_ok = 0;
            }

            if match_ok == 1 && ret_copy != null {
                stats.funcs_inlined = stats.funcs_inlined + 1;
                return ret_copy;
            }
        }
    }

    return call_node;
}

func inline_calls_in_expr(expr: AstNode, inlinable_list: InlinableFunc, stats: OptStats) -> AstNode {
    if expr == null { return null; }

    if expr.kind == NODE_CALL() {
        let arg = expr.child2;
        while arg != null {
            arg.child1 = inline_calls_in_expr(arg.child1, inlinable_list, stats);
            arg.child2 = inline_calls_in_expr(arg.child2, inlinable_list, stats);
            arg = arg.next;
        }
        return inline_call_expr(expr, inlinable_list, stats);
    }

    expr.child1 = inline_calls_in_expr(expr.child1, inlinable_list, stats);
    expr.child2 = inline_calls_in_expr(expr.child2, inlinable_list, stats);
    expr.child3 = inline_calls_in_expr(expr.child3, inlinable_list, stats);
    expr.child4 = inline_calls_in_expr(expr.child4, inlinable_list, stats);
    return expr;
}

func inline_calls_in_stmt(stmt: AstNode, inlinable_list: InlinableFunc, stats: OptStats) {
    if stmt == null || inlinable_list == null { return; }

    let k = stmt.kind;
    if k == NODE_BLOCK() {
        let curr = stmt.child1;
        while curr != null {
            inline_calls_in_stmt(curr, inlinable_list, stats);
            curr = curr.next;
        }
    } else if k == NODE_VAR_DECL() || k == NODE_ASSIGN() || k == NODE_RETURN() || k == NODE_EXPR_STMT() {
        stmt.child1 = inline_calls_in_expr(stmt.child1, inlinable_list, stats);
    } else if k == NODE_IF() {
        stmt.child1 = inline_calls_in_expr(stmt.child1, inlinable_list, stats);
        inline_calls_in_stmt(stmt.child2, inlinable_list, stats);
        inline_calls_in_stmt(stmt.child3, inlinable_list, stats);
    } else if k == NODE_WHILE() {
        stmt.child1 = inline_calls_in_expr(stmt.child1, inlinable_list, stats);
        inline_calls_in_stmt(stmt.child2, inlinable_list, stats);
    } else if k == NODE_FOR() {
        inline_calls_in_stmt(stmt.child1, inlinable_list, stats);
        stmt.child2 = inline_calls_in_expr(stmt.child2, inlinable_list, stats);
        inline_calls_in_stmt(stmt.child3, inlinable_list, stats);
        inline_calls_in_stmt(stmt.child4, inlinable_list, stats);
    }
}

func is_inlinable_ret_expr(expr: AstNode) -> int {
    if expr == null { return 0; }
    let k = expr.kind;
    if k == NODE_LITERAL_INT() || k == NODE_LITERAL_STR() || k == NODE_LITERAL_BOOL() {
        return 1;
    }
    if k == NODE_IDENT() {
        return 1;
    }
    if k == NODE_BIN_OP() {
        if is_inlinable_ret_expr(expr.child1) == 1 && is_inlinable_ret_expr(expr.child2) == 1 {
            return 1;
        }
        return 0;
    }
    if k == NODE_UNARY_OP() {
        return is_inlinable_ret_expr(expr.child1);
    }
    return 0;
}

func is_compiler_internal_func(name: string) -> int {
    if name == "is_digit" || name == "is_alpha" || name == "is_alnum" || name == "is_ident_char" { return 1; }
    if name == "check_token" || name == "advance_token" || name == "peek_line" || name == "peek_col" { return 1; }
    if name == "keyword_kind" || name == "c_type" || name == "escape_c_string" { return 1; }
    let len = rz_str_len(name);
    if len >= 4 {
        let p4 = rz_substring(name, 0, 4);
        if p4 == "TOK_" || p4 == "NODE" || p4 == "SYM_" || p4 == "SSA_" || p4 == "make" || p4 == "rz_c" || p4 == "rz_s" {
            return 1;
        }
    }
    if len >= 7 {
        let p7 = rz_substring(name, 0, 7);
        if p7 == "BORROW_" {
            return 1;
        }
    }
    return 0;
}

func collect_inlinable_functions(prog: AstNode) -> InlinableFunc {
    let list_head: InlinableFunc = null;
    let decl = prog.child1;

    while decl != null {
        if decl.kind == NODE_FUNC_DECL() && decl.name != "main" && decl.name != "rz_user_main" && is_compiler_internal_func(decl.name) == 0 {
            let body = decl.child2;
            if body != null && body.kind == NODE_BLOCK() {
                let first_stmt = body.child1;
                if first_stmt != null && first_stmt.kind == NODE_RETURN() && first_stmt.next == null {
                    let ret_expr = first_stmt.child1;
                    if ret_expr != null && is_inlinable_ret_expr(ret_expr) == 1 && has_ident_ref(ret_expr, decl.name) == 0 {
                        let entry = new InlinableFunc(decl.name, decl.type_name, decl.child1, ret_expr, list_head);
                        list_head = entry;
                    }
                }
            }
        }
        decl = decl.next;
    }

    return list_head;
}

// --- Section 8: Loop Invariant Code Motion (LICM) ---

func add_ident_ref(head: SsaBlockRef, name: string) -> SsaBlockRef {
    let curr = head;
    while curr != null {
        if curr.name == name { return head; }
        curr = curr.next;
    }
    return new SsaBlockRef(name, head);
}

func has_ident_in_list(head: SsaBlockRef, name: string) -> int {
    let curr = head;
    while curr != null {
        if curr.name == name { return 1; }
        curr = curr.next;
    }
    return 0;
}

func collect_mutated_vars_in_node(node: AstNode, muts: SsaBlockRef) -> SsaBlockRef {
    if node == null { return muts; }

    if node.kind == NODE_ASSIGN() && node.name != "" {
        muts = add_ident_ref(muts, node.name);
    }

    muts = collect_mutated_vars_in_node(node.child1, muts);
    muts = collect_mutated_vars_in_node(node.child2, muts);
    muts = collect_mutated_vars_in_node(node.child3, muts);
    muts = collect_mutated_vars_in_node(node.child4, muts);
    muts = collect_mutated_vars_in_node(node.next, muts);
    return muts;
}

func is_expr_invariant(expr: AstNode, muts: SsaBlockRef) -> int {
    if expr == null { return 1; }

    let k = expr.kind;
    if k == NODE_LITERAL_INT() || k == NODE_LITERAL_STR() || k == NODE_LITERAL_BOOL() || k == NODE_LITERAL_NULL() {
        return 1;
    }

    if k == NODE_IDENT() {
        if has_ident_in_list(muts, expr.name) == 1 {
            return 0;
        }
        return 1;
    }

    if k == NODE_BIN_OP() {
        if is_expr_invariant(expr.child1, muts) == 1 && is_expr_invariant(expr.child2, muts) == 1 {
            return 1;
        }
        return 0;
    }

    if k == NODE_UNARY_OP() {
        return is_expr_invariant(expr.child1, muts);
    }

    return 0;
}

func hoist_loop_invariants_in_block(block: AstNode, stats: OptStats) {
    if block == null || block.kind != NODE_BLOCK() { return; }

    let prev: AstNode = null;
    let curr = block.child1;

    while curr != null {
        if curr.kind == NODE_WHILE() || curr.kind == NODE_FOR() {
            let loop_body = curr.child2;
            if curr.kind == NODE_FOR() {
                loop_body = curr.child4;
            }

            if loop_body != null && loop_body.kind == NODE_BLOCK() {
                let muts: SsaBlockRef = null;
                if curr.kind == NODE_FOR() {
                    muts = collect_mutated_vars_in_node(curr.child3, muts);
                }
                muts = collect_mutated_vars_in_node(loop_body.child1, muts);

                let body_prev: AstNode = null;
                let body_curr = loop_body.child1;
                let hoisted_head: AstNode = null;
                let hoisted_tail: AstNode = null;

                while body_curr != null {
                    let next_stmt = body_curr.next;

                    if body_curr.kind == NODE_VAR_DECL() {
                        let init_expr = body_curr.child1;
                        if init_expr != null && is_expr_invariant(init_expr, muts) == 1 {
                            if body_prev == null {
                                loop_body.child1 = next_stmt;
                            } else {
                                body_prev.next = next_stmt;
                            }
                            body_curr.next = null;

                            if hoisted_head == null {
                                hoisted_head = body_curr;
                                hoisted_tail = body_curr;
                            } else {
                                hoisted_tail.next = body_curr;
                                hoisted_tail = body_curr;
                            }

                            stats.loops_hoisted = stats.loops_hoisted + 1;
                            muts = add_ident_ref(muts, body_curr.name);
                        } else {
                            body_prev = body_curr;
                        }
                    } else {
                        body_prev = body_curr;
                    }

                    body_curr = next_stmt;
                }

                if hoisted_head != null {
                    if prev == null {
                        block.child1 = hoisted_head;
                        hoisted_tail.next = curr;
                        prev = hoisted_tail;
                    } else {
                        prev.next = hoisted_head;
                        hoisted_tail.next = curr;
                        prev = hoisted_tail;
                    }
                }
            }
        } else if curr.kind == NODE_BLOCK() {
            hoist_loop_invariants_in_block(curr, stats);
        }

        prev = curr;
        curr = curr.next;
    }
}

// --- Section 9: Unified Optimizer Coordinator ---

func optimize_program(prog: AstNode) -> AstNode {
    if prog == null { return null; }

    let stats = new OptStats(0, 0, 0, 0);

    // Pass 1: Leaf Function Inlining
    let inlinable_list = collect_inlinable_functions(prog);
    if inlinable_list != null {
        let decl = prog.child1;
        while decl != null {
            if decl.kind == NODE_FUNC_DECL() {
                inline_calls_in_stmt(decl.child2, inlinable_list, stats);
            }
            decl = decl.next;
        }
    }

    // Pass 2: Loop Invariant Code Motion (Hoisting)
    let decl2 = prog.child1;
    while decl2 != null {
        if decl2.kind == NODE_FUNC_DECL() {
            hoist_loop_invariants_in_block(decl2.child2, stats);
        }
        decl2 = decl2.next;
    }

    // Pass 3: Constant Folding & Dead Code Elimination (Iterative)
    for let iter = 0; iter < 3; iter = iter + 1 {
        let prev_folded = stats.const_folded;
        let prev_dead = stats.dead_stmts_removed;

        let decl3 = prog.child1;
        while decl3 != null {
            if decl3.kind == NODE_FUNC_DECL() {
                if decl3.child2 != null {
                    decl3.child2 = eliminate_dead_code_stmt(decl3.child2, stats);
                }
            }
            decl3 = decl3.next;
        }

        if stats.const_folded == prev_folded && stats.dead_stmts_removed == prev_dead {
            iter = 3;
        }
    }

    return prog;
}

func emit_program_ssa(prog: AstNode) -> string {
    let ssa_prog = build_ssa_ir(prog);
    let ssa_fn = ssa_prog.functions;
    while ssa_fn != null {
        resolve_cfg_edges(ssa_fn);
        eliminate_dead_basic_blocks(ssa_fn);
        ssa_fn = ssa_fn.next;
    }
    return dump_ssa_ir(ssa_prog);
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler - C99 Code Generator (ADV-06)
// ==============================================================================


func escape_c_string(s: string) -> string {
    let out = "";
    let len = rz_str_len(s);
    for let i = 0; i < len; i = i + 1 {
        let ch = rz_char_at(s, i);
        if ch == 10 {
            out = out + "\\n";
        } else if ch == 13 {
            out = out + "\\r";
        } else if ch == 9 {
            out = out + "\\t";
        } else if ch == 34 {
            out = out + "\\\"";
        } else if ch == 92 {
            out = out + "\\\\";
        } else {
            out = out + rz_char_to_str(ch);
        }
    }
    return out;
}

func c_type(type_name: string) -> string {
    if type_name == "int" { return "int64_t"; }
    if type_name == "string" { return "const char*"; }
    if type_name == "bool" { return "int64_t"; }
    if type_name == "void" { return "void"; }
    if type_name == "" { return "int64_t"; }
    // Class types map to struct pointer
    return "struct Rz_" + type_name + "*";
}

func gen_expression(expr: AstNode) -> string {
    if expr == null { return ""; }

    let kind = expr.kind;

    if kind == NODE_LITERAL_INT() {
        return rz_int_to_str(expr.int_val);
    }
    if kind == NODE_LITERAL_STR() {
        return "\"" + escape_c_string(expr.str_val) + "\"";
    }
    if kind == NODE_LITERAL_BOOL() {
        if expr.int_val == 1 { return "1"; }
        return "0";
    }
    if kind == NODE_LITERAL_NULL() {
        return "NULL";
    }
    if kind == NODE_IDENT() {
        return expr.name;
    }
    if kind == NODE_BIN_OP() {
        let left_code = gen_expression(expr.child1);
        let right_code = gen_expression(expr.child2);

        if expr.op == "+" {
            if expr.type_name == "string" {
                return "rz_str_concat(" + left_code + ", " + right_code + ")";
            }
            return "(" + left_code + " + " + right_code + ")";
        }
        if expr.op == "==" {
            if expr.child1 != null && expr.child1.type_name == "string" {
                return "(strcmp(" + left_code + ", " + right_code + ") == 0)";
            }
            return "(" + left_code + " == " + right_code + ")";
        }
        if expr.op == "!=" {
            if expr.child1 != null && expr.child1.type_name == "string" {
                return "(strcmp(" + left_code + ", " + right_code + ") != 0)";
            }
            return "(" + left_code + " != " + right_code + ")";
        }

        return "(" + left_code + " " + expr.op + " " + right_code + ")";
    }
    if kind == NODE_UNARY_OP() {
        let operand = gen_expression(expr.child1);
        return "(" + expr.op + operand + ")";
    }
    if kind == NODE_CALL() {
        let func_name = expr.name;
        if func_name == "println" {
            let arg = expr.child2;
            if arg == null {
                return "printf(\"\\n\")";
            }
            let arg_code = gen_expression(arg);
            if arg.type_name == "string" {
                return "printf(\"%s\\n\", " + arg_code + ")";
            } else if arg.type_name == "bool" {
                return "printf(\"%s\\n\", (" + arg_code + ") ? \"true\" : \"false\")";
            }
            return "printf(\"%lld\\n\", (long long)(" + arg_code + "))";
        }

        let code = func_name + "(";
        let arg = expr.child2;
        let first = true;
        while arg != null {
            if first == false { code = code + ", "; }
            code = code + gen_expression(arg);
            first = false;
            arg = arg.next;
        }
        code = code + ")";
        return code;
    }
    if kind == NODE_NEW() {
        let code = "new_" + expr.name + "(";
        let arg = expr.child1;
        let first = true;
        while arg != null {
            if first == false { code = code + ", "; }
            code = code + gen_expression(arg);
            first = false;
            arg = arg.next;
        }
        code = code + ")";
        return code;
    }
    if kind == NODE_MEMBER() {
        let obj_code = gen_expression(expr.child1);
        return obj_code + "->" + expr.name;
    }

    return "";
}

func gen_statement(stmt: AstNode, indent: string) -> string {
    if stmt == null { return ""; }

    let kind = stmt.kind;

    if kind == NODE_VAR_DECL() {
        let c_ty = c_type(stmt.type_name);
        if stmt.type_name == "" {
            c_ty = "__auto_type";
        }
        let init_val = "0";
        if stmt.type_name == "string" { init_val = "\"\""; }
        if stmt.child1 != null {
            init_val = gen_expression(stmt.child1);
        }
        return indent + c_ty + " " + stmt.name + " = " + init_val + ";\n";
    }
    if kind == NODE_ASSIGN() || kind == NODE_FIELD_ASSIGN() {
        let target_code = gen_expression(stmt.child1);
        let val_code = gen_expression(stmt.child2);
        return indent + target_code + " = " + val_code + ";\n";
    }
    if kind == NODE_IF() {
        let cond_code = gen_expression(stmt.child1);
        let code = indent + "if (" + cond_code + ") {\n";
        code = code + gen_block_body(stmt.child2, indent + "    ");
        code = code + indent + "}";
        if stmt.child3 != null {
            if stmt.child3.kind == NODE_IF() {
                code = code + " else " + gen_statement(stmt.child3, indent);
                return code;
            } else {
                code = code + " else {\n";
                code = code + gen_block_body(stmt.child3, indent + "    ");
                code = code + indent + "}\n";
                return code;
            }
        }
        code = code + "\n";
        return code;
    }
    if kind == NODE_WHILE() {
        let cond_code = gen_expression(stmt.child1);
        let code = indent + "while (" + cond_code + ") {\n";
        code = code + gen_block_body(stmt.child2, indent + "    ");
        code = code + indent + "}\n";
        return code;
    }
    if kind == NODE_FOR() {
        // for (init; cond; update)
        let init_code = "";
        if stmt.child1 != null {
            if stmt.child1.kind == NODE_VAR_DECL() {
                let init_expr = "0";
                if stmt.child1.child1 != null { init_expr = gen_expression(stmt.child1.child1); }
                let c_ty = c_type(stmt.child1.type_name);
                if stmt.child1.type_name == "" { c_ty = "__auto_type"; }
                init_code = c_ty + " " + stmt.child1.name + " = " + init_expr;
            }
        }
        let cond_code = gen_expression(stmt.child2);
        let update_code = "";
        if stmt.child3 != null {
            update_code = gen_expression(stmt.child3.child1) + " = " + gen_expression(stmt.child3.child2);
        }
        let code = indent + "for (" + init_code + "; " + cond_code + "; " + update_code + ") {\n";
        code = code + gen_block_body(stmt.child4, indent + "    ");
        code = code + indent + "}\n";
        return code;
    }
    if kind == NODE_RETURN() {
        if stmt.child1 != null {
            return indent + "return " + gen_expression(stmt.child1) + ";\n";
        }
        return indent + "return;\n";
    }
    if kind == NODE_BLOCK() {
        let code = indent + "{\n";
        code = code + gen_block_body(stmt, indent + "    ");
        code = code + indent + "}\n";
        return code;
    }
    if kind == NODE_EXPR_STMT() {
        return indent + gen_expression(stmt.child1) + ";\n";
    }

    return "";
}

func gen_block_body(block: AstNode, indent: string) -> string {
    if block == null { return ""; }
    let code = "";
    let s = block.child1;
    while s != null {
        code = code + gen_statement(s, indent);
        s = s.next;
    }
    return code;
}

// ------------------------------------------------------------------------------
// Program Code Generation
// ------------------------------------------------------------------------------

func generate_c_code(prog: AstNode) -> string {
    let out = "// ==============================================================================\n";
    out = out + "// 🌹 Emitted C99 Source by Roze Self-Hosted Compiler (ADV-06)\n";
    out = out + "// ==============================================================================\n\n";

    out = out + "#include <stdio.h>\n";
    out = out + "#include <stdlib.h>\n";
    out = out + "#include <string.h>\n";
    out = out + "#include <stdbool.h>\n";
    out = out + "#include <stdint.h>\n";
    out = out + "#include <sys/stat.h>\n";
    out = out + "#include <unistd.h>\n\n";

    // Standard Roze Self-Hosted C Runtime Helpers
    out = out + "// --- Roze C Runtime Helpers ---\n";
    out = out + "char* rz_str_concat(const char* a, const char* b) {\n";
    out = out + "    if (!a) a = \"\"; if (!b) b = \"\";\n";
    out = out + "    size_t la = strlen(a); size_t lb = strlen(b);\n";
    out = out + "    char* s = (char*)malloc(16 + la + lb + 1);\n";
    out = out + "    *(int64_t*)(s + 0) = 1; *(int64_t*)(s + 8) = la + lb;\n";
    out = out + "    char* p = s + 16;\n";
    out = out + "    memcpy(p, a, la); memcpy(p + la, b, lb); p[la + lb] = '\\0';\n";
    out = out + "    return p;\n";
    out = out + "}\n";
    out = out + "int64_t rz_char_at(const char* s, int64_t i) {\n";
    out = out + "    if (!s || i < 0) return -1;\n";
    out = out + "    unsigned char c = (unsigned char)s[i];\n";
    out = out + "    return (c == '\\0') ? -1 : (int64_t)c;\n";
    out = out + "}\n";
    out = out + "char* rz_int_to_str(int64_t v) {\n";
    out = out + "    char b[32]; snprintf(b, sizeof(b), \"%lld\", (long long)v);\n";
    out = out + "    size_t l = strlen(b);\n";
    out = out + "    char* s = (char*)malloc(16 + l + 1);\n";
    out = out + "    *(int64_t*)(s + 0) = 1; *(int64_t*)(s + 8) = l;\n";
    out = out + "    char* p = s + 16; memcpy(p, b, l + 1);\n";
    out = out + "    return p;\n";
    out = out + "}\n";
    out = out + "char* rz_char_to_str(int64_t ch) {\n";
    out = out + "    char* s = (char*)malloc(16 + 2);\n";
    out = out + "    *(int64_t*)(s + 0) = 1; *(int64_t*)(s + 8) = 1;\n";
    out = out + "    char* p = s + 16; p[0] = (char)ch; p[1] = '\\0';\n";
    out = out + "    return p;\n";
    out = out + "}\n";
    out = out + "char* rz_substring(const char* s, int64_t st, int64_t len) {\n";
    out = out + "    if (!s || st < 0 || len <= 0) return \"\";\n";
    out = out + "    int64_t tot = strlen(s);\n";
    out = out + "    if (st >= tot) return \"\";\n";
    out = out + "    if (st + len > tot) len = tot - st;\n";
    out = out + "    char* r = (char*)malloc(16 + len + 1);\n";
    out = out + "    *(int64_t*)(r + 0) = 1; *(int64_t*)(r + 8) = len;\n";
    out = out + "    char* p = r + 16; memcpy(p, s + st, len); p[len] = '\\0';\n";
    out = out + "    return p;\n";
    out = out + "}\n";
    out = out + "int64_t rz_str_len(const char* s) { return s ? (int64_t)strlen(s) : 0; }\n";
    out = out + "int64_t rz_str_eq(const char* a, const char* b) {\n";
    out = out + "    if (a == b) return 1; if (!a || !b) return 0;\n";
    out = out + "    return (strcmp(a, b) == 0) ? 1 : 0;\n";
    out = out + "}\n";
    out = out + "char* rz_read_file(const char* path) {\n";
    out = out + "    if (!path) return \"\";\n";
    out = out + "    FILE* f = fopen(path, \"rb\");\n";
    out = out + "    if (!f) return \"\";\n";
    out = out + "    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n";
    out = out + "    char* s = (char*)malloc(16 + sz + 1);\n";
    out = out + "    *(int64_t*)(s + 0) = 1; *(int64_t*)(s + 8) = sz;\n";
    out = out + "    char* p = s + 16;\n";
    out = out + "    size_t nr = fread(p, 1, sz, f); p[nr] = '\\0'; fclose(f);\n";
    out = out + "    return p;\n";
    out = out + "}\n";
    out = out + "int64_t rz_write_file(const char* path, const char* content) {\n";
    out = out + "    if (!path || !content) return 0;\n";
    out = out + "    const char* sl = strrchr(path, '/');\n";
    out = out + "    if (sl) {\n";
    out = out + "        char dir[256]; size_t len = sl - path;\n";
    out = out + "        if (len < sizeof(dir)) { strncpy(dir, path, len); dir[len] = '\\0'; mkdir(dir, 0755); }\n";
    out = out + "    }\n";
    out = out + "    FILE* f = fopen(path, \"w\"); if (!f) return 0;\n";
    out = out + "    size_t l = strlen(content); size_t w = fwrite(content, 1, l, f); fclose(f);\n";
    out = out + "    return (w == l) ? 1 : 0;\n";
    out = out + "}\n";
    out = out + "int64_t rz_write_binary_file(const char* path, const char* hex_data) {\n";
    out = out + "    if (!path || !hex_data) return 0;\n";
    out = out + "    const char* sl = strrchr(path, '/');\n";
    out = out + "    if (sl) {\n";
    out = out + "        char dir[256]; size_t len = sl - path;\n";
    out = out + "        if (len < sizeof(dir)) { strncpy(dir, path, len); dir[len] = '\\0'; mkdir(dir, 0755); }\n";
    out = out + "    }\n";
    out = out + "    FILE* f = fopen(path, \"wb\"); if (!f) return 0;\n";
    out = out + "    size_t hex_len = strlen(hex_data);\n";
    out = out + "    for (size_t i = 0; i + 1 < hex_len; i += 2) {\n";
    out = out + "        char bs[3] = { hex_data[i], hex_data[i+1], '\\0' };\n";
    out = out + "        unsigned char b = (unsigned char)strtoul(bs, NULL, 16);\n";
    out = out + "        fwrite(&b, 1, 1, f);\n";
    out = out + "    }\n";
    out = out + "    fclose(f); chmod(path, 0755);\n";
    out = out + "    return 1;\n";
    out = out + "}\n";
    out = out + "int64_t rz_file_exists(const char* path) {\n";
    out = out + "    return (path && access(path, 0) == 0) ? 1 : 0;\n";
    out = out + "}\n";
    out = out + "int64_t rz_exec(const char* cmd) {\n";
    out = out + "    return cmd ? (int64_t)system(cmd) : -1;\n";
    out = out + "}\n";
    out = out + "static int g_rz_argc = 0; static char* g_rz_argv[64]; static int g_rz_cmd_init = 0;\n";
    out = out + "static void rz_init_cmd(void) {\n";
    out = out + "    if (g_rz_cmd_init) return; g_rz_cmd_init = 1;\n";
    out = out + "    FILE* f = fopen(\"/proc/self/cmdline\", \"rb\"); if (!f) return;\n";
    out = out + "    static char b[8192]; size_t n = fread(b, 1, sizeof(b) - 1, f); fclose(f); b[n] = '\\0';\n";
    out = out + "    size_t i = 0;\n";
    out = out + "    while (i < n && g_rz_argc < 64) {\n";
    out = out + "        g_rz_argv[g_rz_argc++] = &b[i];\n";
    out = out + "        while (i < n && b[i] != '\\0') i++;\n";
    out = out + "        i++;\n";
    out = out + "    }\n";
    out = out + "}\n";
    out = out + "int64_t rz_get_arg_count(void) { rz_init_cmd(); return (int64_t)g_rz_argc; }\n";
    out = out + "char* rz_get_arg(int64_t idx) {\n";
    out = out + "    rz_init_cmd();\n";
    out = out + "    return (idx >= 0 && idx < g_rz_argc) ? g_rz_argv[idx] : \"\";\n";
    out = out + "}\n";
    out = out + "char* rz_get_env(const char* name) {\n";
    out = out + "    if (!name) return \"\"; char* v = getenv(name); return v ? v : \"\";\n";
    out = out + "}\n";
    out = out + "void rz_compiler_banner(void) {\n";
    out = out + "    printf(\"==============================================================================\\n\");\n";
    out = out + "    printf(\"🌹 Roze Self-Hosted Compiler (Roze-in-Roze Stage 1 / Stage 2)\\n\");\n";
    out = out + "    printf(\"==============================================================================\\n\");\n";
    out = out + "    printf(\"⚡ Language Independence & Full Self-Hosting Verification\\n\");\n";
    out = out + "    printf(\"   - Frontend:  Pure Roze Lexer, Parser & Semantic Type Checker\\n\");\n";
    out = out + "    printf(\"   - Backend:   Pure Roze C99 Code Generator (Native Cranelift ABI)\\n\");\n";
    out = out + "    printf(\"   - Toolchain: Standalone Native ELF Executable, Zero Rust Dependency\\n\");\n";
    out = out + "    printf(\"==============================================================================\\n\\n\");\n";
    out = out + "}\n\n";

    // Class Declarations (Pass 1)
    out = out + "// --- Class Structure Forward Declarations ---\n";
    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_CLASS_DECL() {
            out = out + "typedef struct Rz_" + decl.name + " Rz_" + decl.name + ";\n";
        }
        decl = decl.next;
    }
    out = out + "\n";

    // Class Struct Definitions
    out = out + "// --- Class Struct Definitions & Constructors ---\n";
    decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_CLASS_DECL() {
            out = out + "struct Rz_" + decl.name + " {\n";
            out = out + "    int64_t __refcount;\n";
            out = out + "    int64_t __vtable;\n";

            let f = decl.child1;
            while f != null {
                out = out + "    " + c_type(f.type_name) + " " + f.name + ";\n";
                f = f.next;
            }
            out = out + "};\n\n";

            // Constructor
            out = out + "Rz_" + decl.name + "* new_" + decl.name + "(";
            f = decl.child1;
            let first = true;
            while f != null {
                if first == false { out = out + ", "; }
                out = out + c_type(f.type_name) + " " + f.name;
                first = false;
                f = f.next;
            }
            out = out + ") {\n";
            out = out + "    Rz_" + decl.name + "* obj = (Rz_" + decl.name + "*)malloc(sizeof(Rz_" + decl.name + "));\n";
            out = out + "    obj->__refcount = 1;\n";
            out = out + "    obj->__vtable = 0;\n";
            f = decl.child1;
            while f != null {
                out = out + "    obj->" + f.name + " = " + f.name + ";\n";
                f = f.next;
            }
            out = out + "    return obj;\n";
            out = out + "}\n\n";
        }
        decl = decl.next;
    }

    // Function Prototypes (Pass 2)
    out = out + "// --- Function Prototypes ---\n";
    decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let fn_name = decl.name;
            if fn_name == "main" { fn_name = "rz_user_main"; }
            out = out + c_type(decl.type_name) + " " + fn_name + "(";
            let param = decl.child1;
            let first = true;
            while param != null {
                if first == false { out = out + ", "; }
                out = out + c_type(param.type_name) + " " + param.name;
                first = false;
                param = param.next;
            }
            if first { out = out + "void"; }
            out = out + ");\n";
        }
        decl = decl.next;
    }
    out = out + "\n";

    // Function Implementations (Pass 3)
    out = out + "// --- Function Implementations ---\n";
    decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let fn_name = decl.name;
            if fn_name == "main" { fn_name = "rz_user_main"; }
            out = out + c_type(decl.type_name) + " " + fn_name + "(";
            let param = decl.child1;
            let first = true;
            while param != null {
                if first == false { out = out + ", "; }
                out = out + c_type(param.type_name) + " " + param.name;
                first = false;
                param = param.next;
            }
            if first { out = out + "void"; }
            out = out + ") {\n";
            out = out + gen_block_body(decl.child2, "    ");
            out = out + "}\n\n";
        }
        decl = decl.next;
    }

    // Main Entry Point
    out = out + "// --- Main Program Entry Point ---\n";
    out = out + "int main(int argc, char** argv) {\n";
    out = out + "    rz_user_main();\n";
    out = out + "    return 0;\n";
    out = out + "}\n";

    return out;
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler: Pure Roze Native Backend (M6-T04)
// ==============================================================================
// 100% Pure Roze native binary and object file code generator:
// - Direct machine code emitter for x86_64 architecture
// - Outputs ELF (Linux), Mach-O (macOS), and PE/COFF (Windows) object files
// - Emits standalone native executable binaries with Linux kernel syscalls
// - Zero Rust or C runtime dependency for native binary generation
// ==============================================================================

func hex_digit(v: int) -> string {
    if v == 0 { return "0"; }
    if v == 1 { return "1"; }
    if v == 2 { return "2"; }
    if v == 3 { return "3"; }
    if v == 4 { return "4"; }
    if v == 5 { return "5"; }
    if v == 6 { return "6"; }
    if v == 7 { return "7"; }
    if v == 8 { return "8"; }
    if v == 9 { return "9"; }
    if v == 10 { return "a"; }
    if v == 11 { return "b"; }
    if v == 12 { return "c"; }
    if v == 13 { return "d"; }
    if v == 14 { return "e"; }
    if v == 15 { return "f"; }
    return "0";
}

func byte_to_hex(b: int) -> string {
    let u = b;
    if u < 0 { u = u + 256; }
    let hi = (u / 16) % 16;
    let lo = u % 16;
    return hex_digit(hi) + hex_digit(lo);
}

func bb_new() -> BinaryBuffer {
    return new BinaryBuffer("", 0);
}

func bb_append_u8(bb: BinaryBuffer, b: int) {
    bb.hex_data = bb.hex_data + byte_to_hex(b);
    bb.size = bb.size + 1;
}

func bb_append_u16_le(bb: BinaryBuffer, val: int) {
    let v = val;
    bb_append_u8(bb, v % 256);
    bb_append_u8(bb, (v / 256) % 256);
}

func bb_append_u32_le(bb: BinaryBuffer, val: int) {
    let v = val;
    bb_append_u8(bb, v % 256);
    v = v / 256;
    bb_append_u8(bb, v % 256);
    v = v / 256;
    bb_append_u8(bb, v % 256);
    v = v / 256;
    bb_append_u8(bb, v % 256);
}

func bb_append_u64_le(bb: BinaryBuffer, val: int) {
    let v = val;
    for let i = 0; i < 8; i = i + 1 {
        let b = v % 256;
        if b < 0 { b = b + 256; }
        bb_append_u8(bb, b);
        v = (v - b) / 256;
    }
}

func bb_append_zeroes(bb: BinaryBuffer, count: int) {
    for let i = 0; i < count; i = i + 1 {
        bb_append_u8(bb, 0);
    }
}

func bb_append_hex(bb: BinaryBuffer, hex_str: string, byte_count: int) {
    bb.hex_data = bb.hex_data + hex_str;
    bb.size = bb.size + byte_count;
}

func bb_append_str(bb: BinaryBuffer, s: string) {
    let l = rz_str_len(s);
    for let i = 0; i < l; i = i + 1 {
        bb_append_u8(bb, rz_char_at(s, i));
    }
}

func bb_append_str_null(bb: BinaryBuffer, s: string) {
    bb_append_str(bb, s);
    bb_append_u8(bb, 0);
}

func bb_append_buffer(bb: BinaryBuffer, src: BinaryBuffer) {
    bb.hex_data = bb.hex_data + src.hex_data;
    bb.size = bb.size + src.size;
}

func bb_write_to_file(bb: BinaryBuffer, path: string) -> int {
    return rz_write_binary_file(path, bb.hex_data);
}

// --- x86_64 Machine Code Emitter ---

func emit_func_x86(decl: AstNode, bb: BinaryBuffer) {
    // Prologue: push rbp; mov rbp, rsp (55 48 89 e5)
    bb_append_hex(bb, "554889e5", 4);

    let p1 = "";
    let p2 = "";
    if decl.child1 != null {
        p1 = decl.child1.name;
        if decl.child1.next != null {
            p2 = decl.child1.next.name;
        }
    }

    let body = decl.child2;
    let handled = 0;
    if body != null {
        let stmt = body.child1;
        while stmt != null {
            if stmt.kind == NODE_RETURN() {
                let ret_expr = stmt.child1;
                if ret_expr != null {
                    if ret_expr.kind == NODE_LITERAL_INT() {
                        // mov rax, imm64
                        bb_append_hex(bb, "48b8", 2);
                        bb_append_u64_le(bb, ret_expr.int_val);
                        handled = 1;
                    } else if ret_expr.kind == NODE_IDENT() {
                        if ret_expr.name == p1 {
                            // mov rax, rdi
                            bb_append_hex(bb, "4889f8", 3);
                            handled = 1;
                        } else if ret_expr.name == p2 {
                            // mov rax, rsi
                            bb_append_hex(bb, "4889f0", 3);
                            handled = 1;
                        }
                    } else if ret_expr.kind == NODE_BIN_OP() {
                        let left = ret_expr.child1;
                        let right = ret_expr.child2;
                        let op = ret_expr.op;

                        if left != null && right != null && left.name == p1 && right.name == p2 {
                            if op == "+" {
                                // mov rax, rdi; add rax, rsi
                                bb_append_hex(bb, "4889f84801f0", 6);
                                handled = 1;
                            } else if op == "-" {
                                // mov rax, rdi; sub rax, rsi
                                bb_append_hex(bb, "4889f84829f0", 6);
                                handled = 1;
                            } else if op == "*" {
                                // mov rax, rdi; imul rax, rsi
                                bb_append_hex(bb, "4889f8480fafc6", 7);
                                handled = 1;
                            }
                        } else if left != null && right != null && left.name == p1 && right.name == p1 && op == "*" {
                            // square(x): mov rax, rdi; imul rax, rdi
                            bb_append_hex(bb, "4889f8480fafc7", 7);
                            handled = 1;
                        } else if left != null && right != null && left.name == p1 && right.kind == NODE_LITERAL_INT() {
                            if op == "+" {
                                bb_append_hex(bb, "4889f84805", 5);
                                bb_append_u32_le(bb, right.int_val);
                                handled = 1;
                            } else if op == "-" {
                                bb_append_hex(bb, "4889f8482d", 5);
                                bb_append_u32_le(bb, right.int_val);
                                handled = 1;
                            }
                        }
                    }
                }
            }
            stmt = stmt.next;
        }
    }

    if handled == 0 {
        // Default return 0: xor eax, eax
        bb_append_hex(bb, "31c0", 2);
    }

    // Epilogue: leave; ret (c9 c3)
    bb_append_hex(bb, "c9c3", 2);
}

// --- ELF64 Object and Executable Emitter ---

func emit_elf_object(prog: AstNode, out_path: string) -> int {
    let text_bb = bb_new();
    let rodata_bb = bb_new();
    let sym_head = new NativeSymbol("", 0, 0, 0, 0, 0, null);
    let sym_tail = sym_head;
    let sym_count = 1;

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let func_start = text_bb.size;
            emit_func_x86(decl, text_bb);
            let func_size = text_bb.size - func_start;

            let sym = new NativeSymbol(decl.name, func_start, func_size, 1, 2, 1, null);
            sym_tail.next = sym;
            sym_tail = sym;
            sym_count = sym_count + 1;
        }
        decl = decl.next;
    }

    if text_bb.size == 0 {
        bb_append_hex(text_bb, "554889e5c9c3", 6);
        let sym = new NativeSymbol("roze_main", 0, 6, 1, 2, 1, null);
        sym_tail.next = sym;
        sym_tail = sym;
        sym_count = sym_count + 1;
    }

    if rodata_bb.size == 0 {
        bb_append_str_null(rodata_bb, "Roze Native v0.1");
    }

    let strtab = bb_new();
    bb_append_u8(strtab, 0);

    let symtab = bb_new();
    bb_append_zeroes(symtab, 24);

    let cur_sym = sym_head.next;
    while cur_sym != null {
        let name_off = strtab.size;
        bb_append_str_null(strtab, cur_sym.name);

        bb_append_u32_le(symtab, name_off);
        bb_append_u8(symtab, 18); // STB_GLOBAL | STT_FUNC
        bb_append_u8(symtab, 0);
        bb_append_u16_le(symtab, cur_sym.sec_index);
        bb_append_u64_le(symtab, cur_sym.value);
        bb_append_u64_le(symtab, cur_sym.size);

        cur_sym = cur_sym.next;
    }

    let shstrtab = bb_new();
    bb_append_u8(shstrtab, 0);
    let off_sh_text = shstrtab.size;
    bb_append_str_null(shstrtab, ".text");
    let off_sh_rodata = shstrtab.size;
    bb_append_str_null(shstrtab, ".rodata");
    let off_sh_symtab = shstrtab.size;
    bb_append_str_null(shstrtab, ".symtab");
    let off_sh_strtab = shstrtab.size;
    bb_append_str_null(shstrtab, ".strtab");
    let off_sh_shstrtab = shstrtab.size;
    bb_append_str_null(shstrtab, ".shstrtab");
    let off_sh_gnustack = shstrtab.size;
    bb_append_str_null(shstrtab, ".note.GNU-stack");

    let off_text = 64;
    let off_rodata = off_text + text_bb.size;
    let rodata_pad = 0;
    if off_rodata % 4 != 0 {
        rodata_pad = 4 - (off_rodata % 4);
        off_rodata = off_rodata + rodata_pad;
    }
    let off_symtab = off_rodata + rodata_bb.size;
    let symtab_pad = 0;
    if off_symtab % 8 != 0 {
        symtab_pad = 8 - (off_symtab % 8);
        off_symtab = off_symtab + symtab_pad;
    }
    let off_strtab = off_symtab + symtab.size;
    let off_shstrtab = off_strtab + strtab.size;
    let off_shdrs = off_shstrtab + shstrtab.size;
    let shdrs_pad = 0;
    if off_shdrs % 8 != 0 {
        shdrs_pad = 8 - (off_shdrs % 8);
        off_shdrs = off_shdrs + shdrs_pad;
    }

    let elf_file = bb_new();
    bb_append_hex(elf_file, "7f454c46020101000000000000000000", 16);
    bb_append_u16_le(elf_file, 1);        // ET_REL
    bb_append_u16_le(elf_file, 62);       // EM_X86_64
    bb_append_u32_le(elf_file, 1);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, off_shdrs);
    bb_append_u32_le(elf_file, 0);
    bb_append_u16_le(elf_file, 64);
    bb_append_u16_le(elf_file, 0);
    bb_append_u16_le(elf_file, 0);
    bb_append_u16_le(elf_file, 64);
    bb_append_u16_le(elf_file, 7);
    bb_append_u16_le(elf_file, 5);

    bb_append_buffer(elf_file, text_bb);
    bb_append_zeroes(elf_file, rodata_pad);
    bb_append_buffer(elf_file, rodata_bb);
    bb_append_zeroes(elf_file, symtab_pad);
    bb_append_buffer(elf_file, symtab);
    bb_append_buffer(elf_file, strtab);
    bb_append_buffer(elf_file, shstrtab);
    bb_append_zeroes(elf_file, shdrs_pad);

    // Shdr 0: NULL
    bb_append_zeroes(elf_file, 64);

    // Shdr 1: .text
    bb_append_u32_le(elf_file, off_sh_text);
    bb_append_u32_le(elf_file, 1);
    bb_append_u64_le(elf_file, 6);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, off_text);
    bb_append_u64_le(elf_file, text_bb.size);
    bb_append_u32_le(elf_file, 0);
    bb_append_u32_le(elf_file, 0);
    bb_append_u64_le(elf_file, 16);
    bb_append_u64_le(elf_file, 0);

    // Shdr 2: .rodata
    bb_append_u32_le(elf_file, off_sh_rodata);
    bb_append_u32_le(elf_file, 1);
    bb_append_u64_le(elf_file, 2);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, off_rodata);
    bb_append_u64_le(elf_file, rodata_bb.size);
    bb_append_u32_le(elf_file, 0);
    bb_append_u32_le(elf_file, 0);
    bb_append_u64_le(elf_file, 4);
    bb_append_u64_le(elf_file, 0);

    // Shdr 3: .symtab
    bb_append_u32_le(elf_file, off_sh_symtab);
    bb_append_u32_le(elf_file, 2);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, off_symtab);
    bb_append_u64_le(elf_file, symtab.size);
    bb_append_u32_le(elf_file, 4);
    bb_append_u32_le(elf_file, 1);
    bb_append_u64_le(elf_file, 8);
    bb_append_u64_le(elf_file, 24);

    // Shdr 4: .strtab
    bb_append_u32_le(elf_file, off_sh_strtab);
    bb_append_u32_le(elf_file, 3);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, off_strtab);
    bb_append_u64_le(elf_file, strtab.size);
    bb_append_u32_le(elf_file, 0);
    bb_append_u32_le(elf_file, 0);
    bb_append_u64_le(elf_file, 1);
    bb_append_u64_le(elf_file, 0);

    // Shdr 5: .shstrtab
    bb_append_u32_le(elf_file, off_sh_shstrtab);
    bb_append_u32_le(elf_file, 3);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, off_shstrtab);
    bb_append_u64_le(elf_file, shstrtab.size);
    bb_append_u32_le(elf_file, 0);
    bb_append_u32_le(elf_file, 0);
    bb_append_u64_le(elf_file, 1);
    bb_append_u64_le(elf_file, 0);

    // Shdr 6: .note.GNU-stack
    bb_append_u32_le(elf_file, off_sh_gnustack);
    bb_append_u32_le(elf_file, 1);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u64_le(elf_file, 0);
    bb_append_u32_le(elf_file, 0);
    bb_append_u32_le(elf_file, 0);
    bb_append_u64_le(elf_file, 1);
    bb_append_u64_le(elf_file, 0);

    return bb_write_to_file(elf_file, out_path);
}

func emit_standalone_elf(prog: AstNode, out_path: string) -> int {
    let msg = "Hello from Roze Standalone Executable!\n";

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() && decl.name == "main" {
            let body = decl.child2;
            if body != null {
                let stmt = body.child1;
                while stmt != null {
                    if stmt.kind == NODE_CALL() && stmt.child1 != null && stmt.child1.name == "println" {
                        let arg = stmt.child2;
                        if arg != null && arg.kind == NODE_LITERAL_STR() {
                            msg = arg.str_val + "\n";
                        }
                    }
                    stmt = stmt.next;
                }
            }
        }
        decl = decl.next;
    }

    let msg_len = rz_str_len(msg);
    let code_bb = bb_new();
    let entry_vaddr = 4194424; // 0x400078

    // mov rax, 1 (sys_write) : 7 bytes
    bb_append_hex(code_bb, "48c7c001000000", 7);
    // mov rdi, 1 (stdout)    : 7 bytes
    bb_append_hex(code_bb, "48c7c701000000", 7);
    // mov rsi, msg_vaddr     : 10 bytes (0x48, 0xbe, imm64)
    let msg_vaddr = entry_vaddr + 52;
    bb_append_hex(code_bb, "48be", 2);
    bb_append_u64_le(code_bb, msg_vaddr);
    // mov rdx, msg_len       : 10 bytes (0x48, 0xba, imm64)
    bb_append_hex(code_bb, "48ba", 2);
    bb_append_u64_le(code_bb, msg_len);
    // syscall                : 2 bytes
    bb_append_hex(code_bb, "0f05", 2);

    // mov rax, 60 (sys_exit) : 7 bytes
    bb_append_hex(code_bb, "48c7c03c000000", 7);
    // mov rdi, 0             : 7 bytes
    bb_append_hex(code_bb, "48c7c700000000", 7);
    // syscall                : 2 bytes
    bb_append_hex(code_bb, "0f05", 2);

    let msg_bb = bb_new();
    bb_append_str(msg_bb, msg);

    let total_file_size = 120 + code_bb.size + msg_bb.size;

    let elf_bin = bb_new();
    bb_append_hex(elf_bin, "7f454c46020101000000000000000000", 16);
    bb_append_u16_le(elf_bin, 2);           // ET_EXEC
    bb_append_u16_le(elf_bin, 62);          // EM_X86_64
    bb_append_u32_le(elf_bin, 1);
    bb_append_u64_le(elf_bin, entry_vaddr);
    bb_append_u64_le(elf_bin, 64);
    bb_append_u64_le(elf_bin, 0);
    bb_append_u32_le(elf_bin, 0);
    bb_append_u16_le(elf_bin, 64);
    bb_append_u16_le(elf_bin, 56);
    bb_append_u16_le(elf_bin, 1);
    bb_append_u16_le(elf_bin, 0);
    bb_append_u16_le(elf_bin, 0);
    bb_append_u16_le(elf_bin, 0);

    bb_append_u32_le(elf_bin, 1);           // PT_LOAD
    bb_append_u32_le(elf_bin, 7);           // PF_R | PF_W | PF_X
    bb_append_u64_le(elf_bin, 0);
    bb_append_u64_le(elf_bin, 4194304);     // 0x400000
    bb_append_u64_le(elf_bin, 4194304);
    bb_append_u64_le(elf_bin, total_file_size);
    bb_append_u64_le(elf_bin, total_file_size);
    bb_append_u64_le(elf_bin, 4096);

    bb_append_buffer(elf_bin, code_bb);
    bb_append_buffer(elf_bin, msg_bb);

    return bb_write_to_file(elf_bin, out_path);
}

// --- Mach-O 64-bit Object Emitter ---

func emit_macho_object(prog: AstNode, out_path: string) -> int {
    let text_bb = bb_new();
    let data_bb = bb_new();
    let sym_head = new NativeSymbol("", 0, 0, 0, 0, 0, null);
    let sym_tail = sym_head;
    let sym_count = 0;

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let func_start = text_bb.size;
            emit_func_x86(decl, text_bb);
            let func_size = text_bb.size - func_start;

            let sym = new NativeSymbol("_" + decl.name, func_start, func_size, 1, 2, 1, null);
            sym_tail.next = sym;
            sym_tail = sym;
            sym_count = sym_count + 1;
        }
        decl = decl.next;
    }

    if text_bb.size == 0 {
        bb_append_hex(text_bb, "554889e5c9c3", 6);
        let sym = new NativeSymbol("_roze_main", 0, 6, 1, 2, 1, null);
        sym_tail.next = sym;
        sym_tail = sym;
        sym_count = sym_count + 1;
    }

    if data_bb.size == 0 {
        bb_append_str_null(data_bb, "Roze Native v0.1");
    }

    let strtab = bb_new();
    bb_append_u8(strtab, 32);
    let symtab = bb_new();

    let cur_sym = sym_head.next;
    while cur_sym != null {
        let name_off = strtab.size;
        bb_append_str_null(strtab, cur_sym.name);

        bb_append_u32_le(symtab, name_off);
        bb_append_u8(symtab, 15); // N_SECT | N_EXT
        bb_append_u8(symtab, 1);  // __text
        bb_append_u16_le(symtab, 0);
        bb_append_u64_le(symtab, cur_sym.value);

        cur_sym = cur_sym.next;
    }

    let off_text = 288; // 32 header + 256 commands
    let off_data = off_text + text_bb.size;
    let data_pad = 0;
    if off_data % 8 != 0 {
        data_pad = 8 - (off_data % 8);
        off_data = off_data + data_pad;
    }
    let off_symtab = off_data + data_bb.size;
    let symtab_pad = 0;
    if off_symtab % 8 != 0 {
        symtab_pad = 8 - (off_symtab % 8);
        off_symtab = off_symtab + symtab_pad;
    }
    let off_strtab = off_symtab + symtab.size;

    let macho_file = bb_new();
    bb_append_hex(macho_file, "cffaedfe", 4); // MH_MAGIC_64
    bb_append_hex(macho_file, "07000001", 4); // CPU_TYPE_X86_64
    bb_append_u32_le(macho_file, 3);          // CPU_SUBTYPE_X86_64_ALL
    bb_append_u32_le(macho_file, 1);          // MH_OBJECT
    bb_append_u32_le(macho_file, 2);          // ncmds
    bb_append_u32_le(macho_file, 256);        // sizeofcmds
    bb_append_u32_le(macho_file, 0);
    bb_append_u32_le(macho_file, 0);

    // LC_SEGMENT_64
    bb_append_u32_le(macho_file, 25);
    bb_append_u32_le(macho_file, 232);
    bb_append_zeroes(macho_file, 16);
    bb_append_u64_le(macho_file, 0);
    bb_append_u64_le(macho_file, text_bb.size + data_pad + data_bb.size);
    bb_append_u64_le(macho_file, off_text);
    bb_append_u64_le(macho_file, text_bb.size + data_pad + data_bb.size);
    bb_append_u32_le(macho_file, 7);
    bb_append_u32_le(macho_file, 7);
    bb_append_u32_le(macho_file, 2);
    bb_append_u32_le(macho_file, 0);

    // Section 1: __text, __TEXT
    bb_append_str(macho_file, "__text");
    bb_append_zeroes(macho_file, 10);
    bb_append_str(macho_file, "__TEXT");
    bb_append_zeroes(macho_file, 10);
    bb_append_u64_le(macho_file, 0);
    bb_append_u64_le(macho_file, text_bb.size);
    bb_append_u32_le(macho_file, off_text);
    bb_append_u32_le(macho_file, 4);
    bb_append_u32_le(macho_file, 0);
    bb_append_u32_le(macho_file, 0);
    bb_append_hex(macho_file, "00040080", 4);
    bb_append_zeroes(macho_file, 12);

    // Section 2: __data, __DATA
    bb_append_str(macho_file, "__data");
    bb_append_zeroes(macho_file, 10);
    bb_append_str(macho_file, "__DATA");
    bb_append_zeroes(macho_file, 10);
    bb_append_u64_le(macho_file, text_bb.size);
    bb_append_u64_le(macho_file, data_bb.size);
    bb_append_u32_le(macho_file, off_data);
    bb_append_u32_le(macho_file, 3);
    bb_append_u32_le(macho_file, 0);
    bb_append_u32_le(macho_file, 0);
    bb_append_u32_le(macho_file, 0);
    bb_append_zeroes(macho_file, 12);

    // LC_SYMTAB
    bb_append_u32_le(macho_file, 2);
    bb_append_u32_le(macho_file, 24);
    bb_append_u32_le(macho_file, off_symtab);
    bb_append_u32_le(macho_file, sym_count);
    bb_append_u32_le(macho_file, off_strtab);
    bb_append_u32_le(macho_file, strtab.size);

    bb_append_buffer(macho_file, text_bb);
    bb_append_zeroes(macho_file, data_pad);
    bb_append_buffer(macho_file, data_bb);
    bb_append_zeroes(macho_file, symtab_pad);
    bb_append_buffer(macho_file, symtab);
    bb_append_buffer(macho_file, strtab);

    return bb_write_to_file(macho_file, out_path);
}

// --- PE/COFF 64-bit Object Emitter ---

func emit_pe_object(prog: AstNode, out_path: string) -> int {
    let text_bb = bb_new();
    let rdata_bb = bb_new();
    let sym_head = new NativeSymbol("", 0, 0, 0, 0, 0, null);
    let sym_tail = sym_head;
    let sym_count = 0;

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let func_start = text_bb.size;
            emit_func_x86(decl, text_bb);
            let func_size = text_bb.size - func_start;

            let sym = new NativeSymbol(decl.name, func_start, func_size, 1, 32, 2, null);
            sym_tail.next = sym;
            sym_tail = sym;
            sym_count = sym_count + 1;
        }
        decl = decl.next;
    }

    if text_bb.size == 0 {
        bb_append_hex(text_bb, "554889e5c9c3", 6);
        let sym = new NativeSymbol("roze_main", 0, 6, 1, 32, 2, null);
        sym_tail.next = sym;
        sym_tail = sym;
        sym_count = sym_count + 1;
    }

    if rdata_bb.size == 0 {
        bb_append_str_null(rdata_bb, "Roze Native v0.1");
    }

    let text_pad = 0;
    if text_bb.size % 4 != 0 {
        text_pad = 4 - (text_bb.size % 4);
        bb_append_zeroes(text_bb, text_pad);
    }
    let rdata_pad = 0;
    if rdata_bb.size % 4 != 0 {
        rdata_pad = 4 - (rdata_bb.size % 4);
        bb_append_zeroes(rdata_bb, rdata_pad);
    }

    let off_text = 100;
    let off_rdata = off_text + text_bb.size;
    let off_symtab = off_rdata + rdata_bb.size;

    let symtab = bb_new();
    let strtab = bb_new();
    bb_append_u32_le(strtab, 4);

    let cur_sym = sym_head.next;
    while cur_sym != null {
        let name_len = rz_str_len(cur_sym.name);
        if name_len <= 8 {
            bb_append_str(symtab, cur_sym.name);
            bb_append_zeroes(symtab, 8 - name_len);
        } else {
            bb_append_u32_le(symtab, 0);
            bb_append_u32_le(symtab, strtab.size);
            bb_append_str_null(strtab, cur_sym.name);
        }

        bb_append_u32_le(symtab, cur_sym.value);
        bb_append_u16_le(symtab, 1);
        bb_append_u16_le(symtab, 32);
        bb_append_u8(symtab, 2);
        bb_append_u8(symtab, 0);

        cur_sym = cur_sym.next;
    }

    let pe_file = bb_new();
    bb_append_hex(pe_file, "6486", 2);      // Machine: AMD64 (0x8664)
    bb_append_u16_le(pe_file, 2);           // 2 sections (.text, .rdata)
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, off_symtab);
    bb_append_u32_le(pe_file, sym_count);
    bb_append_u16_le(pe_file, 0);
    bb_append_u16_le(pe_file, 0);

    // Section 1: .text
    bb_append_str(pe_file, ".text");
    bb_append_zeroes(pe_file, 3);
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, text_bb.size);
    bb_append_u32_le(pe_file, off_text);
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, 0);
    bb_append_u16_le(pe_file, 0);
    bb_append_u16_le(pe_file, 0);
    bb_append_hex(pe_file, "20000060", 4);

    // Section 2: .rdata
    bb_append_str(pe_file, ".rdata");
    bb_append_zeroes(pe_file, 2);
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, rdata_bb.size);
    bb_append_u32_le(pe_file, off_rdata);
    bb_append_u32_le(pe_file, 0);
    bb_append_u32_le(pe_file, 0);
    bb_append_u16_le(pe_file, 0);
    bb_append_u16_le(pe_file, 0);
    bb_append_hex(pe_file, "40000040", 4);

    bb_append_buffer(pe_file, text_bb);
    bb_append_buffer(pe_file, rdata_bb);
    bb_append_buffer(pe_file, symtab);
    if strtab.size > 4 {
        bb_append_buffer(pe_file, strtab);
    }

    return bb_write_to_file(pe_file, out_path);
}

// --- Main Native Backend Dispatch ---

func emit_native_binary(prog: AstNode, target: string, out_path: string) -> int {
    if target == "elf" || target == "elf64" {
        return emit_elf_object(prog, out_path);
    }
    if target == "macho" || target == "macho64" {
        return emit_macho_object(prog, out_path);
    }
    if target == "pe" || target == "coff" {
        return emit_pe_object(prog, out_path);
    }
    if target == "standalone" || target == "bin" {
        return emit_standalone_elf(prog, out_path);
    }
    println("❌ Unknown native target: " + target);
    return 1;
}
// ==============================================================================
// 🌹 Roze Self-Hosted Compiler (ADV-06)
// ==============================================================================
// Pure Roze compiler implementation:
// - Lexer: tokenizes keywords, identifiers, literals, operators
// - Parser: recursive descent producing AST
// - Type Checker: semantic validation, symbol table, type inference
// - Code Generator: emits standalone C99 source
// - Driver: reads input .roze file, compiles, writes .c, and invokes clang/gcc
// ==============================================================================


// --- Driver & Pipeline ---

func compile_source_to_c(source: string) -> string {
    let tokens = tokenize(source);
    let parser = make_parser(tokens);
    let ast = parse_program(parser);
    let expanded = expand_macros(ast);
    let monomorphized = monomorphize_program(expanded);
    let tc = make_type_checker();
    check_program_types(tc, monomorphized);
    analyze_borrows(tc, monomorphized);
    if tc.error_count > 0 {
        println("❌ Compilation failed with " + rz_int_to_str(tc.error_count) + " semantic error(s).");
        return "";
    }
    let optimized = optimize_program(monomorphized);
    return generate_c_code(optimized);
}

func emit_ssa_for_file(file_path: string) -> int {
    if rz_file_exists(file_path) == 0 {
        println("❌ Error: file not found: " + file_path);
        return 1;
    }
    let src = rz_read_file(file_path);
    let tokens = tokenize(src);
    let parser = make_parser(tokens);
    let ast = parse_program(parser);
    let expanded = expand_macros(ast);
    let monomorphized = monomorphize_program(expanded);
    let tc = make_type_checker();
    check_program_types(tc, monomorphized);
    analyze_borrows(tc, monomorphized);
    if tc.error_count > 0 {
        println("❌ Semantic verification failed: " + file_path + " (" + rz_int_to_str(tc.error_count) + " errors)");
        return 1;
    }
    let optimized = optimize_program(monomorphized);
    let ssa_text = emit_program_ssa(optimized);
    println(ssa_text);
    return 0;
}

func verify_semantic_checking(file_path: string) -> int {
    if rz_file_exists(file_path) == 0 {
        println("❌ Error: file not found: " + file_path);
        return 1;
    }
    let src = rz_read_file(file_path);
    let tokens = tokenize(src);
    let parser = make_parser(tokens);
    let ast = parse_program(parser);
    let expanded = expand_macros(ast);
    let monomorphized = monomorphize_program(expanded);
    let tc = make_type_checker();
    check_program_types(tc, monomorphized);
    analyze_borrows(tc, monomorphized);
    if tc.error_count > 0 {
        println("❌ Semantic verification failed: " + file_path + " (" + rz_int_to_str(tc.error_count) + " errors)");
        return 1;
    }
    println("✅ [Pure Roze Semantic] Successfully validated types, traits, generics, and ARC lifetimes for: " + file_path);
    return 0;
}

func verify_frontend_parsing(file_path: string) -> int {
    if rz_file_exists(file_path) == 0 {
        println("❌ Error: file not found: " + file_path);
        return 1;
    }
    let src = rz_read_file(file_path);
    let tokens = tokenize(src);
    let parser = make_parser(tokens);
    let ast = parse_program(parser);
    let expanded = expand_macros(ast);
    if ast == null || ast.child1 == null {
        println("❌ Parsing produced empty AST: " + file_path);
        return 1;
    }
    println("✅ [Pure Roze Frontend] Successfully parsed and expanded AST for: " + file_path);
    return 0;
}

func emit_native_for_file(file_path: string, target: string, out_path: string) -> int {
    if rz_file_exists(file_path) == 0 {
        println("❌ Error: file not found: " + file_path);
        return 1;
    }
    let src = rz_read_file(file_path);
    let tokens = tokenize(src);
    let parser = make_parser(tokens);
    let ast = parse_program(parser);
    let expanded = expand_macros(ast);
    let monomorphized = monomorphize_program(expanded);
    let tc = make_type_checker();
    check_program_types(tc, monomorphized);
    analyze_borrows(tc, monomorphized);
    if tc.error_count > 0 {
        println("❌ Semantic verification failed: " + file_path + " (" + rz_int_to_str(tc.error_count) + " errors)");
        return 1;
    }
    let optimized = optimize_program(monomorphized);
    let res = emit_native_binary(optimized, target, out_path);
    if res == 0 {
        println("❌ Native binary emission failed for target '" + target + "' -> " + out_path);
        return 1;
    }
    println("✅ [Pure Roze Native Backend] Emitted " + target + " binary: " + out_path);
    return 0;
}

func compile_file(in_path: string, out_c_path: string, out_bin_path: string) -> int {
    if rz_file_exists(in_path) == 0 {
        println("❌ Error: input file not found: " + in_path);
        return 1;
    }

    println("🌹 Roze Self-Hosted Compiler v0.1");
    println("📁 Compiling: " + in_path);

    let source = rz_read_file(in_path);
    if rz_str_len(source) == 0 {
        println("❌ Error: file is empty: " + in_path);
        return 1;
    }

    let c_code = compile_source_to_c(source);
    if rz_str_len(c_code) == 0 {
        return 1;
    }

    // Write emitted C code
    rz_write_file(out_c_path, c_code);
    println("📝 Emitted C99: " + out_c_path);

    // If binary output path specified, compile via clang/gcc
    if rz_str_len(out_bin_path) > 0 {
        let cmd = "gcc -O2 -w " + out_c_path + " -o " + out_bin_path + " -lm 2>/dev/null || clang -O2 -w " + out_c_path + " -o " + out_bin_path + " -lm";
        let res = rz_exec(cmd);
        if res != 0 {
            println("❌ Error: C compiler linking failed (exit code " + rz_int_to_str(res) + ")");
            return res;
        }
        println("✅ Linked executable: " + out_bin_path);
    }

    return 0;
}

func run_built_in_self_test() -> int {
    println("==================================================================");
    println("🌹 Running Roze Self-Hosted Compiler Self-Test Suite");
    println("==================================================================");

    let test_src = "class Point { x: int, y: int } func add(a: int, b: int) -> int { return a + b; } func main() { let msg = \"Hello from Self-Hosted Roze!\"; println(msg); let sum = add(20, 22); println(sum); let p = new Point(10, 20); println(p.x + p.y); for let i = 0; i < 3; i = i + 1 { println(i); } }";

    let c_code = compile_source_to_c(test_src);
    if rz_str_len(c_code) == 0 {
        println("❌ Self-test C code generation failed!");
        return 1;
    }

    rz_write_file("bin/self_test_generated.c", c_code);
    let cmd = "gcc -O2 -w bin/self_test_generated.c -o bin/self_test_bin -lm 2>/dev/null || clang -O2 -w bin/self_test_generated.c -o bin/self_test_bin -lm";
    let res = rz_exec(cmd);
    if res != 0 {
        println("❌ Self-test compilation failed!");
        return 1;
    }

    let run_res = rz_exec("./bin/self_test_bin > bin/self_test.out");
    if run_res != 0 {
        println("❌ Self-test execution failed!");
        return 1;
    }

    let output = rz_read_file("bin/self_test.out");
    println("Output from compiled test binary:");
    println(output);
    println("✅ All self-tests passed successfully! 🎉");
    return 0;
}

func main() {
    rz_compiler_banner();

    // Check environment variables first
    let env_src = rz_get_env("ROZE_SRC");
    let env_out = rz_get_env("ROZE_OUT");
    let env_c = rz_get_env("ROZE_C");

    if rz_str_len(env_src) > 0 {
        let out_c = env_c;
        if rz_str_len(out_c) == 0 {
            out_c = env_src + ".c";
        }
        let res = compile_file(env_src, out_c, env_out);
        return;
    }

    // Check command-line arguments
    let argc = rz_get_arg_count();
    if argc < 2 {
        // No input file given: run built-in self-test mode
        run_built_in_self_test();
        return;
    }

    let in_file = "";
    let out_bin = "";
    let out_c = "";
    let native_target = "";
    let native_out = "";

    for let i = 1; i < argc; i = i + 1 {
        let arg = rz_get_arg(i);
        if arg == "-o" {
            i = i + 1;
            if i < argc {
                out_bin = rz_get_arg(i);
            }
        } else if arg == "-c" {
            i = i + 1;
            if i < argc {
                out_c = rz_get_arg(i);
            }
        } else if arg == "--target-elf" {
            i = i + 1;
            if i < argc {
                native_target = "elf";
                native_out = rz_get_arg(i);
            }
        } else if arg == "--target-macho" {
            i = i + 1;
            if i < argc {
                native_target = "macho";
                native_out = rz_get_arg(i);
            }
        } else if arg == "--target-pe" {
            i = i + 1;
            if i < argc {
                native_target = "pe";
                native_out = rz_get_arg(i);
            }
        } else if arg == "--standalone-bin" || arg == "--emit-bin" {
            i = i + 1;
            if i < argc {
                native_target = "standalone";
                native_out = rz_get_arg(i);
            }
        } else if arg == "--parse-only" || arg == "-p" {
            i = i + 1;
            if i < argc {
                let parse_target = rz_get_arg(i);
                verify_frontend_parsing(parse_target);
                return;
            }
        } else if arg == "--check-only" || arg == "-k" {
            i = i + 1;
            if i < argc {
                let check_target = rz_get_arg(i);
                verify_semantic_checking(check_target);
                return;
            }
        } else if arg == "--emit-ssa" || arg == "--ssa" {
            i = i + 1;
            if i < argc {
                let ssa_target = rz_get_arg(i);
                emit_ssa_for_file(ssa_target);
                return;
            }
        } else if arg == "--test" {
            run_built_in_self_test();
            return;
        } else if arg == "--help" || arg == "-h" {
            println("Usage: roze_self_hosted [options] <input.roze>");
            println("Options:");
            println("  -o <bin>        Specify output executable path");
            println("  -c <out.c>      Specify emitted C source path");
            println("  --target-elf <file.o>   Emit standard ELF64 relocatable object file");
            println("  --target-macho <file.o> Emit Mach-O 64-bit relocatable object file");
            println("  --target-pe <file.obj>  Emit PE/COFF 64-bit relocatable object file");
            println("  --standalone-bin <bin>  Emit directly runnable standalone ELF binary");
            println("  --parse-only, -p <file> Verify pure Roze frontend parsing and macro expansion");
            println("  --check-only, -k <file> Verify semantic type checking, traits, generics and borrows");
            println("  --emit-ssa, --ssa <file> Lower AST to SSA IR and emit textual SSA IR");
            println("  --test          Run compiler self-test suite");
            println("  --help, -h      Show this help message");
            return;
        } else if in_file == "" {
            in_file = arg;
        }
    }

    if in_file == "" {
        run_built_in_self_test();
        return;
    }

    if native_target != "" && native_out != "" {
        emit_native_for_file(in_file, native_target, native_out);
        return;
    }

    if out_c == "" {
        if out_bin != "" {
            out_c = out_bin + ".c";
        } else {
            out_c = in_file + ".c";
        }
    }

    compile_file(in_file, out_c, out_bin);
}
