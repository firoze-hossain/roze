func NODE_ENUM_VARIANT() -> int { return 108; }
func NODE_TRAIT_DECL() -> int { return 109; }
func NODE_IMPL_DECL() -> int { return 130; }
func NODE_ANNOTATION() -> int { return 131; }
func NODE_IMPORT() -> int { return 140; }

// Statements
func NODE_BLOCK() -> int { return 110; }
func NODE_IF() -> int { return 111; }
func NODE_WHILE() -> int { return 112; }
func NODE_FOR() -> int { return 113; }
func NODE_RETURN() -> int { return 114; }
func NODE_ASSIGN() -> int { return 115; }
func NODE_EXPR_STMT() -> int { return 116; }
func NODE_MATCH() -> int { return 117; }
func NODE_MATCH_ARM() -> int { return 118; }
func NODE_UNSAFE_BLOCK() -> int { return 119; }
func NODE_COMPTIME_STMT() -> int { return 132; }
func NODE_FIELD_ASSIGN() -> int { return 143; }
func NODE_INDEX_ASSIGN() -> int { return 144; }

// Expressions
func NODE_BIN_OP() -> int { return 120; }
func NODE_UNARY_OP() -> int { return 121; }
func NODE_CALL() -> int { return 122; }
func NODE_MEMBER() -> int { return 123; }
func NODE_NEW() -> int { return 124; }
func NODE_LITERAL_INT() -> int { return 125; }
func NODE_LITERAL_STR() -> int { return 126; }
func NODE_LITERAL_BOOL() -> int { return 127; }
func NODE_LITERAL_NULL() -> int { return 128; }
func NODE_IDENT() -> int { return 129; }
func NODE_METHOD_CALL() -> int { return 133; }
func NODE_INDEX() -> int { return 134; }
func NODE_TRY() -> int { return 135; }
func NODE_CLOSURE() -> int { return 136; }
func NODE_COMPTIME_EXPR() -> int { return 137; }
func NODE_MACRO_CALL() -> int { return 138; }
func NODE_PATTERN() -> int { return 139; }
func NODE_AWAIT() -> int { return 141; }
func NODE_ASM() -> int { return 142; }
func NODE_LITERAL_CHAR() -> int { return 145; }

// --- Data Classes ---
class Token {
    kind: int,
    text: string,
    int_val: int,
    line: int,
    col: int,
    next: Token
}

class AstNode {
    kind: int,
    name: string,
    type_name: string,
    op: string,
    int_val: int,
    str_val: string,
    child1: AstNode,
    child2: AstNode,
    child3: AstNode,
    child4: AstNode,
    next: AstNode,
    line: int,
    col: int
}

class Symbol {
    name: string,
    type_name: string,
    kind: int,
    scope_level: int,
    next: Symbol
}

func make_token(kind: int, text: string, int_val: int, line: int, col: int) -> Token {
    return new Token(kind, text, int_val, line, col, null);
}

func make_ast_node(kind: int, name: string, type_name: string, line: int, col: int) -> AstNode {
    return new AstNode(kind, name, type_name, "", 0, "", null, null, null, null, null, line, col);
}

func token_kind_to_str(kind: int) -> string {
    if kind == TOK_EOF() { return "EOF"; }
    if kind == TOK_IDENT() { return "IDENT"; }
    if kind == TOK_INT() { return "INT"; }
    if kind == TOK_STRING() { return "STRING"; }
    if kind == TOK_BOOL() { return "BOOL"; }
    if kind == TOK_CHAR() { return "CHAR"; }
    if kind == TOK_FUNC() { return "func"; }
    if kind == TOK_LET() { return "let"; }
    if kind == TOK_VAR() { return "var"; }
    if kind == TOK_IF() { return "if"; }
    if kind == TOK_ELSE() { return "else"; }
    if kind == TOK_WHILE() { return "while"; }
    if kind == TOK_FOR() { return "for"; }
    if kind == TOK_RETURN() { return "return"; }
    if kind == TOK_CLASS() { return "class"; }
    if kind == TOK_NEW() { return "new"; }
    if kind == TOK_EXTERN() { return "extern"; }
    if kind == TOK_IMPORT() { return "import"; }
    if kind == TOK_NULL() { return "null"; }
    if kind == TOK_ENUM() { return "enum"; }
    if kind == TOK_MATCH() { return "match"; }
    if kind == TOK_TRAIT() { return "trait"; }
    if kind == TOK_IMPL() { return "impl"; }
    if kind == TOK_UNSAFE() { return "unsafe"; }
    if kind == TOK_COMPTIME() { return "comptime"; }
    if kind == TOK_ASYNC() { return "async"; }
    if kind == TOK_AWAIT() { return "await"; }
    return "TOKEN";
}
