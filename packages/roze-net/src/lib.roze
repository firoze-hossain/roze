    let layer = packet_layer_new(layer_id_dns(), "DNS", 4660, 0, qtype, 0, 0, 0, 0, 0, qname, "", "", "", "", raw_packet_new(0)); // 0x1234
    return packet_from_single_layer(layer);
}
