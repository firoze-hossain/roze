// =========================================================================
// ---- Static Collections Algorithm Suite (java.util.Collections Parity) ----
// =========================================================================

func collections_swap(list: List, i: int, j: int) {
    let tmp = list_get(list, i);
    list_set(list, i, list_get(list, j));
    list_set(list, j, tmp);
}

func collections_reverse(list: List) {
    let i = 0;
    let j = list_length(list) - 1;
    while i < j {
        collections_swap(list, i, j);
        i = i + 1;
        j = j - 1;
    }
}

func collections_fill(list: List, val: int) {
    let n = list_length(list);
    let i = 0;
    while i < n {
        list_set(list, i, val);
        i = i + 1;
    }
}

func collections_copy(dest: List, src: List) {
    let n = list_length(src);
    let i = 0;
    while i < n {
        if i < list_length(dest) {
            list_set(dest, i, list_get(src, i));
        } else {
            list_push(dest, list_get(src, i));
        }
        i = i + 1;
    }
}

func collections_rotate(list: List, dist: int) {
    let n = list_length(list);
    if n <= 1 {
        return;
    }
    let d = dist % n;
    if d < 0 {
        d = d + n;
    }
    if d == 0 {
        return;
    }
    // Three-step reversal: reverse 0..n-1, reverse 0..d-1, reverse d..n-1
    let i = 0;
    let j = n - 1;
    while i < j {
        collections_swap(list, i, j);
        i = i + 1;
        j = j - 1;
    }
    i = 0;
    j = d - 1;
    while i < j {
        collections_swap(list, i, j);
        i = i + 1;
        j = j - 1;
    }
    i = d;
    j = n - 1;
    while i < j {
        collections_swap(list, i, j);
        i = i + 1;
        j = j - 1;
    }
}

func collections_min(list: List) -> int {
    let n = list_length(list);
    if n == 0 {
        return 0;
    }
    let m: int = list_get(list, 0);
    let i = 1;
    while i < n {
        let val: int = list_get(list, i);
        if val < m {
            m = val;
        }
        i = i + 1;
    }
    return m;
}

func collections_max(list: List) -> int {
    let n = list_length(list);
    if n == 0 {
        return 0;
    }
    let m: int = list_get(list, 0);
    let i = 1;
    while i < n {
        let val: int = list_get(list, i);
        if val > m {
            m = val;
        }
        i = i + 1;
    }
    return m;
}

func collections_frequency(list: List, target: int) -> int {
    let count = 0;
    let n = list_length(list);
    let i = 0;
    while i < n {
        let val: int = list_get(list, i);
        if val == target {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

func collections_binary_search(list: List, key: int) -> int {
    let low = 0;
    let high = list_length(list) - 1;
    while low <= high {
        let mid = low + (high - low) / 2;
        let mid_val: int = list_get(list, mid);
        if mid_val < key {
            low = mid + 1;
        } else if mid_val > key {
            high = mid - 1;
        } else {
            return mid;
        }
    }
    return -(low + 1);
}

func _collections_qsort(list: List, low: int, high: int) {
    if low < high {
        let pivot: int = list_get(list, high);
        let i = low - 1;
        let j = low;
        while j < high {
            let val: int = list_get(list, j);
            if val <= pivot {
                i = i + 1;
                collections_swap(list, i, j);
            }
            j = j + 1;
        }
        collections_swap(list, i + 1, high);
        let pi = i + 1;
        _collections_qsort(list, low, pi - 1);
        _collections_qsort(list, pi + 1, high);
    }
}

func collections_sort(list: List) {
    let n = list_length(list);
    if n > 1 {
        _collections_qsort(list, 0, n - 1);
    }
}

func collections_shuffle_seeded(list: List, seed: int) {
    let n = list_length(list);
    if n <= 1 {
        return;
    }
    let mut_seed = seed;
    let i = n - 1;
    while i > 0 {
        mut_seed = (mut_seed * 1103515245 + 12345);
        if mut_seed < 0 {
            mut_seed = -mut_seed;
        }
        let j = mut_seed % (i + 1);
        collections_swap(list, i, j);
        i = i - 1;
    }
}

func collections_shuffle(list: List) {
    let seed = time_now();
    collections_shuffle_seeded(list, seed);
}

func collections_unmodifiable_view(list: List) -> List {
    let res = list_new();
    let n = list_length(list);
    let i = 0;
    while i < n {
        list_push(res, list_get(list, i));
        i = i + 1;
    }
    return res;
}
