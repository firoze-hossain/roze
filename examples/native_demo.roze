// examples/native_demo.roze
// Demonstrates the native (Cranelift) backend spike -- compiles to a
// real, standalone executable, no JVM/JDK involved at all.
// Try it: roze run examples/native_demo.roze --target native
//
// Deliberately uses only what the native backend supports today: int/
// bool functions, arithmetic, if/while/for, calling other functions,
// and println of an int/bool/string-literal. See
// docs/MEMORY_MODEL_DECISION.md for what's not supported yet (general
// strings, list/map, and why).

func fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func sign(x: int) -> int {
    if x > 0 {
        return 1;
    } else if x < 0 {
        return -1;
    } else {
        return 0;
    }
}

func sum_to(n: int) -> int {
    let total = 0;
    for let i = 1; i <= n; i = i + 1 {
        total = total + i;
    }
    return total;
}

func main() {
    println("Hello from the native backend!");

    println(fib(10));
    println(sign(-5));
    println(sum_to(100));

    let x = 5;
    let y = 10;
    println(x < y && y > 0);
    println(x > y || y > 0);

    let i = 0;
    while i < 3 {
        println(i);
        i = i + 1;
    }
}
