{
  "name": "Roze",
  "scopeName": "source.roze",
  "fileTypes": ["roze"],
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.roze",
          "match": "\\b(if|else|for|while|return|match|break|continue|import)\\b"
        },
        {
          "name": "keyword.declaration.roze",
          "match": "\\b(let|var|mut|func|class|enum|trait|impl|extern|unsafe|new)\\b"
        },
        {
          "name": "keyword.other.roze",
          "match": "\\b(true|false|null|this|super|async|await|try|catch|throw|as|in)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.roze",
          "match": "\\b(int|float|string|bool|void|any|unknown|never|u8|rawpointer|Option|Result|Some|None|Ok|Err|List|Map|Channel|Thread)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.roze",
          "match": "\\bfunc\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.roze"
            }
          }
        },
        {
          "name": "support.function.builtin.roze",
          "match": "\\b(println|print|read_line|assert|panic|alloc|free_ptr|write_bytes|read_bytes|thread_spawn|channel_new|channel_send|channel_recv|http_server_start|http_server_accept|http_server_respond|http_server_stop|sql_connect|sql_query|sql_execute|sql_close|list_new|list_push|list_get|list_set|list_remove|list_length|list_is_empty|map_new|map_put|map_get|map_has|map_remove|map_size|map_is_empty|read_file|write_file|append_file|file_exists|delete_file|http_get|http_post|json_encode|json_decode)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.roze",
          "match": "//.*$"
        },
        {
          "name": "comment.block.roze",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.roze",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.roze",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        },
        {
          "name": "string.quoted.single.roze",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.roze",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.roze",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.roze",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%|==|!=|<|>|<=|>=|&&|\\|\\||!|\\?|:|=|\\+=|-=|\\*=|/=)"
        }
      ]
    }
  }
}