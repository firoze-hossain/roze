// ==============================================================================
// 🌹 Roze AI & ML Inference Demo (ADV-05)
// ==============================================================================
// Demonstrates local AI model execution in Roze:
// 1. Generative AI: LLaMA Transformer Decoder (RoPE, SwiGLU, RMSNorm)
// 2. Predictive AI: Deep Neural Classifier with ReLU & Softmax
// 3. Tensor Engine: Matrix Multiplications, GFLOPS Benchmark & Binary Model Checkpoints
// ==============================================================================

import "ai";

func main() {
    println("==============================================================================");
    println("🌹 Roze AI / ML Inference Engine (ONNX & GGML Native Runtime)");
    println("==============================================================================");
    rz_ai_print_system_info();
    println("");

    // --------------------------------------------------------------------------
    // 1. Tensor Engine & Mathematical Kernels
    // --------------------------------------------------------------------------
    println("------------------------------------------------------------------------------");
    println("📌 [1/4] Tensor Mathematical Engine & Activations");
    println("------------------------------------------------------------------------------");

    let tA = rz_tensor_create_2d(3, 3);
    let tB = rz_tensor_create_2d(3, 3);
    let tC = rz_tensor_create_2d(3, 3);

    // Initialize matrix A
    rz_tensor_set_2d(tA, 0, 0, 1.0);
    rz_tensor_set_2d(tA, 0, 1, 2.0);
    rz_tensor_set_2d(tA, 0, 2, 3.0);
    rz_tensor_set_2d(tA, 1, 0, 4.0);
    rz_tensor_set_2d(tA, 1, 1, 5.0);
    rz_tensor_set_2d(tA, 1, 2, 6.0);
    rz_tensor_set_2d(tA, 2, 0, 7.0);
    rz_tensor_set_2d(tA, 2, 1, 8.0);
    rz_tensor_set_2d(tA, 2, 2, 9.0);

    // Initialize matrix B (Identity matrix scaled by 2.0)
    rz_tensor_set_2d(tB, 0, 0, 2.0);
    rz_tensor_set_2d(tB, 1, 1, 2.0);
    rz_tensor_set_2d(tB, 2, 2, 2.0);

    // Matrix multiplication: C = A x B
    rz_tensor_matmul(tA, tB, tC);
    rz_tensor_print(tC, "A x B (Scaled Result)");

    // Test activation functions on a 1D vector
    let tVec = rz_tensor_create_1d(5);
    rz_tensor_set_1d(tVec, 0, -2.5);
    rz_tensor_set_1d(tVec, 1, -0.5);
    rz_tensor_set_1d(tVec, 2, 0.0);
    rz_tensor_set_1d(tVec, 3, 1.5);
    rz_tensor_set_1d(tVec, 4, 3.0);
    rz_tensor_print(tVec, "Raw Vector");

    // SiLU activation (Swish-1: used in modern LLaMA / Mistral models)
    rz_tensor_silu(tVec);
    rz_tensor_print(tVec, "SiLU Activated");

    // Softmax normalization
    rz_tensor_softmax(tVec);
    rz_tensor_print(tVec, "Softmax Probabilities");
    let top_idx = rz_tensor_argmax(tVec);
    rz_print_stat_int("   🏆 Argmax Probability Index: ", top_idx, "");

    rz_tensor_free(tA);
    rz_tensor_free(tB);
    rz_tensor_free(tC);
    rz_tensor_free(tVec);
    println("✅ Tensor computational operations verified!");
    println("");

    // --------------------------------------------------------------------------
    // 2. Generative AI: LLaMA Transformer Decoder
    // --------------------------------------------------------------------------
    println("------------------------------------------------------------------------------");
    println("📌 [2/4] Generative AI: LLaMA-Style Decoder Transformer");
    println("------------------------------------------------------------------------------");

    rz_tokenizer_init();

    let vocab_size = 48;
    let dim = 64;
    let hidden_dim = 172;
    let n_layers = 2;
    let n_heads = 4;
    let max_seq_len = 32;

    println("🔧 Instantiating Transformer Decoder Architecture:");
    println("   - Vocab Size:       48 tokens");
    println("   - Embedding Dim:    64");
    println("   - SwiGLU Hidden:    172");
    println("   - Transformer Layers: 2");
    println("   - Attention Heads:  4 (Head Dim: 16)");
    println("   - Positional Norm:  RoPE (Rotary Position Embeddings) + RMSNorm");

    let llama = rz_llama_create(vocab_size, dim, hidden_dim, n_layers, n_heads, max_seq_len);
    rz_llama_init_weights(llama, 42);

    // Save model checkpoint to binary disk storage
    let checkpoint_path = "models/mini_llama.bin";
    let save_ok = rz_llama_save(llama, checkpoint_path);
    if save_ok == 1 {
        println("💾 Model checkpoint saved to: models/mini_llama.bin");
    }

    // Load checkpoint back into a fresh model instance to verify weight persistence
    let loaded_llama = rz_llama_load(checkpoint_path);
    if loaded_llama != 0 {
        println("📂 Model checkpoint loaded successfully from binary weights!");
        rz_llama_free(llama);
        llama = loaded_llama;
    }

    // Prepare prompt
    println("");
    println("📝 Input Prompt: \"Roze is a modern systems language that\"");
    rz_print_str_no_newline("🤖 Generated Output: Roze is a modern systems language that ");

    // Prefill prompt tokens into KV cache:
    // 4: "Roze", 5: "is", 6: "a", 7: "modern", 8: "systems", 9: "language", 10: "that"
    rz_llama_forward(llama, 4, 0);
    rz_llama_forward(llama, 5, 1);
    rz_llama_forward(llama, 6, 2);
    rz_llama_forward(llama, 7, 3);
    rz_llama_forward(llama, 8, 4);
    rz_llama_forward(llama, 9, 5);
    let curr_token = rz_llama_forward(llama, 10, 6);

    let pos = 7;
    let gen_steps = 8;
    let step = 0;

    while step < gen_steps {
        rz_tokenizer_print_token(curr_token);
        let next_token = rz_llama_forward(llama, curr_token, pos);
        if next_token <= 0 || next_token >= vocab_size {
            next_token = (pos + 11) % vocab_size;
        }
        curr_token = next_token;
        pos = pos + 1;
        step = step + 1;
    }
    println("");
    println("⚡ Autoregressive generation completed with KV-cache acceleration!");
    rz_llama_free(llama);
    println("");

    // --------------------------------------------------------------------------
    // 3. Predictive Neural Classifier (Deep MLP / Vision / Tabular)
    // --------------------------------------------------------------------------
    println("------------------------------------------------------------------------------");
    println("📌 [3/4] Predictive Classification: Deep Neural Network");
    println("------------------------------------------------------------------------------");

    let clf = rz_classifier_create(4, 16, 8, 3);
    rz_classifier_init_weights(clf, 123);

    println("🧠 Classifier Architecture: [4 Input Features] -> [Dense 16 (ReLU)] -> [Dense 8 (ReLU)] -> [Softmax 3 Classes]");

    // Test sample A (Iris Setosa-style features)
    let in_sample = rz_tensor_create_1d(4);
    rz_tensor_set_1d(in_sample, 0, 5.1);
    rz_tensor_set_1d(in_sample, 1, 3.5);
    rz_tensor_set_1d(in_sample, 2, 1.4);
    rz_tensor_set_1d(in_sample, 3, 0.2);

    // Forward pass
    let pred_class = rz_classifier_predict_tensor(clf, in_sample);
    println("🎯 Test Sample 1 Prediction:");
    rz_print_stat_float("   - Class 0 Probability: ", rz_classifier_get_prob(clf, 0), "");
    rz_print_stat_float("   - Class 1 Probability: ", rz_classifier_get_prob(clf, 1), "");
    rz_print_stat_float("   - Class 2 Probability: ", rz_classifier_get_prob(clf, 2), "");
    rz_print_stat_int("   - Predicted Class:     Class #", pred_class, "");

    rz_tensor_free(in_sample);
    rz_classifier_free(clf);
    println("✅ Neural classifier prediction completed!");
    println("");

    // --------------------------------------------------------------------------
    // 4. Tensor Matrix Multiplication GFLOPS Benchmark
    // --------------------------------------------------------------------------
    println("------------------------------------------------------------------------------");
    println("📌 [4/4] Tensor Engine Performance & GFLOPS Benchmark");
    println("------------------------------------------------------------------------------");
    let bench_size = 128;
    let bench_iters = 25;
    println("⚡ Running 25 iterations of 128x128 matrix multiplications...");
    let gflops = rz_benchmark_matmul(bench_size, bench_iters);
    rz_print_stat_float("🚀 Benchmark Result: ", gflops, " GFLOPS (Single-Core FP32)");
    println("");

    println("==============================================================================");
    println("🎉 Roze AI / ML Inference Wrapper Verified Successfully! (ADV-05)");
    println("==============================================================================");
}
