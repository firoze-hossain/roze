class NN {}

func nn_init() -> NN {
    return new NN();
}

impl NN {
    func Linear(in_features: int, out_features: int, bias: bool) -> Linear {
        return nn_linear(in_features, out_features, bias);
    }

    func Conv2d(in_channels: int, out_channels: int, kernel_size: int, stride: int, padding: int, bias: bool) -> Conv2d {
        return nn_conv2d(in_channels, out_channels, kernel_size, stride, padding, bias);
    }

    func MaxPool2d(kernel_size: int, stride: int, padding: int) -> MaxPool2d {
        return nn_max_pool2d(kernel_size, stride, padding);
    }

    func AvgPool2d(kernel_size: int, stride: int, padding: int) -> AvgPool2d {
        return nn_avg_pool2d(kernel_size, stride, padding);
    }

    func BatchNorm2d(num_features: int, eps: float, momentum: float) -> BatchNorm2d {
        return nn_batch_norm2d(num_features, eps, momentum);
    }

    func LayerNorm(normalized_shape: int, eps: float) -> LayerNorm {
        return nn_layer_norm(normalized_shape, eps);
    }

    func Dropout(p: float) -> Dropout {
        return nn_dropout(p);
    }

    func Embedding(num_embeddings: int, embedding_dim: int) -> Embedding {
        return nn_embedding(num_embeddings, embedding_dim);
    }

    func MultiheadAttention(embed_dim: int, num_heads: int, dropout: float, bias: bool) -> MultiheadAttention {
        return nn_multihead_attention(embed_dim, num_heads, dropout, bias);
    }

    func Sequential(modules: list) -> Sequential {
        return nn_sequential(modules);
    }

    func ReLU() -> ReLU {
        return nn_relu();
    }

    func GELU() -> GELU {
        return nn_gelu();
    }

    func SiLU() -> SiLU {
        return nn_silu();
    }

    func Sigmoid() -> Sigmoid {
        return nn_sigmoid();
    }

    func Softmax(dim: int) -> Softmax {
        return nn_softmax(dim);
    }

    func MSELoss() -> MSELoss {
        return nn_mse_loss();
    }

    func L1Loss() -> L1Loss {
        return nn_l1_loss();
    }

    func BCEWithLogitsLoss() -> BCEWithLogitsLoss {
        return nn_bce_with_logits_loss();
    }

    func CrossEntropyLoss() -> CrossEntropyLoss {
        return nn_cross_entropy_loss();
    }

    func Parameter(data: Tensor) -> Parameter {
        return nn_parameter(data);
    }
}

