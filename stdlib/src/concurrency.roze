// stdlib/src/concurrency.roze
//
// Roze Concurrency Module (MED-03 & M1-T04)
// Provides:
//   - M:N Green Threads (Virtual Threads) with work-stealing scheduler
//   - Zero-allocation fiber context switching
//   - OS threads (pthread) and bounded/unbounded thread-safe channels.
//
// Bundled directly into the Roze binary at compile time (via compiler/src/imports.rs).
//
// ---- Intrinsics (always available, no import needed) ----
//
//   fiber_spawn(func)        -> Fiber   : spawns an M:N green thread on multi-core work-stealing pool
//   fiber_join(fiber)        -> T       : cooperatively joins a fiber and waits for its return value
//   fiber_yield()            -> void    : cooperatively yields current fiber to next runnable task
//   fiber_sleep(ms)          -> void    : sleeps current fiber without blocking carrier thread
//   fiber_id()               -> int     : returns unique ID of current running fiber
//   fiber_count()            -> int     : returns count of currently active green threads
//   fiber_stats()            -> void    : outputs scheduler work-stealing metrics and worker status
//
//   thread_spawn(func)       -> Thread  : spawns a background OS thread / JVM virtual thread
//   thread_join(thread)      -> T       : joins a thread and waits for its return value
//   thread_sleep(ms)         -> void    : sleeps current thread for specified milliseconds
//   thread_current_id()      -> int     : returns unique ID of current running thread
//
//   channel_new([capacity])  -> Channel : creates thread-safe FIFO ring-buffer channel (default cap: 64)
//   send(chan, val)          -> bool    : enqueues val into chan (blocks if full, false if closed)
//   recv(chan)               -> T       : dequeues val from chan (blocks if empty, null/0 if closed)
//   channel_close(chan)      -> void    : closes chan and notifies all waiting senders/receivers
//   channel_is_closed(chan)  -> bool    : true if chan has been closed
//   channel_len(chan)        -> int     : current number of pending items in channel buffer
//
// ---- Async / Await State-Machine Engine (M1-T05) ----
//
//   async func name(...)     -> Future  : lowers async function to zero-allocation state machine task
//   await fut                -> T       : cooperatively awaits future completion, returning resolved value
//   future_poll(fut)         -> bool    : non-blocking poll returning true if future is ready
//   future_ready(val)        -> Future  : creates an immediately resolved future with val
//   async_sleep(ms)          -> Future  : asynchronous non-blocking timer future
//
// ---- Concurrency Utilities (available via `import "concurrency";`) ----

func spawn(worker: func() -> int) -> Fiber {
    return fiber_spawn(worker);
}

func fiber(worker: func() -> int) -> Fiber {
    return fiber_spawn(worker);
}

func yield_now() {
    fiber_yield();
}

func fiber_wait(worker_fiber: Fiber) -> int {
    return fiber_join(worker_fiber);
}

func sleep(ms: int) {
    fiber_sleep(ms);
}

func channel() -> Channel {
    return channel_new(64);
}

func bounded_channel(capacity: int) -> Channel {
    return channel_new(capacity);
}

func unbounded_channel() -> Channel {
    return channel_unbounded();
}

func future_completed(val: int) -> Future<int> {
    return future_ready(val);
}

func future_is_done(fut: Future<int>) -> bool {
    return future_poll(fut);
}

// ---- Structured Concurrency: Nursery, Task Groups & Cancelation (M1-T07) ----
//
//   nursery(scope_fn)           -> void : executes scope_fn with a Nursery / TaskGroup, awaiting all tasks
//   task_group(scope_fn)        -> void : alias for nursery(scope_fn)
//   task_group_fail_fast(fn)    -> void : task group with fail-fast policy: child error cancels siblings
//   task_group_speculative(fn)  -> int  : speculative execution: first success cancels siblings and returns
//   task_group_timeout(ms, fn)  -> void : task group with automatic cancellation deadline

func nursery(scope_fn: func(TaskGroup)) {
    let tg = nursery_new();
    scope_fn(tg);
    tg.join();
}

func task_group(scope_fn: func(TaskGroup)) {
    let tg = task_group_new();
    scope_fn(tg);
    tg.join();
}

func task_group_fail_fast(scope_fn: func(TaskGroup)) {
    let tg = task_group_on_failure();
    scope_fn(tg);
    tg.join();
}

func task_group_speculative(scope_fn: func(TaskGroup)) -> int {
    let tg = task_group_on_success();
    scope_fn(tg);
    return tg.join();
}

func task_group_timeout(ms: int, scope_fn: func(TaskGroup)) {
    let tg = task_group_with_timeout(ms);
    scope_fn(tg);
    tg.join();
}

func cancellation_token() -> CancellationToken {
    return cancel_token_new();
}
