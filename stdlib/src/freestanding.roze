// stdlib/src/freestanding.roze
//
// Roze Bare-Metal Freestanding & Kernel Subsystem API
// Hardware query intrinsics, zero-heap detection, and system halt.

extern "C" func freestanding_is_heap_enabled() -> bool;
extern "C" func freestanding_is_float_enabled() -> bool;
extern "C" func freestanding_get_heap_used() -> int;
extern "C" func freestanding_get_heap_capacity() -> int;
extern "C" func freestanding_halt();
extern "C" func multiboot2_get_magic() -> int;
extern "C" func multiboot2_get_info_ptr() -> *raw u8;
extern "C" func serial_print(s: string);
extern "C" func serial_putchar(ch: int);
extern "C" func outb(port: int, val: int);
extern "C" func inb(port: int) -> int;
extern "C" func qemu_exit(code: int);

// Hardware Paging & Virtual Memory Intrinsics (M2-T06)
extern "C" func read_cr3() -> int;
extern "C" func write_cr3(val: int);
extern "C" func invlpg(addr: int);
extern "C" func tlb_invalidate_page(addr: int);
extern "C" func tlb_flush_all();

// Hardware Interrupts, GDT, IDT, PIC & APIC (M2-T07)
extern "C" func cli();
extern "C" func sti();
extern "C" func are_interrupts_enabled() -> bool;
extern "C" func read_rflags() -> int;
extern "C" func read_cr2() -> int;
extern "C" func write_cr2(val: int);
extern "C" func read_msr(msr: int) -> int;
extern "C" func write_msr(msr: int, val: int);
extern "C" func lidt(base: int, limit: int);
extern "C" func lgdt(base: int, limit: int);
extern "C" func ltr(sel: int);
extern "C" func int_invoke(vector: int, error_code: int);
extern "C" func trigger_interrupt(vector: int, error_code: int);
extern "C" func get_last_interrupt_vector() -> int;
extern "C" func get_last_interrupt_error_code() -> int;
extern "C" func get_last_interrupt_fault_addr() -> int;
extern "C" func get_interrupt_count(vec: int) -> int;
extern "C" func gdt_init_default() -> int;
extern "C" func idt_init_default() -> int;
extern "C" func pic_remap(off1: int, off2: int);
extern "C" func pic_send_eoi(irq: int);
extern "C" func pic_mask_irq(irq: int);
extern "C" func pic_unmask_irq(irq: int);
extern "C" func pic_is_masked(irq: int) -> bool;
extern "C" func pic_disable();
extern "C" func apic_init(base: int);
extern "C" func apic_enable();
extern "C" func apic_send_eoi();
extern "C" func apic_is_enabled() -> bool;
extern "C" func mmio_read32(addr: int) -> int;
extern "C" func mmio_write32(addr: int, val: int);
extern "C" func mmio_read16(addr: int) -> int;
extern "C" func mmio_write16(addr: int, val: int);
extern "C" func mmio_read8(addr: int) -> int;
extern "C" func mmio_write8(addr: int, val: int);
extern "C" func ptr_read_u32_at(ptr: *raw u8, offset: int) -> int;
extern "C" func ptr_write_u32_at(ptr: *raw u8, offset: int, val: int);
extern "C" func ptr_read_u16_at(ptr: *raw u8, offset: int) -> int;
extern "C" func ptr_write_u16_at(ptr: *raw u8, offset: int, val: int);
