    test_scapy_operator_stacking();
    test_vlan_8021q_stacking();
    test_arp_stacking();
    test_ipv6_and_icmpv6_stacking();
    test_tcp_flags_and_checksum();
    test_dhcp_protocol_stacking();
    test_ntp_protocol_stacking();
    test_snmp_protocol_stacking();
    test_http_protocol_stacking();
    test_tls_client_hello_stacking();
    test_packet_dissection_roundtrip();
    test_scapy_hexdump_and_show();

    println("================================================================================");
    println("🎉 ALL 12 PROTOCOL STACKING DSL SUITES PASSED SUCCESSFULLY!");
    println("================================================================================");
}
