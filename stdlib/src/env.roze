// stdlib/src/env.roze
//
// Roze Cross-Platform Environment and OS Process State (M4-T05)
// Full architectural parity with Rust std::env and Java 25 java.lang.System.

class Env {
    dummy: int,
}

impl Env {
    func var(key: string) -> string {
        return sys_env_var(key);
    }

    func has(key: string) -> bool {
        return sys_env_has(key);
    }

    func set(key: string, val: string) -> void {
        sys_env_set(key, val);
    }

    func remove(key: string) -> void {
        sys_env_remove(key);
    }

    func current_dir() -> string {
        return sys_env_cwd();
    }

    func set_current_dir(dir: string) -> bool {
        return sys_env_set_cwd(dir);
    }

    func args() -> list {
        return sys_env_args();
    }

    func vars() -> list {
        return sys_env_vars();
    }
}

// ---- Procedural Environment APIs ----

func env_var(key: string) -> string {
    return sys_env_var(key);
}

func env_has(key: string) -> bool {
    return sys_env_has(key);
}

func env_set(key: string, val: string) -> void {
    sys_env_set(key, val);
}

func env_set_var(key: string, val: string) -> void {
    sys_env_set(key, val);
}

func env_remove(key: string) -> void {
    sys_env_remove(key);
}

func env_remove_var(key: string) -> void {
    sys_env_remove(key);
}

func env_current_dir() -> string {
    return sys_env_cwd();
}

func current_dir() -> string {
    return sys_env_cwd();
}

func env_set_current_dir(dir: string) -> bool {
    return sys_env_set_cwd(dir);
}

func set_current_dir(dir: string) -> bool {
    return sys_env_set_cwd(dir);
}

func env_args() -> list {
    return sys_env_args();
}

func args() -> list {
    return sys_env_args();
}

func env_vars() -> list {
    return sys_env_vars();
}

func vars() -> list {
    return sys_env_vars();
}
