func str_starts_with_match(s: string, prefix: string) -> bool {
    let s_len = string_length(s);
    let p_len = string_length(prefix);
    if p_len == 0 { return true; }
    if s_len < p_len { return false; }
    let mut_i = 0;
    while mut_i < p_len {
        if string_char_at(s, mut_i) != string_char_at(prefix, mut_i) {
            return false;
        }
        mut_i = mut_i + 1;
    }
    return true;
}

func str_ends_with_match(s: string, suffix: string) -> bool {
    let s_len = string_length(s);
    let suf_len = string_length(suffix);
    if suf_len == 0 { return true; }
    if s_len < suf_len { return false; }
    let offset = s_len - suf_len;
    let mut_i = 0;
    while mut_i < suf_len {
        if string_char_at(s, offset + mut_i) != string_char_at(suffix, mut_i) {
            return false;
        }
        mut_i = mut_i + 1;
    }
    return true;
}

func str_index_of_match(haystack: string, needle: string) -> int {
    let h_len = string_length(haystack);
    let n_len = string_length(needle);
    if n_len == 0 { return 0; }
    if h_len < n_len { return -1; }
    let mut_i = 0;
    while mut_i <= h_len - n_len {
        let mut_match = true;
        let mut_j = 0;
        while mut_j < n_len && mut_match {
            if string_char_at(haystack, mut_i + mut_j) != string_char_at(needle, mut_j) {
                mut_match = false;
            }
            mut_j = mut_j + 1;
        }
        if mut_match {
            return mut_i;
        }
        mut_i = mut_i + 1;
    }
    return -1;
}

func str_extract_between(s: string, start_marker: string, end_marker: string) -> string {
    let p1 = str_index_of_match(s, start_marker);
    if p1 < 0 { return ""; }
    let start_idx = p1 + string_length(start_marker);
    let rem = substring(s, start_idx, string_length(s));
    let p2 = str_index_of_match(rem, end_marker);
    if p2 < 0 { return rem; }
    return substring(rem, 0, p2);
}

func str_to_int_safe(s: string) -> int {
    let len = string_length(s);
    let mut_val = 0;
    let mut_i = 0;
    while mut_i < len {
        let c = string_char_at(s, mut_i);
        if c >= 48 && c <= 57 {
            mut_val = mut_val * 10 + (c - 48);
        }
        mut_i = mut_i + 1;
    }
    return mut_val;
}

func str_trim_whitespace(s: string) -> string {
    let len = string_length(s);
    if len == 0 { return ""; }
    let mut_start = 0;
    while mut_start < len && (string_char_at(s, mut_start) == 32 || string_char_at(s, mut_start) == 10 || string_char_at(s, mut_start) == 13 || string_char_at(s, mut_start) == 9) {
        mut_start = mut_start + 1;
    }
    let mut_end = len;
    while mut_end > mut_start && (string_char_at(s, mut_end - 1) == 32 || string_char_at(s, mut_end - 1) == 10 || string_char_at(s, mut_end - 1) == 13 || string_char_at(s, mut_end - 1) == 9) {
        mut_end = mut_end - 1;
    }
    if mut_start >= mut_end { return ""; }
    return substring(s, mut_start, mut_end);
}

// Structured Audit Log Entry for Authorization & Governance
class AuditLogEntry {
    timestamp_ms: int,
    operator: string,
    action: string,
    target: string,
    status: string,
