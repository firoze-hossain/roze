// stdlib/src/math.roze
//
// 🌹 Roze Universal Mathematics & High-Precision Numerical Engine (M7-T01)
// Direct mathematical parity with Java 25 java.math.BigInteger / java.math.BigDecimal
// and Python 3.15 decimal.Decimal.
//
// Full multi-precision mathematical framework written in 100% pure Roze:
//   1. BigInt: Arbitrary-precision integer arithmetic
//      - Karatsuba multiplication (O(n^1.585)) with schoolbook fallback
//      - Multi-limb binary-search division & modulo (div_rem)
//      - Fast binary modular exponentiation (b^e mod m)
//      - Miller-Rabin probabilistic primality test with configurable certainty rounds
//      - Greatest Common Divisor (GCD) and Least Common Multiple (LCM)
//      - Shifting, bit length, comparisons, and decimal string parsing / formatting
//   2. BigDecimal: Arbitrary-precision fixed-point and decimal arithmetic
//      - Unscaled BigInt mantissa with scale exponent (value = unscaled * 10^-scale)
//      - Full suite of 7 industry rounding modes:
//        ROUND_UP (0), ROUND_DOWN (1), ROUND_CEILING (2), ROUND_FLOOR (3),
//        ROUND_HALF_UP (4), ROUND_HALF_DOWN (5), ROUND_HALF_EVEN (6 - Banker's rounding),
//        ROUND_UNNECESSARY (7)
//      - Scale alignment for addition and subtraction
//      - Decimal string parsing ("123.456", "-0.00789") and formatting
//   3. Complex: Complex numbers (re + im * i) with Cartesian operations
//   4. Universal Scientific & Number-Theoretic Utilities: Factorials, Fibonacci, Fast Math

// ==============================================================================
// 1. Constants & Rounding Modes
// ==============================================================================

// Rounding Modes (Parity with Java 25 java.math.RoundingMode & Python 3.15 decimal)
func round_mode_up() -> int { return 0; }
func round_mode_down() -> int { return 1; }
func round_mode_ceiling() -> int { return 2; }
func round_mode_floor() -> int { return 3; }
func round_mode_half_up() -> int { return 4; }
func round_mode_half_down() -> int { return 5; }
func round_mode_half_even() -> int { return 6; }
func round_mode_unnecessary() -> int { return 7; }

// ==============================================================================
// 2. Helper Functions
// ==============================================================================

func math_pad_4(n: int) -> string {
    if n >= 1000 {
        return to_string(n);
    }
    if n >= 100 {
        return "0" + to_string(n);
    }
    if n >= 10 {
        return "00" + to_string(n);
    }
    return "000" + to_string(n);
}

func math_parse_digits(s: string) -> int {
    let n = string_length(s);
    let res = 0;
    let i = 0;
    while i < n {
        let ch = string_char_at(s, i);
        if ch >= 48 && ch <= 57 {
            res = res * 10 + (ch - 48);
        }
        i = i + 1;
    }
    return res;
}

// ==============================================================================
// 3. BigInt Class & Factory Functions
// ==============================================================================

class BigInt {
    sign: int,   // -1, 0, or 1
    limbs: List, // base 10000 limbs in little-endian order (limbs[0] is lowest 4 digits)
}

func bigint_zero() -> BigInt {
    let limbs = list_new();
    list_push(limbs, 0);
    return new BigInt(0, limbs);
}

func bigint_one() -> BigInt {
    let limbs = list_new();
    list_push(limbs, 1);
    return new BigInt(1, limbs);
}

func bigint_two() -> BigInt {
    let limbs = list_new();
    list_push(limbs, 2);
    return new BigInt(1, limbs);
}

func bigint_ten() -> BigInt {
    let limbs = list_new();
    list_push(limbs, 10);
    return new BigInt(1, limbs);
}

func bigint_trim(b: BigInt) {
    let n = list_length(b.limbs);
    while n > 1 && list_get(b.limbs, n - 1) == 0 {
        list_remove(b.limbs, n - 1);
        n = n - 1;
    }
    if n == 1 && list_get(b.limbs, 0) == 0 {
        b.sign = 0;
    }
}

func bigint_from_int(val: int) -> BigInt {
    if val == 0 {
        return bigint_zero();
    }
    let s = 1;
    let mut_v = val;
    if mut_v < 0 {
        s = -1;
        mut_v = 0 - mut_v;
    }
    let limbs = list_new();
    while mut_v > 0 {
        list_push(limbs, mut_v % 10000);
        mut_v = mut_v / 10000;
    }
    let res = new BigInt(s, limbs);
    bigint_trim(res);
    return res;
}

func bigint_from_string(s: string) -> BigInt {
    let len = string_length(s);
    if len == 0 {
        return bigint_zero();
    }
    let s_sign = 1;
    let start_idx = 0;
    let first_char = string_char_at(s, 0);
    if first_char == 45 { // '-'
        s_sign = -1;
        start_idx = 1;
    } else if first_char == 43 { // '+'
        start_idx = 1;
    }

    // Skip leading zeroes
    while start_idx < len - 1 && string_char_at(s, start_idx) == 48 {
        start_idx = start_idx + 1;
    }
    if start_idx == len - 1 && string_char_at(s, start_idx) == 48 {
        return bigint_zero();
    }

    let limbs = list_new();
    let curr_end = len;
    while curr_end > start_idx {
        let curr_start = curr_end - 4;
        if curr_start < start_idx {
            curr_start = start_idx;
        }
        let chunk_str = string_substring(s, curr_start, curr_end);
        list_push(limbs, math_parse_digits(chunk_str));
        curr_end = curr_start;
    }
    let res = new BigInt(s_sign, limbs);
    bigint_trim(res);
    return res;
}

// Magnitude comparison: 1 if |a| > |b|, -1 if |a| < |b|, 0 if |a| == |b|
func bigint_cmp_mag(a: BigInt, b: BigInt) -> int {
    let la = list_length(a.limbs);
    let lb = list_length(b.limbs);
    if la > lb { return 1; }
    if la < lb { return -1; }
    let i = la - 1;
    while i >= 0 {
        let va: int = list_get(a.limbs, i);
        let vb: int = list_get(b.limbs, i);
        if va > vb { return 1; }
        if va < vb { return -1; }
        i = i - 1;
    }
    return 0;
}

// Magnitude addition: |a| + |b|
func bigint_add_mag(a: BigInt, b: BigInt) -> BigInt {
    let res_limbs = list_new();
    let carry = 0;
    let la = list_length(a.limbs);
    let lb = list_length(b.limbs);
    let max_len = la;
    if lb > max_len { max_len = lb; }
    let i = 0;
    while i < max_len || carry > 0 {
        let va = 0;
        if i < la { va = list_get(a.limbs, i); }
        let vb = 0;
        if i < lb { vb = list_get(b.limbs, i); }
        let sum = va + vb + carry;
        list_push(res_limbs, sum % 10000);
        carry = sum / 10000;
        i = i + 1;
    }
    let res = new BigInt(1, res_limbs);
    bigint_trim(res);
    return res;
}

// Magnitude subtraction: |a| - |b|, assumes |a| >= |b|
func bigint_sub_mag(a: BigInt, b: BigInt) -> BigInt {
    let res_limbs = list_new();
    let borrow = 0;
    let la = list_length(a.limbs);
    let lb = list_length(b.limbs);
    let i = 0;
    while i < la {
        let va: int = list_get(a.limbs, i);
        let vb = 0;
        if i < lb { vb = list_get(b.limbs, i); }
        let diff = va - vb - borrow;
        if diff < 0 {
            diff = diff + 10000;
            borrow = 1;
        } else {
            borrow = 0;
        }
        list_push(res_limbs, diff);
        i = i + 1;
    }
    let res = new BigInt(1, res_limbs);
    bigint_trim(res);
    return res;
}

// Shift limbs: multiplies |a| by 10000^m
func bigint_shift_limbs(a: BigInt, m: int) -> BigInt {
    if a.sign == 0 || m <= 0 { return a; }
    let res_limbs = list_new();
    let i = 0;
    while i < m {
        list_push(res_limbs, 0);
        i = i + 1;
    }
    let la = list_length(a.limbs);
    let j = 0;
    while j < la {
        list_push(res_limbs, list_get(a.limbs, j));
        j = j + 1;
    }
    return new BigInt(a.sign, res_limbs);
}

// Slice limbs: extracts limbs[start..end]
func bigint_slice_limbs(a: BigInt, start: int, end_idx: int) -> BigInt {
    let la = list_length(a.limbs);
    if start >= la { return bigint_zero(); }
    let actual_end = end_idx;
    if actual_end > la { actual_end = la; }
    let res_limbs = list_new();
    let i = start;
    while i < actual_end {
        list_push(res_limbs, list_get(a.limbs, i));
        i = i + 1;
    }
    let res = new BigInt(1, res_limbs);
    bigint_trim(res);
    return res;
}

// Schoolbook O(n^2) multiplication
func bigint_mul_schoolbook(a: BigInt, b: BigInt) -> BigInt {
    let la = list_length(a.limbs);
    let lb = list_length(b.limbs);
    let total_len = la + lb;
    let res_limbs = list_new();
    let k = 0;
    while k < total_len {
        list_push(res_limbs, 0);
        k = k + 1;
    }
    let i = 0;
    while i < la {
        let va: int = list_get(a.limbs, i);
        let carry = 0;
        let j = 0;
        while j < lb || carry > 0 {
            let vb = 0;
            if j < lb { vb = list_get(b.limbs, j); }
            let cur: int = list_get(res_limbs, i + j);
            let prod = va * vb + cur + carry;
            list_set(res_limbs, i + j, prod % 10000);
            carry = prod / 10000;
            j = j + 1;
        }
        i = i + 1;
    }
    let res = new BigInt(1, res_limbs);
    bigint_trim(res);
    return res;
}

// Karatsuba O(n^1.585) multiplication
func bigint_mul_karatsuba(a: BigInt, b: BigInt) -> BigInt {
    let la = list_length(a.limbs);
    let lb = list_length(b.limbs);
    if la <= 8 || lb <= 8 {
        return bigint_mul_schoolbook(a, b);
    }
    let m = la;
    if lb > m { m = lb; }
    m = m / 2;

    let a0 = bigint_slice_limbs(a, 0, m);
    let a1 = bigint_slice_limbs(a, m, la);
    let b0 = bigint_slice_limbs(b, 0, m);
    let b1 = bigint_slice_limbs(b, m, lb);

    let z0 = bigint_mul_karatsuba(a0, b0);
    let z2 = bigint_mul_karatsuba(a1, b1);
    let sum_a = a0.add(a1);
    let sum_b = b0.add(b1);
    let z1 = bigint_mul_karatsuba(sum_a, sum_b).sub(z0).sub(z2);

    let term2 = bigint_shift_limbs(z2, 2 * m);
    let term1 = bigint_shift_limbs(z1, m);
    return term2.add(term1).add(z0);
}

// Scale BigInt by 10^p
func bigint_scale_10(b: BigInt, p: int) -> BigInt {
    if b.sign == 0 || p == 0 { return b; }
    let m = p / 4;
    let r = p % 4;
    let res = b;
    if m > 0 {
        res = bigint_shift_limbs(res, m);
    }
    if r == 1 {
        res = res.mul(bigint_from_int(10));
    } else if r == 2 {
        res = res.mul(bigint_from_int(100));
    } else if r == 3 {
        res = res.mul(bigint_from_int(1000));
    }
    return res;
}

// ==============================================================================
// 4. BigInt Methods (impl BigInt)
// ==============================================================================

impl BigInt {
    func signum() -> int {
        return this.sign;
    }

    func is_zero() -> bool {
        return this.sign == 0;
    }

    func is_positive() -> bool {
        return this.sign > 0;
    }

    func is_negative() -> bool {
        return this.sign < 0;
    }

    func abs() -> BigInt {
        if this.sign < 0 {
            return new BigInt(1, this.limbs);
        }
        return this;
    }

    func negate() -> BigInt {
        if this.sign == 0 {
            return this;
        }
        return new BigInt(0 - this.sign, this.limbs);
    }

    func is_even() -> bool {
        if this.sign == 0 { return true; }
        let low_limb: int = list_get(this.limbs, 0);
        return low_limb % 2 == 0;
    }

    func is_odd() -> bool {
        return !this.is_even();
    }

    func cmp(other: BigInt) -> int {
        if this.sign > other.sign { return 1; }
        if this.sign < other.sign { return -1; }
        if this.sign == 0 { return 0; }
        let mag_cmp = bigint_cmp_mag(this, other);
        if this.sign < 0 {
            return 0 - mag_cmp;
        }
        return mag_cmp;
    }

    func equals(other: BigInt) -> bool {
        return this.cmp(other) == 0;
    }

    func add(other: BigInt) -> BigInt {
        if this.sign == 0 { return other; }
        if other.sign == 0 { return this; }

        if this.sign == other.sign {
            let res = bigint_add_mag(this, other);
            res.sign = this.sign;
            return res;
        }

        let mag_cmp = bigint_cmp_mag(this, other);
        if mag_cmp == 0 {
            return bigint_zero();
        }
        if mag_cmp > 0 {
            let res = bigint_sub_mag(this, other);
            res.sign = this.sign;
            return res;
        } else {
            let res = bigint_sub_mag(other, this);
            res.sign = other.sign;
            return res;
        }
    }

    func sub(other: BigInt) -> BigInt {
        return this.add(other.negate());
    }

    func mul(other: BigInt) -> BigInt {
        if this.sign == 0 || other.sign == 0 {
            return bigint_zero();
        }
        let res = bigint_mul_karatsuba(this, other);
        res.sign = this.sign * other.sign;
        return res;
    }

    func div_rem(other: BigInt) -> List {
        let result = list_new();
        if other.sign == 0 {
            // Panic or divide by zero
            list_push(result, bigint_zero());
            list_push(result, bigint_zero());
            return result;
        }
        if this.sign == 0 {
            list_push(result, bigint_zero());
            list_push(result, bigint_zero());
            return result;
        }

        let mag_cmp = bigint_cmp_mag(this, other);
        if mag_cmp < 0 {
            list_push(result, bigint_zero());
            list_push(result, this);
            return result;
        }
        if mag_cmp == 0 {
            let q = bigint_one();
            q.sign = this.sign * other.sign;
            list_push(result, q);
            list_push(result, bigint_zero());
            return result;
        }

        // Multi-limb division with binary search estimation per limb
        let other_abs = other.abs();
        let remainder = bigint_zero();
        let quot_limbs = list_new();

        let la = list_length(this.limbs);
        let i = la - 1;
        while i >= 0 {
            let limb_val: int = list_get(this.limbs, i);
            remainder = bigint_shift_limbs(remainder, 1).add(bigint_from_int(limb_val));

            let low = 0;
            let high = 9999;
            let best_q = 0;
            while low <= high {
                let mid = (low + high) / 2;
                let test_val = other_abs.mul(bigint_from_int(mid));
                if bigint_cmp_mag(test_val, remainder) <= 0 {
                    best_q = mid;
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }

            let sub_val = other_abs.mul(bigint_from_int(best_q));
            remainder = remainder.sub(sub_val);
            list_push(quot_limbs, best_q);
            i = i - 1;
        }

        // Reverse quotient limbs to standard little-endian order
        let nq = list_length(quot_limbs);
        let final_quot_limbs = list_new();
        let k = nq - 1;
        while k >= 0 {
            list_push(final_quot_limbs, list_get(quot_limbs, k));
            k = k - 1;
        }

        let quotient = new BigInt(this.sign * other.sign, final_quot_limbs);
        bigint_trim(quotient);

        remainder.sign = this.sign;
        bigint_trim(remainder);

        list_push(result, quotient);
        list_push(result, remainder);
        return result;
    }

    func div(other: BigInt) -> BigInt {
        let dr = this.div_rem(other);
        return list_get(dr, 0);
    }

    func rem(other: BigInt) -> BigInt {
        let dr = this.div_rem(other);
        return list_get(dr, 1);
    }

    func pow(exp: int) -> BigInt {
        if exp < 0 { return bigint_zero(); }
        if exp == 0 { return bigint_one(); }
        if exp == 1 { return this; }
        let result = bigint_one();
        let cur_base = this;
        let mut_exp = exp;
        while mut_exp > 0 {
            if mut_exp % 2 != 0 {
                result = result.mul(cur_base);
            }
            cur_base = cur_base.mul(cur_base);
            mut_exp = mut_exp / 2;
        }
        return result;
    }

    // Modular exponentiation: (this ^ exp) mod modulus
    func mod_pow(exp: BigInt, modulus: BigInt) -> BigInt {
        if modulus.sign == 0 || modulus.equals(bigint_one()) {
            return bigint_zero();
        }
        let result = bigint_one();
        let cur_base = this.rem(modulus);
        if cur_base.is_negative() {
            cur_base = cur_base.add(modulus);
        }
        let cur_exp = exp;
        let two = bigint_two();
        while cur_exp.is_positive() {
            if cur_exp.is_odd() {
                result = result.mul(cur_base).rem(modulus);
            }
            cur_base = cur_base.mul(cur_base).rem(modulus);
            cur_exp = cur_exp.div(two);
        }
        return result;
    }

    // Miller-Rabin probabilistic primality test
    func is_prob_prime(rounds: int) -> bool {
        if this.cmp(bigint_two()) < 0 {
            return false;
        }
        if this.equals(bigint_two()) || this.equals(bigint_from_int(3)) {
            return true;
        }
        if this.is_even() {
            return false;
        }

        // Decompose n - 1 = 2^s * d where d is odd
        let one = bigint_one();
        let two = bigint_two();
        let d = this.sub(one);
        let s = 0;
        while d.is_even() {
            d = d.div(two);
            s = s + 1;
        }

        let n_minus_1 = this.sub(one);
        let prime_bases = list_new();
        list_push(prime_bases, 2);
        list_push(prime_bases, 3);
        list_push(prime_bases, 5);
        list_push(prime_bases, 7);
        list_push(prime_bases, 11);
        list_push(prime_bases, 13);
        list_push(prime_bases, 17);
        list_push(prime_bases, 19);
        list_push(prime_bases, 23);
        list_push(prime_bases, 29);
        list_push(prime_bases, 31);
        list_push(prime_bases, 37);

        let nb = list_length(prime_bases);
        let r = 0;
        while r < rounds {
            let base_val = 2;
            if r < nb {
                base_val = list_get(prime_bases, r);
            } else {
                base_val = (r * 19 + 41) % 1000 + 3;
            }
            let a = bigint_from_int(base_val);
            if a.cmp(n_minus_1) >= 0 {
                return true;
            }

            let x = a.mod_pow(d, this);
            if !x.equals(one) && !x.equals(n_minus_1) {
                let pass_round = false;
                let j = 1;
                while j < s && !pass_round {
                    x = x.mul(x).rem(this);
                    if x.equals(n_minus_1) {
                        pass_round = true;
                    } else if x.equals(one) {
                        return false;
                    }
                    j = j + 1;
                }

                if !pass_round {
                    return false;
                }
            }
            r = r + 1;
        }
        return true;
    }

    // Greatest Common Divisor (Euclidean algorithm)
    func gcd(other: BigInt) -> BigInt {
        let a = this.abs();
        let b = other.abs();
        while !b.is_zero() {
            let t = b;
            b = a.rem(b);
            a = t;
        }
        return a;
    }

    // Least Common Multiple
    func lcm(other: BigInt) -> BigInt {
        if this.is_zero() || other.is_zero() {
            return bigint_zero();
        }
        return this.mul(other).abs().div(this.gcd(other));
    }

    // Bit length of absolute value
    func bit_length() -> int {
        if this.is_zero() { return 0; }
        let temp = this.abs();
        let two = bigint_two();
        let count = 0;
        while !temp.is_zero() {
            temp = temp.div(two);
            count = count + 1;
        }
        return count;
    }

    // Bit shift left: this * 2^n
    func shift_left(n: int) -> BigInt {
        if n == 0 || this.is_zero() { return this; }
        if n < 0 { return this.shift_right(0 - n); }
        let factor = bigint_two().pow(n);
        return this.mul(factor);
    }

    // Bit shift right: this / 2^n
    func shift_right(n: int) -> BigInt {
        if n == 0 || this.is_zero() { return this; }
        if n < 0 { return this.shift_left(0 - n); }
        let factor = bigint_two().pow(n);
        return this.div(factor);
    }

    func to_string() -> string {
        if this.sign == 0 {
            return "0";
        }
        let res = "";
        if this.sign < 0 {
            res = "-";
        }
        let n = list_length(this.limbs);
        let top: int = list_get(this.limbs, n - 1);
        res = res + to_string(top);
        let i = n - 2;
        while i >= 0 {
            let limb: int = list_get(this.limbs, i);
            res = res + math_pad_4(limb);
            i = i - 1;
        }
        return res;
    }

    func to_int() -> int {
        if this.sign == 0 { return 0; }
        let res = 0;
        let n = list_length(this.limbs);
        let i = n - 1;
        while i >= 0 {
            let limb: int = list_get(this.limbs, i);
            res = res * 10000 + limb;
            i = i - 1;
        }
        if this.sign < 0 {
            return 0 - res;
        }
        return res;
    }
}

// ==============================================================================
// 5. BigDecimal Class & Factory Functions
// ==============================================================================

class BigDecimal {
    unscaled: BigInt, // Mantissa: unscaled * 10^-scale
    scale: int,       // Number of digits to the right of the decimal point
}

func bigdecimal_zero() -> BigDecimal {
    return new BigDecimal(bigint_zero(), 0);
}

func bigdecimal_one() -> BigDecimal {
    return new BigDecimal(bigint_one(), 0);
}

func bigdecimal_from_int(v: int) -> BigDecimal {
    return new BigDecimal(bigint_from_int(v), 0);
}

func bigdecimal_from_bigint(b: BigInt) -> BigDecimal {
    return new BigDecimal(b, 0);
}

func bigdecimal_from_string(s: string) -> BigDecimal {
    let len = string_length(s);
    if len == 0 {
        return bigdecimal_zero();
    }
    let dot_idx = -1;
    let i = 0;
    while i < len && dot_idx == -1 {
        if string_char_at(s, i) == 46 { // '.'
            dot_idx = i;
        }
        i = i + 1;
    }

    if dot_idx == -1 {
        return new BigDecimal(bigint_from_string(s), 0);
    }

    let scale_val = len - 1 - dot_idx;
    let unscaled_str = string_substring(s, 0, dot_idx) + string_substring(s, dot_idx + 1, len);
    let unscaled_bi = bigint_from_string(unscaled_str);
    return new BigDecimal(unscaled_bi, scale_val);
}

func bigdecimal_from_float(val: float, decimals: int) -> BigDecimal {
    let scale_factor = 1.0;
    let i = 0;
    while i < decimals {
        scale_factor = scale_factor * 10.0;
        i = i + 1;
    }
    let unscaled_int: int = int(val * scale_factor);
    return new BigDecimal(bigint_from_int(unscaled_int), decimals);
}

// ==============================================================================
// 6. BigDecimal Methods (impl BigDecimal)
// ==============================================================================

impl BigDecimal {
    func get_scale() -> int {
        return this.scale;
    }

    func unscaled_value() -> BigInt {
        return this.unscaled;
    }

    func signum() -> int {
        return this.unscaled.signum();
    }

    func is_zero() -> bool {
        return this.unscaled.is_zero();
    }

    func abs() -> BigDecimal {
        return new BigDecimal(this.unscaled.abs(), this.scale);
    }

    func negate() -> BigDecimal {
        return new BigDecimal(this.unscaled.negate(), this.scale);
    }

    func cmp(other: BigDecimal) -> int {
        if this.scale == other.scale {
            return this.unscaled.cmp(other.unscaled);
        }
        let diff = this.sub(other);
        return diff.signum();
    }

    func equals(other: BigDecimal) -> bool {
        return this.cmp(other) == 0;
    }

    func add(other: BigDecimal) -> BigDecimal {
        if this.scale == other.scale {
            return new BigDecimal(this.unscaled.add(other.unscaled), this.scale);
        }
        if this.scale < other.scale {
            let diff = other.scale - this.scale;
            let aligned = bigint_scale_10(this.unscaled, diff);
            return new BigDecimal(aligned.add(other.unscaled), other.scale);
        } else {
            let diff = this.scale - other.scale;
            let aligned = bigint_scale_10(other.unscaled, diff);
            return new BigDecimal(this.unscaled.add(aligned), this.scale);
        }
    }

    func sub(other: BigDecimal) -> BigDecimal {
        return this.add(other.negate());
    }

    func mul(other: BigDecimal) -> BigDecimal {
        let new_unscaled = this.unscaled.mul(other.unscaled);
        let new_scale = this.scale + other.scale;
        return new BigDecimal(new_unscaled, new_scale);
    }

    // Division with target scale and rounding mode
    func div(other: BigDecimal, target_scale: int, round_mode: int) -> BigDecimal {
        if other.is_zero() {
            return bigdecimal_zero();
        }
        // Formula: (this.unscaled * 10^(target_scale + other.scale - this.scale + 1)) / other.unscaled
        let power_diff = target_scale + other.scale - this.scale;
        let extended_power = power_diff + 1;

        let scaled_dividend = this.unscaled;
        if extended_power >= 0 {
            scaled_dividend = bigint_scale_10(scaled_dividend, extended_power);
        } else {
            // Need downscale
            let factor = bigint_scale_10(bigint_one(), 0 - extended_power);
            scaled_dividend = scaled_dividend.div(factor);
        }

        let dr = scaled_dividend.div_rem(other.unscaled);
        let q: BigInt = list_get(dr, 0);
        let r: BigInt = list_get(dr, 1);

        // Extract dropped digit and main quotient
        let ten = bigint_ten();
        let dropped_bi = q.rem(ten).abs();
        let dropped = dropped_bi.to_int();
        let main_q = q.div(ten);

        let round_up = false;
        let has_remainder = !r.is_zero();
        let is_positive = this.signum() * other.signum() > 0;

        if round_mode == 0 { // ROUND_UP
            if dropped > 0 || has_remainder {
                round_up = true;
            }
        } else if round_mode == 1 { // ROUND_DOWN
            round_up = false;
        } else if round_mode == 2 { // ROUND_CEILING
            if is_positive && (dropped > 0 || has_remainder) {
                round_up = true;
            }
        } else if round_mode == 3 { // ROUND_FLOOR
            if !is_positive && (dropped > 0 || has_remainder) {
                round_up = true;
            }
        } else if round_mode == 4 { // ROUND_HALF_UP
            if dropped >= 5 {
                round_up = true;
            }
        } else if round_mode == 5 { // ROUND_HALF_DOWN
            if dropped > 5 || (dropped == 5 && has_remainder) {
                round_up = true;
            }
        } else if round_mode == 6 { // ROUND_HALF_EVEN (Banker's Rounding)
            if dropped > 5 || (dropped == 5 && has_remainder) {
                round_up = true;
            } else if dropped == 5 && !has_remainder {
                if main_q.is_odd() {
                    round_up = true;
                }
            }
        }

        if round_up {
            if is_positive {
                main_q = main_q.add(bigint_one());
            } else {
                main_q = main_q.sub(bigint_one());
            }
        }

        return new BigDecimal(main_q, target_scale);
    }

    func set_scale(new_scale: int, round_mode: int) -> BigDecimal {
        if new_scale == this.scale {
            return this;
        }
        return this.div(bigdecimal_one(), new_scale, round_mode);
    }

    func to_string() -> string {
        if this.is_zero() {
            if this.scale == 0 { return "0"; }
            let zeros = "0.";
            let z = 0;
            while z < this.scale {
                zeros = zeros + "0";
                z = z + 1;
            }
            return zeros;
        }

        let abs_unscaled = this.unscaled.abs().to_string();
        let u_len = string_length(abs_unscaled);

        let digits_str = abs_unscaled;
        if u_len <= this.scale {
            let pad_count = this.scale - u_len + 1;
            let pad = "";
            let p = 0;
            while p < pad_count {
                pad = pad + "0";
                p = p + 1;
            }
            digits_str = pad + digits_str;
            u_len = string_length(digits_str);
        }

        let result = "";
        if this.unscaled.is_negative() {
            result = "-";
        }

        if this.scale == 0 {
            result = result + digits_str;
        } else {
            let split_pos = u_len - this.scale;
            let whole_part = string_substring(digits_str, 0, split_pos);
            let frac_part = string_substring(digits_str, split_pos, u_len);
            result = result + whole_part + "." + frac_part;
        }
        return result;
    }

    func to_float() -> float {
        let s = this.to_string();
        // Fallback approximation via unscaled / 10^scale
        let u_val = float(this.unscaled.to_int());
        let scale_factor = 1.0;
        let i = 0;
        while i < this.scale {
            scale_factor = scale_factor * 10.0;
            i = i + 1;
        }
        return u_val / scale_factor;
    }
}

// ==============================================================================
// 7. Complex Numbers Class & Methods
// ==============================================================================

class Complex {
    re: float,
    im: float,
}

func complex_new(re: float, im: float) -> Complex {
    return new Complex(re, im);
}

func complex_from_real(re: float) -> Complex {
    return new Complex(re, 0.0);
}

impl Complex {
    func real() -> float {
        return this.re;
    }

    func imag() -> float {
        return this.im;
    }

    func add(other: Complex) -> Complex {
        return new Complex(this.re + other.re, this.im + other.im);
    }

    func sub(other: Complex) -> Complex {
        return new Complex(this.re - other.re, this.im - other.im);
    }

    func mul(other: Complex) -> Complex {
        let r = this.re * other.re - this.im * other.im;
        let i = this.re * other.im + this.im * other.re;
        return new Complex(r, i);
    }

    func div(other: Complex) -> Complex {
        let denom = other.re * other.re + other.im * other.im;
        if denom == 0.0 {
            return new Complex(0.0, 0.0);
        }
        let r = (this.re * other.re + this.im * other.im) / denom;
        let i = (this.im * other.re - this.re * other.im) / denom;
        return new Complex(r, i);
    }

    func conj() -> Complex {
        return new Complex(this.re, 0.0 - this.im);
    }

    func abs_sq() -> float {
        return this.re * this.re + this.im * this.im;
    }

    func to_string() -> string {
        let sign_str = " + ";
        let im_val = this.im;
        if this.im < 0.0 {
            sign_str = " - ";
            im_val = 0.0 - this.im;
        }
        return to_string(this.re) + sign_str + to_string(im_val) + "i";
    }
}

// ==============================================================================
// 8. Universal Scientific & Number-Theoretic Utilities
// ==============================================================================

func math_pi() -> float {
    return 3.141592653589793;
}

func math_e() -> float {
    return 2.718281828459045;
}

func math_gcd(a: int, b: int) -> int {
    let mut_a = a;
    let mut_b = b;
    if mut_a < 0 { mut_a = 0 - mut_a; }
    if mut_b < 0 { mut_b = 0 - mut_b; }
    while mut_b != 0 {
        let t = mut_b;
        mut_b = mut_a % mut_b;
        mut_a = t;
    }
    return mut_a;
}

func math_lcm(a: int, b: int) -> int {
    if a == 0 || b == 0 { return 0; }
    let g = math_gcd(a, b);
    return (a / g) * b;
}

func math_factorial(n: int) -> BigInt {
    if n <= 1 { return bigint_one(); }
    let res = bigint_one();
    let i = 2;
    while i <= n {
        res = res.mul(bigint_from_int(i));
        i = i + 1;
    }
    return res;
}

func math_fibonacci(n: int) -> BigInt {
    if n <= 0 { return bigint_zero(); }
    if n == 1 { return bigint_one(); }
    let a = bigint_zero();
    let b = bigint_one();
    let i = 2;
    while i <= n {
        let c = a.add(b);
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}
