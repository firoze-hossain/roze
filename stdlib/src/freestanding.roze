// stdlib/src/freestanding.roze
//
// Roze Bare-Metal Freestanding & Kernel Subsystem API
// Hardware query intrinsics, zero-heap detection, and system halt.

extern "C" func freestanding_is_heap_enabled() -> bool;
extern "C" func freestanding_is_float_enabled() -> bool;
extern "C" func freestanding_get_heap_used() -> int;
extern "C" func freestanding_get_heap_capacity() -> int;
extern "C" func freestanding_halt();
extern "C" func multiboot2_get_magic() -> int;
extern "C" func multiboot2_get_info_ptr() -> *raw u8;
extern "C" func serial_print(s: string);
extern "C" func serial_putchar(ch: int);
extern "C" func outb(port: int, val: int);
extern "C" func inb(port: int) -> int;
extern "C" func qemu_exit(code: int);

// Hardware Paging & Virtual Memory Intrinsics (M2-T06)
extern "C" func read_cr3() -> int;
extern "C" func write_cr3(val: int);
extern "C" func invlpg(addr: int);
extern "C" func tlb_invalidate_page(addr: int);
extern "C" func tlb_flush_all();
