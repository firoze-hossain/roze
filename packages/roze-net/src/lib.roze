}
func ARP_ips(psrc: string, pdst: string) -> Packet {
    return ARP_custom(1, "00:00:00:00:00:00", psrc, "00:00:00:00:00:00", pdst);
}
func ARP_custom(op: int, hwsrc: string, psrc: string, hwdst: string, pdst: string) -> Packet {
    let layer = packet_layer_new(layer_id_arp(), "ARP", op, 0, 0, 0, 0, 0, 0, 0, hwsrc, psrc, hwdst, pdst, "", raw_packet_new(0));
    return packet_from_single_layer(layer);
}

// 4. IPv4
func IP() -> Packet {
    return IP_addrs("127.0.0.1", "127.0.0.1");
}
func IPv4() -> Packet {
    return IP();
}
func IP_addrs(src: string, dst: string) -> Packet {
    return IP_custom(src, dst, 6, 64); // default TCP proto=6, ttl=64
}
func IP_custom(src: string, dst: string, proto: int, ttl: int) -> Packet {
    let layer = packet_layer_new(layer_id_ipv4(), "IP", proto, ttl, 1, 0, 20, 0, 0, 0, src, dst, "", "", "", raw_packet_new(0));
    return packet_from_single_layer(layer);
}

