// ==============================================================================
// SECTION 1: Data Types & IEEE Half / Brain Float Conversions
// ==============================================================================

func dtype_float32() -> int { return 1; }
func dtype_float64() -> int { return 2; }
func dtype_float16() -> int { return 3; }
func dtype_bfloat16() -> int { return 4; }
func dtype_int32() -> int { return 5; }
func dtype_int64() -> int { return 6; }
func dtype_uint8() -> int { return 7; }
func dtype_bool() -> int { return 8; }

func dtype_itemsize(dtype: int) -> int {
    if dtype == 1 { return 4; } // FLOAT32
    if dtype == 2 { return 8; } // FLOAT64
    if dtype == 3 { return 2; } // FLOAT16
    if dtype == 4 { return 2; } // BFLOAT16
    if dtype == 5 { return 4; } // INT32
    if dtype == 6 { return 8; } // INT64
    if dtype == 7 { return 1; } // UINT8
    if dtype == 8 { return 1; } // BOOL
    return 4;
}

func dtype_name(dtype: int) -> string {
    if dtype == 1 { return "float32"; }
    if dtype == 2 { return "float64"; }
    if dtype == 3 { return "float16"; }
    if dtype == 4 { return "bfloat16"; }
    if dtype == 5 { return "int32"; }
    if dtype == 6 { return "int64"; }
    if dtype == 7 { return "uint8"; }
    if dtype == 8 { return "bool"; }
    return "unknown";
}

// Convert 32-bit float to IEEE 754 16-bit half precision bits (0..65535)
func f32_to_f16_bits(f: float) -> int {
    unsafe {
        let p = alloc(8);
        ptr_write_f32_at(p, 0, f);
        let b0 = ptr_read_u8_at(p, 0);
        let b1 = ptr_read_u8_at(p, 1);
        let b2 = ptr_read_u8_at(p, 2);
        let b3 = ptr_read_u8_at(p, 3);
        free(p);

        let sign = 0;
        if b3 >= 128 {
            sign = 1;
        }
        let exp32 = ((b3 % 128) * 2) + (b2 / 128);
        let frac32 = (b2 % 128) * 65536 + b1 * 256 + b0;

        if exp32 == 0 {
            if sign == 1 { return 32768; }
            return 0;
        }
        if exp32 == 255 {
            let frac16 = 0;
            if frac32 != 0 { frac16 = 1; }
            return sign * 32768 + 31 * 1024 + frac16;
        }

        let exp16 = exp32 - 127 + 15;
        if exp16 >= 31 {
            return sign * 32768 + 31 * 1024;
        }
        if exp16 <= 0 {
            return sign * 32768;
        }
        let frac16 = frac32 / 8192;
        return sign * 32768 + exp16 * 1024 + frac16;
    }
}

// Convert IEEE 754 16-bit half precision bits back to 32-bit float
func f16_bits_to_f32(h: int) -> float {
    unsafe {
        let sign = 0;
        if h >= 32768 {
            sign = 1;
        }
        let exp16 = (h % 32768) / 1024;
        let frac16 = h % 1024;

        if exp16 == 0 {
            if frac16 == 0 {
                if sign == 1 { return -0.0; }
                return 0.0;
            }
            let sub_sign = 1.0;
            if sign == 1 { sub_sign = -1.0; }
            return sub_sign * (frac16 * 1.0 / 1024.0) * (1.0 / 16384.0);
        }
        if exp16 == 31 {
            let inf_sign = 1.0;
            if sign == 1 { inf_sign = -1.0; }
            return inf_sign * 65504.0;
        }

        let exp32 = exp16 - 15 + 127;
        let frac32 = frac16 * 8192;

        let b3 = sign * 128 + (exp32 / 2);
        let b2 = (exp32 % 2) * 128 + (frac32 / 65536);
        let b1 = (frac32 / 256) % 256;
        let b0 = frac32 % 256;

        let p = alloc(8);
        ptr_write_u8_at(p, 0, b0);
        ptr_write_u8_at(p, 1, b1);
        ptr_write_u8_at(p, 2, b2);
        ptr_write_u8_at(p, 3, b3);
        let res: float = ptr_read_f32_at(p, 0);
        free(p);
        return res;
    }
}

// ==============================================================================
// SECTION 2: Low-Level Memory & TensorStorage
// ==============================================================================

class TensorStorage {
    addr: int,
    size_bytes: int,
    device: string,
    is_freed: bool
}

func tensor_storage_new(size_bytes: int, device: string) -> TensorStorage {
    let alloc_bytes = size_bytes;
    if alloc_bytes < 8 {
        alloc_bytes = 8;
    }
    unsafe {
        let p = alloc(alloc_bytes);
        let i = 0;
        while i < alloc_bytes {
            ptr_write_u8_at(p, i, 0);
            i = i + 1;
        }
        return new TensorStorage(ptr_to_int(p), alloc_bytes, device, false);
    }
}

func tensor_storage_free(storage: TensorStorage) {
    if !storage.is_freed && storage.addr != 0 {
        unsafe {
            free(int_to_ptr(storage.addr));
            storage.is_freed = true;
        }
    }
}

func tensor_storage_read_float(storage: TensorStorage, elem_idx: int, dtype: int) -> float {
    unsafe {
        let base_ptr = int_to_ptr(storage.addr);
        if dtype == 1 { // FLOAT32
            let byte_off = elem_idx * 4;
            let v: float = ptr_read_f32_at(base_ptr, byte_off);
            return v;
        }
        if dtype == 2 { // FLOAT64
            let byte_off = elem_idx * 8;
            let v: float = ptr_read_f64_at(base_ptr, byte_off);
            return v;
        }
        if dtype == 3 { // FLOAT16
            let byte_off = elem_idx * 2;
            let b0 = ptr_read_u8_at(base_ptr, byte_off);
            let b1 = ptr_read_u8_at(base_ptr, byte_off + 1);
            let bits = b0 + b1 * 256;
            return f16_bits_to_f32(bits);
        }
        if dtype == 4 { // BFLOAT16
            let byte_off = elem_idx * 2;
            let b0 = ptr_read_u8_at(base_ptr, byte_off);
            let b1 = ptr_read_u8_at(base_ptr, byte_off + 1);
            let p = alloc(8);
            ptr_write_u8_at(p, 0, 0);
            ptr_write_u8_at(p, 1, 0);
            ptr_write_u8_at(p, 2, b0);
            ptr_write_u8_at(p, 3, b1);
            let v: float = ptr_read_f32_at(p, 0);
            free(p);
            return v;
        }
        if dtype == 5 { // INT32
            let byte_off = elem_idx * 4;
            let u: int = ptr_read_u32_at(base_ptr, byte_off);
            if u >= 2147483648 {
                u = u - 4294967296;
            }
            return u * 1.0;
        }
        if dtype == 6 { // INT64
            let byte_off = elem_idx * 8;
            let ival: int = ptr_read_at(base_ptr, byte_off);
            return ival * 1.0;
        }
        if dtype == 7 || dtype == 8 { // UINT8 or BOOL
            let byte_off = elem_idx * 1;
            let b = ptr_read_u8_at(base_ptr, byte_off);
            return b * 1.0;
        }
        return 0.0;
    }
}

func tensor_storage_write_float(storage: TensorStorage, elem_idx: int, dtype: int, val: float) {
    unsafe {
        let base_ptr = int_to_ptr(storage.addr);
        if dtype == 1 { // FLOAT32
            let byte_off = elem_idx * 4;
            ptr_write_f32_at(base_ptr, byte_off, val);
            return;
        }
        if dtype == 2 { // FLOAT64
            let byte_off = elem_idx * 8;
            ptr_write_f64_at(base_ptr, byte_off, val);
            return;
        }
        if dtype == 3 { // FLOAT16
            let byte_off = elem_idx * 2;
            let bits = f32_to_f16_bits(val);
            ptr_write_u8_at(base_ptr, byte_off, bits % 256);
            ptr_write_u8_at(base_ptr, byte_off + 1, (bits / 256) % 256);
            return;
        }
        if dtype == 4 { // BFLOAT16
            let byte_off = elem_idx * 2;
            let p = alloc(8);
            ptr_write_f32_at(p, 0, val);
            let b2 = ptr_read_u8_at(p, 2);
            let b3 = ptr_read_u8_at(p, 3);
            free(p);
            ptr_write_u8_at(base_ptr, byte_off, b2);
            ptr_write_u8_at(base_ptr, byte_off + 1, b3);
            return;
        }
        if dtype == 5 { // INT32
            let byte_off = elem_idx * 4;
            ptr_write_u32_at(base_ptr, byte_off, int(val));
            return;
        }
        if dtype == 6 { // INT64
            let byte_off = elem_idx * 8;
            let ival = int(val);
            ptr_write_at(base_ptr, byte_off, ival);
            return;
        }
        if dtype == 7 || dtype == 8 { // UINT8 or BOOL
            let byte_off = elem_idx * 1;
            let b = int(val) % 256;
            if b < 0 { b = 0; }
            ptr_write_u8_at(base_ptr, byte_off, b);
            return;
        }
    }
}

// ==============================================================================
// SECTION 3: Multi-Dimensional Shape (Ranks 0D to 6D)
// ==============================================================================

class Shape {
    dim0: int,
    dim1: int,
    dim2: int,
    dim3: int,
    dim4: int,
    dim5: int,
    rank: int
}

func shape_0d() -> Shape {
    return new Shape(1, 1, 1, 1, 1, 1, 0);
}

func shape_1d(d0: int) -> Shape {
    return new Shape(d0, 1, 1, 1, 1, 1, 1);
}

func shape_2d(d0: int, d1: int) -> Shape {
    return new Shape(d0, d1, 1, 1, 1, 1, 2);
}

func shape_3d(d0: int, d1: int, d2: int) -> Shape {
    return new Shape(d0, d1, d2, 1, 1, 1, 3);
}

func shape_4d(d0: int, d1: int, d2: int, d3: int) -> Shape {
    return new Shape(d0, d1, d2, d3, 1, 1, 4);
}

func shape_5d(d0: int, d1: int, d2: int, d3: int, d4: int) -> Shape {
    return new Shape(d0, d1, d2, d3, d4, 1, 5);
}

func shape_6d(d0: int, d1: int, d2: int, d3: int, d4: int, d5: int) -> Shape {
    return new Shape(d0, d1, d2, d3, d4, d5, 6);
}

func shape_numel(s: Shape) -> int {
    if s.rank == 0 { return 1; }
    if s.rank == 1 { return s.dim0; }
    if s.rank == 2 { return s.dim0 * s.dim1; }
    if s.rank == 3 { return s.dim0 * s.dim1 * s.dim2; }
    if s.rank == 4 { return s.dim0 * s.dim1 * s.dim2 * s.dim3; }
    if s.rank == 5 { return s.dim0 * s.dim1 * s.dim2 * s.dim3 * s.dim4; }
    return s.dim0 * s.dim1 * s.dim2 * s.dim3 * s.dim4 * s.dim5;
}

impl Shape {
    func numel() -> int {
        return shape_numel(this);
    }

    func dim(axis: int) -> int {
        let a = axis;
        if a < 0 {
            a = this.rank + a;
        }
        if a == 0 { return this.dim0; }
        if a == 1 { return this.dim1; }
        if a == 2 { return this.dim2; }
        if a == 3 { return this.dim3; }
        if a == 4 { return this.dim4; }
        if a == 5 { return this.dim5; }
        return 1;
    }

    func equals(other: Shape) -> bool {
        if this.rank != other.rank { return false; }
        if this.rank >= 1 && this.dim0 != other.dim0 { return false; }
        if this.rank >= 2 && this.dim1 != other.dim1 { return false; }
        if this.rank >= 3 && this.dim2 != other.dim2 { return false; }
        if this.rank >= 4 && this.dim3 != other.dim3 { return false; }
        if this.rank >= 5 && this.dim4 != other.dim4 { return false; }
        if this.rank >= 6 && this.dim5 != other.dim5 { return false; }
        return true;
    }

    func to_string() -> string {
        if this.rank == 0 { return "[]"; }
        if this.rank == 1 { return "[" + to_string(this.dim0) + "]"; }
        if this.rank == 2 { return "[" + to_string(this.dim0) + ", " + to_string(this.dim1) + "]"; }
        if this.rank == 3 { return "[" + to_string(this.dim0) + ", " + to_string(this.dim1) + ", " + to_string(this.dim2) + "]"; }
        if this.rank == 4 { return "[" + to_string(this.dim0) + ", " + to_string(this.dim1) + ", " + to_string(this.dim2) + ", " + to_string(this.dim3) + "]"; }
        if this.rank == 5 { return "[" + to_string(this.dim0) + ", " + to_string(this.dim1) + ", " + to_string(this.dim2) + ", " + to_string(this.dim3) + ", " + to_string(this.dim4) + "]"; }
        return "[" + to_string(this.dim0) + ", " + to_string(this.dim1) + ", " + to_string(this.dim2) + ", " + to_string(this.dim3) + ", " + to_string(this.dim4) + ", " + to_string(this.dim5) + "]";
    }
}

// ==============================================================================
// SECTION 4: Strides & Memory Layout
// ==============================================================================

class Strides {
    s0: int,
    s1: int,
    s2: int,
    s3: int,
    s4: int,
    s5: int,
    rank: int
}

func strides_contiguous(s: Shape) -> Strides {
    if s.rank == 0 {
        return new Strides(0, 0, 0, 0, 0, 0, 0);
    }
    if s.rank == 1 {
        return new Strides(1, 0, 0, 0, 0, 0, 1);
    }
    if s.rank == 2 {
        return new Strides(s.dim1, 1, 0, 0, 0, 0, 2);
    }
    if s.rank == 3 {
        return new Strides(s.dim1 * s.dim2, s.dim2, 1, 0, 0, 0, 3);
    }
    if s.rank == 4 {
        return new Strides(s.dim1 * s.dim2 * s.dim3, s.dim2 * s.dim3, s.dim3, 1, 0, 0, 4);
    }
    if s.rank == 5 {
        return new Strides(s.dim1 * s.dim2 * s.dim3 * s.dim4, s.dim2 * s.dim3 * s.dim4, s.dim3 * s.dim4, s.dim4, 1, 0, 5);
    }
    return new Strides(
        s.dim1 * s.dim2 * s.dim3 * s.dim4 * s.dim5,
        s.dim2 * s.dim3 * s.dim4 * s.dim5,
        s.dim3 * s.dim4 * s.dim5,
        s.dim4 * s.dim5,
        s.dim5,
        1,
        6
    );
}

impl Strides {
    func stride(axis: int) -> int {
        let a = axis;
        if a < 0 {
            a = this.rank + a;
        }
        if a == 0 { return this.s0; }
        if a == 1 { return this.s1; }
        if a == 2 { return this.s2; }
        if a == 3 { return this.s3; }
        if a == 4 { return this.s4; }
        if a == 5 { return this.s5; }
        return 0;
    }

    func is_contiguous(s: Shape) -> bool {
        let expected = strides_contiguous(s);
        if this.rank != expected.rank { return false; }
        if this.rank >= 1 && this.s0 != expected.s0 { return false; }
        if this.rank >= 2 && this.s1 != expected.s1 { return false; }
        if this.rank >= 3 && this.s2 != expected.s2 { return false; }
        if this.rank >= 4 && this.s3 != expected.s3 { return false; }
        if this.rank >= 5 && this.s4 != expected.s4 { return false; }
        if this.rank >= 6 && this.s5 != expected.s5 { return false; }
        return true;
    }
}

// ==============================================================================
// SECTION 5: Slice Structure with Negative Indices & Steps
// ==============================================================================

class Slice {
    start: int,
    stop: int,
    step: int,
    has_start: bool,
    has_stop: bool,
    has_step: bool
}

func slice_all() -> Slice {
    return new Slice(0, 0, 1, false, false, false);
}

func slice_step(step: int) -> Slice {
    return new Slice(0, 0, step, false, false, true);
}

func slice_reverse() -> Slice {
    return new Slice(0, 0, -1, false, false, true);
}

func slice_new(start: int, stop: int, step: int) -> Slice {
    return new Slice(start, stop, step, true, true, true);
}

func slice_range(start: int, stop: int) -> Slice {
    return new Slice(start, stop, 1, true, true, false);
}

func slice_from(start: int) -> Slice {
    return new Slice(start, 0, 1, true, false, false);
}

func slice_to(stop: int) -> Slice {
    return new Slice(0, stop, 1, false, true, false);
}

// ==============================================================================
// SECTION 6: Tensor Data Structure, Autograd Nodes & Core Accessors
// ==============================================================================

class AutogradNode {
    op: int,
    op_name: string,
    input_a: Tensor,
    input_b: Tensor,
    saved_param_float: float,
    saved_param_int: int,
    custom_fn_id: int
}

impl AutogradNode {
    func name() -> string {
        return this.op_name;
    }
}

func op_none() -> int { return 0; }
func op_add() -> int { return 1; }
func op_sub() -> int { return 2; }
func op_mul() -> int { return 3; }
func op_div() -> int { return 4; }
func op_scale() -> int { return 5; }
func op_neg() -> int { return 6; }
func op_matmul() -> int { return 7; }
func op_dot() -> int { return 8; }
func op_relu() -> int { return 9; }
func op_sigmoid() -> int { return 10; }
func op_tanh() -> int { return 11; }
func op_gelu() -> int { return 12; }
func op_silu() -> int { return 13; }
func op_softmax() -> int { return 14; }
func op_sum() -> int { return 15; }
func op_mean() -> int { return 16; }
func op_sum_dim() -> int { return 17; }
func op_transpose() -> int { return 18; }
func op_reshape() -> int { return 19; }
func op_mse_loss() -> int { return 20; }
func op_pow() -> int { return 21; }
func op_exp() -> int { return 22; }
func op_log() -> int { return 23; }
func op_custom() -> int { return 24; }
func op_conv2d() -> int { return 25; }
func op_embedding() -> int { return 26; }
func op_cross_entropy_loss() -> int { return 27; }
func op_bce_with_logits_loss() -> int { return 28; }
func op_l1_loss() -> int { return 29; }

func autograd_node_new(op: int, op_name: string, input_a: Tensor, input_b: Tensor) -> AutogradNode {
    return new AutogradNode(op, op_name, input_a, input_b, 0.0, 0, 0);
}

func autograd_node_param(op: int, op_name: string, input_a: Tensor, input_b: Tensor, param_f: float, param_i: int) -> AutogradNode {
    return new AutogradNode(op, op_name, input_a, input_b, param_f, param_i, 0);
}

func autograd_node_custom(op_name: string, input_a: Tensor, input_b: Tensor, custom_fn_id: int) -> AutogradNode {
    return new AutogradNode(op_custom(), op_name, input_a, input_b, 0.0, 0, custom_fn_id);
}

class AutogradContext {
    saved_t1: Tensor,
    saved_t2: Tensor,
    saved_f1: float,
    saved_f2: float,
    saved_i1: int,
    saved_i2: int
}

func autograd_context_new() -> AutogradContext {
    return new AutogradContext(null, null, 0.0, 0.0, 0, 0);
}

impl AutogradContext {
    func save_for_backward(t1: Tensor, t2: Tensor) {
        this.saved_t1 = t1;
        this.saved_t2 = t2;
    }
}

class Tensor {
    shape: Shape,
    strides: Strides,
    offset: int,
    dtype_id: int,
    storage: TensorStorage,
    requires_grad: bool,
    device: string,
    grad: Tensor,
    grad_fn: AutogradNode,
    is_leaf: bool,
    id: int
}

func autograd_str_to_int(s: string) -> int {
    let len = string_length(s);
    let mut_val = 0;
    let mut_i = 0;
    while mut_i < len {
        let c = string_char_at(s, mut_i);
        if c >= 48 && c <= 57 {
            mut_val = (mut_val * 10) + (c - 48);
        }
        mut_i = mut_i + 1;
    }
    return mut_val;
}

func float_to_int(f: float) -> int {
    let s = to_string(f);
    let len = string_length(s);
    let sign = 1;
    let start = 0;
    if len > 0 && string_char_at(s, 0) == 45 {
        sign = -1;
        start = 1;
    }
    let res = 0;
    let i = start;
    while i < len {
        let c = string_char_at(s, i);
        if c == 46 {
            return sign * res;
        }
        if c >= 48 && c <= 57 {
            res = (res * 10) + (c - 48);
        }
        i = i + 1;
    }
    return sign * res;
}

func autograd_ctrl_addr() -> int {
    let s = sys_env_var("ROZE_AUTOGRAD_CTRL");
    if s != "" {
        return autograd_str_to_int(s);
    }
    unsafe {
        let p = alloc(64);
        ptr_write_at(p, 0, 1);
        ptr_write_at(p, 8, 1);
        let addr = ptr_to_int(p);
        sys_env_set("ROZE_AUTOGRAD_CTRL", to_string(addr));
        return addr;
    }
}

func tensor_next_id() -> int {
    unsafe {
        let addr = autograd_ctrl_addr();
        let p = int_to_ptr(addr);
        let id: int = ptr_read_at(p, 0);
        ptr_write_at(p, 0, id + 1);
        return id;
    }
}

func autograd_is_grad_enabled() -> bool {
    unsafe {
        let addr = autograd_ctrl_addr();
        let p = int_to_ptr(addr);
        let en: int = ptr_read_at(p, 8);
        return en != 0;
    }
}

func autograd_set_grad_enabled(enabled: bool) -> bool {
    unsafe {
        let addr = autograd_ctrl_addr();
        let p = int_to_ptr(addr);
        let prev: int = ptr_read_at(p, 8);
        let next_val = 0;
        if enabled { next_val = 1; }
        ptr_write_at(p, 8, next_val);
        return prev != 0;
    }
}

func no_grad_scope_begin() -> bool {
    return autograd_set_grad_enabled(false);
}

func no_grad_scope_end(prev: bool) {
    autograd_set_grad_enabled(prev);
}

func tensor_create(shape: Shape, strides: Strides, offset: int, dtype_id: int, storage: TensorStorage, requires_grad: bool, device: string) -> Tensor {
    let tid = tensor_next_id();
    return new Tensor(shape, strides, offset, dtype_id, storage, requires_grad, device, null, null, true, tid);
}

func tensor_create_with_grad_fn(shape: Shape, strides: Strides, offset: int, dtype_id: int, storage: TensorStorage, requires_grad: bool, device: string, grad_fn: AutogradNode) -> Tensor {
    let tid = tensor_next_id();
    return new Tensor(shape, strides, offset, dtype_id, storage, requires_grad, device, null, grad_fn, false, tid);
}

func tensor_numel(t: Tensor) -> int {
    return t.shape.numel();
}

impl Tensor {
    func rank() -> int {
        return this.shape.rank;
    }

    func ndim() -> int {
        return this.shape.rank;
    }

    func dim(axis: int) -> int {
        return this.shape.dim(axis);
    }

    func numel() -> int {
        return this.shape.numel();
    }

    func stride(axis: int) -> int {
        return this.strides.stride(axis);
    }

    func is_contiguous() -> bool {
        return this.strides.is_contiguous(this.shape);
    }

    func dtype() -> int {
        return this.dtype_id;
    }

    func device_name() -> string {
        return this.device;
    }

    func backward() {
        tensor_backward(this);
    }

    func zero_grad() {
        this.grad = null;
    }

    func set_requires_grad(req: bool) {
        this.requires_grad = req;
    }

    func get_grad() -> Tensor {
        return this.grad;
    }

    func get_grad_fn() -> AutogradNode {
        return this.grad_fn;
    }

    func get_is_leaf() -> bool {
        return this.is_leaf;
    }

    func sum() -> Tensor {
        return tensor_sum_tensor(this);
    }

    func mean() -> Tensor {
        return tensor_mean_tensor(this);
    }

    func mse_loss(target: Tensor) -> Tensor {
        return tensor_mse_loss(this, target);
    }

    func l1_loss(target: Tensor) -> Tensor {
        return tensor_l1_loss(this, target);
    }

    func bce_with_logits_loss(target: Tensor) -> Tensor {
        return tensor_bce_with_logits_loss(this, target);
    }

    func cross_entropy_loss(target: Tensor) -> Tensor {
        return tensor_cross_entropy_loss(this, target);
    }

    func compute_offset_1d(i0: int) -> int {
        return this.offset + i0 * this.strides.s0;
    }

    func compute_offset_2d(i0: int, i1: int) -> int {
        return this.offset + i0 * this.strides.s0 + i1 * this.strides.s1;
    }

    func compute_offset_3d(i0: int, i1: int, i2: int) -> int {
        return this.offset + i0 * this.strides.s0 + i1 * this.strides.s1 + i2 * this.strides.s2;
    }

    func compute_offset_4d(i0: int, i1: int, i2: int, i3: int) -> int {
        return this.offset + i0 * this.strides.s0 + i1 * this.strides.s1 + i2 * this.strides.s2 + i3 * this.strides.s3;
    }

    func compute_offset_5d(i0: int, i1: int, i2: int, i3: int, i4: int) -> int {
        return this.offset + i0 * this.strides.s0 + i1 * this.strides.s1 + i2 * this.strides.s2 + i3 * this.strides.s3 + i4 * this.strides.s4;
    }

    func compute_offset_6d(i0: int, i1: int, i2: int, i3: int, i4: int, i5: int) -> int {
        return this.offset + i0 * this.strides.s0 + i1 * this.strides.s1 + i2 * this.strides.s2 + i3 * this.strides.s3 + i4 * this.strides.s4 + i5 * this.strides.s5;
    }

    // Scalar access (0D or 1-element tensors)
    func item() -> float {
        return tensor_storage_read_float(this.storage, this.offset, this.dtype_id);
    }

    func set_item(val: float) {
        tensor_storage_write_float(this.storage, this.offset, this.dtype_id, val);
    }

    // 1D Access
    func get_1d(i0: int) -> float {
        let off = this.compute_offset_1d(i0);
        return tensor_storage_read_float(this.storage, off, this.dtype_id);
    }

    func set_1d(i0: int, val: float) {
        let off = this.compute_offset_1d(i0);
        tensor_storage_write_float(this.storage, off, this.dtype_id, val);
    }

    // 2D Access
    func get_2d(r: int, c: int) -> float {
        let off = this.compute_offset_2d(r, c);
        return tensor_storage_read_float(this.storage, off, this.dtype_id);
    }

    func set_2d(r: int, c: int, val: float) {
        let off = this.compute_offset_2d(r, c);
        tensor_storage_write_float(this.storage, off, this.dtype_id, val);
    }

    // 3D Access
    func get_3d(d0: int, d1: int, d2: int) -> float {
        let off = this.compute_offset_3d(d0, d1, d2);
        return tensor_storage_read_float(this.storage, off, this.dtype_id);
    }

    func set_3d(d0: int, d1: int, d2: int, val: float) {
        let off = this.compute_offset_3d(d0, d1, d2);
        tensor_storage_write_float(this.storage, off, this.dtype_id, val);
    }

    // 4D Access
    func get_4d(d0: int, d1: int, d2: int, d3: int) -> float {
        let off = this.compute_offset_4d(d0, d1, d2, d3);
        return tensor_storage_read_float(this.storage, off, this.dtype_id);
    }

    func set_4d(d0: int, d1: int, d2: int, d3: int, val: float) {
        let off = this.compute_offset_4d(d0, d1, d2, d3);
        tensor_storage_write_float(this.storage, off, this.dtype_id, val);
    }

    // 5D Access
    func get_5d(d0: int, d1: int, d2: int, d3: int, d4: int) -> float {
        let off = this.compute_offset_5d(d0, d1, d2, d3, d4);
        return tensor_storage_read_float(this.storage, off, this.dtype_id);
    }

    func set_5d(d0: int, d1: int, d2: int, d3: int, d4: int, val: float) {
        let off = this.compute_offset_5d(d0, d1, d2, d3, d4);
        tensor_storage_write_float(this.storage, off, this.dtype_id, val);
    }

    // 6D Access
    func get_6d(d0: int, d1: int, d2: int, d3: int, d4: int, d5: int) -> float {
        let off = this.compute_offset_6d(d0, d1, d2, d3, d4, d5);
        return tensor_storage_read_float(this.storage, off, this.dtype_id);
    }

    func set_6d(d0: int, d1: int, d2: int, d3: int, d4: int, d5: int, val: float) {
        let off = this.compute_offset_6d(d0, d1, d2, d3, d4, d5);
        tensor_storage_write_float(this.storage, off, this.dtype_id, val);
    }
}

// Global Free function
func tensor_free(t: Tensor) {
    tensor_storage_free(t.storage);
}

// Backward-compatible global getters/setters
func tensor_get_2d(t: Tensor, r: int, c: int) -> float {
    return t.get_2d(r, c);
}

func tensor_set_2d(t: Tensor, r: int, c: int, val: float) {
    t.set_2d(r, c, val);
}

// ==============================================================================
// SECTION 7: Tensor Creation Factories
// ==============================================================================

func tensor_new(s: Shape, dtype: int, device: string) -> Tensor {
    let total = shape_numel(s);
    let bytes = total * dtype_itemsize(dtype);
    let st = tensor_storage_new(bytes, device);
    let st_strides = strides_contiguous(s);
    return tensor_create(s, st_strides, 0, dtype, st, false, device);
}

func tensor_zeros(s: Shape, dtype: int) -> Tensor {
    return tensor_new(s, dtype, "cpu");
}

func tensor_ones(s: Shape, dtype: int) -> Tensor {
    let t = tensor_zeros(s, dtype);
    let total = t.numel();
    let i = 0;
    while i < total {
        tensor_storage_write_float(t.storage, i, dtype, 1.0);
        i = i + 1;
    }
    return t;
}

func tensor_full(s: Shape, fill_val: float, dtype: int) -> Tensor {
    let t = tensor_zeros(s, dtype);
    let total = t.numel();
    let i = 0;
    while i < total {
        tensor_storage_write_float(t.storage, i, dtype, fill_val);
        i = i + 1;
    }
    return t;
}

func tensor_scalar(val: float, dtype: int) -> Tensor {
    let s = shape_0d();
    let t = tensor_zeros(s, dtype);
    t.set_item(val);
    return t;
}

// Rank-specific convenience factories
func tensor_zeros_1d(d0: int) -> Tensor {
    return tensor_zeros(shape_1d(d0), 1);
}

func tensor_zeros_2d(rows: int, cols: int) -> Tensor {
    return tensor_zeros(shape_2d(rows, cols), 1);
}

func tensor_zeros_3d(d0: int, d1: int, d2: int) -> Tensor {
    return tensor_zeros(shape_3d(d0, d1, d2), 1);
}

func tensor_zeros_4d(d0: int, d1: int, d2: int, d3: int) -> Tensor {
    return tensor_zeros(shape_4d(d0, d1, d2, d3), 1);
}

func tensor_zeros_5d(d0: int, d1: int, d2: int, d3: int, d4: int) -> Tensor {
    return tensor_zeros(shape_5d(d0, d1, d2, d3, d4), 1);
}

func tensor_zeros_6d(d0: int, d1: int, d2: int, d3: int, d4: int, d5: int) -> Tensor {
    return tensor_zeros(shape_6d(d0, d1, d2, d3, d4, d5), 1);
}

func tensor_ones_1d(d0: int) -> Tensor {
    return tensor_ones(shape_1d(d0), 1);
}

func tensor_ones_2d(rows: int, cols: int) -> Tensor {
    return tensor_ones(shape_2d(rows, cols), 1);
}

func tensor_ones_3d(d0: int, d1: int, d2: int) -> Tensor {
    return tensor_ones(shape_3d(d0, d1, d2), 1);
}

func tensor_ones_4d(d0: int, d1: int, d2: int, d3: int) -> Tensor {
    return tensor_ones(shape_4d(d0, d1, d2, d3), 1);
}

func tensor_eye(n: int, dtype: int) -> Tensor {
    let t = tensor_zeros(shape_2d(n, n), dtype);
    let i = 0;
    while i < n {
        t.set_2d(i, i, 1.0);
        i = i + 1;
    }
    return t;
}

func tensor_arange(start: float, end: float, step: float, dtype: int) -> Tensor {
    let span = end - start;
    let count = int(span / step);
    if count < 0 { count = 0; }
    let t = tensor_zeros(shape_1d(count), dtype);
    let i = 0;
    let cur = start;
    while i < count {
        t.set_1d(i, cur);
        cur = cur + step;
        i = i + 1;
    }
    return t;
}

func tensor_linspace(start: float, end: float, steps: int, dtype: int) -> Tensor {
    if steps <= 0 { return tensor_zeros(shape_1d(0), dtype); }
    if steps == 1 {
        let t = tensor_zeros(shape_1d(1), dtype);
        t.set_1d(0, start);
        return t;
    }
    let t = tensor_zeros(shape_1d(steps), dtype);
    let step_sz = (end - start) / ((steps - 1) * 1.0);
    let i = 0;
    while i < steps {
        t.set_1d(i, start + (i * 1.0) * step_sz);
        i = i + 1;
    }
    return t;
}

func tensor_clone(t: Tensor) -> Tensor {
    let out = tensor_zeros(t.shape, t.dtype_id);
    // Linear copy if contiguous
    if t.is_contiguous() {
        let n = t.numel();
        let i = 0;
        while i < n {
            let v = tensor_storage_read_float(t.storage, t.offset + i, t.dtype_id);
            tensor_storage_write_float(out.storage, i, t.dtype_id, v);
            i = i + 1;
        }
        return out;
    }
    // Strided copy
    return tensor_contiguous(t);
}

// ==============================================================================
// SECTION 8: Strided Slicing with Negative Indices & Steps (Zero-Copy Views)
// ==============================================================================

class NormalizedSlice {
    start: int,
    len: int,
    step: int
}

func slice_normalize(sl: Slice, dim_len: int) -> NormalizedSlice {
    let step = 1;
    if sl.has_step {
        step = sl.step;
    }
    if step == 0 { step = 1; }

    let start = 0;
    let stop = dim_len;

    if step > 0 {
        if sl.has_start {
            start = sl.start;
            if start < 0 { start = dim_len + start; }
            if start < 0 { start = 0; }
            if start > dim_len { start = dim_len; }
        } else {
            start = 0;
        }

        if sl.has_stop {
            stop = sl.stop;
            if stop < 0 { stop = dim_len + stop; }
            if stop < 0 { stop = 0; }
            if stop > dim_len { stop = dim_len; }
        } else {
            stop = dim_len;
        }

        let new_len = 0;
        if start < stop {
            new_len = (stop - start + step - 1) / step;
        }
        return new NormalizedSlice(start, new_len, step);
    } else {
        // Negative step
        let neg_step = 0 - step;
        if sl.has_start {
            start = sl.start;
            if start < 0 { start = dim_len + start; }
            if start < 0 { start = -1; }
            if start >= dim_len { start = dim_len - 1; }
        } else {
            start = dim_len - 1;
        }

        if sl.has_stop {
            stop = sl.stop;
            if stop < 0 { stop = dim_len + stop; }
            if stop < -1 { stop = -1; }
            if stop >= dim_len { stop = dim_len - 1; }
        } else {
            stop = -1;
        }

        let new_len = 0;
        if start > stop {
            new_len = (start - stop + neg_step - 1) / neg_step;
        }
        return new NormalizedSlice(start, new_len, step);
    }
}

func tensor_slice_1d(t: Tensor, s0: Slice) -> Tensor {
    let p0 = slice_normalize(s0, t.shape.dim0);
    let new_shape = shape_1d(p0.len);
    let new_strides = new Strides(t.strides.s0 * p0.step, 0, 0, 0, 0, 0, 1);
    let new_offset = t.offset + p0.start * t.strides.s0;
    return tensor_create(new_shape, new_strides, new_offset, t.dtype_id, t.storage, t.requires_grad, t.device);
}

func tensor_slice_2d(t: Tensor, s0: Slice, s1: Slice) -> Tensor {
    let p0 = slice_normalize(s0, t.shape.dim0);
    let p1 = slice_normalize(s1, t.shape.dim1);
    let new_shape = shape_2d(p0.len, p1.len);
    let new_strides = new Strides(t.strides.s0 * p0.step, t.strides.s1 * p1.step, 0, 0, 0, 0, 2);
    let new_offset = t.offset + p0.start * t.strides.s0 + p1.start * t.strides.s1;
    return tensor_create(new_shape, new_strides, new_offset, t.dtype_id, t.storage, t.requires_grad, t.device);
}

func tensor_slice_3d(t: Tensor, s0: Slice, s1: Slice, s2: Slice) -> Tensor {
    let p0 = slice_normalize(s0, t.shape.dim0);
    let p1 = slice_normalize(s1, t.shape.dim1);
    let p2 = slice_normalize(s2, t.shape.dim2);

    let new_shape = shape_3d(p0.len, p1.len, p2.len);
    let new_strides = new Strides(t.strides.s0 * p0.step, t.strides.s1 * p1.step, t.strides.s2 * p2.step, 0, 0, 0, 3);
    let new_offset = t.offset + p0.start * t.strides.s0 + p1.start * t.strides.s1 + p2.start * t.strides.s2;
    return tensor_create(new_shape, new_strides, new_offset, t.dtype_id, t.storage, t.requires_grad, t.device);
}

// Slice single dimension (select row/col view)
func tensor_select(t: Tensor, dim: int, index: int) -> Tensor {
    let idx = index;
    let dim_len = t.dim(dim);
    if idx < 0 { idx = dim_len + idx; }

    if t.rank() == 2 {
        if dim == 0 {
            // Selecting row -> returns 1D vector view of that row
            let s = shape_1d(t.shape.dim1);
            let str = new Strides(t.strides.s1, 0, 0, 0, 0, 0, 1);
            let off = t.offset + idx * t.strides.s0;
            return tensor_create(s, str, off, t.dtype_id, t.storage, t.requires_grad, t.device);
        } else {
            // Selecting col -> returns 1D vector view of that col
            let s = shape_1d(t.shape.dim0);
            let str = new Strides(t.strides.s0, 0, 0, 0, 0, 0, 1);
            let off = t.offset + idx * t.strides.s1;
            return tensor_create(s, str, off, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
    }
    if t.rank() == 1 {
        // Selecting item -> returns 0D scalar view
        let s = shape_0d();
        let str = new Strides(0, 0, 0, 0, 0, 0, 0);
        let off = t.offset + idx * t.strides.s0;
        return tensor_create(s, str, off, t.dtype_id, t.storage, t.requires_grad, t.device);
    }
    return t;
}

// ==============================================================================
// SECTION 9: Broadcasting Engine (NumPy & PyTorch Parity)
// ==============================================================================

func can_broadcast_dim(d1: int, d2: int) -> bool {
    return d1 == d2 || d1 == 1 || d2 == 1;
}

func max_int(a: int, b: int) -> int {
    if a > b { return a; }
    return b;
}

func broadcast_shapes(s1: Shape, s2: Shape) -> Shape {
    let r1 = s1.rank;
    let r2 = s2.rank;
    let max_r = max_int(r1, r2);

    if max_r == 0 { return shape_0d(); }
    if max_r == 1 {
        let b0 = max_int(s1.dim(0), s2.dim(0));
        return shape_1d(b0);
    }
    if max_r == 2 {
        let b0 = max_int(s1.dim(-2), s2.dim(-2));
        let b1 = max_int(s1.dim(-1), s2.dim(-1));
        return shape_2d(b0, b1);
    }
    if max_r == 3 {
        let b0 = max_int(s1.dim(-3), s2.dim(-3));
        let b1 = max_int(s1.dim(-2), s2.dim(-2));
        let b2 = max_int(s1.dim(-1), s2.dim(-1));
        return shape_3d(b0, b1, b2);
    }
    // max_r == 4
    let b0 = max_int(s1.dim(-4), s2.dim(-4));
    let b1 = max_int(s1.dim(-3), s2.dim(-3));
    let b2 = max_int(s1.dim(-2), s2.dim(-2));
    let b3 = max_int(s1.dim(-1), s2.dim(-1));
    return shape_4d(b0, b1, b2, b3);
}

// Zero-copy broadcast view (setting strides to 0 along expanded dimensions)
func tensor_broadcast_to(t: Tensor, target: Shape) -> Tensor {
    if t.shape.equals(target) { return t; }

    let tr = target.rank;
    let cur_r = t.shape.rank;

    if tr == 2 {
        let d0 = target.dim0;
        let d1 = target.dim1;
        let s0 = 0;
        let s1 = 0;

        if cur_r == 2 {
            if t.shape.dim0 == d0 { s0 = t.strides.s0; } else { s0 = 0; }
            if t.shape.dim1 == d1 { s1 = t.strides.s1; } else { s1 = 0; }
        } else if cur_r == 1 {
            s0 = 0;
            if t.shape.dim0 == d1 { s1 = t.strides.s0; } else { s1 = 0; }
        } else if cur_r == 0 {
            s0 = 0;
            s1 = 0;
        }
        let str = new Strides(s0, s1, 0, 0, 0, 0, 2);
        return tensor_create(target, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }

    if tr == 1 {
        let d0 = target.dim0;
        let s0 = 0;
        if cur_r == 1 && t.shape.dim0 == d0 { s0 = t.strides.s0; }
        let str = new Strides(s0, 0, 0, 0, 0, 0, 1);
        return tensor_create(target, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }

    if tr == 3 {
        let s0 = 0; let s1 = 0; let s2 = 0;
        if cur_r == 3 {
            if t.shape.dim0 == target.dim0 { s0 = t.strides.s0; }
            if t.shape.dim1 == target.dim1 { s1 = t.strides.s1; }
            if t.shape.dim2 == target.dim2 { s2 = t.strides.s2; }
        } else if cur_r == 2 {
            if t.shape.dim0 == target.dim1 { s1 = t.strides.s0; }
            if t.shape.dim1 == target.dim2 { s2 = t.strides.s1; }
        }
        let str = new Strides(s0, s1, s2, 0, 0, 0, 3);
        return tensor_create(target, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }

    return t;
}

// Broadcasted elementwise arithmetic
func tensor_add(a: Tensor, b: Tensor) -> Tensor {
    let out_shape = broadcast_shapes(a.shape, b.shape);
    let view_a = tensor_broadcast_to(a, out_shape);
    let view_b = tensor_broadcast_to(b, out_shape);
    let out = tensor_zeros(out_shape, a.dtype_id);

    if out_shape.rank == 2 {
        let r = 0;
        let rows = out_shape.dim0;
        let cols = out_shape.dim1;
        while r < rows {
            let c = 0;
            while c < cols {
                let va = view_a.get_2d(r, c);
                let vb = view_b.get_2d(r, c);
                out.set_2d(r, c, va + vb);
                c = c + 1;
            }
            r = r + 1;
        }
    } else if out_shape.rank == 1 {
        let i = 0;
        let n = out_shape.dim0;
        while i < n {
            let va = view_a.get_1d(i);
            let vb = view_b.get_1d(i);
            out.set_1d(i, va + vb);
            i = i + 1;
        }
    } else if out_shape.rank == 0 {
        out.set_item(view_a.item() + view_b.item());
    }

    if autograd_is_grad_enabled() && (a.requires_grad || b.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_add(), "<AddBackward0>", a, b);
    }
    return out;
}

func tensor_sub(a: Tensor, b: Tensor) -> Tensor {
    let out_shape = broadcast_shapes(a.shape, b.shape);
    let view_a = tensor_broadcast_to(a, out_shape);
    let view_b = tensor_broadcast_to(b, out_shape);
    let out = tensor_zeros(out_shape, a.dtype_id);

    if out_shape.rank == 2 {
        let r = 0;
        let rows = out_shape.dim0;
        let cols = out_shape.dim1;
        while r < rows {
            let c = 0;
            while c < cols {
                let va = view_a.get_2d(r, c);
                let vb = view_b.get_2d(r, c);
                out.set_2d(r, c, va - vb);
                c = c + 1;
            }
            r = r + 1;
        }
    } else if out_shape.rank == 1 {
        let i = 0;
        let n = out_shape.dim0;
        while i < n {
            let va = view_a.get_1d(i);
            let vb = view_b.get_1d(i);
            out.set_1d(i, va - vb);
            i = i + 1;
        }
    } else if out_shape.rank == 0 {
        out.set_item(view_a.item() - view_b.item());
    }

    if autograd_is_grad_enabled() && (a.requires_grad || b.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_sub(), "<SubBackward0>", a, b);
    }
    return out;
}

func tensor_mul(a: Tensor, b: Tensor) -> Tensor {
    let out_shape = broadcast_shapes(a.shape, b.shape);
    let view_a = tensor_broadcast_to(a, out_shape);
    let view_b = tensor_broadcast_to(b, out_shape);
    let out = tensor_zeros(out_shape, a.dtype_id);

    if out_shape.rank == 2 {
        let r = 0;
        let rows = out_shape.dim0;
        let cols = out_shape.dim1;
        while r < rows {
            let c = 0;
            while c < cols {
                let va = view_a.get_2d(r, c);
                let vb = view_b.get_2d(r, c);
                out.set_2d(r, c, va * vb);
                c = c + 1;
            }
            r = r + 1;
        }
    } else if out_shape.rank == 1 {
        let i = 0;
        let n = out_shape.dim0;
        while i < n {
            let va = view_a.get_1d(i);
            let vb = view_b.get_1d(i);
            out.set_1d(i, va * vb);
            i = i + 1;
        }
    } else if out_shape.rank == 0 {
        out.set_item(view_a.item() * view_b.item());
    }

    if autograd_is_grad_enabled() && (a.requires_grad || b.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_mul(), "<MulBackward0>", a, b);
    }
    return out;
}

func tensor_div(a: Tensor, b: Tensor) -> Tensor {
    let out_shape = broadcast_shapes(a.shape, b.shape);
    let view_a = tensor_broadcast_to(a, out_shape);
    let view_b = tensor_broadcast_to(b, out_shape);
    let out = tensor_zeros(out_shape, a.dtype_id);

    if out_shape.rank == 2 {
        let r = 0;
        let rows = out_shape.dim0;
        let cols = out_shape.dim1;
        while r < rows {
            let c = 0;
            while c < cols {
                let va = view_a.get_2d(r, c);
                let vb = view_b.get_2d(r, c);
                let res = 0.0;
                if vb != 0.0 { res = va / vb; }
                out.set_2d(r, c, res);
                c = c + 1;
            }
            r = r + 1;
        }
    } else if out_shape.rank == 1 {
        let i = 0;
        let n = out_shape.dim0;
        while i < n {
            let va = view_a.get_1d(i);
            let vb = view_b.get_1d(i);
            let res = 0.0;
            if vb != 0.0 { res = va / vb; }
            out.set_1d(i, res);
            i = i + 1;
        }
    }

    if autograd_is_grad_enabled() && (a.requires_grad || b.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_div(), "<DivBackward0>", a, b);
    }
    return out;
}

func tensor_scale(a: Tensor, scalar: float) -> Tensor {
    let s = tensor_scalar(scalar, a.dtype_id);
    let out = tensor_mul(a, s);
    if autograd_is_grad_enabled() && a.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_param(op_scale(), "<ScaleBackward0>", a, null, scalar, 0);
    }
    return out;
}

func tensor_neg(t: Tensor) -> Tensor {
    return tensor_scale(t, -1.0);
}

// ==============================================================================
// SECTION 10: Matrix Transposition & General Permutation
// ==============================================================================

func tensor_transpose(t: Tensor, dim0: int, dim1: int) -> Tensor {
    let d0 = dim0; if d0 < 0 { d0 = t.rank() + d0; }
    let d1 = dim1; if d1 < 0 { d1 = t.rank() + d1; }

    if t.rank() == 2 && ((d0 == 0 && d1 == 1) || (d0 == 1 && d1 == 0)) {
        let new_s = shape_2d(t.shape.dim1, t.shape.dim0);
        let new_str = new Strides(t.strides.s1, t.strides.s0, 0, 0, 0, 0, 2);
        let res = tensor_create(new_s, new_str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        if autograd_is_grad_enabled() && t.requires_grad {
            res.requires_grad = true;
            res.is_leaf = false;
            res.grad_fn = autograd_node_param(op_transpose(), "<TransposeBackward0>", t, null, 0.0, d0 * 10 + d1);
        }
        return res;
    }

    if t.rank() == 3 {
        let d0_sz = t.shape.dim0;
        let d1_sz = t.shape.dim1;
        let d2_sz = t.shape.dim2;
        let s0_sz = t.strides.s0;
        let s1_sz = t.strides.s1;
        let s2_sz = t.strides.s2;

        if (d0 == 0 && d1 == 1) || (d0 == 1 && d1 == 0) {
            let res = tensor_create(shape_3d(d1_sz, d0_sz, d2_sz), new Strides(s1_sz, s0_sz, s2_sz, 0, 0, 0, 3), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
            if autograd_is_grad_enabled() && t.requires_grad {
                res.requires_grad = true;
                res.is_leaf = false;
                res.grad_fn = autograd_node_param(op_transpose(), "<TransposeBackward0>", t, null, 0.0, d0 * 10 + d1);
            }
            return res;
        }
        if (d0 == 0 && d1 == 2) || (d0 == 2 && d1 == 0) {
            let res = tensor_create(shape_3d(d2_sz, d1_sz, d0_sz), new Strides(s2_sz, s1_sz, s0_sz, 0, 0, 0, 3), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
            if autograd_is_grad_enabled() && t.requires_grad {
                res.requires_grad = true;
                res.is_leaf = false;
                res.grad_fn = autograd_node_param(op_transpose(), "<TransposeBackward0>", t, null, 0.0, d0 * 10 + d1);
            }
            return res;
        }
        if (d0 == 1 && d1 == 2) || (d0 == 2 && d1 == 1) {
            let res = tensor_create(shape_3d(d0_sz, d2_sz, d1_sz), new Strides(s0_sz, s2_sz, s1_sz, 0, 0, 0, 3), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
            if autograd_is_grad_enabled() && t.requires_grad {
                res.requires_grad = true;
                res.is_leaf = false;
                res.grad_fn = autograd_node_param(op_transpose(), "<TransposeBackward0>", t, null, 0.0, d0 * 10 + d1);
            }
            return res;
        }
        return t;
    }

    return t;
}

func tensor_t(t: Tensor) -> Tensor {
    return tensor_transpose(t, 0, 1);
}

func tensor_permute_3d(t: Tensor, p0: int, p1: int, p2: int) -> Tensor {
    let d0 = 0; let s0 = 0;
    if p0 == 0 { d0 = t.shape.dim0; s0 = t.strides.s0; }
    if p0 == 1 { d0 = t.shape.dim1; s0 = t.strides.s1; }
    if p0 == 2 { d0 = t.shape.dim2; s0 = t.strides.s2; }

    let d1 = 0; let s1 = 0;
    if p1 == 0 { d1 = t.shape.dim0; s1 = t.strides.s0; }
    if p1 == 1 { d1 = t.shape.dim1; s1 = t.strides.s1; }
    if p1 == 2 { d1 = t.shape.dim2; s1 = t.strides.s2; }

    let d2 = 0; let s2 = 0;
    if p2 == 0 { d2 = t.shape.dim0; s2 = t.strides.s0; }
    if p2 == 1 { d2 = t.shape.dim1; s2 = t.strides.s1; }
    if p2 == 2 { d2 = t.shape.dim2; s2 = t.strides.s2; }

    let new_s = shape_3d(d0, d1, d2);
    let new_str = new Strides(s0, s1, s2, 0, 0, 0, 3);
    return tensor_create(new_s, new_str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
}

// ==============================================================================
// SECTION 11: Contiguous Re-Allocation & Shape Transformations
// ==============================================================================

func tensor_is_contiguous(t: Tensor) -> bool {
    return t.is_contiguous();
}

func tensor_contiguous(t: Tensor) -> Tensor {
    if t.is_contiguous() {
        return t;
    }
    // Allocate new linear storage and copy elements following strided layout
    let out = tensor_zeros(t.shape, t.dtype_id);

    if t.rank() == 1 {
        let n = t.shape.dim0;
        let i = 0;
        while i < n {
            out.set_1d(i, t.get_1d(i));
            i = i + 1;
        }
        return out;
    }

    if t.rank() == 2 {
        let rows = t.shape.dim0;
        let cols = t.shape.dim1;
        let r = 0;
        while r < rows {
            let c = 0;
            while c < cols {
                out.set_2d(r, c, t.get_2d(r, c));
                c = c + 1;
            }
            r = r + 1;
        }
        return out;
    }

    if t.rank() == 3 {
        let d0 = t.shape.dim0;
        let d1 = t.shape.dim1;
        let d2 = t.shape.dim2;
        let i0 = 0;
        while i0 < d0 {
            let i1 = 0;
            while i1 < d1 {
                let i2 = 0;
                while i2 < d2 {
                    out.set_3d(i0, i1, i2, t.get_3d(i0, i1, i2));
                    i2 = i2 + 1;
                }
                i1 = i1 + 1;
            }
            i0 = i0 + 1;
        }
        return out;
    }

    return out;
}

func tensor_reshape(t: Tensor, new_shape: Shape) -> Tensor {
    if t.numel() != new_shape.numel() {
        return t; // Shape mismatch
    }
    let contig = tensor_contiguous(t);
    let new_strides = strides_contiguous(new_shape);
    let res = tensor_create(new_shape, new_strides, 0, contig.dtype_id, contig.storage, contig.requires_grad, contig.device);
    if autograd_is_grad_enabled() && t.requires_grad {
        res.requires_grad = true;
        res.is_leaf = false;
        res.grad_fn = autograd_node_new(op_reshape(), "<ReshapeBackward0>", t, null);
    }
    return res;
}

func tensor_flatten(t: Tensor, start_dim: int, end_dim: int) -> Tensor {
    let total = t.numel();
    let s = shape_1d(total);
    return tensor_reshape(t, s);
}

func tensor_squeeze(t: Tensor, dim: int) -> Tensor {
    let r = t.rank();
    let d = dim;
    if d < 0 { d = r + d; }

    if r == 2 {
        if d == 0 && t.shape.dim0 == 1 {
            return tensor_create(shape_1d(t.shape.dim1), new Strides(t.strides.s1, 0, 0, 0, 0, 0, 1), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        if d == 1 && t.shape.dim1 == 1 {
            return tensor_create(shape_1d(t.shape.dim0), new Strides(t.strides.s0, 0, 0, 0, 0, 0, 1), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
    }
    if r == 3 {
        if d == 0 && t.shape.dim0 == 1 {
            return tensor_create(shape_2d(t.shape.dim1, t.shape.dim2), new Strides(t.strides.s1, t.strides.s2, 0, 0, 0, 0, 2), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        if d == 1 && t.shape.dim1 == 1 {
            return tensor_create(shape_2d(t.shape.dim0, t.shape.dim2), new Strides(t.strides.s0, t.strides.s2, 0, 0, 0, 0, 2), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        if d == 2 && t.shape.dim2 == 1 {
            return tensor_create(shape_2d(t.shape.dim0, t.shape.dim1), new Strides(t.strides.s0, t.strides.s1, 0, 0, 0, 0, 2), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
    }
    if r == 4 {
        if d == 0 && t.shape.dim0 == 1 {
            return tensor_create(shape_3d(t.shape.dim1, t.shape.dim2, t.shape.dim3), new Strides(t.strides.s1, t.strides.s2, t.strides.s3, 0, 0, 0, 3), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
    }
    return t;
}

func tensor_unsqueeze(t: Tensor, dim: int) -> Tensor {
    let r = t.rank();
    let d = dim;
    if d < 0 { d = r + 1 + d; }

    if r == 0 {
        return tensor_create(shape_1d(1), new Strides(1, 0, 0, 0, 0, 0, 1), t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }
    if r == 1 {
        if d == 0 {
            let s = shape_2d(1, t.shape.dim0);
            let str = new Strides(t.strides.s0, t.strides.s0, 0, 0, 0, 0, 2);
            return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        let s = shape_2d(t.shape.dim0, 1);
        let str = new Strides(t.strides.s0, 1, 0, 0, 0, 0, 2);
        return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }
    if r == 2 {
        if d == 0 {
            let s = shape_3d(1, t.shape.dim0, t.shape.dim1);
            let str = new Strides(t.strides.s0, t.strides.s0, t.strides.s1, 0, 0, 0, 3);
            return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        if d == 1 {
            let s = shape_3d(t.shape.dim0, 1, t.shape.dim1);
            let str = new Strides(t.strides.s0, t.strides.s1, t.strides.s1, 0, 0, 0, 3);
            return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        let s = shape_3d(t.shape.dim0, t.shape.dim1, 1);
        let str = new Strides(t.strides.s0, t.strides.s1, 1, 0, 0, 0, 3);
        return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }
    if r == 3 {
        if d == 0 {
            let s = shape_4d(1, t.shape.dim0, t.shape.dim1, t.shape.dim2);
            let str = new Strides(t.strides.s0, t.strides.s0, t.strides.s1, t.strides.s2, 0, 0, 4);
            return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
        }
        let s = shape_4d(t.shape.dim0, t.shape.dim1, t.shape.dim2, 1);
        let str = new Strides(t.strides.s0, t.strides.s1, t.strides.s2, 1, 0, 0, 4);
        return tensor_create(s, str, t.offset, t.dtype_id, t.storage, t.requires_grad, t.device);
    }
    return t;
}

// ==============================================================================
// SECTION 12: Tensor Contractions, Linear Algebra & MatMul
// ==============================================================================

// 1D Vector Dot Product: a . b = sum(a_i * b_i)
func tensor_dot(a: Tensor, b: Tensor) -> float {
    let n = a.numel();
    let sum = 0.0;
    let i = 0;
    while i < n {
        sum = sum + (a.get_1d(i) * b.get_1d(i));
        i = i + 1;
    }
    return sum;
}

// 2D Matrix Multiplication (GEMM): C = A x B where A is (M x K) and B is (K x N)
func tensor_matmul(a: Tensor, b: Tensor) -> Tensor {
    let m = a.shape.dim0;
    let k = a.shape.dim1;
    let n = b.shape.dim1;
    let out = tensor_zeros(shape_2d(m, n), a.dtype_id);

    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            let sum = 0.0;
            let p = 0;
            while p < k {
                let av = a.get_2d(i, p);
                let bv = b.get_2d(p, j);
                sum = sum + (av * bv);
                p = p + 1;
            }
            out.set_2d(i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }

    if autograd_is_grad_enabled() && (a.requires_grad || b.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_matmul(), "<MmBackward0>", a, b);
    }
    return out;
}

// 3D Batched Matrix Multiplication (BMM): (B x M x K) x (B x K x N) -> (B x M x N)
func tensor_bmm(a: Tensor, b: Tensor) -> Tensor {
    let batch = a.shape.dim0;
    let m = a.shape.dim1;
    let k = a.shape.dim2;
    let n = b.shape.dim2;
    let out = tensor_zeros(shape_3d(batch, m, n), a.dtype_id);

    let b_idx = 0;
    while b_idx < batch {
        let i = 0;
        while i < m {
            let j = 0;
            while j < n {
                let sum = 0.0;
                let p = 0;
                while p < k {
                    let av = a.get_3d(b_idx, i, p);
                    let bv = b.get_3d(b_idx, p, j);
                    sum = sum + (av * bv);
                    p = p + 1;
                }
                out.set_3d(b_idx, i, j, sum);
                j = j + 1;
            }
            i = i + 1;
        }
        b_idx = b_idx + 1;
    }
    return out;
}

// General Tensor Contraction
func tensor_tensordot(a: Tensor, b: Tensor, axes: int) -> Tensor {
    if axes == 1 {
        if a.rank() == 1 && b.rank() == 1 {
            return tensor_scalar(tensor_dot(a, b), a.dtype_id);
        }
        if a.rank() == 2 && b.rank() == 2 {
            return tensor_matmul(a, b);
        }
    }
    return tensor_matmul(a, b);
}

// ==============================================================================
// SECTION 13: Mathematical Reductions & Norms
// ==============================================================================

func torch_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0; }
    let guess = x / 2.0;
    if guess == 0.0 { guess = 1.0; }
    let iter = 0;
    while iter < 10 {
        guess = (guess + (x / guess)) / 2.0;
        iter = iter + 1;
    }
    return guess;
}

func torch_exp(x: float) -> float {
    let sum = 1.0;
    let term = 1.0;
    let n = 1;
    while n <= 10 {
        term = term * (x / (n * 1.0));
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

func torch_ln(x: float) -> float {
    if x <= 0.0 { return -999999.0; }
    let k = 0;
    let v = x;
    while v >= 2.0 {
        v = v / 2.0;
        k = k + 1;
    }
    while v < 1.0 {
        v = v * 2.0;
        k = k - 1;
    }
    let z = (v - 1.0) / (v + 1.0);
    let z2 = z * z;
    let term = z;
    let sum = z;
    term = term * z2;
    sum = sum + term / 3.0;
    term = term * z2;
    sum = sum + term / 5.0;
    term = term * z2;
    sum = sum + term / 7.0;
    term = term * z2;
    sum = sum + term / 9.0;
    let ln_v = 2.0 * sum;
    let ln_2 = 0.69314718056;
    return ln_v + (k * 1.0) * ln_2;
}

func torch_pow(base: float, p: float) -> float {
    if p == 0.0 { return 1.0; }
    if p == 1.0 { return base; }
    if p == 2.0 { return base * base; }
    if p == 3.0 { return base * base * base; }
    if base == 0.0 { return 0.0; }
    let int_p = int(p);
    if float(int_p) == p {
        let res = 1.0;
        let n = int_p;
        let is_neg = false;
        if n < 0 {
            is_neg = true;
            n = -n;
        }
        let b = base;
        while n > 0 {
            if n % 2 == 1 {
                res = res * b;
            }
            b = b * b;
            n = n / 2;
        }
        if is_neg { return 1.0 / res; }
        return res;
    }
    if base > 0.0 {
        return torch_exp(p * torch_ln(base));
    }
    return 0.0;
}

func tensor_sum(t: Tensor) -> float {
    let contig = tensor_contiguous(t);
    let n = contig.numel();
    let sum = 0.0;
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        sum = sum + v;
        i = i + 1;
    }
    return sum;
}

func tensor_mean(t: Tensor) -> float {
    let n = t.numel();
    if n == 0 { return 0.0; }
    return tensor_sum(t) / (n * 1.0);
}

func tensor_max(t: Tensor) -> float {
    let contig = tensor_contiguous(t);
    let n = contig.numel();
    if n == 0 { return 0.0; }
    let mx = tensor_storage_read_float(contig.storage, contig.offset, contig.dtype_id);
    let i = 1;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        if v > mx { mx = v; }
        i = i + 1;
    }
    return mx;
}

func tensor_min(t: Tensor) -> float {
    let contig = tensor_contiguous(t);
    let n = contig.numel();
    if n == 0 { return 0.0; }
    let mn = tensor_storage_read_float(contig.storage, contig.offset, contig.dtype_id);
    let i = 1;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        if v < mn { mn = v; }
        i = i + 1;
    }
    return mn;
}

func tensor_norm_l1(t: Tensor) -> float {
    let contig = tensor_contiguous(t);
    let n = contig.numel();
    let sum = 0.0;
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        if v < 0.0 { v = 0.0 - v; }
        sum = sum + v;
        i = i + 1;
    }
    return sum;
}

// Frobenius / L2 Vector & Matrix Norm
func tensor_norm_l2(t: Tensor) -> float {
    let contig = tensor_contiguous(t);
    let n = contig.numel();
    let sum_sq = 0.0;
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    return torch_sqrt(sum_sq);
}

// Dimensional reduction (sum along axis 0 or 1 for 2D matrix)
func tensor_sum_dim(t: Tensor, dim: int, keepdim: bool) -> Tensor {
    let axis = dim; if axis < 0 { axis = t.rank() + axis; }
    let rows = t.shape.dim0;
    let cols = t.shape.dim1;

    let out_shape = shape_1d(cols);
    if axis == 0 {
        if keepdim { out_shape = shape_2d(1, cols); }
    } else {
        out_shape = shape_1d(rows);
        if keepdim { out_shape = shape_2d(rows, 1); }
    }
    let out = tensor_zeros(out_shape, t.dtype_id);

    if axis == 0 {
        let c = 0;
        while c < cols {
            let col_sum = 0.0;
            let r = 0;
            while r < rows {
                col_sum = col_sum + t.get_2d(r, c);
                r = r + 1;
            }
            if keepdim { out.set_2d(0, c, col_sum); } else { out.set_1d(c, col_sum); }
            c = c + 1;
        }
    } else {
        let r = 0;
        while r < rows {
            let row_sum = 0.0;
            let c = 0;
            while c < cols {
                row_sum = row_sum + t.get_2d(r, c);
                c = c + 1;
            }
            if keepdim { out.set_2d(r, 0, row_sum); } else { out.set_1d(r, row_sum); }
            r = r + 1;
        }
    }

    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_param(op_sum_dim(), "<SumDimBackward0>", t, null, 0.0, axis);
    }
    return out;
}

// ==============================================================================
// SECTION 14: Neural Network Activations & Layers
// ==============================================================================

func tensor_relu(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        if v > 0.0 {
            tensor_storage_write_float(out.storage, i, contig.dtype_id, v);
        } else {
            tensor_storage_write_float(out.storage, i, contig.dtype_id, 0.0);
        }
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_relu(), "<ReluBackward0>", t, null);
    }
    return out;
}

func tensor_sigmoid(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        let sig = 1.0 / (1.0 + torch_exp(0.0 - v));
        tensor_storage_write_float(out.storage, i, contig.dtype_id, sig);
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_sigmoid(), "<SigmoidBackward0>", t, null);
    }
    return out;
}

func tensor_tanh(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        let ep = torch_exp(v);
        let en = torch_exp(0.0 - v);
        let th = (ep - en) / (ep + en);
        tensor_storage_write_float(out.storage, i, contig.dtype_id, th);
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_tanh(), "<TanhBackward0>", t, null);
    }
    return out;
}

// Gaussian Error Linear Unit (GELU)
func tensor_gelu(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let x = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        // Approximation: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
        let poly = x + 0.044715 * x * x * x;
        let c = 0.7978845608 * poly;
        let ep = torch_exp(c);
        let en = torch_exp(0.0 - c);
        let th = (ep - en) / (ep + en);
        let gelu_val = 0.5 * x * (1.0 + th);
        tensor_storage_write_float(out.storage, i, contig.dtype_id, gelu_val);
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_gelu(), "<GeluBackward0>", t, null);
    }
    return out;
}

// Sigmoid Linear Unit (SiLU / Swish): x * sigmoid(x)
func tensor_silu(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let x = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        let sig = 1.0 / (1.0 + torch_exp(0.0 - x));
        tensor_storage_write_float(out.storage, i, contig.dtype_id, x * sig);
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_silu(), "<SiluBackward0>", t, null);
    }
    return out;
}

// Numerically Stable Softmax
func tensor_softmax(t: Tensor) -> Tensor {
    let out = tensor_zeros_1d(1);
    if t.rank() == 1 {
        let n = t.shape.dim0;
        out = tensor_zeros_1d(n);
        let max_val = t.get_1d(0);
        let i = 1;
        while i < n {
            let v = t.get_1d(i);
            if v > max_val { max_val = v; }
            i = i + 1;
        }

        let sum_exp = 0.0;
        i = 0;
        while i < n {
            let v = t.get_1d(i);
            sum_exp = sum_exp + torch_exp(v - max_val);
            i = i + 1;
        }

        i = 0;
        while i < n {
            let v = t.get_1d(i);
            let prob = torch_exp(v - max_val) / sum_exp;
            out.set_1d(i, prob);
            i = i + 1;
        }
    } else {
        let rows = t.shape.dim0;
        let cols = t.shape.dim1;
        out = tensor_zeros(shape_2d(rows, cols), t.dtype_id);

        let r = 0;
        while r < rows {
            let max_val = t.get_2d(r, 0);
            let c = 1;
            while c < cols {
                let v = t.get_2d(r, c);
                if v > max_val { max_val = v; }
                c = c + 1;
            }

            let sum_exp = 0.0;
            c = 0;
            while c < cols {
                let v = t.get_2d(r, c);
                sum_exp = sum_exp + torch_exp(v - max_val);
                c = c + 1;
            }

            c = 0;
            while c < cols {
                let v = t.get_2d(r, c);
                let prob = torch_exp(v - max_val) / sum_exp;
                out.set_2d(r, c, prob);
                c = c + 1;
            }
            r = r + 1;
        }
    }

    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_softmax(), "<SoftmaxBackward0>", t, null);
    }
    return out;
}

// Deep Neural Network Linear Layer
class LinearLayer {
    in_features: int,
    out_features: int,
    weights: Tensor,
    bias: Tensor
}

func linear_new(in_features: int, out_features: int) -> LinearLayer {
    let weights = tensor_zeros_2d(in_features, out_features);
    let bias = tensor_zeros_2d(1, out_features);

    // Xavier / Glorot Initialization
    let limit = torch_sqrt(6.0 / ((in_features + out_features) * 1.0));
    let r = 0;
    while r < in_features {
        let c = 0;
        while c < out_features {
            let pseudo_rand = (((r * 17 + c * 31) % 100) - 50) / 100.0 * limit;
            weights.set_2d(r, c, pseudo_rand);
            c = c + 1;
        }
        r = r + 1;
    }
    weights.requires_grad = true;
    bias.requires_grad = true;

    return new LinearLayer(in_features, out_features, weights, bias);
}

func linear_forward(layer: LinearLayer, input: Tensor) -> Tensor {
    let mm = tensor_matmul(input, layer.weights);
    return tensor_add(mm, layer.bias);
}

// Mean Squared Error (MSE) Loss
func mse_loss(pred: Tensor, target: Tensor) -> float {
    let diff = tensor_sub(pred, target);
    let n = diff.numel();
    let sum_sq = 0.0;
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(diff.storage, diff.offset + i, diff.dtype_id);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    return sum_sq / (n * 1.0);
}

// L1 Loss (Mean Absolute Error)
func l1_loss(pred: Tensor, target: Tensor) -> float {
    let diff = tensor_sub(pred, target);
    let n = diff.numel();
    let sum_abs = 0.0;
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(diff.storage, diff.offset + i, diff.dtype_id);
        if v < 0.0 {
            v = 0.0 - v;
        }
        sum_abs = sum_abs + v;
        i = i + 1;
    }
    return sum_abs / (n * 1.0);
}

// Binary Cross Entropy With Logits Loss (Numerically Stable Sigmoid + BCE)
func bce_with_logits_loss(pred: Tensor, target: Tensor) -> float {
    let contig_p = tensor_contiguous(pred);
    let contig_t = tensor_contiguous(target);
    let n = contig_p.numel();
    let sum_loss = 0.0;
    let i = 0;
    while i < n {
        let x = tensor_storage_read_float(contig_p.storage, contig_p.offset + i, contig_p.dtype_id);
        let y = tensor_storage_read_float(contig_t.storage, contig_t.offset + i, contig_t.dtype_id);
        let max_x = 0.0;
        if x > 0.0 {
            max_x = x;
        }
        let abs_x = x;
        if abs_x < 0.0 {
            abs_x = 0.0 - abs_x;
        }
        let term = max_x - (x * y) + torch_ln(1.0 + torch_exp(0.0 - abs_x));
        sum_loss = sum_loss + term;
        i = i + 1;
    }
    return sum_loss / (n * 1.0);
}

// Cross Entropy Loss (LogSoftmax + NLLLoss, Numerically Stable with LogSumExp)
func cross_entropy_loss(pred: Tensor, target: Tensor) -> float {
    let contig_p = tensor_contiguous(pred);
    let contig_t = tensor_contiguous(target);
    let n = 1;
    let c = contig_p.numel();
    if contig_p.ndim() == 2 {
        n = contig_p.shape.dim0;
        c = contig_p.shape.dim1;
    }
    let is_class_index = (contig_t.numel() == n);
    let total_loss = 0.0;
    let i = 0;
    while i < n {
        let max_val = -999999.0;
        let j = 0;
        while j < c {
            let v = tensor_storage_read_float(contig_p.storage, contig_p.offset + (i * c) + j, contig_p.dtype_id);
            if v > max_val {
                max_val = v;
            }
            j = j + 1;
        }
        let sum_exp = 0.0;
        j = 0;
        while j < c {
            let v = tensor_storage_read_float(contig_p.storage, contig_p.offset + (i * c) + j, contig_p.dtype_id);
            sum_exp = sum_exp + torch_exp(v - max_val);
            j = j + 1;
        }
        let log_sum_exp = max_val + torch_ln(sum_exp);

        if is_class_index {
            let target_cls = float_to_int(tensor_storage_read_float(contig_t.storage, contig_t.offset + i, contig_t.dtype_id));
            let logit = tensor_storage_read_float(contig_p.storage, contig_p.offset + (i * c) + target_cls, contig_p.dtype_id);
            total_loss = total_loss + (log_sum_exp - logit);
        } else {
            j = 0;
            while j < c {
                let target_prob = tensor_storage_read_float(contig_t.storage, contig_t.offset + (i * c) + j, contig_t.dtype_id);
                if target_prob > 0.0 {
                    let logit = tensor_storage_read_float(contig_p.storage, contig_p.offset + (i * c) + j, contig_p.dtype_id);
                    let log_p = logit - log_sum_exp;
                    total_loss = total_loss - (target_prob * log_p);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return total_loss / (n * 1.0);
}

func linear_zero_grad(layer: LinearLayer) {
    layer.weights.zero_grad();
    layer.bias.zero_grad();
}

func sgd_step(layer: LinearLayer, lr: float) {
    // Stochastic gradient descent step on weights and bias
    if layer.weights.grad != null {
        let total_w = layer.weights.numel();
        let i = 0;
        while i < total_w {
            let w = tensor_storage_read_float(layer.weights.storage, layer.weights.offset + i, layer.weights.dtype_id);
            let g = tensor_storage_read_float(layer.weights.grad.storage, layer.weights.grad.offset + i, layer.weights.grad.dtype_id);
            tensor_storage_write_float(layer.weights.storage, layer.weights.offset + i, layer.weights.dtype_id, w - lr * g);
            i = i + 1;
        }
    } else {
        let total_w = layer.weights.numel();
        let i = 0;
        while i < total_w {
            let w = tensor_storage_read_float(layer.weights.storage, i, layer.weights.dtype_id);
            tensor_storage_write_float(layer.weights.storage, i, layer.weights.dtype_id, w * (1.0 - lr * 0.01));
            i = i + 1;
        }
    }

    if layer.bias.grad != null {
        let total_b = layer.bias.numel();
        let i = 0;
        while i < total_b {
            let b = tensor_storage_read_float(layer.bias.storage, layer.bias.offset + i, layer.bias.dtype_id);
            let g = tensor_storage_read_float(layer.bias.grad.storage, layer.bias.grad.offset + i, layer.bias.grad.dtype_id);
            tensor_storage_write_float(layer.bias.storage, layer.bias.offset + i, layer.bias.dtype_id, b - lr * g);
            i = i + 1;
        }
    }
}

// ==============================================================================
// SECTION 15: Dynamic Computational Graph Autograd Tape Engine
// ==============================================================================

class VisitedSet {
    id: int,
    next: VisitedSet
}

func visited_contains(vs: VisitedSet, id: int) -> bool {
    let cur = vs;
    while cur != null {
        if cur.id == id { return true; }
        cur = cur.next;
    }
    return false;
}

class TapeNode {
    tensor: Tensor,
    next: TapeNode
}

class TopoBuilder {
    visited: VisitedSet,
    head: TapeNode
}

func autograd_topo_visit(builder: TopoBuilder, t: Tensor) {
    if t == null { return; }
    if visited_contains(builder.visited, t.id) { return; }
    builder.visited = new VisitedSet(t.id, builder.visited);

    if t.grad_fn != null {
        if t.grad_fn.input_a != null {
            autograd_topo_visit(builder, t.grad_fn.input_a);
        }
        if t.grad_fn.input_b != null {
            autograd_topo_visit(builder, t.grad_fn.input_b);
        }
    }

    builder.head = new TapeNode(t, builder.head);
}

func autograd_reduce_grad(grad: Tensor, target_shape: Shape) -> Tensor {
    if grad.shape.rank == target_shape.rank {
        let same = true;
        if target_shape.rank >= 1 && grad.shape.dim0 != target_shape.dim0 { same = false; }
        if target_shape.rank >= 2 && grad.shape.dim1 != target_shape.dim1 { same = false; }
        if target_shape.rank >= 3 && grad.shape.dim2 != target_shape.dim2 { same = false; }
        if same { return grad; }

        if target_shape.rank == 2 {
            if grad.shape.dim0 == target_shape.dim0 && target_shape.dim1 == 1 {
                return tensor_sum_dim(grad, 1, true);
            }
            if target_shape.dim0 == 1 && grad.shape.dim1 == target_shape.dim1 {
                return tensor_sum_dim(grad, 0, true);
            }
            if target_shape.dim0 == 1 && target_shape.dim1 == 1 {
                let s = tensor_sum(grad);
                let out = tensor_zeros_2d(1, 1);
                out.set_2d(0, 0, s);
                return out;
            }
        }
        return grad;
    }

    if grad.shape.rank == 2 && target_shape.rank == 1 {
        if grad.shape.dim1 == target_shape.dim0 {
            return tensor_sum_dim(grad, 0, false);
        }
        if grad.shape.dim0 == target_shape.dim0 {
            return tensor_sum_dim(grad, 1, false);
        }
        if target_shape.dim0 == 1 {
            let s = tensor_sum(grad);
            let out = tensor_zeros_1d(1);
            out.set_1d(0, s);
            return out;
        }
    }

    if target_shape.rank == 0 || target_shape.numel() == 1 {
        let s = tensor_sum(grad);
        return tensor_scalar(s, grad.dtype_id);
    }

    if grad.rank() == 1 && target_shape.rank == 2 && target_shape.dim0 == 1 && target_shape.dim1 == grad.shape.dim0 {
        return tensor_reshape(grad, target_shape);
    }

    return grad;
}

func autograd_accumulate_grad(target_t: Tensor, delta_grad: Tensor) {
    if target_t == null || !target_t.requires_grad {
        return;
    }
    let reduced = autograd_reduce_grad(delta_grad, target_t.shape);
    if target_t.grad == null {
        target_t.grad = tensor_clone(reduced);
    } else {
        target_t.grad = tensor_add(target_t.grad, reduced);
    }
}

func autograd_execute_node(node_t: Tensor, fn: AutogradNode, g: Tensor) {
    let op = fn.op;

    if op == op_add() {
        autograd_accumulate_grad(fn.input_a, g);
        autograd_accumulate_grad(fn.input_b, g);
        return;
    }

    if op == op_sub() {
        autograd_accumulate_grad(fn.input_a, g);
        autograd_accumulate_grad(fn.input_b, tensor_neg(g));
        return;
    }

    if op == op_mul() {
        if fn.input_a != null && fn.input_a.requires_grad {
            autograd_accumulate_grad(fn.input_a, tensor_mul(g, fn.input_b));
        }
        if fn.input_b != null && fn.input_b.requires_grad {
            autograd_accumulate_grad(fn.input_b, tensor_mul(g, fn.input_a));
        }
        return;
    }

    if op == op_div() {
        if fn.input_a != null && fn.input_a.requires_grad {
            autograd_accumulate_grad(fn.input_a, tensor_div(g, fn.input_b));
        }
        if fn.input_b != null && fn.input_b.requires_grad {
            let b2 = tensor_mul(fn.input_b, fn.input_b);
            let num = tensor_mul(tensor_neg(g), fn.input_a);
            autograd_accumulate_grad(fn.input_b, tensor_div(num, b2));
        }
        return;
    }

    if op == op_scale() {
        autograd_accumulate_grad(fn.input_a, tensor_scale(g, fn.saved_param_float));
        return;
    }

    if op == op_neg() {
        autograd_accumulate_grad(fn.input_a, tensor_neg(g));
        return;
    }

    if op == op_matmul() {
        if fn.input_a != null && fn.input_a.requires_grad {
            let bt = tensor_transpose(fn.input_b, 0, 1);
            autograd_accumulate_grad(fn.input_a, tensor_matmul(g, bt));
        }
        if fn.input_b != null && fn.input_b.requires_grad {
            let at = tensor_transpose(fn.input_a, 0, 1);
            autograd_accumulate_grad(fn.input_b, tensor_matmul(at, g));
        }
        return;
    }

    if op == op_relu() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let v = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            if v > 0.0 {
                tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv);
            }
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_sigmoid() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let v = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            let s = 1.0 / (1.0 + torch_exp(0.0 - v));
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv * s * (1.0 - s));
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_tanh() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let v = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            let ep = torch_exp(v);
            let en = torch_exp(0.0 - v);
            let th = (ep - en) / (ep + en);
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv * (1.0 - th * th));
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_gelu() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let x = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            let poly = x + 0.044715 * x * x * x;
            let c = 0.7978845608 * poly;
            let ep = torch_exp(c);
            let en = torch_exp(0.0 - c);
            let th = (ep - en) / (ep + en);
            let dt = 1.0 - th * th;
            let dc = 0.7978845608 * (1.0 + 3.0 * 0.044715 * x * x);
            let dgelu = 0.5 * (1.0 + th) + 0.5 * x * dt * dc;
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv * dgelu);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_silu() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let x = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            let s = 1.0 / (1.0 + torch_exp(0.0 - x));
            let dsilu = s * (1.0 + x * (1.0 - s));
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv * dsilu);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_softmax() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let cp = tensor_contiguous(node_t);
        let cg = tensor_contiguous(g);
        let dot = 0.0;
        let i = 0;
        while i < n {
            let pi = tensor_storage_read_float(cp.storage, cp.offset + i, cp.dtype_id);
            let gi = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            dot = dot + pi * gi;
            i = i + 1;
        }
        i = 0;
        while i < n {
            let pi = tensor_storage_read_float(cp.storage, cp.offset + i, cp.dtype_id);
            let gi = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, pi * (gi - dot));
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_sum() {
        let n = fn.input_a.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let gv = g.item();
        let i = 0;
        while i < n {
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_mean() {
        let n = fn.input_a.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let gv = g.item() / (n * 1.0);
        let i = 0;
        while i < n {
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_sum_dim() {
        let ga = tensor_broadcast_to(g, fn.input_a.shape);
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_transpose() {
        let d0 = fn.saved_param_int / 10;
        let d1 = fn.saved_param_int % 10;
        autograd_accumulate_grad(fn.input_a, tensor_transpose(g, d0, d1));
        return;
    }

    if op == op_reshape() {
        autograd_accumulate_grad(fn.input_a, tensor_reshape(g, fn.input_a.shape));
        return;
    }

    if op == op_pow() {
        let p = fn.saved_param_float;
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let a_val = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            let deriv = p * torch_pow(a_val, p - 1.0);
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv * deriv);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_exp() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let a_val = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, gv * torch_exp(a_val));
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_log() {
        let n = g.numel();
        let ga = tensor_zeros(fn.input_a.shape, g.dtype_id);
        let ca = tensor_contiguous(fn.input_a);
        let cg = tensor_contiguous(g);
        let i = 0;
        while i < n {
            let a_val = tensor_storage_read_float(ca.storage, ca.offset + i, ca.dtype_id);
            let gv = tensor_storage_read_float(cg.storage, cg.offset + i, cg.dtype_id);
            let res = 0.0;
            if a_val != 0.0 { res = gv / a_val; }
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, res);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        return;
    }

    if op == op_mse_loss() {
        let n = fn.input_a.numel();
        let factor = 2.0 / (n * 1.0) * g.item();
        let diff = tensor_sub(fn.input_a, fn.input_b);
        let ga = tensor_scale(diff, factor);
        let gb = tensor_scale(diff, 0.0 - factor);
        autograd_accumulate_grad(fn.input_a, ga);
        autograd_accumulate_grad(fn.input_b, gb);
        return;
    }

    if op == op_cross_entropy_loss() {
        let contig_a = tensor_contiguous(fn.input_a);
        let contig_b = tensor_contiguous(fn.input_b);
        let n = 1;
        let c = contig_a.numel();
        if contig_a.ndim() == 2 {
            n = contig_a.shape.dim0;
            c = contig_a.shape.dim1;
        }
        let is_class_index = (contig_b.numel() == n);
        let ga = tensor_zeros(contig_a.shape, contig_a.dtype_id);
        let gb = tensor_zeros(contig_b.shape, contig_b.dtype_id);
        let factor = (1.0 / (n * 1.0)) * g.item();

        let i = 0;
        while i < n {
            let max_val = -999999.0;
            let j = 0;
            while j < c {
                let v = tensor_storage_read_float(contig_a.storage, contig_a.offset + (i * c) + j, contig_a.dtype_id);
                if v > max_val { max_val = v; }
                j = j + 1;
            }
            let sum_exp = 0.0;
            j = 0;
            while j < c {
                let v = tensor_storage_read_float(contig_a.storage, contig_a.offset + (i * c) + j, contig_a.dtype_id);
                sum_exp = sum_exp + torch_exp(v - max_val);
                j = j + 1;
            }
            let log_sum_exp = max_val + torch_ln(sum_exp);
            j = 0;
            while j < c {
                let v = tensor_storage_read_float(contig_a.storage, contig_a.offset + (i * c) + j, contig_a.dtype_id);
                let prob = torch_exp(v - max_val) / sum_exp;
                let target_v = 0.0;
                if is_class_index {
                    let target_cls = float_to_int(tensor_storage_read_float(contig_b.storage, contig_b.offset + i, contig_b.dtype_id));
                    if j == target_cls {
                        target_v = 1.0;
                    }
                } else {
                    target_v = tensor_storage_read_float(contig_b.storage, contig_b.offset + (i * c) + j, contig_b.dtype_id);
                    let log_p = v - log_sum_exp;
                    tensor_storage_write_float(gb.storage, (i * c) + j, gb.dtype_id, (0.0 - log_p) * factor);
                }
                let grad_a_val = (prob - target_v) * factor;
                tensor_storage_write_float(ga.storage, (i * c) + j, ga.dtype_id, grad_a_val);
                j = j + 1;
            }
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        autograd_accumulate_grad(fn.input_b, gb);
        return;
    }

    if op == op_bce_with_logits_loss() {
        let n = fn.input_a.numel();
        let factor = (1.0 / (n * 1.0)) * g.item();
        let contig_a = tensor_contiguous(fn.input_a);
        let contig_b = tensor_contiguous(fn.input_b);
        let ga = tensor_zeros(contig_a.shape, contig_a.dtype_id);
        let gb = tensor_zeros(contig_b.shape, contig_b.dtype_id);
        let i = 0;
        while i < n {
            let x = tensor_storage_read_float(contig_a.storage, contig_a.offset + i, contig_a.dtype_id);
            let y = tensor_storage_read_float(contig_b.storage, contig_b.offset + i, contig_b.dtype_id);
            let sig = 1.0 / (1.0 + torch_exp(0.0 - x));
            let grad_x = (sig - y) * factor;
            let grad_y = (0.0 - x) * factor;
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, grad_x);
            tensor_storage_write_float(gb.storage, i, gb.dtype_id, grad_y);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        autograd_accumulate_grad(fn.input_b, gb);
        return;
    }

    if op == op_l1_loss() {
        let n = fn.input_a.numel();
        let factor = (1.0 / (n * 1.0)) * g.item();
        let contig_a = tensor_contiguous(fn.input_a);
        let contig_b = tensor_contiguous(fn.input_b);
        let ga = tensor_zeros(contig_a.shape, contig_a.dtype_id);
        let gb = tensor_zeros(contig_b.shape, contig_b.dtype_id);
        let i = 0;
        while i < n {
            let va = tensor_storage_read_float(contig_a.storage, contig_a.offset + i, contig_a.dtype_id);
            let vb = tensor_storage_read_float(contig_b.storage, contig_b.offset + i, contig_b.dtype_id);
            let diff = va - vb;
            let sgn = 0.0;
            if diff > 0.0 {
                sgn = 1.0;
            } else if diff < 0.0 {
                sgn = -1.0;
            }
            tensor_storage_write_float(ga.storage, i, ga.dtype_id, sgn * factor);
            tensor_storage_write_float(gb.storage, i, gb.dtype_id, (0.0 - sgn) * factor);
            i = i + 1;
        }
        autograd_accumulate_grad(fn.input_a, ga);
        autograd_accumulate_grad(fn.input_b, gb);
        return;
    }

    if op == op_custom() {
        autograd_dispatch_custom_backward(fn.custom_fn_id, fn.input_a, fn.input_b, g);
        return;
    }

    if op == op_conv2d() {
        let stride = fn.saved_param_int / 100;
        let padding = fn.saved_param_int % 100;
        let in_t = fn.input_a;
        let wt = fn.input_b;

        let n = in_t.shape.dim0;
        let c_in = in_t.shape.dim1;
        let h = in_t.shape.dim2;
        let w = in_t.shape.dim3;

        let c_out = wt.shape.dim0;
        let k_h = wt.shape.dim2;
        let k_w = wt.shape.dim3;

        let h_out = (h + 2 * padding - k_h) / stride + 1;
        let w_out = (w + 2 * padding - k_w) / stride + 1;

        if wt != null && wt.requires_grad {
            let gw = tensor_zeros_4d(c_out, c_in, k_h, k_w);
            let batch = 0;
            while batch < n {
                let co = 0;
                while co < c_out {
                    let oh = 0;
                    while oh < h_out {
                        let ow = 0;
                        while ow < w_out {
                            let g_val = g.get_4d(batch, co, oh, ow);
                            let ci = 0;
                            while ci < c_in {
                                let kh = 0;
                                while kh < k_h {
                                    let ih = oh * stride - padding + kh;
                                    if ih >= 0 && ih < h {
                                        let kw = 0;
                                        while kw < k_w {
                                            let iw = ow * stride - padding + kw;
                                            if iw >= 0 && iw < w {
                                                let iv = in_t.get_4d(batch, ci, ih, iw);
                                                let cur_w = gw.get_4d(co, ci, kh, kw);
                                                gw.set_4d(co, ci, kh, kw, cur_w + g_val * iv);
                                            }
                                            kw = kw + 1;
                                        }
                                    }
                                    kh = kh + 1;
                                }
                                ci = ci + 1;
                            }
                            ow = ow + 1;
                        }
                        oh = oh + 1;
                    }
                    co = co + 1;
                }
                batch = batch + 1;
            }
            autograd_accumulate_grad(wt, gw);
        }

        if in_t != null && in_t.requires_grad {
            let gi = tensor_zeros_4d(n, c_in, h, w);
            let batch = 0;
            while batch < n {
                let co = 0;
                while co < c_out {
                    let oh = 0;
                    while oh < h_out {
                        let ow = 0;
                        while ow < w_out {
                            let g_val = g.get_4d(batch, co, oh, ow);
                            let ci = 0;
                            while ci < c_in {
                                let kh = 0;
                                while kh < k_h {
                                    let ih = oh * stride - padding + kh;
                                    if ih >= 0 && ih < h {
                                        let kw = 0;
                                        while kw < k_w {
                                            let iw = ow * stride - padding + kw;
                                            if iw >= 0 && iw < w {
                                                let wv = wt.get_4d(co, ci, kh, kw);
                                                let cur_i = gi.get_4d(batch, ci, ih, iw);
                                                gi.set_4d(batch, ci, ih, iw, cur_i + g_val * wv);
                                            }
                                            kw = kw + 1;
                                        }
                                    }
                                    kh = kh + 1;
                                }
                                ci = ci + 1;
                            }
                            ow = ow + 1;
                        }
                        oh = oh + 1;
                    }
                    co = co + 1;
                }
                batch = batch + 1;
            }
            autograd_accumulate_grad(in_t, gi);
        }
        return;
    }

    if op == op_embedding() {
        let wt = fn.input_a;
        let indices = fn.input_b;
        if wt != null && wt.requires_grad {
            let gw = tensor_zeros(wt.shape, wt.dtype_id);
            let n = indices.numel();
            let d = wt.shape.dim1;
            let i = 0;
            while i < n {
                let idx = float_to_int(indices.get_1d(i));
                if idx >= 0 && idx < wt.shape.dim0 {
                    let c = 0;
                    while c < d {
                        let cur_g = gw.get_2d(idx, c);
                        let in_g = g.get_2d(i, c);
                        gw.set_2d(idx, c, cur_g + in_g);
                        c = c + 1;
                    }
                }
                i = i + 1;
            }
            autograd_accumulate_grad(wt, gw);
        }
        return;
    }
}

func tensor_backward(t: Tensor) {
    tensor_backward_with_grad(t, null, false);
}

func tensor_backward_with_grad(t: Tensor, grad: Tensor, retain_graph: bool) {
    if !t.requires_grad && t.grad_fn == null {
        return;
    }
    let prev_en = autograd_set_grad_enabled(false);

    if grad != null {
        t.grad = tensor_clone(grad);
    } else {
        if t.grad == null {
            t.grad = tensor_ones(t.shape, t.dtype_id);
        }
    }

    let builder = new TopoBuilder(null, null);
    autograd_topo_visit(builder, t);

    let cur = builder.head;
    while cur != null {
        let node_t = cur.tensor;
        if node_t.grad_fn != null && node_t.grad != null {
            autograd_execute_node(node_t, node_t.grad_fn, node_t.grad);
        }
        cur = cur.next;
    }

    autograd_set_grad_enabled(prev_en);
}

func autograd_backward(t: Tensor) {
    tensor_backward(t);
}

func tensor_zero_grad(t: Tensor) {
    t.grad = null;
}

func tensor_pow(t: Tensor, p: float) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        tensor_storage_write_float(out.storage, i, contig.dtype_id, torch_pow(v, p));
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_param(op_pow(), "<PowBackward0>", t, null, p, 0);
    }
    return out;
}

func tensor_exp(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        tensor_storage_write_float(out.storage, i, contig.dtype_id, torch_exp(v));
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_exp(), "<ExpBackward0>", t, null);
    }
    return out;
}

func tensor_log(t: Tensor) -> Tensor {
    let contig = tensor_contiguous(t);
    let out = tensor_zeros(contig.shape, contig.dtype_id);
    let n = contig.numel();
    let i = 0;
    while i < n {
        let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
        tensor_storage_write_float(out.storage, i, contig.dtype_id, torch_ln(v));
        i = i + 1;
    }
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_log(), "<LogBackward0>", t, null);
    }
    return out;
}

func tensor_sum_tensor(t: Tensor) -> Tensor {
    let s = tensor_sum(t);
    let out = tensor_scalar(s, t.dtype_id);
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_sum(), "<SumBackward0>", t, null);
    }
    return out;
}

func tensor_mean_tensor(t: Tensor) -> Tensor {
    let m = tensor_mean(t);
    let out = tensor_scalar(m, t.dtype_id);
    if autograd_is_grad_enabled() && t.requires_grad {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_mean(), "<MeanBackward0>", t, null);
    }
    return out;
}

func tensor_mse_loss(pred: Tensor, target: Tensor) -> Tensor {
    let loss_val = mse_loss(pred, target);
    let out = tensor_scalar(loss_val, pred.dtype_id);
    if autograd_is_grad_enabled() && (pred.requires_grad || target.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_mse_loss(), "<MseLossBackward0>", pred, target);
    }
    return out;
}

func tensor_l1_loss(pred: Tensor, target: Tensor) -> Tensor {
    let loss_val = l1_loss(pred, target);
    let out = tensor_scalar(loss_val, pred.dtype_id);
    if autograd_is_grad_enabled() && (pred.requires_grad || target.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_l1_loss(), "<L1LossBackward0>", pred, target);
    }
    return out;
}

func tensor_bce_with_logits_loss(pred: Tensor, target: Tensor) -> Tensor {
    let loss_val = bce_with_logits_loss(pred, target);
    let out = tensor_scalar(loss_val, pred.dtype_id);
    if autograd_is_grad_enabled() && (pred.requires_grad || target.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_bce_with_logits_loss(), "<BceWithLogitsLossBackward0>", pred, target);
    }
    return out;
}

func tensor_cross_entropy_loss(pred: Tensor, target: Tensor) -> Tensor {
    let loss_val = cross_entropy_loss(pred, target);
    let out = tensor_scalar(loss_val, pred.dtype_id);
    if autograd_is_grad_enabled() && (pred.requires_grad || target.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_new(op_cross_entropy_loss(), "<CrossEntropyLossBackward0>", pred, target);
    }
    return out;
}

class AutogradFunction {
    fn_id: int,
    name: string
}

func autograd_custom_forward(fn_id: int, a: Tensor, b: Tensor) -> Tensor {
    if fn_id == 1 {
        // Custom Cube: f(x) = x^3
        let contig = tensor_contiguous(a);
        let out = tensor_zeros(contig.shape, contig.dtype_id);
        let n = contig.numel();
        let i = 0;
        while i < n {
            let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
            tensor_storage_write_float(out.storage, i, contig.dtype_id, v * v * v);
            i = i + 1;
        }
        if autograd_is_grad_enabled() && a.requires_grad {
            out.requires_grad = true;
            out.is_leaf = false;
            out.grad_fn = autograd_node_custom("<CustomCubeBackward>", a, null, fn_id);
        }
        return out;
    }
    if fn_id == 2 {
        // Custom Affine: f(x) = 2.0 * x + 5.0
        let contig = tensor_contiguous(a);
        let out = tensor_zeros(contig.shape, contig.dtype_id);
        let n = contig.numel();
        let i = 0;
        while i < n {
            let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
            tensor_storage_write_float(out.storage, i, contig.dtype_id, 2.0 * v + 5.0);
            i = i + 1;
        }
        if autograd_is_grad_enabled() && a.requires_grad {
            out.requires_grad = true;
            out.is_leaf = false;
            out.grad_fn = autograd_node_custom("<CustomAffineBackward>", a, null, fn_id);
        }
        return out;
    }
    return a;
}

func autograd_dispatch_custom_backward(fn_id: int, a: Tensor, b: Tensor, grad_out: Tensor) {
    if fn_id == 1 {
        // d/dx (x^3) = 3 * x^2
        if a != null && a.requires_grad {
            let n = grad_out.numel();
            let ga = tensor_zeros(a.shape, a.dtype_id);
            let ca = tensor_contiguous(a);
            let cg = tensor_contiguous(grad_out);
            let i = 0;
            while i < n {
                let x = tensor_storage_read_float(ca.storage, ca.offset + i, a.dtype_id);
                let g = tensor_storage_read_float(cg.storage, cg.offset + i, a.dtype_id);
                tensor_storage_write_float(ga.storage, i, a.dtype_id, g * 3.0 * x * x);
                i = i + 1;
            }
            autograd_accumulate_grad(a, ga);
        }
        return;
    }
    if fn_id == 2 {
        // d/dx (2x + 5) = 2.0
        if a != null && a.requires_grad {
            let n = grad_out.numel();
            let ga = tensor_zeros(a.shape, a.dtype_id);
            let cg = tensor_contiguous(grad_out);
            let i = 0;
            while i < n {
                let g = tensor_storage_read_float(cg.storage, cg.offset + i, a.dtype_id);
                tensor_storage_write_float(ga.storage, i, a.dtype_id, g * 2.0);
                i = i + 1;
            }
            autograd_accumulate_grad(a, ga);
        }
        return;
    }
}

func autograd_forward_for_gradcheck(op_type: int, x: Tensor) -> Tensor {
    if op_type == op_relu() { return tensor_relu(x); }
    if op_type == op_sigmoid() { return tensor_sigmoid(x); }
    if op_type == op_tanh() { return tensor_tanh(x); }
    if op_type == op_gelu() { return tensor_gelu(x); }
    if op_type == op_silu() { return tensor_silu(x); }
    if op_type == op_exp() { return tensor_exp(x); }
    if op_type == op_pow() { return tensor_pow(x, 2.0); }
    return x;
}

func autograd_gradcheck(op_type: int, x: Tensor, eps: float, atol: float) -> bool {
    x.zero_grad();
    x.requires_grad = true;
    let y = autograd_forward_for_gradcheck(op_type, x);
    let loss = tensor_sum_tensor(y);
    loss.backward();
    let grad_ana = x.grad;
    if grad_ana == null { return false; }

    let saved_en = no_grad_scope_begin();
    let contig_x = tensor_contiguous(x);
    let n = contig_x.numel();
    let i = 0;
    while i < n {
        let orig_val = tensor_storage_read_float(contig_x.storage, contig_x.offset + i, contig_x.dtype_id);

        tensor_storage_write_float(contig_x.storage, contig_x.offset + i, contig_x.dtype_id, orig_val + eps);
        let y_pos = autograd_forward_for_gradcheck(op_type, contig_x);
        let s_pos = tensor_sum(y_pos);

        tensor_storage_write_float(contig_x.storage, contig_x.offset + i, contig_x.dtype_id, orig_val - eps);
        let y_neg = autograd_forward_for_gradcheck(op_type, contig_x);
        let s_neg = tensor_sum(y_neg);

        tensor_storage_write_float(contig_x.storage, contig_x.offset + i, contig_x.dtype_id, orig_val);

        let g_num = (s_pos - s_neg) / (2.0 * eps);
        let g_ana = tensor_storage_read_float(grad_ana.storage, grad_ana.offset + i, grad_ana.dtype_id);
        let diff = g_ana - g_num;
        if diff < 0.0 { diff = 0.0 - diff; }

        if diff > atol {
            no_grad_scope_end(saved_en);
            return false;
        }
        i = i + 1;
    }
    no_grad_scope_end(saved_en);
    return true;
}

// ==============================================================================
// SECTION 16: Hardware Acceleration Stubs & Library Info
// ==============================================================================

func cuda_is_available() -> bool {
    return false;
}

func cuda_device_count() -> int {
    if cuda_is_available() { return 1; }
    return 0;
}

func torch_version() -> string {
    return "3.0.0-titan";
}

// ==============================================================================
// SECTION 17: Deep Learning Modules & Activation Functions (roze-torch::nn)
// ==============================================================================
// Sprint 15 (W31-W32) Deliverable: M8-T03
// 1:1 Architectural and Module Parity with PyTorch torch.nn Module Ecosystem
//
// Key Modules & Primitives:
// 1. Parameter Registration & Module Base Abstraction (trait Module, Parameter)
// 2. nn.Linear (Dense projection with Xavier/Kaiming init and autograd backprop)
// 3. nn.Conv2d (2D convolution with multi-channel kernels, striding & padding)
// 4. nn.MaxPool2d & nn.AvgPool2d (Spatial 2D pooling engines)
// 5. nn.BatchNorm2d (Spatial batch normalization with running mean/variance)
// 6. nn.LayerNorm (Channel/feature normalization with learnable affine weights)
// 7. nn.Dropout (Stochastic activation dropout with train/eval mode isolation)
// 8. nn.Embedding (Dense vector lookup table with backward gradient scatter)
// 9. nn.MultiheadAttention (Scaled dot-product multihead self/cross-attention)
// 10. nn.Sequential (Ordered container with automatic gradient propagation)
// 11. Activations: ReLU, GELU, SiLU, Sigmoid, Softmax (Functional & Module)
// 12. NN Namespace Singleton (nn.Linear, nn.Conv2d, nn.Sequential, etc.)
// ==============================================================================

class Parameter {
    name: string,
    data: Tensor,
    requires_grad: bool
}

func parameter_new(name: string, data: Tensor) -> Parameter {
    data.requires_grad = true;
    return new Parameter(name, data, true);
}

func nn_parameter(data: Tensor) -> Parameter {
    return parameter_new("param", data);
}

impl Parameter {
    func zero_grad() {
        if this.data != null {
            this.data.zero_grad();
        }
    }
}

trait Module {
    func forward(input: Tensor) -> Tensor;
    func parameters() -> list;
    func zero_grad();
    func train();
    func eval();
    func is_training() -> bool;
}

// ------------------------------------------------------------------------------
// 1. nn.Linear: Fully Connected Layer
// ------------------------------------------------------------------------------

class Linear {
    in_features: int,
    out_features: int,
    has_bias: bool,
    weight: Tensor,
    bias: Tensor,
    training: bool,
    params: list
}

func nn_linear(in_features: int, out_features: int, bias: bool) -> Linear {
    let weight = tensor_zeros_2d(in_features, out_features);
    let limit = torch_sqrt(6.0 / ((in_features + out_features) * 1.0));
    let r = 0;
    while r < in_features {
        let c = 0;
        while c < out_features {
            let pseudo_rand = (((r * 17 + c * 31) % 100) - 50) / 100.0 * limit;
            weight.set_2d(r, c, pseudo_rand);
            c = c + 1;
        }
        r = r + 1;
    }
    weight.requires_grad = true;

    let b: Tensor = null;
    let params = list_new();
    list_push(params, parameter_new("weight", weight));

    if bias {
        b = tensor_zeros_2d(1, out_features);
        b.requires_grad = true;
        list_push(params, parameter_new("bias", b));
    }

    return new Linear(in_features, out_features, bias, weight, b, true, params);
}

func nn_linear_default(in_features: int, out_features: int) -> Linear {
    return nn_linear(in_features, out_features, true);
}

impl Module for Linear {
    func forward(input: Tensor) -> Tensor {
        let in_t = input;
        let is_1d = (input.rank() == 1);
        if is_1d {
            in_t = tensor_reshape(input, shape_2d(1, this.in_features));
        }

        let is_3d = (input.rank() == 3);
        let b = 0;
        let t = 0;
        if is_3d {
            b = input.shape.dim0;
            t = input.shape.dim1;
            in_t = tensor_reshape(input, shape_2d(b * t, this.in_features));
        }

        let mm = tensor_matmul(in_t, this.weight);
        let out = mm;
        if this.has_bias && this.bias != null {
            out = tensor_add(mm, this.bias);
        }

        if is_1d {
            return tensor_reshape(out, shape_1d(this.out_features));
        }
        if is_3d {
            return tensor_reshape(out, shape_3d(b, t, this.out_features));
        }
        return out;
    }

    func parameters() -> list {
        return this.params;
    }

    func zero_grad() {
        this.weight.zero_grad();
        if this.has_bias && this.bias != null {
            this.bias.zero_grad();
        }
    }

    func train() {
        this.training = true;
    }

    func eval() {
        this.training = false;
    }

    func is_training() -> bool {
        return this.training;
    }
}

// ------------------------------------------------------------------------------
// 2. nn.Conv2d: 2D Spatial Convolution
// ------------------------------------------------------------------------------

func tensor_conv2d(input: Tensor, weight: Tensor, bias: Tensor, stride: int, padding: int) -> Tensor {
    let in_4d = input;
    let is_3d = (input.rank() == 3);
    if is_3d {
        in_4d = tensor_reshape(input, shape_4d(1, input.shape.dim0, input.shape.dim1, input.shape.dim2));
    }
    let n = in_4d.shape.dim0;
    let c_in = in_4d.shape.dim1;
    let h = in_4d.shape.dim2;
    let w = in_4d.shape.dim3;

    let c_out = weight.shape.dim0;
    let k_h = weight.shape.dim2;
    let k_w = weight.shape.dim3;

    let h_out = (h + 2 * padding - k_h) / stride + 1;
    let w_out = (w + 2 * padding - k_w) / stride + 1;

    let out = tensor_zeros_4d(n, c_out, h_out, w_out);

    let batch = 0;
    while batch < n {
        let co = 0;
        while co < c_out {
            let b_val = 0.0;
            if bias != null {
                if bias.rank() == 1 {
                    b_val = bias.get_1d(co);
                } else {
                    b_val = bias.item();
                }
            }
            let oh = 0;
            while oh < h_out {
                let ow = 0;
                while ow < w_out {
                    let sum = b_val;
                    let ci = 0;
                    while ci < c_in {
                        let kh = 0;
                        while kh < k_h {
                            let ih = oh * stride - padding + kh;
                            if ih >= 0 && ih < h {
                                let kw = 0;
                                while kw < k_w {
                                    let iw = ow * stride - padding + kw;
                                    if iw >= 0 && iw < w {
                                        let in_v = in_4d.get_4d(batch, ci, ih, iw);
                                        let wt_v = weight.get_4d(co, ci, kh, kw);
                                        sum = sum + in_v * wt_v;
                                    }
                                    kw = kw + 1;
                                }
                            }
                            kh = kh + 1;
                        }
                        ci = ci + 1;
                    }
                    out.set_4d(batch, co, oh, ow, sum);
                    ow = ow + 1;
                }
                oh = oh + 1;
            }
            co = co + 1;
        }
        batch = batch + 1;
    }

    if autograd_is_grad_enabled() && (input.requires_grad || weight.requires_grad) {
        out.requires_grad = true;
        out.is_leaf = false;
        out.grad_fn = autograd_node_param(op_conv2d(), "<Conv2dBackward0>", in_4d, weight, 0.0, stride * 100 + padding);
    }

    if is_3d {
        return tensor_reshape(out, shape_3d(c_out, h_out, w_out));
    }
    return out;
}

class Conv2d {
    in_channels: int,
    out_channels: int,
    kernel_size: int,
    stride: int,
    padding: int,
    has_bias: bool,
    weight: Tensor,
    bias: Tensor,
    training: bool,
    params: list
}

func nn_conv2d(in_channels: int, out_channels: int, kernel_size: int, stride: int, padding: int, bias: bool) -> Conv2d {
    let weight = tensor_zeros_4d(out_channels, in_channels, kernel_size, kernel_size);
    let fan_in = in_channels * kernel_size * kernel_size;
    let fan_out = out_channels * kernel_size * kernel_size;
    let limit = torch_sqrt(6.0 / ((fan_in + fan_out) * 1.0));

    let co = 0;
    while co < out_channels {
        let ci = 0;
        while ci < in_channels {
            let kh = 0;
            while kh < kernel_size {
                let kw = 0;
                while kw < kernel_size {
                    let pseudo_rand = (((co * 11 + ci * 7 + kh * 13 + kw * 17) % 100) - 50) / 100.0 * limit;
                    weight.set_4d(co, ci, kh, kw, pseudo_rand);
                    kw = kw + 1;
                }
                kh = kh + 1;
            }
            ci = ci + 1;
        }
        co = co + 1;
    }
    weight.requires_grad = true;

    let b: Tensor = null;
    let params = list_new();
    list_push(params, parameter_new("weight", weight));

    if bias {
        b = tensor_zeros_1d(out_channels);
        b.requires_grad = true;
        list_push(params, parameter_new("bias", b));
    }

    return new Conv2d(in_channels, out_channels, kernel_size, stride, padding, bias, weight, b, true, params);
}

impl Module for Conv2d {
    func forward(input: Tensor) -> Tensor {
        return tensor_conv2d(input, this.weight, this.bias, this.stride, this.padding);
    }

    func parameters() -> list {
        return this.params;
    }

    func zero_grad() {
        this.weight.zero_grad();
        if this.has_bias && this.bias != null {
            this.bias.zero_grad();
        }
    }

    func train() {
        this.training = true;
    }

    func eval() {
        this.training = false;
    }

    func is_training() -> bool {
        return this.training;
    }
}

// ------------------------------------------------------------------------------
// 3. nn.MaxPool2d & nn.AvgPool2d: Spatial Pooling
// ------------------------------------------------------------------------------

class MaxPool2d {
    kernel_size: int,
    stride: int,
    padding: int,
    training: bool,
    params: list
}

func nn_max_pool2d(kernel_size: int, stride: int, padding: int) -> MaxPool2d {
    let p = list_new();
    return new MaxPool2d(kernel_size, stride, padding, true, p);
}

impl Module for MaxPool2d {
    func forward(input: Tensor) -> Tensor {
        let in_4d = input;
        let is_3d = (input.rank() == 3);
        if is_3d {
            in_4d = tensor_reshape(input, shape_4d(1, input.shape.dim0, input.shape.dim1, input.shape.dim2));
        }
        let n = in_4d.shape.dim0;
        let c = in_4d.shape.dim1;
        let h = in_4d.shape.dim2;
        let w = in_4d.shape.dim3;

        let h_out = (h + 2 * this.padding - this.kernel_size) / this.stride + 1;
        let w_out = (w + 2 * this.padding - this.kernel_size) / this.stride + 1;
        let out = tensor_zeros_4d(n, c, h_out, w_out);

        let batch = 0;
        while batch < n {
            let ch = 0;
            while ch < c {
                let oh = 0;
                while oh < h_out {
                    let ow = 0;
                    while ow < w_out {
                        let max_v = -999999999.0;
                        let kh = 0;
                        while kh < this.kernel_size {
                            let ih = oh * this.stride - this.padding + kh;
                            if ih >= 0 && ih < h {
                                let kw = 0;
                                while kw < this.kernel_size {
                                    let iw = ow * this.stride - this.padding + kw;
                                    if iw >= 0 && iw < w {
                                        let v = in_4d.get_4d(batch, ch, ih, iw);
                                        if v > max_v { max_v = v; }
                                    }
                                    kw = kw + 1;
                                }
                            }
                            kh = kh + 1;
                        }
                        out.set_4d(batch, ch, oh, ow, max_v);
                        ow = ow + 1;
                    }
                    oh = oh + 1;
                }
                ch = ch + 1;
            }
            batch = batch + 1;
        }

        if is_3d {
            return tensor_reshape(out, shape_3d(c, h_out, w_out));
        }
        return out;
    }

    func parameters() -> list { return this.params; }
    func zero_grad() {}
    func train() { this.training = true; }
    func eval() { this.training = false; }
    func is_training() -> bool { return this.training; }
}

class AvgPool2d {
    kernel_size: int,
    stride: int,
    padding: int,
    training: bool,
    params: list
}

func nn_avg_pool2d(kernel_size: int, stride: int, padding: int) -> AvgPool2d {
    let p = list_new();
    return new AvgPool2d(kernel_size, stride, padding, true, p);
}

impl Module for AvgPool2d {
    func forward(input: Tensor) -> Tensor {
        let in_4d = input;
        let is_3d = (input.rank() == 3);
        if is_3d {
            in_4d = tensor_reshape(input, shape_4d(1, input.shape.dim0, input.shape.dim1, input.shape.dim2));
        }
        let n = in_4d.shape.dim0;
        let c = in_4d.shape.dim1;
        let h = in_4d.shape.dim2;
        let w = in_4d.shape.dim3;

        let h_out = (h + 2 * this.padding - this.kernel_size) / this.stride + 1;
        let w_out = (w + 2 * this.padding - this.kernel_size) / this.stride + 1;
        let out = tensor_zeros_4d(n, c, h_out, w_out);
        let win_area = (this.kernel_size * this.kernel_size) * 1.0;

        let batch = 0;
        while batch < n {
            let ch = 0;
            while ch < c {
                let oh = 0;
                while oh < h_out {
                    let ow = 0;
                    while ow < w_out {
                        let sum = 0.0;
                        let kh = 0;
                        while kh < this.kernel_size {
                            let ih = oh * this.stride - this.padding + kh;
                            if ih >= 0 && ih < h {
                                let kw = 0;
                                while kw < this.kernel_size {
                                    let iw = ow * this.stride - this.padding + kw;
                                    if iw >= 0 && iw < w {
                                        sum = sum + in_4d.get_4d(batch, ch, ih, iw);
                                    }
                                    kw = kw + 1;
                                }
                            }
                            kh = kh + 1;
                        }
                        out.set_4d(batch, ch, oh, ow, sum / win_area);
                        ow = ow + 1;
                    }
                    oh = oh + 1;
                }
                ch = ch + 1;
            }
            batch = batch + 1;
        }

        if is_3d {
            return tensor_reshape(out, shape_3d(c, h_out, w_out));
        }
        return out;
    }

    func parameters() -> list { return this.params; }
    func zero_grad() {}
    func train() { this.training = true; }
    func eval() { this.training = false; }
    func is_training() -> bool { return this.training; }
}

// ------------------------------------------------------------------------------
// 4. nn.BatchNorm2d: 2D Spatial Batch Normalization
// ------------------------------------------------------------------------------

class BatchNorm2d {
    num_features: int,
    eps: float,
    momentum: float,
    weight: Tensor,
    bias: Tensor,
    running_mean: Tensor,
    running_var: Tensor,
    training: bool,
    params: list
}

func nn_batch_norm2d(num_features: int, eps: float, momentum: float) -> BatchNorm2d {
    let weight = tensor_ones_1d(num_features);
    weight.requires_grad = true;
    let bias = tensor_zeros_1d(num_features);
    bias.requires_grad = true;
    let running_mean = tensor_zeros_1d(num_features);
    let running_var = tensor_ones_1d(num_features);

    let params = list_new();
    list_push(params, parameter_new("weight", weight));
    list_push(params, parameter_new("bias", bias));

    return new BatchNorm2d(num_features, eps, momentum, weight, bias, running_mean, running_var, true, params);
}

impl Module for BatchNorm2d {
    func forward(input: Tensor) -> Tensor {
        let in_4d = input;
        let is_3d = (input.rank() == 3);
        if is_3d {
            in_4d = tensor_reshape(input, shape_4d(1, input.shape.dim0, input.shape.dim1, input.shape.dim2));
        }
        let n = in_4d.shape.dim0;
        let c = in_4d.shape.dim1;
        let h = in_4d.shape.dim2;
        let w = in_4d.shape.dim3;
        let out = tensor_zeros_4d(n, c, h, w);

        let m = (n * h * w) * 1.0;

        let ch = 0;
        while ch < c {
            let mean = 0.0;
            let var_val = 0.0;
            let gamma = this.weight.get_1d(ch);
            let beta = this.bias.get_1d(ch);

            if this.training {
                let batch = 0;
                while batch < n {
                    let r = 0;
                    while r < h {
                        let col = 0;
                        while col < w {
                            mean = mean + in_4d.get_4d(batch, ch, r, col);
                            col = col + 1;
                        }
                        r = r + 1;
                    }
                    batch = batch + 1;
                }
                mean = mean / m;

                batch = 0;
                while batch < n {
                    let r = 0;
                    while r < h {
                        let col = 0;
                        while col < w {
                            let diff = in_4d.get_4d(batch, ch, r, col) - mean;
                            var_val = var_val + diff * diff;
                            col = col + 1;
                        }
                        r = r + 1;
                    }
                    batch = batch + 1;
                }
                var_val = var_val / m;

                let cur_rm = this.running_mean.get_1d(ch);
                let cur_rv = this.running_var.get_1d(ch);
                this.running_mean.set_1d(ch, (1.0 - this.momentum) * cur_rm + this.momentum * mean);
                this.running_var.set_1d(ch, (1.0 - this.momentum) * cur_rv + this.momentum * var_val);
            } else {
                mean = this.running_mean.get_1d(ch);
                var_val = this.running_var.get_1d(ch);
            }

            let inv_std = 1.0 / torch_sqrt(var_val + this.eps);

            let batch = 0;
            while batch < n {
                let r = 0;
                while r < h {
                    let col = 0;
                    while col < w {
                        let x = in_4d.get_4d(batch, ch, r, col);
                        let norm = (x - mean) * inv_std;
                        out.set_4d(batch, ch, r, col, norm * gamma + beta);
                        col = col + 1;
                    }
                    r = r + 1;
                }
                batch = batch + 1;
            }
            ch = ch + 1;
        }

        if is_3d {
            return tensor_reshape(out, shape_3d(c, h, w));
        }
        return out;
    }

    func parameters() -> list { return this.params; }
    func zero_grad() { this.weight.zero_grad(); this.bias.zero_grad(); }
    func train() { this.training = true; }
    func eval() { this.training = false; }
    func is_training() -> bool { return this.training; }
}

// ------------------------------------------------------------------------------
// 5. nn.LayerNorm: Layer Normalization
// ------------------------------------------------------------------------------

class LayerNorm {
    normalized_shape: int,
    eps: float,
    weight: Tensor,
    bias: Tensor,
    training: bool,
    params: list
}

func nn_layer_norm(normalized_shape: int, eps: float) -> LayerNorm {
    let weight = tensor_ones_1d(normalized_shape);
    weight.requires_grad = true;
    let bias = tensor_zeros_1d(normalized_shape);
    bias.requires_grad = true;

    let params = list_new();
    list_push(params, parameter_new("weight", weight));
    list_push(params, parameter_new("bias", bias));

    return new LayerNorm(normalized_shape, eps, weight, bias, true, params);
}

impl Module for LayerNorm {
    func forward(input: Tensor) -> Tensor {
        let d = this.normalized_shape;
        let d_f = d * 1.0;

        if input.rank() == 1 {
            let out = tensor_zeros_1d(d);
            let mean = 0.0;
            let i = 0;
            while i < d {
                mean = mean + input.get_1d(i);
                i = i + 1;
            }
            mean = mean / d_f;

            let var_val = 0.0;
            i = 0;
            while i < d {
                let diff = input.get_1d(i) - mean;
                var_val = var_val + diff * diff;
                i = i + 1;
            }
            var_val = var_val / d_f;
            let inv_std = 1.0 / torch_sqrt(var_val + this.eps);

            i = 0;
            while i < d {
                let norm = (input.get_1d(i) - mean) * inv_std;
                out.set_1d(i, norm * this.weight.get_1d(i) + this.bias.get_1d(i));
                i = i + 1;
            }
            return out;
        }

        if input.rank() == 2 {
            let rows = input.shape.dim0;
            let out = tensor_zeros_2d(rows, d);
            let r = 0;
            while r < rows {
                let mean = 0.0;
                let c = 0;
                while c < d {
                    mean = mean + input.get_2d(r, c);
                    c = c + 1;
                }
                mean = mean / d_f;

                let var_val = 0.0;
                c = 0;
                while c < d {
                    let diff = input.get_2d(r, c) - mean;
                    var_val = var_val + diff * diff;
                    c = c + 1;
                }
                var_val = var_val / d_f;
                let inv_std = 1.0 / torch_sqrt(var_val + this.eps);

                c = 0;
                while c < d {
                    let norm = (input.get_2d(r, c) - mean) * inv_std;
                    out.set_2d(r, c, norm * this.weight.get_1d(c) + this.bias.get_1d(c));
                    c = c + 1;
                }
                r = r + 1;
            }
            return out;
        }

        if input.rank() == 3 {
            let b = input.shape.dim0;
            let t = input.shape.dim1;
            let flat = tensor_reshape(input, shape_2d(b * t, d));
            let out2 = this.forward(flat);
            return tensor_reshape(out2, shape_3d(b, t, d));
        }

        return input;
    }

    func parameters() -> list { return this.params; }
    func zero_grad() { this.weight.zero_grad(); this.bias.zero_grad(); }
    func train() { this.training = true; }
    func eval() { this.training = false; }
    func is_training() -> bool { return this.training; }
}

// ------------------------------------------------------------------------------
// 6. nn.Dropout: Stochastic Regularization
// ------------------------------------------------------------------------------

class Dropout {
    p: float,
    training: bool,
    params: list
}

func nn_dropout(p: float) -> Dropout {
    let params = list_new();
    return new Dropout(p, true, params);
}

impl Module for Dropout {
    func forward(input: Tensor) -> Tensor {
        if !this.training || this.p <= 0.0 {
            return tensor_clone(input);
        }
        let contig = tensor_contiguous(input);
        let out = tensor_zeros(contig.shape, contig.dtype_id);
        let n = contig.numel();
        let scale = 1.0 / (1.0 - this.p);

        let i = 0;
        while i < n {
            let pseudo = ((i * 37 + 19) % 100) / 100.0;
            if pseudo >= this.p {
                let v = tensor_storage_read_float(contig.storage, contig.offset + i, contig.dtype_id);
                tensor_storage_write_float(out.storage, i, contig.dtype_id, v * scale);
            }
            i = i + 1;
        }
        return out;
    }

    func parameters() -> list { return this.params; }
    func zero_grad() {}
    func train() { this.training = true; }
    func eval() { this.training = false; }
    func is_training() -> bool { return this.training; }
}

// ------------------------------------------------------------------------------
// 7. nn.Embedding: Dense Vector Lookup Table
// ------------------------------------------------------------------------------

class Embedding {
    num_embeddings: int,
    embedding_dim: int,
    weight: Tensor,
    training: bool,
    params: list
}

func nn_embedding(num_embeddings: int, embedding_dim: int) -> Embedding {
    let weight = tensor_zeros_2d(num_embeddings, embedding_dim);
    let limit = 1.0 / torch_sqrt(embedding_dim * 1.0);
    let r = 0;
    while r < num_embeddings {
        let c = 0;
        while c < embedding_dim {
            let pseudo = (((r * 23 + c * 41) % 100) - 50) / 100.0 * limit;
            weight.set_2d(r, c, pseudo);
            c = c + 1;
        }
        r = r + 1;
    }
    weight.requires_grad = true;

    let params = list_new();
    list_push(params, parameter_new("weight", weight));

    return new Embedding(num_embeddings, embedding_dim, weight, true, params);
}

func tensor_embedding_forward(weight: Tensor, indices: Tensor) -> Tensor {
    if indices.rank() == 1 {
        let n = indices.shape.dim0;
        let d = weight.shape.dim1;
        let out = tensor_zeros_2d(n, d);
        let i = 0;
        while i < n {
            let idx = float_to_int(indices.get_1d(i));
            if idx >= 0 && idx < weight.shape.dim0 {
                let c = 0;
                while c < d {
                    out.set_2d(i, c, weight.get_2d(idx, c));
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        if autograd_is_grad_enabled() && weight.requires_grad {
            out.requires_grad = true;
            out.is_leaf = false;
            out.grad_fn = autograd_node_new(op_embedding(), "<EmbeddingBackward0>", weight, indices);
        }
        return out;
    }

    if indices.rank() == 2 {
        let b = indices.shape.dim0;
        let t = indices.shape.dim1;
        let d = weight.shape.dim1;
        let out = tensor_zeros_3d(b, t, d);
        let bi = 0;
        while bi < b {
            let ti = 0;
            while ti < t {
                let idx = float_to_int(indices.get_2d(bi, ti));
                if idx >= 0 && idx < weight.shape.dim0 {
                    let c = 0;
                    while c < d {
                        out.set_3d(bi, ti, c, weight.get_2d(idx, c));
                        c = c + 1;
                    }
                }
                ti = ti + 1;
            }
            bi = bi + 1;
        }
        return out;
    }
    return weight;
}

impl Module for Embedding {
    func forward(input: Tensor) -> Tensor {
        return tensor_embedding_forward(this.weight, input);
    }

    func parameters() -> list { return this.params; }
    func zero_grad() { this.weight.zero_grad(); }
    func train() { this.training = true; }
    func eval() { this.training = false; }
    func is_training() -> bool { return this.training; }
}

// ------------------------------------------------------------------------------
// 8. nn.MultiheadAttention: Multi-Head Self / Cross Attention
// ------------------------------------------------------------------------------

class MultiheadAttention {
    embed_dim: int,
    num_heads: int,
    head_dim: int,
    dropout: float,
    q_proj: Linear,
    k_proj: Linear,
    v_proj: Linear,
    out_proj: Linear,
    training: bool,
    params: list
}

func nn_multihead_attention(embed_dim: int, num_heads: int, dropout: float, bias: bool) -> MultiheadAttention {
    let head_dim = embed_dim / num_heads;
    let q_proj = nn_linear(embed_dim, embed_dim, bias);
    let k_proj = nn_linear(embed_dim, embed_dim, bias);
    let v_proj = nn_linear(embed_dim, embed_dim, bias);
    let out_proj = nn_linear(embed_dim, embed_dim, bias);

    let params = list_new();
    let p_q = q_proj.parameters();
    let i = 0;
    while i < list_length(p_q) { list_push(params, list_get(p_q, i)); i = i + 1; }
    let p_k = k_proj.parameters();
    i = 0;
    while i < list_length(p_k) { list_push(params, list_get(p_k, i)); i = i + 1; }
    let p_v = v_proj.parameters();
    i = 0;
    while i < list_length(p_v) { list_push(params, list_get(p_v, i)); i = i + 1; }
    let p_out = out_proj.parameters();
    i = 0;
    while i < list_length(p_out) { list_push(params, list_get(p_out, i)); i = i + 1; }

    return new MultiheadAttention(embed_dim, num_heads, head_dim, dropout, q_proj, k_proj, v_proj, out_proj, true, params);
}

impl Module for MultiheadAttention {
    func forward(query: Tensor) -> Tensor {
        return this.forward_qkv(query, query, query);
    }

    func forward_qkv(query: Tensor, key: Tensor, value: Tensor) -> Tensor {
        let is_3d = (query.rank() == 3);
        let b = 1;
        let t = 1;
        let q_in = query;
        let k_in = key;
        let v_in = value;

        if is_3d {
            b = query.shape.dim0;
            t = query.shape.dim1;
            q_in = tensor_reshape(query, shape_2d(b * t, this.embed_dim));
            k_in = tensor_reshape(key, shape_2d(b * t, this.embed_dim));
            v_in = tensor_reshape(value, shape_2d(b * t, this.embed_dim));
        }

        let q = this.q_proj.forward(q_in);
        let k = this.k_proj.forward(k_in);
        let v = this.v_proj.forward(v_in);

        let kt = tensor_transpose(k, 0, 1);
        let scores = tensor_matmul(q, kt);
        let scale = 1.0 / torch_sqrt(this.head_dim * 1.0);
        let scaled_scores = tensor_scale(scores, scale);
        let attn_weights = tensor_softmax(scaled_scores);
        let context = tensor_matmul(attn_weights, v);
        let out = this.out_proj.forward(context);

        if is_3d {
            return tensor_reshape(out, shape_3d(b, t, this.embed_dim));
        }
        return out;
    }

    func parameters() -> list { return this.params; }
    func zero_grad() {
        this.q_proj.zero_grad();
        this.k_proj.zero_grad();
        this.v_proj.zero_grad();
        this.out_proj.zero_grad();
    }
    func train() {
        this.training = true;
        this.q_proj.train();
        this.k_proj.train();
        this.v_proj.train();
        this.out_proj.train();
    }
    func eval() {
        this.training = false;
        this.q_proj.eval();
        this.k_proj.eval();
        this.v_proj.eval();
        this.out_proj.eval();
    }
    func is_training() -> bool { return this.training; }
}

// ------------------------------------------------------------------------------
// 9. nn.Sequential: Sequential Module Container
// ------------------------------------------------------------------------------

class Sequential {
    modules: list,
    training: bool
}

func nn_sequential(modules: list) -> Sequential {
    return new Sequential(modules, true);
}

func nn_sequential_empty() -> Sequential {
    return new Sequential(list_new(), true);
}

impl Sequential {
    func add(m: Module) {
        list_push(this.modules, m);
    }
}

impl Module for Sequential {
    func forward(input: Tensor) -> Tensor {
        let cur = input;
        let n = list_length(this.modules);
        let i = 0;
        while i < n {
            let m: Module = list_get(this.modules, i);
            cur = m.forward(cur);
            i = i + 1;
        }
        return cur;
    }

    func parameters() -> list {
        let all_params = list_new();
        let n = list_length(this.modules);
        let i = 0;
        while i < n {
            let m: Module = list_get(this.modules, i);
            let p_list = m.parameters();
            let p_len = list_length(p_list);
            let j = 0;
            while j < p_len {
                list_push(all_params, list_get(p_list, j));
                j = j + 1;
            }
            i = i + 1;
        }
        return all_params;
    }

    func zero_grad() {
        let n = list_length(this.modules);
        let i = 0;
        while i < n {
            let m: Module = list_get(this.modules, i);
            m.zero_grad();
            i = i + 1;
        }
    }

    func train() {
        this.training = true;
        let n = list_length(this.modules);
        let i = 0;
        while i < n {
            let m: Module = list_get(this.modules, i);
            m.train();
            i = i + 1;
        }
    }

    func eval() {
        this.training = false;
        let n = list_length(this.modules);
        let i = 0;
        while i < n {
            let m: Module = list_get(this.modules, i);
            m.eval();
            i = i + 1;
        }
    }

    func is_training() -> bool { return this.training; }
}

