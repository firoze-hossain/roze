// ==============================================================================
// 🌹 RozeBoot Core - Advanced Inversion of Control & Metaprogramming (M10-T01)
// ==============================================================================
// 1:1 Architectural Parity with Spring Framework 6 / Spring Boot 3 Core Container
//
// Key Subsystems:
// 1. Stereotype & Metaprogramming Annotations (@Component, @Service, @Repository,
//    @Controller, @RestController, @Configuration, @Bean, @Autowired, @Qualifier,
//    @Value, @Scope, @PostConstruct, @PreDestroy, @Primary, @Lazy, @Order, @Profile,
//    @ConditionalOnProperty, @ConditionalOnMissingBean, @ConditionalOnBean)
// 2. Hierarchical Environment & Dynamic Property Placeholder Resolution (${prop:default})
// 3. Conditional Bean Evaluation Engine (Property, Missing Bean, On Bean, Profile)
// 4. Advanced BeanDefinition Model & Metadata Registry
// 5. Kahn's Directed Acyclic Graph (DAG) Topological Dependency Graph Resolution
// 6. Depth-First Circular Dependency Detection with Cycle Diagnostics
// 7. Full Bean Lifecycle Management (Eager Singleton Caching vs Prototype Factories)
// 8. Application Event Bus & Event Listeners (ContextRefreshed, ContextClosed)
// ==============================================================================

// ==============================================================================
// SECTION 1: Fundamental Constants & String Utilities
// ==============================================================================

// Bean Scopes
func scope_singleton() -> int { return 1; }
func scope_prototype() -> int { return 2; }

// Bean Lifecycle States
func bean_state_uninstantiated() -> int { return 0; }
func bean_state_instantiating() -> int { return 1; }
func bean_state_instantiated() -> int { return 2; }
func bean_state_initialized() -> int { return 3; }
func bean_state_destroyed() -> int { return 4; }

// Safe ASCII Char Converter (0-127)
func ioc_ascii_char(code: int) -> string {
    if code >= 97 && code <= 122 {
        if code == 97 { return "a"; } if code == 98 { return "b"; }
        if code == 99 { return "c"; } if code == 100 { return "d"; }
        if code == 101 { return "e"; } if code == 102 { return "f"; }
        if code == 103 { return "g"; } if code == 104 { return "h"; }
        if code == 105 { return "i"; } if code == 106 { return "j"; }
        if code == 107 { return "k"; } if code == 108 { return "l"; }
        if code == 109 { return "m"; } if code == 110 { return "n"; }
        if code == 111 { return "o"; } if code == 112 { return "p"; }
        if code == 113 { return "q"; } if code == 114 { return "r"; }
        if code == 115 { return "s"; } if code == 116 { return "t"; }
        if code == 117 { return "u"; } if code == 118 { return "v"; }
        if code == 119 { return "w"; } if code == 120 { return "x"; }
        if code == 121 { return "y"; } if code == 122 { return "z"; }
    }
    if code >= 65 && code <= 90 {
        if code == 65 { return "A"; } if code == 66 { return "B"; }
        if code == 67 { return "C"; } if code == 68 { return "D"; }
        if code == 69 { return "E"; } if code == 70 { return "F"; }
        if code == 71 { return "G"; } if code == 72 { return "H"; }
        if code == 73 { return "I"; } if code == 74 { return "J"; }
        if code == 75 { return "K"; } if code == 76 { return "L"; }
        if code == 77 { return "M"; } if code == 78 { return "N"; }
        if code == 79 { return "O"; } if code == 80 { return "P"; }
        if code == 81 { return "Q"; } if code == 82 { return "R"; }
        if code == 83 { return "S"; } if code == 84 { return "T"; }
        if code == 85 { return "U"; } if code == 86 { return "V"; }
        if code == 87 { return "W"; } if code == 88 { return "X"; }
        if code == 89 { return "Y"; } if code == 90 { return "Z"; }
    }
    if code >= 48 && code <= 57 {
        if code == 48 { return "0"; } if code == 49 { return "1"; }
        if code == 50 { return "2"; } if code == 51 { return "3"; }
        if code == 52 { return "4"; } if code == 53 { return "5"; }
        if code == 54 { return "6"; } if code == 55 { return "7"; }
        if code == 56 { return "8"; } if code == 57 { return "9"; }
    }
    if code == 32 { return " "; }
    if code == 33 { return "!"; }
    if code == 34 { return "\""; }
    if code == 35 { return "#"; }
    if code == 36 { return "$"; }
    if code == 37 { return "%"; }
    if code == 38 { return "&"; }
    if code == 39 { return "'"; }
    if code == 40 { return "("; }
    if code == 41 { return ")"; }
    if code == 42 { return "*"; }
    if code == 43 { return "+"; }
    if code == 44 { return ","; }
    if code == 45 { return "-"; }
    if code == 46 { return "."; }
    if code == 47 { return "/"; }
    if code == 58 { return ":"; }
    if code == 59 { return ";"; }
    if code == 60 { return "<"; }
    if code == 61 { return "="; }
    if code == 62 { return ">"; }
    if code == 63 { return "?"; }
    if code == 64 { return "@"; }
    if code == 91 { return "["; }
    if code == 92 { return "\\"; }
    if code == 93 { return "]"; }
    if code == 94 { return "^"; }
    if code == 95 { return "_"; }
    if code == 96 { return "`"; }
    if code == 123 { return "{"; }
    if code == 124 { return "|"; }
    if code == 125 { return "}"; }
    if code == 126 { return "~"; }
    if code == 10 { return "\n"; }
    if code == 13 { return "\r"; }
    if code == 9 { return "\t"; }
    return "?";
}

func ioc_sub_str(s: string, start: int, end: int) -> string {
    let s_len = string_length(s);
    if start < 0 { start = 0; }
    if end > s_len { end = s_len; }
    if start >= end { return ""; }
    let res = "";
    let i = start;
    while i < end {
        let c: int = string_char_at(s, i);
        res = res + ioc_ascii_char(c);
        i = i + 1;
    }
    return res;
}

func ioc_str_starts_with(s: string, prefix: string) -> bool {
    let s_len = string_length(s);
    let p_len = string_length(prefix);
    if p_len > s_len { return false; }
    let sub = ioc_sub_str(s, 0, p_len);
    return sub == prefix;
}

func ioc_str_contains(s: string, sub: string) -> bool {
    let s_len = string_length(s);
    let sub_len = string_length(sub);
    if sub_len == 0 { return true; }
    if sub_len > s_len { return false; }
    let i = 0;
    while i <= s_len - sub_len {
        let chunk = ioc_sub_str(s, i, i + sub_len);
        if chunk == sub {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func ioc_str_index_of(s: string, sub: string) -> int {
    let s_len = string_length(s);
    let sub_len = string_length(sub);
    if sub_len == 0 { return 0; }
    if sub_len > s_len { return -1; }
    let i = 0;
    while i <= s_len - sub_len {
        let chunk = ioc_sub_str(s, i, i + sub_len);
        if chunk == sub {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func ioc_int_to_str(val: int) -> string {
    if val == 0 { return "0"; }
    let mut_val = val;
    let is_neg = false;
    if mut_val < 0 {
        is_neg = true;
        mut_val = 0 - mut_val;
    }
    let res = "";
    while mut_val > 0 {
        let digit = mut_val % 10;
        let c = ioc_ascii_char(48 + digit);
        res = c + res;
        mut_val = mut_val / 10;
    }
    if is_neg {
        res = "-" + res;
    }
    return res;
}

