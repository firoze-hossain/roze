// ==============================================================================
// 🌹 Roze Self-Hosted Compiler: Mach-O 64-bit Emitter (M6-T04)
// ==============================================================================
// Emits macOS Mach-O 64-bit relocatable object files (MH_OBJECT):
// - mach_header_64 (magic 0xfeedfacf, CPU_TYPE_X86_64)
// - LC_SEGMENT_64 with __text and __data sections
// - LC_SYMTAB with nlist_64 symbol table and string table
// ==============================================================================

func emit_macho_object(prog: AstNode, out_path: string) -> int {
    let text_bb = bb_new();
    let data_bb = bb_new();
    let sym_head = new NativeSymbol("", 0, 0, 0, 0, 0, null);
    let sym_tail = sym_head;
    let sym_count = 0;

    let decl = prog.child1;
    while decl != null {
        if decl.kind == NODE_FUNC_DECL() {
            let func_start = text_bb.size;
            emit_func_x86(decl, text_bb);
            let func_size = text_bb.size - func_start;

            let sym = new NativeSymbol("_" + decl.name, func_start, func_size, 1, 2, 1, null);
            sym_tail.next = sym;
            sym_tail = sym;
            sym_count = sym_count + 1;
        }
        decl = decl.next;
    }

    if text_bb.size == 0 {
        bb_append_hex(text_bb, "554889e5c9c3", 6);
        let sym = new NativeSymbol("_roze_main", 0, 6, 1, 2, 1, null);
        sym_tail.next = sym;
        sym_tail = sym;
        sym_count = sym_count + 1;
    }

    if data_bb.size == 0 {
        bb_append_str_null(data_bb, "Roze Native v0.1");
    }

    // Build strtab & symtab
    let strtab = bb_new();
    bb_append_u8(strtab, 32); // initial byte
    let symtab = bb_new();

    let cur_sym = sym_head.next;
    while cur_sym != null {
        let name_off = strtab.size;
        bb_append_str_null(strtab, cur_sym.name);

        // struct nlist_64 (16 bytes):
        // n_strx (u32)
        bb_append_u32_le(symtab, name_off);
        // n_type (u8): N_SECT | N_EXT = 0x0e | 0x01 = 0x0f (15)
        bb_append_u8(symtab, 15);
        // n_sect (u8): 1 (__text)
        bb_append_u8(symtab, 1);
        // n_desc (u16): 0
        bb_append_u16_le(symtab, 0);
        // n_value (u64): func offset in __text
        bb_append_u64_le(symtab, cur_sym.value);

        cur_sym = cur_sym.next;
    }

    // Layout:
    // mach_header_64: 32 bytes
    // LC_SEGMENT_64: 72 + 2 * 80 = 232 bytes
    // LC_SYMTAB: 24 bytes
    // Total commands size = 256 bytes
    let off_text = 32 + 256; // 288 = 0x120
    let off_data = off_text + text_bb.size;
    let data_pad = 0;
    if off_data % 8 != 0 {
        data_pad = 8 - (off_data % 8);
        off_data = off_data + data_pad;
    }
    let off_symtab = off_data + data_bb.size;
    let symtab_pad = 0;
    if off_symtab % 8 != 0 {
        symtab_pad = 8 - (off_symtab % 8);
        off_symtab = off_symtab + symtab_pad;
    }
    let off_strtab = off_symtab + symtab.size;

    let macho_file = bb_new();
    // Header (32 bytes):
    // magic: 0xfeedfacf -> cf fa ed fe
    bb_append_hex(macho_file, "cffaedfe", 4);
    // cputype: CPU_TYPE_X86_64 = 0x01000007 -> 07 00 00 01
    bb_append_hex(macho_file, "07000001", 4);
    // cpusubtype: CPU_SUBTYPE_X86_64_ALL = 3
    bb_append_u32_le(macho_file, 3);
    // filetype: MH_OBJECT = 1
    bb_append_u32_le(macho_file, 1);
    // ncmds: 2
    bb_append_u32_le(macho_file, 2);
    // sizeofcmds: 256
    bb_append_u32_le(macho_file, 256);
    // flags: 0
    bb_append_u32_le(macho_file, 0);
    // reserved: 0
    bb_append_u32_le(macho_file, 0);

    // LC_SEGMENT_64 (72 bytes + 2 * 80 = 232 bytes):
    bb_append_u32_le(macho_file, 25); // LC_SEGMENT_64
    bb_append_u32_le(macho_file, 232);
    bb_append_zeroes(macho_file, 16);  // segname
    bb_append_u64_le(macho_file, 0);   // vmaddr
    bb_append_u64_le(macho_file, text_bb.size + data_pad + data_bb.size); // vmsize
    bb_append_u64_le(macho_file, off_text); // fileoff
    bb_append_u64_le(macho_file, text_bb.size + data_pad + data_bb.size); // filesize
    bb_append_u32_le(macho_file, 7);   // maxprot
    bb_append_u32_le(macho_file, 7);   // initprot
    bb_append_u32_le(macho_file, 2);   // nsects
    bb_append_u32_le(macho_file, 0);   // flags

    // Section 1: __text, __TEXT (80 bytes)
    bb_append_str(macho_file, "__text");
    bb_append_zeroes(macho_file, 10);  // pad to 16
    bb_append_str(macho_file, "__TEXT");
    bb_append_zeroes(macho_file, 10);  // pad to 16
    bb_append_u64_le(macho_file, 0);   // addr
    bb_append_u64_le(macho_file, text_bb.size); // size
    bb_append_u32_le(macho_file, off_text);     // offset
    bb_append_u32_le(macho_file, 4);   // align (2^4 = 16)
    bb_append_u32_le(macho_file, 0);   // reloff
    bb_append_u32_le(macho_file, 0);   // nreloc
    bb_append_hex(macho_file, "00040080", 4); // S_ATTR_SOME_INSTRUCTIONS | S_ATTR_PURE_INSTRUCTIONS
    bb_append_zeroes(macho_file, 12);

    // Section 2: __data, __DATA (80 bytes)
    bb_append_str(macho_file, "__data");
    bb_append_zeroes(macho_file, 10);
    bb_append_str(macho_file, "__DATA");
    bb_append_zeroes(macho_file, 10);
    bb_append_u64_le(macho_file, text_bb.size);
    bb_append_u64_le(macho_file, data_bb.size);
    bb_append_u32_le(macho_file, off_data);
    bb_append_u32_le(macho_file, 3);   // align (2^3 = 8)
    bb_append_u32_le(macho_file, 0);
    bb_append_u32_le(macho_file, 0);
    bb_append_u32_le(macho_file, 0);   // S_REGULAR
    bb_append_zeroes(macho_file, 12);

    // LC_SYMTAB (24 bytes)
    bb_append_u32_le(macho_file, 2);   // LC_SYMTAB
    bb_append_u32_le(macho_file, 24);
    bb_append_u32_le(macho_file, off_symtab);
    bb_append_u32_le(macho_file, sym_count);
    bb_append_u32_le(macho_file, off_strtab);
    bb_append_u32_le(macho_file, strtab.size);

    // Data sections:
    bb_append_buffer(macho_file, text_bb);
    bb_append_zeroes(macho_file, data_pad);
    bb_append_buffer(macho_file, data_bb);
    bb_append_zeroes(macho_file, symtab_pad);
    bb_append_buffer(macho_file, symtab);
    bb_append_buffer(macho_file, strtab);

    return bb_write_to_file(macho_file, out_path);
}
