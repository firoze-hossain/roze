// packages/roze-release/tests/test_release.roze
// ==============================================================================
// 🌹 ROZE v3.0 'TITAN' PRODUCTION LAUNCH TEST SUITE
// ==============================================================================

import "roze-release.core";

func assert_true(cond: bool, msg: string) {
    if !cond {
        println("❌ ASSERTION FAILED: " + msg);
        let crash = 1 / 0;
    } else {
        println("✅ " + msg);
    }
}

func assert_eq_int(actual: int, expected: int, msg: string) {
    if actual != expected {
        println("❌ ASSERTION FAILED: " + msg);
        println("   Expected: " + to_string(expected));
        println("   Actual:   " + to_string(actual));
        let crash = 1 / 0;
    } else {
        println("✅ " + msg);
    }
}

func main() {
    println("================================================================================");
    println("🌹 EXECUTING ROZE v3.0 'TITAN' MASTER RELEASE VERIFICATION SUITE");
    println("================================================================================");

    let diag = titan_run_master_verification();
    titan_print_diagnostics_report(diag);

    assert_true(diag.all_passed, "All 10 Universal Computing Domains PASSED");
    assert_eq_int(diag.domains_passed, 10, "10/10 Domains Verified");
    assert_true(diag.assertions_passed >= 20, "Comprehensive Domain Assertions Passed");
    assert_true(diag.release_version == "3.0.0", "Release Version is 3.0.0");
    assert_true(diag.release_codename == "Titan", "Release Codename is Titan");

    println("\n🎉 ROZE v3.0 'TITAN' VERIFICATION COMPLETE: ALL SYSTEMS READY FOR PRODUCTION!");
}
