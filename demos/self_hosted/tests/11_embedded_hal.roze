// ==============================================================================
// 🌹 Roze Self-Hosted Compiler: Embedded HAL & Microcontroller IoT (M6-T08)
// ==============================================================================
// Tests embedded-hal peripheral traits and MMIO operations:
// - GPIO OutputPin, InputPin simulation
// - PWM Duty cycle and channel control
// - UART Serial TX/RX
// - MMIO Bitwise Register manipulation
// ==============================================================================

class MockGpioPin {
    pin_number: int,
    is_high: int
}

func gpio_new(pin: int) -> MockGpioPin {
    return new MockGpioPin(pin, 0);
}

func gpio_set_high(p: MockGpioPin) {
    p.is_high = 1;
}

func gpio_set_low(p: MockGpioPin) {
    p.is_high = 0;
}

func gpio_toggle(p: MockGpioPin) {
    if p.is_high == 1 {
        p.is_high = 0;
    } else {
        p.is_high = 1;
    }
}

class MockUartDevice {
    tx_buffer: string
}

func uart_new() -> MockUartDevice {
    return new MockUartDevice("");
}

func uart_write_byte(u: MockUartDevice, b: int) {
    let ch = rz_int_to_str(b);
    u.tx_buffer = u.tx_buffer + ch + ",";
}

func uart_write_str(u: MockUartDevice, s: string) {
    u.tx_buffer = u.tx_buffer + s;
}

func mock_shift_left(val: int, shift: int) -> int {
    let res = val;
    for let i = 0; i < shift; i = i + 1 {
        res = res * 2;
    }
    return res;
}

func mock_mmio_bit_set(reg: int, bit: int) -> int {
    let mask = mock_shift_left(1, bit);
    return reg + mask;
}

func main() {
    println("🌹 [Microcontroller IoT] Running Embedded-HAL & Peripheral Tests");

    // 1. GPIO Pin Driver Test
    let pin13 = gpio_new(13);
    gpio_set_high(pin13);
    if pin13.is_high != 1 {
        println("❌ GPIO high assertion failed");
    } else {
        println("✅ GPIO Pin 13 set high: OK");
    }

    gpio_toggle(pin13);
    if pin13.is_high != 0 {
        println("❌ GPIO toggle assertion failed");
    } else {
        println("✅ GPIO Pin 13 toggled to low: OK");
    }

    // 2. UART Serial Driver Test
    let uart = uart_new();
    uart_write_str(uart, "ROZE_FIRMWARE_OK:");
    uart_write_byte(uart, 42);
    println("✅ UART TX Output: " + uart.tx_buffer);

    // 3. MMIO Bit Manipulation Tests
    let initial_cr = 0;
    let cr_bit5 = mock_mmio_bit_set(initial_cr, 5);
    if cr_bit5 != 32 {
        println("❌ MMIO bit set failed: expected 32, got " + rz_int_to_str(cr_bit5));
    } else {
        println("✅ MMIO bit set 5 (0x20): OK");
    }

    let cr_bit7 = mock_mmio_bit_set(cr_bit5, 7);
    if cr_bit7 != 160 {
        println("❌ MMIO bit set failed: expected 160, got " + rz_int_to_str(cr_bit7));
    } else {
        println("✅ MMIO bit set 7 (0xA0): OK");
    }

    println("🎉 Embedded-HAL IoT peripheral test suite completed successfully!");
}
