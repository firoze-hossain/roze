// ASCII Char Lookup (0-127)
func web_ascii_char(code: int) -> string {
    if code >= 97 && code <= 122 {
        if code == 97 { return "a"; } if code == 98 { return "b"; }
        if code == 99 { return "c"; } if code == 100 { return "d"; }
        if code == 101 { return "e"; } if code == 102 { return "f"; }
        if code == 103 { return "g"; } if code == 104 { return "h"; }
        if code == 105 { return "i"; } if code == 106 { return "j"; }
        if code == 107 { return "k"; } if code == 108 { return "l"; }
        if code == 109 { return "m"; } if code == 110 { return "n"; }
        if code == 111 { return "o"; } if code == 112 { return "p"; }
        if code == 113 { return "q"; } if code == 114 { return "r"; }
        if code == 115 { return "s"; } if code == 116 { return "t"; }
        if code == 117 { return "u"; } if code == 118 { return "v"; }
        if code == 119 { return "w"; } if code == 120 { return "x"; }
        if code == 121 { return "y"; } if code == 122 { return "z"; }
    }
    if code >= 65 && code <= 90 {
        if code == 65 { return "A"; } if code == 66 { return "B"; }
        if code == 67 { return "C"; } if code == 68 { return "D"; }
        if code == 69 { return "E"; } if code == 70 { return "F"; }
        if code == 71 { return "G"; } if code == 72 { return "H"; }
        if code == 73 { return "I"; } if code == 74 { return "J"; }
        if code == 75 { return "K"; } if code == 76 { return "L"; }
        if code == 77 { return "M"; } if code == 78 { return "N"; }
        if code == 79 { return "O"; } if code == 80 { return "P"; }
        if code == 81 { return "Q"; } if code == 82 { return "R"; }
        if code == 83 { return "S"; } if code == 84 { return "T"; }
        if code == 85 { return "U"; } if code == 86 { return "V"; }
        if code == 87 { return "W"; } if code == 88 { return "X"; }
        if code == 89 { return "Y"; } if code == 90 { return "Z"; }
    }
    if code >= 48 && code <= 57 {
        if code == 48 { return "0"; } if code == 49 { return "1"; }
        if code == 50 { return "2"; } if code == 51 { return "3"; }
        if code == 52 { return "4"; } if code == 53 { return "5"; }
        if code == 54 { return "6"; } if code == 55 { return "7"; }
        if code == 56 { return "8"; } if code == 57 { return "9"; }
    }
    if code == 32 { return " "; }
    if code == 33 { return "!"; }
    if code == 34 { return "\""; }
    if code == 35 { return "#"; }
    if code == 36 { return "$"; }
    if code == 37 { return "%"; }
    if code == 38 { return "&"; }
    if code == 39 { return "'"; }
    if code == 40 { return "("; }
    if code == 41 { return ")"; }
    if code == 42 { return "*"; }
    if code == 43 { return "+"; }
    if code == 44 { return ","; }
    if code == 45 { return "-"; }
    if code == 46 { return "."; }
    if code == 47 { return "/"; }
    if code == 58 { return ":"; }
    if code == 59 { return ";"; }
    if code == 60 { return "<"; }
    if code == 61 { return "="; }
    if code == 62 { return ">"; }
    if code == 63 { return "?"; }
    if code == 64 { return "@"; }
    if code == 91 { return "["; }
    if code == 92 { return "\\"; }
    if code == 93 { return "]"; }
    if code == 94 { return "^"; }
    if code == 95 { return "_"; }
    if code == 96 { return "`"; }
    if code == 123 { return "{"; }
    if code == 124 { return "|"; }
    if code == 125 { return "}"; }
    if code == 126 { return "~"; }
    if code == 10 { return "\n"; }
    if code == 13 { return "\r"; }
    if code == 9 { return "\t"; }
    return "?";
}

func web_sub_str(s: string, start: int, end: int) -> string {
    let s_len = string_length(s);
    if start < 0 { start = 0; }
    if end > s_len { end = s_len; }
    if start >= end { return ""; }
    let res = "";
    let i = start;
    while i < end {
        let c: int = string_char_at(s, i);
        res = res + web_ascii_char(c);
        i = i + 1;
    }
    return res;
}

func web_str_starts_with(s: string, prefix: string) -> bool {
    let s_len = string_length(s);
    let p_len = string_length(prefix);
    if p_len > s_len { return false; }
    let sub = web_sub_str(s, 0, p_len);
    return sub == prefix;
}

func web_str_contains(s: string, sub: string) -> bool {
    let s_len = string_length(s);
    let sub_len = string_length(sub);
    if sub_len == 0 { return true; }
    if sub_len > s_len { return false; }
    let i = 0;
    while i <= s_len - sub_len {
        let chunk = web_sub_str(s, i, i + sub_len);
        if chunk == sub {
            return true;
        }
        i = i + 1;
    }
    return false;
}

func web_str_index_of(s: string, sub: string) -> int {
    let s_len = string_length(s);
    let sub_len = string_length(sub);
    if sub_len == 0 { return 0; }
    if sub_len > s_len { return -1; }
    let i = 0;
    while i <= s_len - sub_len {
        let chunk = web_sub_str(s, i, i + sub_len);
        if chunk == sub {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func web_is_digit(c: int) -> bool {
    return c >= 48 && c <= 57;
}

func web_is_alpha(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

// ==============================================================================
// SECTION 2: Common HTTP Headers & Protocol Data Types
// ==============================================================================

class HeaderField {
    name: string,
    value: string
}

func header_field_new(name: string, val: string) -> HeaderField {
    return new HeaderField(name, val);
}

func header_find(headers: list, name: string) -> string {
    let total = list_length(headers);
    let i = 0;
    while i < total {
        let h: HeaderField = list_get(headers, i);
        if h.name == name {
            return h.value;
        }
        i = i + 1;
    }
    return "";
}

// ==============================================================================
// SECTION 3: HTTP/1.1 Pipelining Engine (RFC 9112 Section 9.3)
// ==============================================================================

class HttpPipelinedRequest {
    request_id: int,
    method: string,
    uri: string,
    headers: list, // list of HeaderField
    body: string
}

func pipelined_request_new(id: int, method: string, uri: string, headers: list, body: string) -> HttpPipelinedRequest {
    return new HttpPipelinedRequest(id, method, uri, headers, body);
}

class HttpPipelinedResponse {
    request_id: int,
    status_code: int,
    status_text: string,
    headers: list, // list of HeaderField
    body: string
}

func pipelined_response_new(id: int, code: int, text: string, headers: list, body: string) -> HttpPipelinedResponse {
    return new HttpPipelinedResponse(id, code, text, headers, body);
}

class HttpPipelinedSession {
    connection_id: int,
    request_queue: list,  // list of HttpPipelinedRequest
    response_queue: list, // list of HttpPipelinedResponse
    keep_alive: bool,
    processed_count: int
}

func pipelined_session_new(conn_id: int) -> HttpPipelinedSession {
    let reqs = list_new();
    let resps = list_new();
    return new HttpPipelinedSession(conn_id, reqs, resps, true, 0);
}

func pipelined_push_request(session: HttpPipelinedSession, req: HttpPipelinedRequest) {
    list_push(session.request_queue, req);
}

func pipelined_process_next(session: HttpPipelinedSession, handler_code: int, handler_text: string, handler_body: string) -> HttpPipelinedResponse {
    if list_length(session.request_queue) == 0 {
        return null;
    }
    let req: HttpPipelinedRequest = list_remove(session.request_queue, 0);
    session.processed_count = session.processed_count + 1;

    let res_headers = list_new();
    list_push(res_headers, new HeaderField("Server", "RozeBoot-ReactiveWeb/3.0"));
    list_push(res_headers, new HeaderField("Connection", "keep-alive"));
    list_push(res_headers, new HeaderField("Content-Type", "application/json"));

    let resp = new HttpPipelinedResponse(req.request_id, handler_code, handler_text, res_headers, handler_body);
    list_push(session.response_queue, resp);
    return resp;
}

func pipelined_serialize_response(resp: HttpPipelinedResponse) -> string {
    let out = "HTTP/1.1 " + to_string(resp.status_code) + " " + resp.status_text + "\r\n";
    let h_count = list_length(resp.headers);
    let i = 0;
    while i < h_count {
        let h: HeaderField = list_get(resp.headers, i);
        out = out + h.name + ": " + h.value + "\r\n";
        i = i + 1;
    }
    out = out + "Content-Length: " + to_string(string_length(resp.body)) + "\r\n\r\n";
    out = out + resp.body;
    return out;
}

// ==============================================================================
// SECTION 4: HTTP/2 Multiplexed Binary Framing & HPACK Compression (RFC 7540 / 7541)
// ==============================================================================

class Http2Frame {
    length: int,
    frame_type: int,
    flags: int,
    stream_id: int,
    payload: list // list of int (byte values 0-255)
}

func http2_frame_new(len: int, f_type: int, flags: int, stream_id: int, payload: list) -> Http2Frame {
    return new Http2Frame(len, f_type, flags, stream_id, payload);
}

class Http2Stream {
    stream_id: int,
    state: int,
    headers: list, // list of HeaderField
    window_size: int,
    is_closed: bool
}

func http2_stream_new(id: int) -> Http2Stream {
    return new Http2Stream(id, h2_stream_idle(), list_new(), 65535, false);
}

class HpackEntry {
    index: int,
    name: string,
    value: string
}

class HpackTable {
    static_entries: list,  // list of HpackEntry
    dynamic_entries: list, // list of HpackEntry
    max_dynamic_size: int
}

func hpack_table_new() -> HpackTable {
    let s = list_new();
    list_push(s, new HpackEntry(1, ":authority", ""));
    list_push(s, new HpackEntry(2, ":method", "GET"));
    list_push(s, new HpackEntry(3, ":method", "POST"));
    list_push(s, new HpackEntry(4, ":path", "/"));
    list_push(s, new HpackEntry(5, ":path", "/index.html"));
    list_push(s, new HpackEntry(6, ":scheme", "http"));
    list_push(s, new HpackEntry(7, ":scheme", "https"));
    list_push(s, new HpackEntry(8, ":status", "200"));
    list_push(s, new HpackEntry(9, ":status", "204"));
    list_push(s, new HpackEntry(10, ":status", "206"));
    list_push(s, new HpackEntry(11, ":status", "304"));
    list_push(s, new HpackEntry(12, ":status", "400"));
    list_push(s, new HpackEntry(13, ":status", "404"));
    list_push(s, new HpackEntry(14, ":status", "500"));
    list_push(s, new HpackEntry(16, "accept-encoding", "gzip, deflate"));
    list_push(s, new HpackEntry(28, "content-type", "application/json"));
    list_push(s, new HpackEntry(31, "content-type", "application/grpc"));
    list_push(s, new HpackEntry(58, "user-agent", "roze-agent/1.0"));

    let d = list_new();
    return new HpackTable(s, d, 4096);
}

func hpack_lookup_static(table: HpackTable, idx: int) -> HpackEntry {
    let total = list_length(table.static_entries);
    let i = 0;
    while i < total {
        let entry: HpackEntry = list_get(table.static_entries, i);
        if entry.index == idx {
            return entry;
        }
        i = i + 1;
    }
    return null;
}

func hpack_find_static_index(table: HpackTable, name: string, val: string) -> int {
    let total = list_length(table.static_entries);
    let i = 0;
    while i < total {
        let entry: HpackEntry = list_get(table.static_entries, i);
        if entry.name == name && entry.value == val {
            return entry.index;
        }
        i = i + 1;
    }
    return -1;
}

func hpack_add_dynamic(table: HpackTable, name: string, val: string) {
    let new_idx = 62 + list_length(table.dynamic_entries);
    list_push(table.dynamic_entries, new HpackEntry(new_idx, name, val));
}

class Http2Session {
    connection_id: int,
    streams: list, // list of Http2Stream
    hpack: HpackTable,
    outbound_frames: list, // list of Http2Frame
    peer_window: int,
    local_window: int,
    preface_received: bool
}

func http2_session_new(conn_id: int) -> Http2Session {
    let s = list_new();
    let hp = hpack_table_new();
    let out = list_new();
    return new Http2Session(conn_id, s, hp, out, 65535, 65535, false);
}

func http2_find_stream(session: Http2Session, stream_id: int) -> Http2Stream {
    let total = list_length(session.streams);
    let i = 0;
    while i < total {
        let st: Http2Stream = list_get(session.streams, i);
        if st.stream_id == stream_id {
            return st;
        }
        i = i + 1;
    }
    return null;
}

func http2_open_stream(session: Http2Session, stream_id: int) -> Http2Stream {
    let st = http2_find_stream(session, stream_id);
    if st != null {
        return st;
    }
    let new_st = http2_stream_new(stream_id);
    new_st.state = h2_stream_open();
    list_push(session.streams, new_st);
    return new_st;
}

// Parses 9-byte HTTP/2 Binary Frame Header
func http2_parse_frame_header(bytes: list) -> Http2Frame {
    if list_length(bytes) < 9 {
        return null;
    }
    let b0: int = list_get(bytes, 0);
    let b1: int = list_get(bytes, 1);
    let b2: int = list_get(bytes, 2);
    let length = bit_or(bit_or(bit_shl(b0, 16), bit_shl(b1, 8)), b2);

    let f_type: int = list_get(bytes, 3);
    let flags: int = list_get(bytes, 4);

    let b5: int = list_get(bytes, 5);
    let b6: int = list_get(bytes, 6);
    let b7: int = list_get(bytes, 7);
    let b8: int = list_get(bytes, 8);
    let stream_id = bit_or(bit_or(bit_or(bit_shl(bit_and(b5, 127), 24), bit_shl(b6, 16)), bit_shl(b7, 8)), b8);

    let payload = list_new();
    let total_len = list_length(bytes);
    let p_idx = 9;
    while p_idx < total_len {
        let pb: int = list_get(bytes, p_idx);
        list_push(payload, pb);
        p_idx = p_idx + 1;
    }

    return new Http2Frame(length, f_type, flags, stream_id, payload);
}

// Serializes 9-byte HTTP/2 Frame Header + Payload
func http2_serialize_frame(frame: Http2Frame) -> list {
    let out = list_new();
    // 24-bit Length
    list_push(out, bit_and(bit_shr(frame.length, 16), 255));
    list_push(out, bit_and(bit_shr(frame.length, 8), 255));
    list_push(out, bit_and(frame.length, 255));
    // 8-bit Type
    list_push(out, bit_and(frame.frame_type, 255));
    // 8-bit Flags
    list_push(out, bit_and(frame.flags, 255));
    // 31-bit Stream ID
    list_push(out, bit_and(bit_shr(frame.stream_id, 24), 127));
    list_push(out, bit_and(bit_shr(frame.stream_id, 16), 255));
    list_push(out, bit_and(bit_shr(frame.stream_id, 8), 255));
    list_push(out, bit_and(frame.stream_id, 255));

    // Payload
    let p_len = list_length(frame.payload);
    let i = 0;
    while i < p_len {
        let b: int = list_get(frame.payload, i);
        list_push(out, b);
        i = i + 1;
    }
    return out;
}

// ==============================================================================
// SECTION 5: HTTP/3 over QUIC Transport & QPACK Compression (RFC 9000 / 9114)
// ==============================================================================

class Http3Frame {
    frame_type: int,
    payload_len: int,
    payload: list // list of int (byte values)
}

func http3_frame_new(f_type: int, payload: list) -> Http3Frame {
    return new Http3Frame(f_type, list_length(payload), payload);
}

// QUIC Variable-Length Integer Encoding (RFC 9000 Section 16)
func quic_varint_len(val: int) -> int {
    if val < 64 { return 1; }
    if val < 16384 { return 2; }
    if val < 1073741824 { return 4; }
    return 8;
}

func quic_encode_varint(val: int) -> list {
    let out = list_new();
    if val < 64 {
        list_push(out, val); // 00xxxxxx
    } else if val < 16384 {
        list_push(out, bit_or(64, bit_and(bit_shr(val, 8), 63))); // 01xxxxxx
        list_push(out, bit_and(val, 255));
    } else if val < 1073741824 {
        list_push(out, bit_or(128, bit_and(bit_shr(val, 24), 63))); // 10xxxxxx
        list_push(out, bit_and(bit_shr(val, 16), 255));
        list_push(out, bit_and(bit_shr(val, 8), 255));
        list_push(out, bit_and(val, 255));
    } else {
        list_push(out, 192); // 11000000
        list_push(out, 0);
        list_push(out, 0);
        list_push(out, 0);
        list_push(out, bit_and(bit_shr(val, 24), 255));
        list_push(out, bit_and(bit_shr(val, 16), 255));
        list_push(out, bit_and(bit_shr(val, 8), 255));
        list_push(out, bit_and(val, 255));
    }
    return out;
}

class QpackEntry {
    index: int,
    name: string,
    value: string
}

class QpackTable {
    static_entries: list // list of QpackEntry (RFC 9204 Appendix A)
}

func qpack_table_new() -> QpackTable {
    let s = list_new();
    list_push(s, new QpackEntry(0, ":authority", ""));
    list_push(s, new QpackEntry(1, ":path", "/"));
    list_push(s, new QpackEntry(17, ":method", "GET"));
    list_push(s, new QpackEntry(20, ":method", "POST"));
    list_push(s, new QpackEntry(22, ":scheme", "http"));
    list_push(s, new QpackEntry(23, ":scheme", "https"));
    list_push(s, new QpackEntry(24, ":status", "103"));
    list_push(s, new QpackEntry(25, ":status", "200"));
    list_push(s, new QpackEntry(26, ":status", "304"));
    list_push(s, new QpackEntry(27, ":status", "404"));
    list_push(s, new QpackEntry(28, ":status", "503"));
    list_push(s, new QpackEntry(29, "accept", "*/*"));
    list_push(s, new QpackEntry(36, "content-type", "application/json"));
    list_push(s, new QpackEntry(42, "content-type", "application/grpc"));
    return new QpackTable(s);
}

func qpack_lookup(table: QpackTable, idx: int) -> QpackEntry {
    let total = list_length(table.static_entries);
    let i = 0;
    while i < total {
        let entry: QpackEntry = list_get(table.static_entries, i);
        if entry.index == idx {
            return entry;
        }
        i = i + 1;
    }
    return null;
}

// HTTP/3 Frame Serializer
func http3_serialize_frame(frame: Http3Frame) -> list {
    let out = list_new();
    let type_bytes = quic_encode_varint(frame.frame_type);
    let len_bytes = quic_encode_varint(frame.payload_len);

    let t_len = list_length(type_bytes);
    let i = 0;
    while i < t_len {
        let b: int = list_get(type_bytes, i);
        list_push(out, b);
        i = i + 1;
    }

    let l_len = list_length(len_bytes);
    let j = 0;
    while j < l_len {
        let b: int = list_get(len_bytes, j);
        list_push(out, b);
        j = j + 1;
    }

    let p_len = list_length(frame.payload);
    let k = 0;
    while k < p_len {
        let b: int = list_get(frame.payload, k);
        list_push(out, b);
        k = k + 1;
    }
    return out;
}

// ==============================================================================
// SECTION 6: WebSockets Bidirectional Messaging (RFC 6455)
// ==============================================================================

class WebSocketFrame {
    fin: bool,
    opcode: int,
    masked: bool,
    payload_len: int,
    text_payload: string,
    binary_payload: list // list of int
}

func ws_frame_new(fin: bool, opcode: int, masked: bool, text: string, bin: list) -> WebSocketFrame {
    let p_len = string_length(text);
    if bin != null {
        let b_len = list_length(bin);
        if b_len > 0 {
            p_len = b_len;
        }
    }
    return new WebSocketFrame(fin, opcode, masked, p_len, text, bin);
}

// RFC 6455 Handshake Accept Key Computation
// Magic GUID: 258EAFA5-E914-47DA-95CA-C5AB0DC85B11
func ws_compute_accept_key(sec_ws_key: string) -> string {
    // Standard RFC 6455 deterministic accept hash simulation for pure Roze
    let combined = sec_ws_key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    let hash_int = 0;
    let c_len = string_length(combined);
    let i = 0;
    while i < c_len {
        let c: int = string_char_at(combined, i);
        hash_int = bit_and((hash_int * 31) + c, 2147483647);
        i = i + 1;
    }
    return "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=";
}

// WebSocket Frame Parser
func ws_parse_frame(bytes: list) -> WebSocketFrame {
    let b_len = list_length(bytes);
    if b_len < 2 {
        return null;
    }
    let b0: int = list_get(bytes, 0);
    let fin = (bit_and(b0, 128)) != 0;
    let opcode = bit_and(b0, 15);

    let b1: int = list_get(bytes, 1);
    let masked = (bit_and(b1, 128)) != 0;
    let len_code = bit_and(b1, 127);

    let offset = 2;
    let payload_len = len_code;
    if len_code == 126 {
        if b_len < 4 { return null; }
        let l0: int = list_get(bytes, 2);
        let l1: int = list_get(bytes, 3);
        payload_len = bit_or(bit_shl(l0, 8), l1);
        offset = 4;
    }

    let mask_keys = list_new();
    if masked {
        let m = 0;
        while m < 4 {
            let mk: int = list_get(bytes, offset + m);
            list_push(mask_keys, mk);
            m = m + 1;
        }
        offset = offset + 4;
    }

    // Unmask payload bytes
    let bin_out = list_new();
    let text_out = "";
    let p = 0;
    while p < payload_len && (offset + p) < b_len {
        let raw_b: int = list_get(bytes, offset + p);
        let unmasked_b = raw_b;
        if masked {
            let mk: int = list_get(mask_keys, p % 4);
            unmasked_b = bit_xor(raw_b, mk);
        }
        list_push(bin_out, unmasked_b);
        if opcode == ws_opcode_text() {
            text_out = text_out + web_ascii_char(unmasked_b);
        }
        p = p + 1;
    }

    return new WebSocketFrame(fin, opcode, masked, payload_len, text_out, bin_out);
}

// WebSocket Frame Serializer (Server to Client: unmasked per RFC 6455)
func ws_serialize_frame(frame: WebSocketFrame) -> list {
    let out = list_new();
    let b0 = frame.opcode;
    if frame.fin {
        b0 = bit_or(b0, 128);
    }
    list_push(out, b0);

    let p_len = frame.payload_len;
    if p_len < 126 {
        list_push(out, p_len);
    } else {
        list_push(out, 126);
        list_push(out, bit_and(bit_shr(p_len, 8), 255));
        list_push(out, bit_and(p_len, 255));
    }

    if frame.opcode == ws_opcode_text() {
        let s_len = string_length(frame.text_payload);
        let i = 0;
        while i < s_len {
            let c: int = string_char_at(frame.text_payload, i);
            list_push(out, c);
            i = i + 1;
        }
    } else if frame.binary_payload != null {
        let b_count = list_length(frame.binary_payload);
        let j = 0;
        while j < b_count {
            let b: int = list_get(frame.binary_payload, j);
            list_push(out, b);
            j = j + 1;
        }
    }
    return out;
}

class WebSocketSession {
    session_id: string,
    state: int, // 0 connecting, 1 open, 2 closed
    outbound_frames: list, // list of WebSocketFrame
    received_messages: list // list of WebSocketFrame
}

func ws_session_new(id: string) -> WebSocketSession {
    return new WebSocketSession(id, 1, list_new(), list_new());
}

func ws_send_text(session: WebSocketSession, text: string) -> WebSocketFrame {
    let frame = ws_frame_new(true, ws_opcode_text(), false, text, list_new());
    list_push(session.outbound_frames, frame);
    return frame;
}

func ws_send_binary(session: WebSocketSession, bin: list) -> WebSocketFrame {
    let frame = ws_frame_new(true, ws_opcode_binary(), false, "", bin);
    list_push(session.outbound_frames, frame);
    return frame;
}

func ws_send_ping(session: WebSocketSession) -> WebSocketFrame {
    let frame = ws_frame_new(true, ws_opcode_ping(), false, "", list_new());
    list_push(session.outbound_frames, frame);
    return frame;
}

func ws_send_pong(session: WebSocketSession) -> WebSocketFrame {
    let frame = ws_frame_new(true, ws_opcode_pong(), false, "", list_new());
    list_push(session.outbound_frames, frame);
    return frame;
}

func ws_close(session: WebSocketSession) {
    let frame = ws_frame_new(true, ws_opcode_close(), false, "Normal Closure", list_new());
    list_push(session.outbound_frames, frame);
    session.state = 2; // Closed
}

// ==============================================================================
// SECTION 7: gRPC & Protocol Buffers RPC Engine
// ==============================================================================

// Protobuf Varint Encoder
func proto_encode_varint(val: int) -> list {
    let out = list_new();
    let mut_v = val;
    while mut_v >= 128 {
        list_push(out, bit_or(bit_and(mut_v, 127), 128));
        mut_v = bit_shr(mut_v, 7);
    }
    list_push(out, bit_and(mut_v, 127));
    return out;
}

// Protobuf Varint Decoder (returns decoded value)
func proto_decode_varint(bytes: list, offset: int) -> int {
    let res = 0;
    let shift = 0;
    let idx = offset;
    let b_len = list_length(bytes);
    while idx < b_len {
        let b: int = list_get(bytes, idx);
        res = bit_or(res, bit_shl(bit_and(b, 127), shift));
        if bit_and(b, 128) == 0 {
            return res;
        }
        shift = shift + 7;
        idx = idx + 1;
    }
    return res;
}

// gRPC 5-Byte Frame Encapsulation: [1-byte compressed flag][4-byte big-endian length]
func grpc_frame_message(payload: list) -> list {
    let out = list_new();
    let p_len = list_length(payload);
    // Compressed flag (0 = uncompressed)
    list_push(out, 0);
    // 4-byte Big-Endian Length
    list_push(out, bit_and(bit_shr(p_len, 24), 255));
    list_push(out, bit_and(bit_shr(p_len, 16), 255));
    list_push(out, bit_and(bit_shr(p_len, 8), 255));
    list_push(out, bit_and(p_len, 255));

    let i = 0;
    while i < p_len {
        let b: int = list_get(payload, i);
        list_push(out, b);
        i = i + 1;
    }
    return out;
}

// gRPC Unframing
func grpc_unframe_message(bytes: list) -> list {
    let total = list_length(bytes);
    if total < 5 { return list_new(); }
    let b1: int = list_get(bytes, 1);
    let b2: int = list_get(bytes, 2);
    let b3: int = list_get(bytes, 3);
    let b4: int = list_get(bytes, 4);
    let p_len = bit_or(bit_or(bit_or(bit_shl(b1, 24), bit_shl(b2, 16)), bit_shl(b3, 8)), b4);

    let payload = list_new();
    let i = 5;
    while i < total && (i - 5) < p_len {
        let b: int = list_get(bytes, i);
        list_push(payload, b);
        i = i + 1;
    }
    return payload;
}

class GrpcMethod {
    name: string,
    method_type: int // 1 = Unary, 2 = ServerStreaming, 3 = ClientStreaming, 4 = BidiStreaming
}

func grpc_method_new(name: string, m_type: int) -> GrpcMethod {
    return new GrpcMethod(name, m_type);
}

class GrpcService {
    service_name: string,
    methods: list // list of GrpcMethod
}

func grpc_service_new(name: string) -> GrpcService {
    return new GrpcService(name, list_new());
}

func grpc_service_add_method(service: GrpcService, name: string, m_type: int) {
    list_push(service.methods, new GrpcMethod(name, m_type));
}

class GrpcCall {
    service: string,
    method: string,
    request_payload: list,
    response_payload: list,
    status_code: int,
    status_message: string
}

func grpc_dispatch_call(service: GrpcService, method_name: string, req_payload: list) -> GrpcCall {
    let total = list_length(service.methods);
    let i = 0;
    while i < total {
        let m: GrpcMethod = list_get(service.methods, i);
        if m.name == method_name {
            // Method found, execute RPC
            let res_payload = list_new();
            list_push(res_payload, 8); // Field 1 Varint
            list_push(res_payload, 1); // Success code 1
            return new GrpcCall(service.service_name, method_name, req_payload, res_payload, grpc_status_ok(), "OK");
        }
        i = i + 1;
    }
    return new GrpcCall(service.service_name, method_name, req_payload, list_new(), grpc_status_unimplemented(), "Method not implemented");
}

// ==============================================================================
// SECTION 8: URI Template Routing Engine (/users/{id:[0-9]+})
// ==============================================================================

class RouteParam {
    key: string,
    value: string
}

func route_param_new(k: string, v: string) -> RouteParam {
    return new RouteParam(k, v);
}

class RouteMatch {
    matched: bool,
    handler_name: string,
    params: list // list of RouteParam
}

func route_match_new(matched: bool, handler: string) -> RouteMatch {
    return new RouteMatch(matched, handler, list_new());
}

class ReactiveRoute {
    method: string,
    pattern: string,
    handler_name: string,
    is_pattern: bool
}

func reactive_route_new(method: string, pattern: string, handler: string) -> ReactiveRoute {
    let is_pat = web_str_contains(pattern, "{");
    return new ReactiveRoute(method, pattern, handler, is_pat);
}

// Matches URI against pattern with regex validation (e.g. {id:[0-9]+})
func route_match_uri(route: ReactiveRoute, req_method: string, req_path: string) -> RouteMatch {
    if route.method != req_method {
        return new RouteMatch(false, "", list_new());
    }

    if !route.is_pattern {
        if route.pattern == req_path {
            return new RouteMatch(true, route.handler_name, list_new());
        }
        return new RouteMatch(false, "", list_new());
    }

    // Pattern matching: extract tokens
    let p_len = string_length(route.pattern);
    let open_idx = web_str_index_of(route.pattern, "{");
    let close_idx = web_str_index_of(route.pattern, "}");
    if open_idx == -1 || close_idx == -1 {
        return new RouteMatch(false, "", list_new());
    }

    let prefix = web_sub_str(route.pattern, 0, open_idx);
    let suffix = web_sub_str(route.pattern, close_idx + 1, p_len);

    if !web_str_starts_with(req_path, prefix) {
        return new RouteMatch(false, "", list_new());
    }

    let path_len = string_length(req_path);
    let prefix_len = string_length(prefix);
    let suffix_len = string_length(suffix);
    let var_val_len = path_len - prefix_len - suffix_len;
    if var_val_len <= 0 {
        return new RouteMatch(false, "", list_new());
    }

    let extracted_val = web_sub_str(req_path, prefix_len, prefix_len + var_val_len);

    let inside = web_sub_str(route.pattern, open_idx + 1, close_idx);
    let colon_idx = web_str_index_of(inside, ":");
    let param_name = inside;
    let param_regex = "";
    if colon_idx != -1 {
        param_name = web_sub_str(inside, 0, colon_idx);
        param_regex = web_sub_str(inside, colon_idx + 1, string_length(inside));
    }

    // Validate constraint if specified
    if param_regex == "[0-9]+" {
        let v_len = string_length(extracted_val);
        let i = 0;
        while i < v_len {
            let c: int = string_char_at(extracted_val, i);
            if !web_is_digit(c) {
                return new RouteMatch(false, "", list_new());
            }
            i = i + 1;
        }
    } else if param_regex == "[a-zA-Z_]+" {
        let v_len = string_length(extracted_val);
        let i = 0;
        while i < v_len {
            let c: int = string_char_at(extracted_val, i);
            if !web_is_alpha(c) {
                return new RouteMatch(false, "", list_new());
            }
            i = i + 1;
        }
    }

    let res_match = new RouteMatch(true, route.handler_name, list_new());
    list_push(res_match.params, new RouteParam(param_name, extracted_val));
    return res_match;
}

// ==============================================================================
// SECTION 9: Request Body JSON & CBOR Binary Binding (RFC 8949)
// ==============================================================================

class CborItem {
    major_type: int,
    int_val: int,
    text_val: string,
    bytes_val: list
}

func cbor_item_uint(val: int) -> CborItem {
    return new CborItem(cbor_type_uint(), val, "", list_new());
}

func cbor_item_text(text: string) -> CborItem {
    return new CborItem(cbor_type_text(), string_length(text), text, list_new());
}

func cbor_item_bytes(b: list) -> CborItem {
    return new CborItem(cbor_type_bytes(), list_length(b), "", b);
}

// Encodes CBOR Unsigned Integer (Major Type 0)
func cbor_encode_uint(val: int) -> list {
    let out = list_new();
    if val < 24 {
        list_push(out, val);
    } else if val < 256 {
        list_push(out, 24);
        list_push(out, val);
    } else if val < 65536 {
        list_push(out, 25);
        list_push(out, bit_and(bit_shr(val, 8), 255));
        list_push(out, bit_and(val, 255));
    } else {
        list_push(out, 26);
        list_push(out, bit_and(bit_shr(val, 24), 255));
        list_push(out, bit_and(bit_shr(val, 16), 255));
        list_push(out, bit_and(bit_shr(val, 8), 255));
        list_push(out, bit_and(val, 255));
    }
    return out;
}

// Encodes CBOR Text String (Major Type 3)
func cbor_encode_text(s: string) -> list {
    let out = list_new();
    let s_len = string_length(s);
    if s_len < 24 {
        list_push(out, bit_or(bit_shl(3, 5), s_len));
    } else {
        list_push(out, bit_or(bit_shl(3, 5), 24));
        list_push(out, s_len);
    }
    let i = 0;
    while i < s_len {
        let c: int = string_char_at(s, i);
        list_push(out, c);
        i = i + 1;
    }
    return out;
}

// Encodes CBOR Map Header (Major Type 5)
func cbor_encode_map_header(pair_count: int) -> list {
    let out = list_new();
    if pair_count < 24 {
        list_push(out, bit_or(bit_shl(5, 5), pair_count));
    } else {
        list_push(out, bit_or(bit_shl(5, 5), 24));
        list_push(out, pair_count);
    }
    return out;
}

// Decodes CBOR Text String
func cbor_decode_text(bytes: list, offset: int) -> string {
    let b_len = list_length(bytes);
    if offset >= b_len { return ""; }
    let h: int = list_get(bytes, offset);
    let str_len = bit_and(h, 31);
    let content_offset = offset + 1;
    if str_len == 24 {
        let l: int = list_get(bytes, offset + 1);
        str_len = l;
        content_offset = offset + 2;
    }

    let out = "";
    let i = 0;
    while i < str_len && (content_offset + i) < b_len {
        let c: int = list_get(bytes, content_offset + i);
        out = out + web_ascii_char(c);
        i = i + 1;
    }
    return out;
}

// ==============================================================================
// SECTION 10: Jakarta-Style Validation Engine (RFC 7807)
// ==============================================================================

class ConstraintViolation {
    field_name: string,
    rejected_value: string,
    message: string
}

func constraint_violation_new(field: string, val: string, msg: string) -> ConstraintViolation {
    return new ConstraintViolation(field, val, msg);
}

class ValidationResult {
    is_valid: bool,
    violations: list // list of ConstraintViolation
}

func validation_result_new() -> ValidationResult {
    return new ValidationResult(true, list_new());
}

func validation_add_error(res: ValidationResult, field: string, val: string, msg: string) {
    res.is_valid = false;
    list_push(res.violations, new ConstraintViolation(field, val, msg));
}

// Jakarta @NotNull validator
func validate_not_null(res: ValidationResult, field: string, val: string) {
    if string_length(val) == 0 {
        validation_add_error(res, field, val, "must not be null or empty");
    }
}

// Jakarta @NotBlank validator
func validate_not_blank(res: ValidationResult, field: string, val: string) {
    let s_len = string_length(val);
    let has_non_space = false;
    let i = 0;
    while i < s_len {
        let c: int = string_char_at(val, i);
        if c != 32 && c != 9 && c != 10 && c != 13 {
            has_non_space = true;
        }
        i = i + 1;
    }
    if !has_non_space {
        validation_add_error(res, field, val, "must not be blank");
    }
}

// Jakarta @Size(min, max) validator
func validate_size(res: ValidationResult, field: string, val: string, min: int, max: int) {
    let s_len = string_length(val);
    if s_len < min || s_len > max {
        let msg = "size must be between " + to_string(min) + " and " + to_string(max);
        validation_add_error(res, field, val, msg);
    }
}

// Jakarta @Min validator
func validate_min(res: ValidationResult, field: string, val: int, min_val: int) {
    if val < min_val {
        let msg = "must be greater than or equal to " + to_string(min_val);
        validation_add_error(res, field, to_string(val), msg);
    }
}

// Jakarta @Max validator
func validate_max(res: ValidationResult, field: string, val: int, max_val: int) {
    if val > max_val {
        let msg = "must be less than or equal to " + to_string(max_val);
        validation_add_error(res, field, to_string(val), msg);
    }
}

// Jakarta @Email validator
func validate_email(res: ValidationResult, field: string, email: string) {
    if !web_str_contains(email, "@") || !web_str_contains(email, ".") {
        validation_add_error(res, field, email, "must be a well-formed email address");
    }
}

// Formats ValidationResult as RFC 7807 Problem Details JSON
func validation_to_problem_details(res: ValidationResult) -> string {
    let out = "{\"type\":\"https://roze.dev/errors/validation-failed\",\"title\":\"Constraint Violation\",\"status\":400,\"violations\":[";
    let total = list_length(res.violations);
    let i = 0;
    while i < total {
        let v: ConstraintViolation = list_get(res.violations, i);
        out = out + "{\"field\":\"" + v.field_name + "\",\"message\":\"" + v.message + "\"}";
        if i < total - 1 {
            out = out + ",";
        }
        i = i + 1;
    }
    out = out + "]}";
    return out;
}

// ==============================================================================
// SECTION 11: Unified Reactive Web Server Engine (rozeboot.web)
// ==============================================================================

class ReactiveWebServer {
    name: string,
    port: int,
    routes: list,            // list of ReactiveRoute
    pipelined_sessions: list,// list of HttpPipelinedSession
    http2_sessions: list,    // list of Http2Session
    ws_sessions: list,       // list of WebSocketSession
    grpc_services: list,     // list of GrpcService
    is_running: bool,
    requests_processed: int
}

func reactive_web_server_new(name: string, port: int) -> ReactiveWebServer {
    return new ReactiveWebServer(
        name,
        port,
        list_new(),
        list_new(),
        list_new(),
        list_new(),
        list_new(),
        false,
        0
    );
}

func web_add_route(server: ReactiveWebServer, method: string, path: string, handler: string) {
    list_push(server.routes, reactive_route_new(method, path, handler));
}

func web_add_grpc_service(server: ReactiveWebServer, service: GrpcService) {
    list_push(server.grpc_services, service);
}

func web_start(server: ReactiveWebServer) {
    server.is_running = true;
}

func web_stop(server: ReactiveWebServer) {
    server.is_running = false;
}

// Simulates high-throughput reactive dispatch loop benchmark
func web_benchmark_dispatch(server: ReactiveWebServer, iterations: int) -> int {
    let count = 0;
    let i = 0;
    while i < iterations {
        let m = route_match_uri(
            reactive_route_new("GET", "/api/v1/users/{id:[0-9]+}", "getUserById"),
            "GET",
            "/api/v1/users/42"
        );
        if m.matched {
            count = count + 1;
        }
        i = i + 1;
    }
    server.requests_processed = server.requests_processed + count;
    return count;
}
