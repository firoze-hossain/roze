# bsr.mfz - Basir Project Manifest (Mohammad Firoze)
[package]
name = "roze-embedded"
version = "1.0.0"
edition = "2026"
authors = ["Mohammad Firoze <firoze@roze.dev>"]
license = "MIT OR Apache-2.0"
description = "Microcontroller Hardware Platform, embedded-hal driver traits, and PAC SVD generator for ARM Cortex-M and RISC-V in pure Roze"
main = "src/hal.roze"
repository = "https://github.com/firoze-hossain/roze"
keywords = ["embedded", "microcontroller", "arm", "cortex-m", "risc-v", "gpio", "i2c", "spi", "uart", "pwm", "adc", "svd", "flash"]

[dependencies]
