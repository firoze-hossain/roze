// packages/roze-game/tests/test_physics.roze
import "roze-game.ecs";
import "roze-game.physics";

func assert_true(cond: bool, msg: string) {
    if !cond {
        println("❌ Assertion failed: " + msg);
    }
}

func float_approx_eq(a: float, b: float, eps: float) -> bool {
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    return diff <= eps;
}

func main() {
    println("================================================================================");
    println("🌹 ROZE-GAME: RIGID-BODY PHYSICS & 3D SPATIAL AUDIO VERIFICATION (M11-T03)");
    println("================================================================================");

    // --------------------------------------------------------------------------
    // SUITE 1: Vector Math Helpers & Geometric Collision Primitives
    // --------------------------------------------------------------------------
    println("--> Testing Suite 1: Geometric Primitives (AABB, Sphere, Capsule, Plane)...");
    let v_vel = new Vector3(10.0, -10.0, 0.0);
    let v_norm = new Vector3(0.0, 1.0, 0.0);
    let v_refl = vec3_reflect(v_vel, v_norm);
    assert_true(float_approx_eq(v_refl.x, 10.0, 0.001) && float_approx_eq(v_refl.y, 10.0, 0.001), "Vector reflection failed");

    // AABB vs AABB Collision
    let aabb1 = aabb_from_center_extents(new Vector3(0.0, 0.0, 0.0), new Vector3(1.0, 1.0, 1.0));
    let aabb2 = aabb_from_center_extents(new Vector3(1.5, 0.0, 0.0), new Vector3(1.0, 1.0, 1.0));
    let aabb_man = collision_aabb_aabb(aabb1, aabb2);
    assert_true(aabb_man.has_collision, "Overlapping AABBs must collide");
    assert_true(float_approx_eq(aabb_man.penetration, 0.5, 0.01), "AABB penetration depth should be 0.5");
    assert_true(float_approx_eq(aabb_man.normal.x, 1.0, 0.01), "AABB separation normal should point along +X");

    let aabb3 = aabb_from_center_extents(new Vector3(5.0, 0.0, 0.0), new Vector3(1.0, 1.0, 1.0));
    let aabb_sep = collision_aabb_aabb(aabb1, aabb3);
    assert_true(!aabb_sep.has_collision, "Disjoint AABBs should not collide");

    // Sphere vs Sphere Collision
    let s1 = sphere_new(new Vector3(0.0, 0.0, 0.0), 1.0);
    let s2 = sphere_new(new Vector3(1.5, 0.0, 0.0), 1.0);
    let s_man = collision_sphere_sphere(s1, s2);
    assert_true(s_man.has_collision, "Overlapping spheres must collide");
    assert_true(float_approx_eq(s_man.penetration, 0.5, 0.01), "Sphere penetration depth should be 0.5");
    assert_true(float_approx_eq(s_man.normal.x, 1.0, 0.01), "Sphere collision normal should be (1, 0, 0)");

    let s3 = sphere_new(new Vector3(3.0, 0.0, 0.0), 1.0);
    assert_true(!collision_sphere_sphere(s1, s3).has_collision, "Disjoint spheres should not collide");

    // Sphere vs Capsule Collision
    let cap = capsule_new(new Vector3(2.0, -2.0, 0.0), new Vector3(2.0, 2.0, 0.0), 0.5);
    let s_cap = sphere_new(new Vector3(1.0, 0.0, 0.0), 1.0);
    let cap_man = collision_sphere_capsule(s_cap, cap);
    assert_true(cap_man.has_collision, "Sphere should intersect capsule at distance 1.0 < 1.5");
    assert_true(float_approx_eq(cap_man.penetration, 0.5, 0.01), "Sphere-capsule penetration mismatch");

    // Sphere vs Plane Collision
    let plane = plane_new(vec3_zero(), new Vector3(0.0, 1.0, 0.0));
    let s_plane = sphere_new(new Vector3(0.0, 0.75, 0.0), 1.0);
    let plane_man = collision_sphere_plane(s_plane, plane);
    assert_true(plane_man.has_collision, "Sphere at y=0.75 with r=1.0 must penetrate plane at y=0");
    assert_true(float_approx_eq(plane_man.penetration, 0.25, 0.01), "Plane penetration should be 0.25");

    println("SUITE 1 PASSED: Geometric collision primitives verified.");

    // --------------------------------------------------------------------------
    // SUITE 2: OBB (Oriented Bounding Box) & 15-Axis SAT Collision Detection
    // --------------------------------------------------------------------------
    println("--> Testing Suite 2: OBB & 15-Axis SAT Collision Detection...");
    let obb1 = obb_new(
        vec3_zero(),
        new Vector3(1.0, 1.0, 1.0),
        new Vector3(1.0, 0.0, 0.0),
        new Vector3(0.0, 1.0, 0.0),
        new Vector3(0.0, 0.0, 1.0)
    );

    // OBB2 translated by 1.8 along X
    let obb2 = obb_new(
        new Vector3(1.8, 0.0, 0.0),
        new Vector3(1.0, 1.0, 1.0),
        new Vector3(1.0, 0.0, 0.0),
        new Vector3(0.0, 1.0, 0.0),
        new Vector3(0.0, 0.0, 1.0)
    );

    let obb_col = collision_obb_obb(obb1, obb2);
    assert_true(obb_col.has_collision, "Overlapping OBBs must collide");
    assert_true(float_approx_eq(obb_col.penetration, 0.2, 0.01), "OBB penetration depth should be 0.2");

    // OBB3 rotated 45 degrees around Z axis, placed at (1.5, 1.5, 0)
    let diag = 0.7071;
    let obb3 = obb_new(
        new Vector3(1.5, 1.5, 0.0),
        new Vector3(1.0, 1.0, 1.0),
        new Vector3(diag, diag, 0.0),
        new Vector3(0.0 - diag, diag, 0.0),
        new Vector3(0.0, 0.0, 1.0)
    );
    let obb_rot_col = collision_obb_obb(obb1, obb3);
    assert_true(obb_rot_col.has_collision, "Rotated OBB should collide under SAT");

    // Disjoint OBB
    let obb4 = obb_new(
        new Vector3(5.0, 0.0, 0.0),
        new Vector3(1.0, 1.0, 1.0),
        new Vector3(1.0, 0.0, 0.0),
        new Vector3(0.0, 1.0, 0.0),
        new Vector3(0.0, 0.0, 1.0)
    );
    assert_true(!collision_obb_obb(obb1, obb4).has_collision, "Disjoint OBBs must not collide");

    println("SUITE 2 PASSED: OBB & 15-axis SAT collision detection verified.");

    // --------------------------------------------------------------------------
    // SUITE 3: 3D Raycasting Engine (AABB, Sphere, Plane, Triangle)
    // --------------------------------------------------------------------------
    println("--> Testing Suite 3: 3D Raycasting Engine...");
    let ray = ray_new(new Vector3(0.0, 0.0, -5.0), new Vector3(0.0, 0.0, 1.0), 100.0);

    // Raycast Sphere
    let hit_sphere = ray_cast_sphere(ray, sphere_new(vec3_zero(), 1.0));
    assert_true(hit_sphere.hit, "Ray pointing at sphere center must hit");
    assert_true(float_approx_eq(hit_sphere.distance, 4.0, 0.01), "Ray hit distance to sphere (radius 1 at z=0) must be 4.0");
    assert_true(float_approx_eq(hit_sphere.point.z, -1.0, 0.01), "Sphere hit point Z should be -1.0");

    // Raycast AABB
    let hit_box = ray_cast_aabb(ray, aabb_from_center_extents(vec3_zero(), vec3_one()));
    assert_true(hit_box.hit, "Ray must hit AABB");
    assert_true(float_approx_eq(hit_box.distance, 4.0, 0.01), "AABB hit distance must be 4.0");
    assert_true(float_approx_eq(hit_box.normal.z, -1.0, 0.01), "Hit normal should be -Z (0, 0, -1)");

    // Raycast Plane
    let hit_plane = ray_cast_plane(ray, plane_new(new Vector3(0.0, 0.0, 10.0), new Vector3(0.0, 0.0, -1.0)));
    assert_true(hit_plane.hit, "Ray must hit plane at z=10");
    assert_true(float_approx_eq(hit_plane.distance, 15.0, 0.01), "Ray distance to plane at z=10 from z=-5 is 15.0");

    // Raycast Triangle (Möller–Trumbore)
    let v0 = new Vector3(-2.0, -2.0, 0.0);
    let v1 = new Vector3(2.0, -2.0, 0.0);
    let v2 = new Vector3(0.0, 2.0, 0.0);
    let hit_tri = ray_cast_triangle(ray, v0, v1, v2);
    assert_true(hit_tri.hit, "Ray through origin must hit triangle");
    assert_true(float_approx_eq(hit_tri.distance, 5.0, 0.01), "Triangle distance must be 5.0");

    // Ray missing triangle
    let ray_miss = ray_new(new Vector3(10.0, 10.0, -5.0), new Vector3(0.0, 0.0, 1.0), 100.0);
    assert_true(!ray_cast_triangle(ray_miss, v0, v1, v2).hit, "Ray off to the side should miss triangle");

    println("SUITE 3 PASSED: 3D raycasting engine verified.");

    // --------------------------------------------------------------------------
    // SUITE 4: GJK (Gilbert-Johnson-Keerthi) Convex Collision Detection
    // --------------------------------------------------------------------------
    println("--> Testing Suite 4: GJK Convex Collision Algorithm...");
    let c1 = vec3_zero();
    let ext1 = new Vector3(1.0, 1.0, 1.0);
    let c2 = new Vector3(1.5, 0.5, 0.5);
    let ext2 = new Vector3(1.0, 1.0, 1.0);

    let gjk_hit = gjk_intersection_boxes(c1, ext1, c2, ext2);
    assert_true(gjk_hit, "GJK algorithm should detect intersection between overlapping boxes");

    let c3 = new Vector3(5.0, 5.0, 5.0);
    let gjk_miss = gjk_intersection_boxes(c1, ext1, c3, ext2);
    assert_true(!gjk_miss, "GJK algorithm should report false for separated boxes");

    println("SUITE 4 PASSED: GJK convex collision algorithm verified.");

    // --------------------------------------------------------------------------
    // SUITE 5: Rigid-Body Dynamics & Sequential Impulse Resolution
    // --------------------------------------------------------------------------
    println("--> Testing Suite 5: Rigid-Body Dynamics & Sequential Impulses...");
    let ball = physics_body_sphere(1, new Vector3(0.0, 10.0, 0.0), 1.0, 2.0);
    assert_true(float_approx_eq(ball.inv_mass, 0.5, 0.001), "Inv mass of 2kg sphere should be 0.5");
    assert_true(ball.use_gravity, "Dynamic ball must use gravity");

    // Apply linear impulse
    physics_body_apply_impulse(ball, new Vector3(10.0, 0.0, 0.0));
    assert_true(float_approx_eq(ball.linear_velocity.x, 5.0, 0.01), "Impulse 10Ns on 2kg body yields 5m/s velocity");

    // Integrate with gravity for 1 second
    let gravity = new Vector3(0.0, -9.81, 0.0);
    let dt = 0.01666;
    let step = 0;
    while step < 60 {
        physics_body_integrate(ball, gravity, dt);
        step = step + 1;
    }
    assert_true(ball.position.x > 4.0, "Ball should have traveled in +X direction");
    assert_true(ball.position.y < 10.0, "Ball should have fallen under gravity");

    // Elastic Collision with Static Ground Floor
    let falling_ball = physics_body_sphere(2, new Vector3(0.0, 0.5, 0.0), 1.0, 1.0);
    falling_ball.linear_velocity = new Vector3(0.0, -10.0, 0.0);
    falling_ball.restitution = 0.8;

    let floor = physics_body_static_plane(3, vec3_zero(), new Vector3(0.0, 1.0, 0.0));
    floor.restitution = 0.8;

    let col_manifold = manifold_new(new Vector3(0.0, 1.0, 0.0), 0.5, new Vector3(0.0, 0.0, 0.0));
    physics_resolve_collision(floor, falling_ball, col_manifold, 0.01666);

    // After bounce, falling_ball Y velocity should be inverted to +8.0 m/s (10 * 0.8)
    assert_true(falling_ball.linear_velocity.y > 7.5, "Ball must bounce upward with e=0.8");

    println("SUITE 5 PASSED: Rigid-body dynamics and impulse resolution verified.");

    // --------------------------------------------------------------------------
    // SUITE 6: Spatial Hashing Broadphase Voxel Grid
    // --------------------------------------------------------------------------
    println("--> Testing Suite 6: Spatial Hashing Broadphase Voxel Grid...");
    let grid = spatial_grid_new(4.0); // 4-meter voxel cells

    // Insert Body 1 at (0, 0, 0)
    let aabb_b1 = aabb_from_center_extents(new Vector3(0.0, 0.0, 0.0), new Vector3(0.5, 0.5, 0.5));
    spatial_grid_insert(grid, 1, aabb_b1);

    // Insert Body 2 nearby at (1, 0, 0) -> same 4m cell!
    let aabb_b2 = aabb_from_center_extents(new Vector3(1.0, 0.0, 0.0), new Vector3(0.5, 0.5, 0.5));
    spatial_grid_insert(grid, 2, aabb_b2);

    // Insert Body 3 far away at (100, 100, 100) -> completely different cell!
    let aabb_b3 = aabb_from_center_extents(new Vector3(100.0, 100.0, 100.0), new Vector3(0.5, 0.5, 0.5));
    spatial_grid_insert(grid, 3, aabb_b3);

    let pairs = spatial_grid_get_candidate_pairs(grid);
    assert_true(list_length(pairs) == 1, "Should identify exactly 1 broadphase candidate pair");
    let p0: BroadphasePair = list_get(pairs, 0);
    assert_true(p0.id_a == 1 && p0.id_b == 2, "Candidate pair must be (1, 2)");

    println("SUITE 6 PASSED: Spatial hashing broadphase grid verified.");

    // --------------------------------------------------------------------------
    // SUITE 7: Particle Emitters & 3D Spatial Audio Mixer Gate
    // --------------------------------------------------------------------------
    println("--> Testing Suite 7: Particle Emitters & 3D Spatial Audio Mixer...");
    // 1. Particle Simulation
    let emitter = emitter_new(vec3_zero(), 500);
    emitter_burst(emitter, 100);
    assert_true(emitter.active_particles_count == 100, "Burst must spawn 100 active particles");

    emitter_update(emitter, 0.1);
    let p_sample: Particle = list_get(emitter.particles, 0);
    assert_true(p_sample.is_alive, "Particle should still be alive after 0.1s");
    assert_true(p_sample.position.y != 0.0, "Particle position must be updated by velocity/gravity");

    // 2. 3D Spatial Audio Mixer
    let mixer = audio_mixer_new(44100);
    mixer.listener.position = vec3_zero();
    mixer.listener.forward = new Vector3(0.0, 0.0, -1.0);
    mixer.listener.up = new Vector3(0.0, 1.0, 0.0);

    // Channel to the far right (+X) at distance 10
    let ch_right = audio_channel_new(1, new Vector3(10.0, 0.0, 0.0), 440.0, waveform_sine());
    audio_mixer_add_channel(mixer, ch_right);

    // Channel to the far left (-X) at distance 10
    let ch_left = audio_channel_new(2, new Vector3(-10.0, 0.0, 0.0), 220.0, waveform_sawtooth());
    audio_mixer_add_channel(mixer, ch_left);

    // Spatialize channels
    audio_channel_spatialize(ch_right, mixer.listener, mixer.speed_of_sound);
    audio_channel_spatialize(ch_left, mixer.listener, mixer.speed_of_sound);

    assert_true(ch_right.gain_right > ch_right.gain_left, "Right channel should have greater right ear gain");
    assert_true(ch_left.gain_left > ch_left.gain_right, "Left channel should have greater left ear gain");

    // Doppler Shift Test
    ch_right.velocity = new Vector3(-50.0, 0.0, 0.0); // Source moving toward listener at 50 m/s
    audio_channel_spatialize(ch_right, mixer.listener, mixer.speed_of_sound);
    assert_true(ch_right.pitch_shifted > 1.0, "Approaching source should experience upward Doppler pitch shift");

    // Render 128 stereo audio frames
    let audio_frames = audio_mixer_render_buffer(mixer, 128);
    assert_true(list_length(audio_frames) == 128, "Audio mixer must render requested frame count");

    // 3. High-Throughput Physics & Audio Benchmark Stress Gate
    println("--> Executing High-Throughput Physics & Audio Benchmark Stress Gate...");
    let bench = physics_benchmark_stress_test();
    println("    Benchmark Stats:");
    println("    • Rigid Bodies Simulated:   " + to_string(bench.total_bodies));
    println("    • Active Particles:         " + to_string(bench.total_particles));
    println("    • Spatial Audio Channels:   " + to_string(bench.audio_channels_mixed));
    println("    • Collisions Resolved:      " + to_string(bench.collisions_resolved));
    println("    • Simulation Steps:         " + to_string(bench.simulation_steps));

    assert_true(bench.total_bodies == 500, "Must simulate 500 rigid bodies");
    assert_true(bench.audio_channels_mixed == 32, "Must mix 32 spatial audio channels");
    assert_true(bench.collisions_resolved > 0, "Must detect and resolve active collisions");
    assert_true(bench.is_success, "Benchmark stress test gate must pass");

    println("SUITE 7 PASSED: Particle emitters, 3D spatial audio & benchmark stress gate verified.");

    println("================================================================================");
    println("🎉 ALL 7 SUITES PASSED: M11-T03 RIGID-BODY PHYSICS & 3D AUDIO 100% COMPLETE!");
    println("================================================================================");
}
