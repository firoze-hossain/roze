// ==============================================================================
// 20. Pure Roze Mathematical Helpers for Optimizers & Schedulers
// ==============================================================================

func int_to_float(i: int) -> float {
    return i * 1.0;
}

func torch_cos(x: float) -> float {
    let pi = 3.141592653589793;
    let pi2 = 2.0 * pi;
    let rem = x;
    if rem < 0.0 {
        rem = 0.0 - rem;
    }
    let k = float_to_int(rem / pi2);
    rem = rem - (int_to_float(k) * pi2);
    if rem > pi {
        rem = pi2 - rem;
    }
    let x2 = rem * rem;
    let sum = 1.0;
    let term = 1.0;
    let i = 1;
    while i <= 10 {
        let d = int_to_float(2 * i * (2 * i - 1));
        term = (0.0 - term * x2) / d;
        sum = sum + term;
        i = i + 1;
    }
    return sum;
}

// ==============================================================================
// 21. Numerical Optimizers (SGD, Adam, AdamW, RMSprop, Adagrad)
// ==============================================================================

trait Optimizer {
    func step();
    func zero_grad();
    func get_lr() -> float;
    func set_lr(new_lr: float);
}

// ------------------------------------------------------------------------------
// 1. SGD (Stochastic Gradient Descent with Momentum & Nesterov)
// ------------------------------------------------------------------------------

class SGD {
    params: list,
    lr: float,
    momentum: float,
    dampening: float,
    weight_decay: float,
    nesterov: bool,
    velocities: list,
    step_count: int
}

func optim_sgd(params: list, lr: float, momentum: float, weight_decay: float, dampening: float, nesterov: bool) -> SGD {
    let vels = list_new();
    let n = list_length(params);
    let i = 0;
    while i < n {
        let p: Parameter = list_get(params, i);
        list_push(vels, tensor_zeros(p.data.shape, p.data.dtype_id));
        i = i + 1;
    }
    return new SGD(params, lr, momentum, dampening, weight_decay, nesterov, vels, 0);
}

impl Optimizer for SGD {
    func step() {
        this.step_count = this.step_count + 1;
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            if p.requires_grad && p.data != null && p.data.grad != null {
                let t = p.data;
                let g = t.grad;
                let vel: Tensor = list_get(this.velocities, i);
                let num = t.numel();
                let j = 0;
                while j < num {
                    let p_val = tensor_storage_read_float(t.storage, t.offset + j, t.dtype_id);
                    let g_val = tensor_storage_read_float(g.storage, g.offset + j, g.dtype_id);
                    if this.weight_decay != 0.0 {
                        g_val = g_val + (this.weight_decay * p_val);
                    }
                    let d_p = g_val;
                    if this.momentum != 0.0 {
                        let v_val = tensor_storage_read_float(vel.storage, vel.offset + j, vel.dtype_id);
                        if this.step_count == 1 {
                            v_val = g_val;
                        } else {
                            v_val = (this.momentum * v_val) + ((1.0 - this.dampening) * g_val);
                        }
                        tensor_storage_write_float(vel.storage, vel.offset + j, vel.dtype_id, v_val);
                        if this.nesterov {
                            d_p = g_val + (this.momentum * v_val);
                        } else {
                            d_p = v_val;
                        }
                    }
                    let new_p = p_val - (this.lr * d_p);
                    tensor_storage_write_float(t.storage, t.offset + j, t.dtype_id, new_p);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    func zero_grad() {
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            p.zero_grad();
            i = i + 1;
        }
    }

    func get_lr() -> float {
        return this.lr;
    }

    func set_lr(new_lr: float) {
        this.lr = new_lr;
    }
}

// ------------------------------------------------------------------------------
// 2. Adam (Adaptive Moment Estimation)
// ------------------------------------------------------------------------------

class Adam {
    params: list,
    lr: float,
    beta1: float,
    beta2: float,
    eps: float,
    weight_decay: float,
    exp_avg: list,
    exp_avg_sq: list,
    step_count: int,
    beta1_t: float,
    beta2_t: float
}

func optim_adam(params: list, lr: float, beta1: float, beta2: float, eps: float, weight_decay: float) -> Adam {
    let exp_m = list_new();
    let exp_v = list_new();
    let n = list_length(params);
    let i = 0;
    while i < n {
        let p: Parameter = list_get(params, i);
        list_push(exp_m, tensor_zeros(p.data.shape, p.data.dtype_id));
        list_push(exp_v, tensor_zeros(p.data.shape, p.data.dtype_id));
        i = i + 1;
    }
    return new Adam(params, lr, beta1, beta2, eps, weight_decay, exp_m, exp_v, 0, 1.0, 1.0);
}

impl Optimizer for Adam {
    func step() {
        this.step_count = this.step_count + 1;
        this.beta1_t = this.beta1_t * this.beta1;
        this.beta2_t = this.beta2_t * this.beta2;
        let bias_corr1 = 1.0 - this.beta1_t;
        let bias_corr2 = 1.0 - this.beta2_t;

        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            if p.requires_grad && p.data != null && p.data.grad != null {
                let t = p.data;
                let g = t.grad;
                let exp_m: Tensor = list_get(this.exp_avg, i);
                let exp_v: Tensor = list_get(this.exp_avg_sq, i);
                let num = t.numel();
                let j = 0;
                while j < num {
                    let p_val = tensor_storage_read_float(t.storage, t.offset + j, t.dtype_id);
                    let g_val = tensor_storage_read_float(g.storage, g.offset + j, g.dtype_id);
                    if this.weight_decay != 0.0 {
                        g_val = g_val + (this.weight_decay * p_val);
                    }
                    let m_val = tensor_storage_read_float(exp_m.storage, exp_m.offset + j, exp_m.dtype_id);
                    let v_val = tensor_storage_read_float(exp_v.storage, exp_v.offset + j, exp_v.dtype_id);

                    m_val = (this.beta1 * m_val) + ((1.0 - this.beta1) * g_val);
                    v_val = (this.beta2 * v_val) + ((1.0 - this.beta2) * g_val * g_val);

                    tensor_storage_write_float(exp_m.storage, exp_m.offset + j, exp_m.dtype_id, m_val);
                    tensor_storage_write_float(exp_v.storage, exp_v.offset + j, exp_v.dtype_id, v_val);

                    let m_hat = m_val / bias_corr1;
                    let v_hat = v_val / bias_corr2;

                    let update = (this.lr * m_hat) / (torch_sqrt(v_hat) + this.eps);
                    tensor_storage_write_float(t.storage, t.offset + j, t.dtype_id, p_val - update);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    func zero_grad() {
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            p.zero_grad();
            i = i + 1;
        }
    }

    func get_lr() -> float {
        return this.lr;
    }

    func set_lr(new_lr: float) {
        this.lr = new_lr;
    }
}

// ------------------------------------------------------------------------------
// 3. AdamW (Decoupled Weight Decay Adam)
// ------------------------------------------------------------------------------

class AdamW {
    params: list,
    lr: float,
    beta1: float,
    beta2: float,
    eps: float,
    weight_decay: float,
    exp_avg: list,
    exp_avg_sq: list,
    step_count: int,
    beta1_t: float,
    beta2_t: float
}

func optim_adamw(params: list, lr: float, beta1: float, beta2: float, eps: float, weight_decay: float) -> AdamW {
    let exp_m = list_new();
    let exp_v = list_new();
    let n = list_length(params);
    let i = 0;
    while i < n {
        let p: Parameter = list_get(params, i);
        list_push(exp_m, tensor_zeros(p.data.shape, p.data.dtype_id));
        list_push(exp_v, tensor_zeros(p.data.shape, p.data.dtype_id));
        i = i + 1;
    }
    return new AdamW(params, lr, beta1, beta2, eps, weight_decay, exp_m, exp_v, 0, 1.0, 1.0);
}

impl Optimizer for AdamW {
    func step() {
        this.step_count = this.step_count + 1;
        this.beta1_t = this.beta1_t * this.beta1;
        this.beta2_t = this.beta2_t * this.beta2;
        let bias_corr1 = 1.0 - this.beta1_t;
        let bias_corr2 = 1.0 - this.beta2_t;

        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            if p.requires_grad && p.data != null && p.data.grad != null {
                let t = p.data;
                let g = t.grad;
                let exp_m: Tensor = list_get(this.exp_avg, i);
                let exp_v: Tensor = list_get(this.exp_avg_sq, i);
                let num = t.numel();
                let j = 0;
                while j < num {
                    let p_val = tensor_storage_read_float(t.storage, t.offset + j, t.dtype_id);
                    let g_val = tensor_storage_read_float(g.storage, g.offset + j, g.dtype_id);

                    // Decoupled weight decay: theta_t+1 = theta_t - lr * weight_decay * theta_t
                    if this.weight_decay != 0.0 {
                        p_val = p_val * (1.0 - (this.lr * this.weight_decay));
                    }

                    let m_val = tensor_storage_read_float(exp_m.storage, exp_m.offset + j, exp_m.dtype_id);
                    let v_val = tensor_storage_read_float(exp_v.storage, exp_v.offset + j, exp_v.dtype_id);

                    m_val = (this.beta1 * m_val) + ((1.0 - this.beta1) * g_val);
                    v_val = (this.beta2 * v_val) + ((1.0 - this.beta2) * g_val * g_val);

                    tensor_storage_write_float(exp_m.storage, exp_m.offset + j, exp_m.dtype_id, m_val);
                    tensor_storage_write_float(exp_v.storage, exp_v.offset + j, exp_v.dtype_id, v_val);

                    let m_hat = m_val / bias_corr1;
                    let v_hat = v_val / bias_corr2;

                    let update = (this.lr * m_hat) / (torch_sqrt(v_hat) + this.eps);
                    tensor_storage_write_float(t.storage, t.offset + j, t.dtype_id, p_val - update);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    func zero_grad() {
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            p.zero_grad();
            i = i + 1;
        }
    }

    func get_lr() -> float {
        return this.lr;
    }

    func set_lr(new_lr: float) {
        this.lr = new_lr;
    }
}

// ------------------------------------------------------------------------------
// 4. RMSprop
// ------------------------------------------------------------------------------

class RMSprop {
    params: list,
    lr: float,
    alpha: float,
    eps: float,
    weight_decay: float,
    momentum: float,
    square_avg: list,
    momentum_buffer: list,
    step_count: int
}

func optim_rmsprop(params: list, lr: float, alpha: float, eps: float, weight_decay: float, momentum: float) -> RMSprop {
    let sq_avg = list_new();
    let mom_buf = list_new();
    let n = list_length(params);
    let i = 0;
    while i < n {
        let p: Parameter = list_get(params, i);
        list_push(sq_avg, tensor_zeros(p.data.shape, p.data.dtype_id));
        list_push(mom_buf, tensor_zeros(p.data.shape, p.data.dtype_id));
        i = i + 1;
    }
    return new RMSprop(params, lr, alpha, eps, weight_decay, momentum, sq_avg, mom_buf, 0);
}

impl Optimizer for RMSprop {
    func step() {
        this.step_count = this.step_count + 1;
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            if p.requires_grad && p.data != null && p.data.grad != null {
                let t = p.data;
                let g = t.grad;
                let sq: Tensor = list_get(this.square_avg, i);
                let mom: Tensor = list_get(this.momentum_buffer, i);
                let num = t.numel();
                let j = 0;
                while j < num {
                    let p_val = tensor_storage_read_float(t.storage, t.offset + j, t.dtype_id);
                    let g_val = tensor_storage_read_float(g.storage, g.offset + j, g.dtype_id);
                    if this.weight_decay != 0.0 {
                        g_val = g_val + (this.weight_decay * p_val);
                    }
                    let sq_val = tensor_storage_read_float(sq.storage, sq.offset + j, sq.dtype_id);
                    sq_val = (this.alpha * sq_val) + ((1.0 - this.alpha) * g_val * g_val);
                    tensor_storage_write_float(sq.storage, sq.offset + j, sq.dtype_id, sq_val);

                    let avg = torch_sqrt(sq_val) + this.eps;
                    if this.momentum > 0.0 {
                        let m_val = tensor_storage_read_float(mom.storage, mom.offset + j, mom.dtype_id);
                        m_val = (this.momentum * m_val) + (g_val / avg);
                        tensor_storage_write_float(mom.storage, mom.offset + j, mom.dtype_id, m_val);
                        p_val = p_val - (this.lr * m_val);
                    } else {
                        p_val = p_val - (this.lr * g_val / avg);
                    }
                    tensor_storage_write_float(t.storage, t.offset + j, t.dtype_id, p_val);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    func zero_grad() {
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            p.zero_grad();
            i = i + 1;
        }
    }

    func get_lr() -> float {
        return this.lr;
    }

    func set_lr(new_lr: float) {
        this.lr = new_lr;
    }
}

// ------------------------------------------------------------------------------
// 5. Adagrad
// ------------------------------------------------------------------------------

class Adagrad {
    params: list,
    lr: float,
    eps: float,
    weight_decay: float,
    sum_sq: list,
    step_count: int
}

func optim_adagrad(params: list, lr: float, eps: float, weight_decay: float) -> Adagrad {
    let s_sq = list_new();
    let n = list_length(params);
    let i = 0;
    while i < n {
        let p: Parameter = list_get(params, i);
        list_push(s_sq, tensor_zeros(p.data.shape, p.data.dtype_id));
        i = i + 1;
    }
    return new Adagrad(params, lr, eps, weight_decay, s_sq, 0);
}

impl Optimizer for Adagrad {
    func step() {
        this.step_count = this.step_count + 1;
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            if p.requires_grad && p.data != null && p.data.grad != null {
                let t = p.data;
                let g = t.grad;
                let sum_sq: Tensor = list_get(this.sum_sq, i);
                let num = t.numel();
                let j = 0;
                while j < num {
                    let p_val = tensor_storage_read_float(t.storage, t.offset + j, t.dtype_id);
                    let g_val = tensor_storage_read_float(g.storage, g.offset + j, g.dtype_id);
                    if this.weight_decay != 0.0 {
                        g_val = g_val + (this.weight_decay * p_val);
                    }
                    let s_val = tensor_storage_read_float(sum_sq.storage, sum_sq.offset + j, sum_sq.dtype_id);
                    s_val = s_val + (g_val * g_val);
                    tensor_storage_write_float(sum_sq.storage, sum_sq.offset + j, sum_sq.dtype_id, s_val);

                    let std = torch_sqrt(s_val) + this.eps;
                    p_val = p_val - (this.lr * g_val / std);
                    tensor_storage_write_float(t.storage, t.offset + j, t.dtype_id, p_val);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    func zero_grad() {
        let n = list_length(this.params);
        let i = 0;
        while i < n {
            let p: Parameter = list_get(this.params, i);
            p.zero_grad();
            i = i + 1;
        }
    }

    func get_lr() -> float {
        return this.lr;
    }

    func set_lr(new_lr: float) {
        this.lr = new_lr;
    }
}

// ==============================================================================
// 22. Learning Rate Schedulers (StepLR, CosineAnnealingLR)
// ==============================================================================

class StepLR {
    optimizer: Optimizer,
    step_size: int,
    gamma: float,
    last_epoch: int
}

func optim_step_lr(optimizer: Optimizer, step_size: int, gamma: float) -> StepLR {
    return new StepLR(optimizer, step_size, gamma, 0);
}

impl StepLR {
    func step() -> float {
        this.last_epoch = this.last_epoch + 1;
        if this.last_epoch % this.step_size == 0 {
            let cur_lr = this.optimizer.get_lr();
            let new_lr = cur_lr * this.gamma;
            this.optimizer.set_lr(new_lr);
        }
        return this.optimizer.get_lr();
    }

    func get_last_lr() -> float {
        return this.optimizer.get_lr();
    }
}

class CosineAnnealingLR {
    optimizer: Optimizer,
    T_max: int,
    eta_min: float,
    last_epoch: int,
    base_lr: float
}

func optim_cosine_annealing_lr(optimizer: Optimizer, T_max: int, eta_min: float) -> CosineAnnealingLR {
    return new CosineAnnealingLR(optimizer, T_max, eta_min, 0, optimizer.get_lr());
}

impl CosineAnnealingLR {
    func step() -> float {
        this.last_epoch = this.last_epoch + 1;
        let pi = 3.141592653589793;
        let frac = int_to_float(this.last_epoch) / int_to_float(this.T_max);
        let cos_val = torch_cos(frac * pi);
        let new_lr = this.eta_min + (0.5 * (this.base_lr - this.eta_min) * (1.0 + cos_val));
        this.optimizer.set_lr(new_lr);
        return new_lr;
    }

    func get_last_lr() -> float {
        return this.optimizer.get_lr();
    }
}

// ==============================================================================
// 23. Optim Namespace Singleton (optim.SGD, optim.Adam, optim.StepLR, etc.)
// ==============================================================================

class Optim {}

func optim_init() -> Optim {
    return new Optim();
}

impl Optim {
    func SGD(params: list, lr: float, momentum: float, weight_decay: float, dampening: float, nesterov: bool) -> SGD {
        return optim_sgd(params, lr, momentum, weight_decay, dampening, nesterov);
    }

    func Adam(params: list, lr: float, beta1: float, beta2: float, eps: float, weight_decay: float) -> Adam {
        return optim_adam(params, lr, beta1, beta2, eps, weight_decay);
    }

    func AdamW(params: list, lr: float, beta1: float, beta2: float, eps: float, weight_decay: float) -> AdamW {
        return optim_adamw(params, lr, beta1, beta2, eps, weight_decay);
    }

    func RMSprop(params: list, lr: float, alpha: float, eps: float, weight_decay: float, momentum: float) -> RMSprop {
        return optim_rmsprop(params, lr, alpha, eps, weight_decay, momentum);
    }

    func Adagrad(params: list, lr: float, eps: float, weight_decay: float) -> Adagrad {
        return optim_adagrad(params, lr, eps, weight_decay);
    }

    func StepLR(optimizer: Optimizer, step_size: int, gamma: float) -> StepLR {
        return optim_step_lr(optimizer, step_size, gamma);
    }

    func CosineAnnealingLR(optimizer: Optimizer, T_max: int, eta_min: float) -> CosineAnnealingLR {
        return optim_cosine_annealing_lr(optimizer, T_max, eta_min);
    }
}
