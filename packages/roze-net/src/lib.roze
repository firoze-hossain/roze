}
func IPv6_custom(src: string, dst: string, next_hdr: int, hop_limit: int) -> Packet {
    let layer = packet_layer_new(layer_id_ipv6(), "IPv6", next_hdr, hop_limit, 0, 0, 0, 0, 0, 0, src, dst, "", "", "", raw_packet_new(0));
    return packet_from_single_layer(layer);
}

// 6. ICMP
func ICMP() -> Packet {
    return ICMP_Echo(0, 0);
}
func ICMP_Echo(id: int, seq: int) -> Packet {
    return ICMP_custom(8, 0, id, seq); // 8 = Echo Request
}
func ICMP_custom(msg_type: int, code: int, id: int, seq: int) -> Packet {
    let layer = packet_layer_new(layer_id_icmp(), "ICMP", msg_type, code, id, seq, 0, 0, 0, 0, "", "", "", "", "", raw_packet_new(0));
