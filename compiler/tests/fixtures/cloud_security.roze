import "cloud_security";

func main() {
    println("==================================================================");
    println("🌹 Roze Web Security & Cloud Observability Suite (M3-T10)");
    println("==================================================================");

    // -------------------------------------------------------------------------
    // TEST SUITE 1: SecurityPrincipal & RBAC Context
    // -------------------------------------------------------------------------
    println("[TEST SUITE 1] SecurityPrincipal & RBAC Context");
    let roles = list_new();
    list_push(roles, "USER");
    list_push(roles, "ADMIN");

    let scopes = list_new();
    list_push(scopes, "read:orders");
    list_push(scopes, "write:orders");

    let p = principal_new("user_101", "alice_admin", roles, scopes);
    println("Principal User ID:    " + p.user_id);
    println("Principal Username:   " + p.username);
    println("Principal Authenticated: " + to_string(p.authenticated));
    println("Has Role 'ADMIN':     " + to_string(principal_has_role(p, "ADMIN")));
    println("Has Role 'SUPER':     " + to_string(principal_has_role(p, "SUPER")));
    println("Has Scope 'read:orders': " + to_string(principal_has_scope(p, "read:orders")));

    let sec_ctx = sec_ctx_new();
    sec_ctx_set_principal(sec_ctx, p);
    let cur = sec_ctx_get_principal(sec_ctx);
    println("Context Principal:    " + cur.username);
    println("[PASS] SecurityPrincipal & RBAC Context verified.");

    // -------------------------------------------------------------------------
    // TEST SUITE 2: JWT Authentication Filter & RBAC Gatekeeper
    // -------------------------------------------------------------------------
    println("");
    println("[TEST SUITE 2] JWT Authentication Filter & RBAC Gatekeeper");
    let secret = "super-secret-enterprise-cloud-key-32b";
    let filter = jwt_auth_filter_new(secret, "https://auth.roze.enterprise");
    jwt_filter_exclude_path(filter, "/health");
    jwt_filter_exclude_path(filter, "/metrics");
    jwt_filter_require_role(filter, "/api/admin", "ADMIN");

    // 1. Excluded path
    let res1 = jwt_filter_authenticate(filter, "/health", "");
    println("Excluded /health Status: " + to_string(res1.status_code));

    // 2. Missing token on protected endpoint
    let res2 = jwt_filter_authenticate(filter, "/api/orders", "");
    println("Missing Token Status:    " + to_string(res2.status_code));
    println("WWW-Authenticate Header: " + res2.www_authenticate_header);

    // 3. User token attempting admin endpoint (RBAC 403 Forbidden)
    let user_roles = list_new();
    list_push(user_roles, "USER");
    let user_claims = map_new();
    map_set(user_claims, "sub", "user_42");
    map_set(user_claims, "username", "bob_regular");
    map_set(user_claims, "roles", user_roles);
    map_set(user_claims, "exp", time_now() + 3600);
    let user_token = jwt_sign(user_claims, secret);

    let res3 = jwt_filter_authenticate(filter, "/api/admin/settings", "Bearer " + user_token);
    println("Regular User /api/admin: " + to_string(res3.status_code) + " (" + res3.error_message + ")");

    // 4. Admin token on admin endpoint (200 OK)
    let admin_roles = list_new();
    list_push(admin_roles, "ADMIN");
    let admin_claims = map_new();
    map_set(admin_claims, "sub", "admin_01");
    map_set(admin_claims, "username", "alice_super");
    map_set(admin_claims, "roles", admin_roles);
    map_set(admin_claims, "exp", time_now() + 3600);
    let admin_token = jwt_sign(admin_claims, secret);

    let res4 = jwt_filter_authenticate(filter, "/api/admin/settings", "Bearer " + admin_token);
    println("Admin User /api/admin:   " + to_string(res4.status_code));
    println("Admin User Principal:    " + res4.principal.username);
    println("[PASS] JWT Authentication Filter & RBAC Gatekeeper verified.");

    // -------------------------------------------------------------------------
    // TEST SUITE 3: OAuth 2.0 / OIDC Token Validation & Scope Evaluator
    // -------------------------------------------------------------------------
    println("");
    println("[TEST SUITE 3] OAuth 2.0 / OIDC Token Validation & Scope Evaluator");
    let oauth_token = oauth2_issue_bearer_token("client_order_service", "sub_8899", "charlie_client", "read:orders write:orders", 7200, secret);
    let token_info = oauth2_validate_token(oauth_token, secret);
    println("OAuth2 Token Active:     " + to_string(token_info.active));
    println("OAuth2 Client ID:        " + token_info.client_id);
    println("OAuth2 Subject:          " + token_info.sub);
    println("OAuth2 Scope:            " + token_info.scope);
    println("Has Scope 'write:orders':" + to_string(oauth2_has_scope(token_info, "write:orders")));
    println("Has Scope 'admin:delete':" + to_string(oauth2_has_scope(token_info, "admin:delete")));
    println("[PASS] OAuth 2.0 / OIDC Token Validation verified.");

    // -------------------------------------------------------------------------
    // TEST SUITE 4: Argon2id Password Hashing Engine (RFC 9106)
    // -------------------------------------------------------------------------
    println("");
    println("[TEST SUITE 4] Argon2id Password Hashing Engine (RFC 9106)");
    let raw_pass = "EnterprisePassphrase#2026";
    let salt = "SecureRozeSalt42";
    let phc_hash = argon2id_hash_password(raw_pass, salt);
    println("Argon2id PHC Hash:       " + phc_hash);

    let verify_correct = argon2id_verify_password(raw_pass, phc_hash);
    let verify_wrong = argon2id_verify_password("WrongPassword123", phc_hash);
    println("Verify Correct Password: " + to_string(verify_correct));
    println("Verify Incorrect Password:" + to_string(verify_wrong));
    println("[PASS] Argon2id Password Hashing Engine verified.");

    // -------------------------------------------------------------------------
    // TEST SUITE 5: Prometheus / OpenMetrics Telemetry Engine (/metrics)
    // -------------------------------------------------------------------------
    println("");
    println("[TEST SUITE 5] Prometheus / OpenMetrics Telemetry Engine");
    let reg = metric_registry_new();
    metric_counter_inc(reg, "http_requests_total", "handler=\"/api/orders\",method=\"GET\",status=\"200\"", 42, "Total HTTP requests processed");
    metric_counter_inc(reg, "http_requests_total", "handler=\"/api/orders\",method=\"POST\",status=\"201\"", 18, "Total HTTP requests processed");
    metric_gauge_set(reg, "jvm_memory_used_bytes", "area=\"heap\"", 134217728, "Current JVM heap memory usage");
    metric_histogram_observe(reg, "http_request_duration_ms", "handler=\"/api/orders\"", 45, "HTTP request latency");
    metric_histogram_observe(reg, "http_request_duration_ms", "handler=\"/api/orders\"", 120, "HTTP request latency");

    let prom_text = prometheus_export_metrics(reg);
    println("--- Prometheus Exposition Sample ---");
    println(prom_text);
    println("[PASS] Prometheus / OpenMetrics Telemetry Engine verified.");

    // -------------------------------------------------------------------------
    // TEST SUITE 6: OpenTelemetry (OTel) Distributed Tracing Engine
    // -------------------------------------------------------------------------
    println("");
    println("[TEST SUITE 6] OpenTelemetry (OTel) Distributed Tracing Engine");
    let tracer = tracer_new("roze-cloud-service");
    let root_span = tracer_start_span(tracer, "HTTP GET /api/v1/orders/10042", "", 1000);
    span_set_attribute(root_span, "http.method", "GET");
    span_set_attribute(root_span, "http.route", "/api/v1/orders/{id}");
    span_add_event(root_span, "auth_successful");

    let traceparent_header = span_get_traceparent(root_span);
    println("W3C traceparent Header:  " + traceparent_header);

    // Child span simulating database query using propagated traceparent
    let db_span = tracer_start_span(tracer, "SQL SELECT FROM orders", traceparent_header, 1020);
    span_set_attribute(db_span, "db.system", "postgresql");
    span_end(tracer, db_span, 1055);

    span_end(tracer, root_span, 1070);

    let otel_json = tracer_export_json(tracer);
    println("OTel JSON Export:        " + otel_json);
    println("[PASS] OpenTelemetry (OTel) Distributed Tracing Engine verified.");

    // -------------------------------------------------------------------------
    // TEST SUITE 7: Auto-Generated OpenAPI 3.1 Specification & Swagger UI
    // -------------------------------------------------------------------------
    println("");
    println("[TEST SUITE 7] Auto-Generated OpenAPI 3.1 & Swagger UI");
    let spec = openapi_spec_new("RozeCommerce Cloud API", "v3.1.0", "Cloud-native enterprise microservices API");

    let ep1 = api_endpoint_new("/api/v1/orders/{id}");
    let op1 = api_op("GET", "Retrieve order by ID", list_new(), "", 200, true);
    api_endpoint_add_op(ep1, op1);
    openapi_add_endpoint(spec, ep1);

    let ep2 = api_endpoint_new("/api/v1/orders");
    let op2 = api_op("POST", "Create new customer order", list_new(), "OrderRequest", 201, true);
    api_endpoint_add_op(ep2, op2);
    openapi_add_endpoint(spec, ep2);

    let spec_json = openapi_spec_to_json(spec);
    println("--- OpenAPI 3.1 Spec (Excerpt) ---");
    println(string_substring(spec_json, 0, 300) + "...\n}");

    let swagger_html = swagger_ui_render_html(spec);
    println("Swagger UI HTML Length:  " + to_string(string_length(swagger_html)) + " bytes");
    println("[PASS] Auto-Generated OpenAPI 3.1 & Swagger UI verified.");

    println("==================================================================");
    println("All 7 Web Security & Cloud Observability Suites Passed Successfully!");
    println("==================================================================");
}
