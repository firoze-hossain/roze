// ------------------------------------------------------------------------------
// 4. Geometry, Vector & Physics Collision Math
// ------------------------------------------------------------------------------

class Vec2 {
    x: float,
    y: float
}

func vec2_new(x: float, y: float) -> Vec2 {
    return new Vec2(x, y);
}

func distance_sq(x1: float, y1: float, x2: float, y2: float) -> float {
    let dx = x1 - x2;
    let dy = y1 - y2;
    return (dx * dx) + (dy * dy);
}

func check_collision_circles(x1: float, y1: float, r1: float, x2: float, y2: float, r2: float) -> bool {
    let r_sum = r1 + r2;
    return distance_sq(x1, y1, x2, y2) <= (r_sum * r_sum);
}

func check_collision_box(x1: float, y1: float, w1: float, h1: float, x2: float, y2: float, w2: float, h2: float) -> bool {
    if (x1 + w1 >= x2) && (x1 <= x2 + w2) && (y1 + h1 >= y2) && (y1 <= y2 + h2) {
        return true;
    }
    return false;
}

// ------------------------------------------------------------------------------
// 5. Game Entity Classes (Spaceship, Projectile, Particle, Asteroid)
// ------------------------------------------------------------------------------

class Spaceship {
    x: float,
    y: float,
    vx: float,
    vy: float,
    angle: float,
    radius: float,
    health: int,
    score: int
}

func spaceship_new(x: float, y: float) -> Spaceship {
    return new Spaceship(x, y, 0.0, 0.0, 0.0, 16.0, 100, 0);
}

class Projectile {
    x: float,
    y: float,
    vx: float,
    vy: float,
    lifetime: float,
    active: bool
}

func projectile_new(x: float, y: float, vx: float, vy: float) -> Projectile {
    return new Projectile(x, y, vx, vy, 1.5, true);
}

class Particle {
    x: float,
    y: float,
    vx: float,
    vy: float,
    life: float,
    max_life: float,
    color: int,
    size: float
}

func particle_new(x: float, y: float, vx: float, vy: float, max_life: float, color: int, size: float) -> Particle {
    return new Particle(x, y, vx, vy, max_life, max_life, color, size);
}

class Asteroid {
    x: float,
    y: float,
    vx: float,
    vy: float,
    radius: float,
    health: int,
    color: int,
    active: bool
}

func asteroid_new(x: float, y: float, vx: float, vy: float, radius: float, health: int, color: int) -> Asteroid {
    return new Asteroid(x, y, vx, vy, radius, health, color, true);
}
