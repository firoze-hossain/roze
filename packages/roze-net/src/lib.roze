func NTP() -> Packet {
    return NTP_ClientRequest();
}
func NTP_ClientRequest() -> Packet {
    let layer = packet_layer_new(layer_id_ntp(), "NTP", 0, 4, 3, 0, 6, 236, 0, 0, "LOCL", "", "", "", "", raw_packet_new(0)); // leap=0, v=4, mode=3, stratum=0
    return packet_from_single_layer(layer);
}
